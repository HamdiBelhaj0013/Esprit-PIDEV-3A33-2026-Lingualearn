{% extends 'base.html.twig' %}

{% block title %}{{ user.id ? 'Edit User' : 'Create New User' }} - {{ parent() }}{% endblock %}

{% block page_title %}
    <i class="ti ti-{{ user.id ? 'pencil' : 'user-plus' }} me-2"></i>
    {{ user.id ? 'Edit User' : 'Create New User' }}
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb breadcrumb-arrows" aria-label="breadcrumbs">
        <li class="breadcrumb-item"><a href="{{ path('admin_users_index') }}">Users</a></li>
        {% if user.id %}
            <li class="breadcrumb-item"><a href="{{ path('admin_users_show', {id: user.id}) }}">{{ user.fullName }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit</li>
        {% else %}
            <li class="breadcrumb-item active" aria-current="page">New User</li>
        {% endif %}
    </ol>
{% endblock %}

{% block page_actions %}
    <div class="col-auto ms-auto d-print-none">
        <a href="{{ user.id ? path('admin_users_show', {id: user.id}) : path('admin_users_index') }}" class="btn">
            <i class="ti ti-arrow-left icon"></i>
            Back
        </a>
    </div>
{% endblock %}

{% block body %}
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        {{ user.id ? 'Edit User Information' : 'User Information' }}
                    </h3>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}

                    {# Personal Information Section #}
                    <div class="mb-3">
                        <h3 class="card-subtitle">Personal Information</h3>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                {{ form_label(form.firstName, null, {'label_attr': {'class': 'form-label required'}}) }}
                                {{ form_widget(form.firstName, {'attr': {'class': 'form-control', 'placeholder': 'John'}}) }}
                                {{ form_errors(form.firstName) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                {{ form_label(form.lastName, null, {'label_attr': {'class': 'form-label required'}}) }}
                                {{ form_widget(form.lastName, {'attr': {'class': 'form-control', 'placeholder': 'Doe'}}) }}
                                {{ form_errors(form.lastName) }}
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.email, null, {'label_attr': {'class': 'form-label required'}}) }}
                        <div class="input-icon">
                            <span class="input-icon-addon">
                                <i class="ti ti-mail"></i>
                            </span>
                            {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'user@example.com'}}) }}
                        </div>
                        {{ form_errors(form.email) }}
                    </div>

                    {# Password Section (Only for new users) #}
                    {% if form.plainPassword is defined %}
                        <hr class="my-4">
                        <div class="mb-3">
                            <h3 class="card-subtitle">Security</h3>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    {{ form_label(form.plainPassword.first, 'Password', {'label_attr': {'class': 'form-label required'}}) }}
                                    <div class="input-icon">
                                        <span class="input-icon-addon">
                                            <i class="ti ti-lock"></i>
                                        </span>
                                        {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-control', 'placeholder': '••••••••'}}) }}
                                    </div>
                                    {{ form_errors(form.plainPassword.first) }}
                                    <small class="form-hint">Minimum 6 characters</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="mb-3">
                                    {{ form_label(form.plainPassword.second, 'Confirm Password', {'label_attr': {'class': 'form-label required'}}) }}
                                    <div class="input-icon">
                                        <span class="input-icon-addon">
                                            <i class="ti ti-lock"></i>
                                        </span>
                                        {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control', 'placeholder': '••••••••'}}) }}
                                    </div>
                                    {{ form_errors(form.plainPassword.second) }}
                                </div>
                            </div>
                        </div>
                    {% endif %}

                    {# Admin Settings (Only for admins) #}
                    {% if form.status is defined %}
                        <hr class="my-4">
                        <div class="mb-3">
                            <h3 class="card-subtitle">Administrative Settings</h3>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    {{ form_label(form.status, null, {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.status, {'attr': {'class': 'form-select'}}) }}
                                    {{ form_errors(form.status) }}
                                </div>
                            </div>
                        </div>

                        {% if form.roles is defined %}
                            <div class="mb-3">
                                {{ form_label(form.roles, null, {'label_attr': {'class': 'form-label'}}) }}
                                <div class="form-selectgroup">
                                    {% for child in form.roles %}
                                        <label class="form-selectgroup-item">
                                            {{ form_widget(child, {'attr': {'class': 'form-selectgroup-input'}}) }}
                                            <span class="form-selectgroup-label">
                                                <i class="ti ti-{{ child.vars.label == 'Admin' ? 'shield-check' : (child.vars.label == 'Teacher' ? 'school' : (child.vars.label == 'Premium User' ? 'crown' : 'user')) }} me-1"></i>
                                                {{ child.vars.label }}
                                            </span>
                                        </label>
                                    {% endfor %}
                                </div>
                                {{ form_errors(form.roles) }}
                                <small class="form-hint">Select one or more roles for this user</small>
                            </div>
                        {% endif %}
                    {% endif %}

                    {# Form Actions #}
                    <div class="card-footer bg-transparent mt-4">
                        <div class="d-flex justify-content-between">
                            <a href="{{ user.id ? path('admin_users_show', {id: user.id}) : path('admin_users_index') }}"
                               class="btn">
                                <i class="ti ti-x icon"></i>
                                Cancel
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="ti ti-check icon"></i>
                                {{ user.id ? 'Update User' : 'Create User' }}
                            </button>
                        </div>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
