{% extends 'layouts/admin.html.twig' %}

{% block title %}{{ user.id ? 'Edit User' : 'Create New User' }} - {{ parent() }}{% endblock %}

{% block page_title %}
    <span class="d-flex align-items-center gap-2">
        <span class="page-icon-badge {{ user.id ? 'badge-edit' : 'badge-new' }}">
            <i class="ti ti-{{ user.id ? 'pencil' : 'user-plus' }}"></i>
        </span>
        {{ user.id ? 'Edit User' : 'Create New User' }}
    </span>
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb breadcrumb-arrows" aria-label="breadcrumbs">
        <li class="breadcrumb-item"><a href="{{ path('admin_users_index') }}"><i class="ti ti-users me-1"></i>Users</a></li>
        {% if user.id %}
            <li class="breadcrumb-item"><a href="{{ path('admin_users_show', {id: user.id}) }}">{{ user.fullName }}</a></li>
            <li class="breadcrumb-item active" aria-current="page">Edit</li>
        {% else %}
            <li class="breadcrumb-item active" aria-current="page">New User</li>
        {% endif %}
    </ol>
{% endblock %}

{% block page_actions %}
    <div class="col-auto ms-auto d-print-none">
        <a href="{{ user.id ? path('admin_users_show', {id: user.id}) : path('admin_users_index') }}" class="btn btn-ghost-secondary">
            <i class="ti ti-arrow-left me-1"></i> Back
        </a>
    </div>
{% endblock %}

{% block content %}

    {# ── SHARED STYLES ─────────────────────────────────────────────────────────── #}
    <style>
        :root {
            --uf-primary:    #3b5bdb;
            --uf-primary-lt: #edf2ff;
            --uf-success:   #2fb344;
            --uf-warn:      #f59f00;
            --uf-danger:    #d63939;
            --uf-text:      #1a1f36;
            --uf-muted:     #6c7a99;
            --uf-border:    #e3e8f0;
            --uf-bg:        #f8fafc;
            --uf-card:      #ffffff;
            --uf-radius:    14px;
            --uf-shadow:    0 4px 24px rgba(59,91,219,.08);
            --uf-shadow-lg: 0 8px 40px rgba(59,91,219,.14);
        }

        /* ── Layout ── */
        .uf-page { max-width: 860px; margin: 0 auto; }

        /* ── Section header ── */
        .uf-section {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 18px 0 10px;
            border-bottom: 2px solid var(--uf-border);
            margin-bottom: 24px;
        }
        .uf-section-icon {
            width: 36px; height: 36px;
            border-radius: 10px;
            display: grid; place-items: center;
            font-size: 18px;
            flex-shrink: 0;
        }
        .uf-section-icon.blue  { background: var(--uf-primary-lt); color: var(--uf-primary); }
        .uf-section-icon.green { background: #d3f9d8; color: var(--uf-success); }
        .uf-section-icon.gold  { background: #fff3bf; color: var(--uf-warn); }
        .uf-section-icon.red   { background: #ffe3e3; color: var(--uf-danger); }
        .uf-section h4 { margin: 0; font-size: .9rem; font-weight: 700; color: var(--uf-text); letter-spacing: .03em; text-transform: uppercase; }
        .uf-section small { color: var(--uf-muted); font-size: .78rem; margin-top: 1px; display: block; }

        /* ── Inputs ── */
        .uf-field { margin-bottom: 20px; }
        .uf-label {
            display: flex; align-items: center; gap: 6px;
            font-size: .8rem; font-weight: 600;
            color: var(--uf-text); margin-bottom: 7px; letter-spacing: .02em;
        }
        .uf-label .req { color: var(--uf-danger); }
        .uf-input-wrap { position: relative; }
        .uf-input-wrap .uf-icon {
            position: absolute; left: 13px; top: 50%; transform: translateY(-50%);
            color: var(--uf-muted); font-size: 16px; pointer-events: none;
            transition: color .2s;
        }
        .uf-input-wrap:focus-within .uf-icon { color: var(--uf-primary); }
        .uf-input-wrap input,
        .uf-input-wrap select {
            padding-left: 40px !important;
        }
        .form-control, .form-select {
            border: 1.5px solid var(--uf-border);
            border-radius: 10px;
            font-size: .88rem;
            padding: 10px 14px;
            transition: border-color .2s, box-shadow .2s;
            background: #fff;
        }
        .form-control:focus, .form-select:focus {
            border-color: var(--uf-primary);
            box-shadow: 0 0 0 3px rgba(59,91,219,.12);
            outline: none;
        }
        .uf-hint { font-size: .76rem; color: var(--uf-muted); margin-top: 5px; }
        .uf-error { font-size: .76rem; color: var(--uf-danger); margin-top: 4px; font-weight: 500; }

        /* ── Password strength ── */
        .pw-strength-bar { height: 4px; border-radius: 99px; background: var(--uf-border); margin-top: 8px; overflow: hidden; }
        .pw-strength-fill { height: 100%; border-radius: 99px; width: 0%; transition: width .4s ease, background .4s ease; }
        .pw-strength-label { font-size: .72rem; color: var(--uf-muted); margin-top: 3px; }
        .pw-toggle {
            position: absolute; right: 12px; top: 50%; transform: translateY(-50%);
            background: none; border: none; cursor: pointer; color: var(--uf-muted);
            font-size: 16px; padding: 0; transition: color .2s;
        }
        .pw-toggle:hover { color: var(--uf-primary); }

        /* ── Role cards ── */
        .role-cards { display: flex; flex-wrap: wrap; gap: 12px; }
        .role-card {
            flex: 1 1 calc(33% - 8px); min-width: 150px;
            border: 2px solid var(--uf-border);
            border-radius: 12px;
            padding: 16px 14px 14px;
            cursor: pointer;
            transition: border-color .2s, background .2s, box-shadow .2s, transform .15s;
            background: #fff;
            position: relative;
            overflow: hidden;
            user-select: none;
        }
        .role-card:hover { border-color: #b0c0f0; box-shadow: 0 2px 12px rgba(59,91,219,.1); transform: translateY(-1px); }
        .role-card.is-active {
            border-color: var(--uf-primary);
            background: var(--uf-primary-lt);
            box-shadow: 0 4px 16px rgba(59,91,219,.18);
        }
        .role-card.is-active.role-admin  { border-color: #e03131; background: #fff5f5; }
        .role-card.is-active.role-teacher{ border-color: #2f9e44; background: #ebfbee; }
        .role-card.is-active.role-user   { border-color: var(--uf-primary); background: var(--uf-primary-lt); }
        .role-card-icon {
            width: 40px; height: 40px; border-radius: 10px;
            display: grid; place-items: center;
            font-size: 20px; margin-bottom: 10px;
            transition: background .2s;
        }
        .role-user   .role-card-icon { background: #e8f0fe; color: var(--uf-primary); }
        .role-admin  .role-card-icon { background: #ffe3e3; color: #e03131; }
        .role-teacher.role-card-icon,
        .role-teacher .role-card-icon { background: #d3f9d8; color: #2f9e44; }
        .role-card.is-active.role-admin   .role-card-icon { background: #ffc9c9; }
        .role-card.is-active.role-teacher .role-card-icon { background: #b2f2bb; }
        .role-card.is-active.role-user    .role-card-icon { background: #bac8ff; }
        .role-card-name { font-weight: 700; font-size: .85rem; color: var(--uf-text); }
        .role-card-desc { font-size: .74rem; color: var(--uf-muted); margin-top: 2px; }
        .role-card-check {
            position: absolute; top: 10px; right: 10px;
            width: 20px; height: 20px; border-radius: 50%;
            border: 2px solid var(--uf-border);
            display: grid; place-items: center;
            transition: all .2s;
            background: #fff;
        }
        .role-card.is-active .role-card-check {
            border-color: currentColor;
            background: var(--uf-primary);
            border-color: var(--uf-primary);
        }
        .role-card.is-active.role-admin  .role-card-check { background: #e03131; border-color: #e03131; }
        .role-card.is-active.role-teacher .role-card-check { background: #2f9e44; border-color: #2f9e44; }
        .role-card-check i { color: #fff; font-size: 11px; opacity: 0; transition: opacity .15s; }
        .role-card.is-active .role-card-check i { opacity: 1; }
        /* Hide original Symfony checkbox inputs */
        .role-hidden-checkbox { position: absolute; opacity: 0; pointer-events: none; }

        /* ── Status selector ── */
        .status-pills { display: flex; gap: 8px; flex-wrap: wrap; }
        .status-pill {
            display: flex; align-items: center; gap: 8px;
            padding: 10px 16px; border-radius: 10px;
            border: 2px solid var(--uf-border);
            cursor: pointer; transition: all .2s;
            background: #fff; font-size: .83rem; font-weight: 600;
            user-select: none;
        }
        .status-pill:hover { transform: translateY(-1px); box-shadow: 0 2px 8px rgba(0,0,0,.08); }
        .status-pill input[type=radio] { position: absolute; opacity: 0; pointer-events: none; }
        .status-pill .dot { width: 8px; height: 8px; border-radius: 50%; }
        .status-pill[data-val="active"]    .dot { background: var(--uf-success); }
        .status-pill[data-val="suspended"] .dot { background: var(--uf-warn); }
        .status-pill[data-val="deleted"]   .dot { background: var(--uf-danger); }
        .status-pill.is-active[data-val="active"]    { border-color: var(--uf-success); background: #d3f9d8; color: #1a6130; }
        .status-pill.is-active[data-val="suspended"] { border-color: var(--uf-warn);    background: #fff3bf; color: #7d4a00; }
        .status-pill.is-active[data-val="deleted"]   { border-color: var(--uf-danger);  background: #ffe3e3; color: #7d1717; }

        /* ── Plan cards ── */
        .plan-cards { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 0; }
        .plan-card {
            flex: 1 1 140px;
            border: 2px solid var(--uf-border);
            border-radius: 14px; padding: 18px 14px 14px;
            cursor: pointer; transition: all .2s;
            background: #fff; text-align: center;
            position: relative; overflow: hidden;
            user-select: none;
        }
        .plan-card:hover { border-color: #b0c0f0; transform: translateY(-2px); box-shadow: var(--uf-shadow); }
        .plan-card.is-active {
            border-color: var(--uf-warn);
            background: linear-gradient(135deg,#fff9db 0%,#fff3bf 100%);
            box-shadow: 0 6px 24px rgba(245,159,0,.2);
        }
        .plan-card.is-active.plan-free { border-color: #868e96; background: #f8f9fa; }
        .plan-card-icon { font-size: 26px; margin-bottom: 8px; }
        .plan-card.is-active:not(.plan-free) .plan-card-icon { animation: pulse-crown .8s ease; }
        @keyframes pulse-crown {
            0%   { transform: scale(1); }
            40%  { transform: scale(1.3) rotate(-10deg); }
            70%  { transform: scale(.95) rotate(5deg); }
            100% { transform: scale(1); }
        }
        .plan-card-name { font-weight: 700; font-size: .85rem; color: var(--uf-text); }
        .plan-card-price { font-size: .74rem; color: var(--uf-muted); margin-top: 3px; }
        .plan-hidden-select { position: absolute; opacity: 0; pointer-events: none; }

        /* ── Expiry field ── */
        .expiry-wrap { transition: opacity .3s ease; }
        .expiry-wrap.is-disabled { opacity: .4; pointer-events: none; }

        /* ── Submit button ── */
        .uf-submit-btn {
            display: inline-flex; align-items: center; gap: 10px;
            padding: 12px 32px;
            background: linear-gradient(135deg, #3b5bdb 0%, #4c6ef5 100%);
            color: #fff; border: none; border-radius: 12px;
            font-weight: 700; font-size: .9rem;
            cursor: pointer;
            box-shadow: 0 4px 14px rgba(59,91,219,.4);
            transition: transform .15s, box-shadow .15s, opacity .2s;
            position: relative; overflow: hidden;
        }
        .uf-submit-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 24px rgba(59,91,219,.45); }
        .uf-submit-btn:active { transform: translateY(0); }
        .uf-submit-btn.loading { pointer-events: none; opacity: .8; }
        .uf-submit-btn .btn-spinner {
            display: none; width: 16px; height: 16px;
            border: 2px solid rgba(255,255,255,.4);
            border-top-color: #fff;
            border-radius: 50%;
            animation: spin .7s linear infinite;
        }
        .uf-submit-btn.loading .btn-spinner { display: block; }
        .uf-submit-btn.loading .btn-label { display: none; }
        @keyframes spin { to { transform: rotate(360deg); } }

        .uf-cancel-btn {
            display: inline-flex; align-items: center; gap: 8px;
            padding: 12px 24px;
            background: transparent;
            color: var(--uf-muted); border: 1.5px solid var(--uf-border);
            border-radius: 12px; font-weight: 600; font-size: .88rem;
            cursor: pointer; text-decoration: none;
            transition: all .2s;
        }
        .uf-cancel-btn:hover { border-color: var(--uf-danger); color: var(--uf-danger); background: #fff5f5; }

        /* ── Page icon badge ── */
        .page-icon-badge {
            width: 36px; height: 36px; border-radius: 10px;
            display: grid; place-items: center; font-size: 18px;
        }
        .page-icon-badge.badge-new  { background: #d3f9d8; color: #2f9e44; }
        .page-icon-badge.badge-edit { background: var(--uf-primary-lt); color: var(--uf-primary); }

        /* ── Animations ── */
        @keyframes fadeSlideUp {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .uf-card { animation: fadeSlideUp .4s ease both; }
        .uf-card:nth-child(2) { animation-delay: .06s; }
        .uf-card:nth-child(3) { animation-delay: .12s; }
        .uf-card:nth-child(4) { animation-delay: .18s; }

        /* ── Floating label effect for text inputs ── */
        .uf-input-wrap input::placeholder { color: #c0c8d8; }

        /* ── Subscription expiry timestamp ── */
        .expiry-badge {
            display: inline-flex; align-items: center; gap: 6px;
            padding: 6px 12px; border-radius: 8px;
            background: #fff9db; border: 1px solid #ffe066;
            color: #7d4a00; font-size: .78rem; font-weight: 600;
            margin-top: 8px;
        }
    </style>

    <div class="uf-page">
        {{ form_start(form, {'attr': {'id': 'user-form', 'novalidate': 'novalidate'}}) }}

        {# ── Global form errors (e.g. "email already taken") ──────────────────── #}
        {% set formErrors = form_errors(form) %}
        {% if formErrors %}
            <div class="alert alert-danger d-flex align-items-center gap-2 mb-3" role="alert">
                <i class="ti ti-alert-circle flex-shrink-0"></i>
                <div>{{ formErrors }}</div>
            </div>
        {% endif %}

        {# ── CARD 1 — Personal Info ─────────────────────────────────────────────── #}
        <div class="card mb-4 uf-card" style="border-radius:var(--uf-radius); border:1px solid var(--uf-border); box-shadow:var(--uf-shadow);">
            <div class="card-body p-4">
                <div class="uf-section">
                    <div class="uf-section-icon blue"><i class="ti ti-id-badge-2"></i></div>
                    <div>
                        <h4>Personal Information</h4>
                        <small>Name and contact details</small>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="uf-field">
                            <label class="uf-label">
                                <i class="ti ti-user"></i> First Name <span class="req">*</span>
                            </label>
                            <div class="uf-input-wrap">
                                <i class="ti ti-user uf-icon"></i>
                                {{ form_widget(form.firstName, {'attr': {'class': 'form-control' ~ (form.firstName.vars.valid ? '' : ' is-invalid'), 'placeholder': 'FirstName', 'style': 'padding-left:40px'}}) }}
                            </div>
                            <div class="uf-error">{{ form_errors(form.firstName) }}</div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="uf-field">
                            <label class="uf-label">
                                <i class="ti ti-user"></i> Last Name <span class="req">*</span>
                            </label>
                            <div class="uf-input-wrap">
                                <i class="ti ti-user uf-icon"></i>
                                {{ form_widget(form.lastName, {'attr': {'class': 'form-control' ~ (form.lastName.vars.valid ? '' : ' is-invalid'), 'placeholder': 'Last name', 'style': 'padding-left:40px'}}) }}
                            </div>
                            <div class="uf-error">{{ form_errors(form.lastName) }}</div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="uf-field mb-0">
                            <label class="uf-label">
                                <i class="ti ti-mail"></i> Email Address <span class="req">*</span>
                            </label>
                            <div class="uf-input-wrap">
                                <i class="ti ti-mail uf-icon"></i>
                                {{ form_widget(form.email, {'attr': {'class': 'form-control' ~ (form.email.vars.valid ? '' : ' is-invalid'), 'placeholder': 'name@example.com', 'style': 'padding-left:40px'}}) }}
                            </div>
                            <div class="uf-error">{{ form_errors(form.email) }}</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# ── CARD 2 — Password ──────────────────────────────────────────────────── #}
        {% if form.plainPassword is defined %}
            <div class="card mb-4 uf-card" style="border-radius:var(--uf-radius); border:1px solid var(--uf-border); box-shadow:var(--uf-shadow);">
                <div class="card-body p-4">
                    <div class="uf-section">
                        <div class="uf-section-icon red"><i class="ti ti-lock"></i></div>
                        <div>
                            <h4>Security</h4>
                            <small>
                                {% if user.id %}Leave blank to keep the current password{% else %}Set a strong password{% endif %}
                            </small>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="uf-field">
                                <label class="uf-label">
                                    <i class="ti ti-lock"></i>
                                    {{ user.id ? 'New Password' : 'Password' }}
                                    {% if not user.id %}<span class="req">*</span>{% endif %}
                                </label>
                                <div class="uf-input-wrap" style="position:relative">
                                    <i class="ti ti-lock uf-icon"></i>
                                    {{ form_widget(form.plainPassword.first, {'attr': {
                                        'class': 'form-control' ~ (form.plainPassword.vars.valid ? '' : ' is-invalid'),
                                        'placeholder': '••••••••',
                                        'id': 'pw-field-1',
                                        'style': 'padding-left:40px; padding-right:42px'
                                    }}) }}
                                    <button type="button" class="pw-toggle" onclick="togglePw('pw-field-1',this)">
                                        <i class="ti ti-eye"></i>
                                    </button>
                                </div>
                                <div class="pw-strength-bar"><div class="pw-strength-fill" id="pw-strength-fill"></div></div>
                                <div class="pw-strength-label" id="pw-strength-label">Enter a password</div>
                                <div class="uf-error">{{ form_errors(form.plainPassword.first) }}</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="uf-field">
                                <label class="uf-label">
                                    <i class="ti ti-lock-check"></i> Confirm Password
                                    {% if not user.id %}<span class="req">*</span>{% endif %}
                                </label>
                                <div class="uf-input-wrap" style="position:relative">
                                    <i class="ti ti-lock-check uf-icon"></i>
                                    {{ form_widget(form.plainPassword.second, {'attr': {
                                        'class': 'form-control' ~ (form.plainPassword.vars.valid ? '' : ' is-invalid'),
                                        'placeholder': '••••••••',
                                        'id': 'pw-field-2',
                                        'style': 'padding-left:40px; padding-right:42px'
                                    }}) }}
                                    <button type="button" class="pw-toggle" onclick="togglePw('pw-field-2',this)">
                                        <i class="ti ti-eye"></i>
                                    </button>
                                </div>
                                <div class="uf-hint" id="pw-match-hint"></div>
                                <div class="uf-error">{{ form_errors(form.plainPassword.second) }}</div>
                            </div>
                        </div>
                    </div>
                    <div class="uf-error">{{ form_errors(form.plainPassword) }}</div>
                </div>
            </div>
        {% endif %}

        {# ── CARD 3 — Admin Settings ────────────────────────────────────────────── #}
        {% if form.status is defined %}
            <div class="card mb-4 uf-card" style="border-radius:var(--uf-radius); border:1px solid var(--uf-border); box-shadow:var(--uf-shadow);">
                <div class="card-body p-4">
                    <div class="uf-section">
                        <div class="uf-section-icon red"><i class="ti ti-shield-lock"></i></div>
                        <div>
                            <h4>Administrative Settings</h4>
                            <small>Roles and permissions</small>
                        </div>
                    </div>

                    {# ── Account Status: hidden on NEW — new users always start active ── #}
                    {# The select is still rendered so Symfony submits 'active' as the value. #}
                    <div style="position:absolute;opacity:0;pointer-events:none;width:1px;height:1px;overflow:hidden;">
                        {{ form_widget(form.status, {'attr': {'id': 'status-select', 'data-default': 'active'}}) }}
                    </div>

                    {# ── Roles ── #}
                    {% if form.roles is defined %}
                        <div class="uf-field mt-4">
                            <label class="uf-label"><i class="ti ti-badge"></i> User Roles</label>

                            {# Render Symfony's hidden checkboxes (accessible but visually hidden) #}
                            <div style="position:absolute;opacity:0;pointer-events:none;width:1px;height:1px;overflow:hidden;" aria-hidden="true">
                                {% for child in form.roles %}
                                    {{ form_widget(child) }}
                                {% endfor %}
                            </div>

                            <div class="role-cards">
                                {% set roleData = {
                                    'ROLE_USER':    {'label': 'User',    'icon': 'ti-user',         'desc': 'Standard access', 'css': 'role-user'},
                                    'ROLE_ADMIN':   {'label': 'Admin',   'icon': 'ti-shield-check', 'desc': 'Full admin access', 'css': 'role-admin'},
                                    'ROLE_TEACHER': {'label': 'Teacher', 'icon': 'ti-school',       'desc': 'Manage content', 'css': 'role-teacher'}
                                } %}
                                {% for child in form.roles %}
                                    {% set val = child.vars.value %}
                                    {% set rd  = roleData[val] ?? {'label': val, 'icon': 'ti-user', 'desc': '', 'css': 'role-user'} %}
                                    {% set checked = child.vars.checked %}
                                    <div class="role-card {{ rd.css }} {% if checked %}is-active{% endif %}"
                                         data-role="{{ val }}"
                                         data-checkbox-id="{{ child.vars.id }}"
                                         onclick="toggleRole(this)">
                                        <div class="role-card-check"><i class="ti ti-check"></i></div>
                                        <div class="role-card-icon"><i class="ti {{ rd.icon }}"></i></div>
                                        <div class="role-card-name">{{ rd.label }}</div>
                                        <div class="role-card-desc">{{ rd.desc }}</div>
                                    </div>
                                {% endfor %}
                            </div>
                            <div class="uf-hint mt-2">Select all roles that apply. Users always have base ROLE_USER.</div>
                            <div class="uf-error">{{ form_errors(form.roles) }}</div>
                        </div>
                    {% endif %}
                </div>
            </div>
        {% endif %}

        {# ── FOOTER — Save / Cancel ─────────────────────────────────────────── #}
        <div class="d-flex align-items-center justify-content-between py-2 mt-2">
            <a href="{{ path('admin_users_index') }}" class="uf-cancel-btn">
                <i class="ti ti-x me-1"></i> Cancel
            </a>
            <button type="submit" class="uf-submit-btn" id="submit-btn">
                <div class="btn-spinner"></div>
                <span class="btn-label">
                    <i class="ti ti-user-plus me-1"></i> Create User
                </span>
            </button>
        </div>

        {{ form_rest(form) }}{# renders hidden _token (CSRF) and any unrendered fields #}
        {{ form_end(form, {'render_rest': false}) }}
    </div>{# end .uf-page #}

    {# ── Subscription card is OUTSIDE the main form to avoid nested-form issues ── #}
    <div class="uf-page">
        {# ── CARD 4 — Subscription Management ─────────────────────────────────
           NOTE: This card is OUTSIDE the main form on purpose.
           HTML forbids nested forms — action forms here are standalone.
        ─────────────────────────────────────────────────────────────────── #}
        <div class="card mb-4 uf-card" style="border-radius:var(--uf-radius); border:1px solid var(--uf-border); box-shadow:var(--uf-shadow);">
            <div class="card-body p-4">
                <div class="uf-section">
                    <div class="uf-section-icon gold"><i class="ti ti-crown"></i></div>
                    <div>
                        <h4>Subscription Management</h4>
                        <small>Changes sync with Stripe in real time</small>
                    </div>
                </div>

                {# ── Current status ── #}
                {% if user.id %}
                    <div class="p-3 rounded-3 mb-3" style="background:var(--uf-bg); border:1px solid var(--uf-border);">
                        <div class="d-flex align-items-center gap-3">
                        <span style="background:{% if user.isPremium %}#fff3bf{% else %}#f1f3f9{% endif %}; color:{% if user.isPremium %}#e67700{% else %}#868e96{% endif %}; border-radius:10px; font-size:18px; width:40px; height:40px; display:grid; place-items:center; flex-shrink:0;">
                            {% if user.isPremium %}👑{% else %}👤{% endif %}
                        </span>
                            <div>
                                <strong style="font-size:.85rem;">{{ user.subscriptionPlan ?? 'FREE' }}</strong>
                                <div style="font-size:.78rem; color:var(--uf-muted);">
                                    {% if user.subscriptionExpiry %}
                                        Expires {{ user.subscriptionExpiry|date('M d, Y') }}
                                    {% else %}
                                        No expiry
                                    {% endif %}
                                    {% if user.stripeSubscriptionId %}
                                        &nbsp;·&nbsp;<span style="color:#2f9e44;"><i class="ti ti-brand-stripe"></i> Stripe linked</span>
                                    {% elseif user.isPremium %}
                                        &nbsp;·&nbsp;<span style="color:#f59f00;"><i class="ti ti-shield-check"></i> Admin-granted</span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>

                    {% if not user.isPremium %}
                        {# ─── User is FREE: show grant options ─── #}
                        <div class="mb-3">
                            <div style="font-size:.78rem; font-weight:700; color:#374151; margin-bottom:10px; text-transform:uppercase; letter-spacing:.04em;">
                                <i class="ti ti-crown text-warning"></i> Grant Premium Access
                            </div>

                            {# One-click grant buttons — no Stripe charge needed, DB-only #}
                            <div style="display:flex; gap:8px; flex-wrap:wrap; margin-bottom:16px;">
                                <form method="post" action="{{ path('admin_users_grant_premium', {id: user.id, plan: 'MONTHLY'}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('grant_premium_' ~ user.id) }}">
                                    <button type="submit" onclick="return confirm('Grant MONTHLY premium to {{ user.fullName|e('js') }}?')"
                                            class="btn btn-sm" style="background:#16a34a;color:#fff;border:none;border-radius:8px;padding:9px 18px;font-weight:600;font-size:.82rem;">
                                        <i class="ti ti-crown me-1"></i> Monthly ($9.99/mo)
                                    </button>
                                </form>
                                <form method="post" action="{{ path('admin_users_grant_premium', {id: user.id, plan: 'YEARLY'}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('grant_premium_' ~ user.id) }}">
                                    <button type="submit" onclick="return confirm('Grant YEARLY premium to {{ user.fullName|e('js') }}?')"
                                            class="btn btn-sm" style="background:#d97706;color:#fff;border:none;border-radius:8px;padding:9px 18px;font-weight:600;font-size:.82rem;">
                                        <i class="ti ti-diamond me-1"></i> Yearly ($99.99/yr)
                                    </button>
                                </form>
                            </div>

                            {# Free trial: 3 quick buttons for common durations #}
                            <div style="border-top:1px solid var(--uf-border); padding-top:12px;">
                                <div style="font-size:.78rem; font-weight:700; color:#374151; margin-bottom:8px; text-transform:uppercase; letter-spacing:.04em;">
                                    <i class="ti ti-gift text-info"></i> Free Trial (no charge)
                                </div>
                                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                                    {% for days, plan in {'7': 'MONTHLY', '14': 'MONTHLY', '30': 'MONTHLY'} %}
                                        <form method="post" action="{{ path('admin_users_free_trial', {id: user.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('free_trial_' ~ user.id) }}">
                                            <input type="hidden" name="plan" value="{{ plan }}">
                                            <input type="hidden" name="trial_days" value="{{ days }}">
                                            <button type="submit" onclick="return confirm('Give {{ user.fullName|e('js') }} a {{ days }}-day free trial?')"
                                                    class="btn btn-sm btn-outline-secondary" style="border-radius:8px; font-size:.8rem;">
                                                {{ days }} days
                                            </button>
                                        </form>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>

                    {% else %}
                        {# ─── User is PREMIUM: show switch + revoke ─── #}
                        <div class="mb-3">
                            <div style="font-size:.78rem; font-weight:700; color:#374151; margin-bottom:10px; text-transform:uppercase; letter-spacing:.04em;">
                                <i class="ti ti-arrows-exchange"></i> Change Plan
                            </div>
                            {% if user.subscriptionPlan == 'MONTHLY' %}
                                <form method="post" action="{{ path('admin_users_change_plan', {id: user.id, plan: 'YEARLY'}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('change_plan_' ~ user.id) }}">
                                    <button type="submit" onclick="return confirm('Upgrade {{ user.fullName|e('js') }} to YEARLY?')"
                                            class="btn btn-sm" style="background:#d97706;color:#fff;border:none;border-radius:8px;padding:9px 18px;font-weight:600;font-size:.82rem;">
                                        <i class="ti ti-arrow-up me-1"></i> Upgrade to Yearly ($99.99/yr)
                                    </button>
                                </form>
                            {% else %}
                                <form method="post" action="{{ path('admin_users_change_plan', {id: user.id, plan: 'MONTHLY'}) }}">
                                    <input type="hidden" name="_token" value="{{ csrf_token('change_plan_' ~ user.id) }}">
                                    <button type="submit" onclick="return confirm('Downgrade {{ user.fullName|e('js') }} to MONTHLY?')"
                                            class="btn btn-sm" style="background:#6366f1;color:#fff;border:none;border-radius:8px;padding:9px 18px;font-weight:600;font-size:.82rem;">
                                        <i class="ti ti-arrow-down me-1"></i> Downgrade to Monthly ($9.99/mo)
                                    </button>
                                </form>
                            {% endif %}
                        </div>

                        <div>
                            <div style="font-size:.78rem; font-weight:700; color:#374151; margin-bottom:8px; text-transform:uppercase; letter-spacing:.04em;">
                                <i class="ti ti-ban text-danger"></i> Revoke Premium
                            </div>
                            <form method="post" action="{{ path('admin_users_revoke_premium', {id: user.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('revoke_premium_' ~ user.id) }}">
                                <button type="submit" onclick="return confirm('Revoke premium from {{ user.fullName|e('js') }}? Access removed immediately.')"
                                        class="btn btn-sm btn-danger" style="border-radius:8px; font-size:.82rem;">
                                    <i class="ti ti-ban me-1"></i> Revoke Premium Access
                                </button>
                            </form>
                        </div>
                    {% endif %}

                {% else %}
                    {# ─── New user being created ─── #}
                    <div style="background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:10px; padding:14px 16px; color:#6b7280; font-size:.82rem; line-height:1.7;">
                        <i class="ti ti-info-circle" style="color:#3b5bdb;"></i>
                        <strong>Subscription assigned after account creation.</strong><br>
                        New users start FREE. Open the profile after saving to grant access.
                    </div>
                {% endif %}

            </div>
        </div>
    </div>{# end subscription #}

    <script>
        /* ── Role card toggle ─────────────────────────────────────────────────── */
        function toggleRole(card) {
            const checkboxId = card.dataset.checkboxId;
            const checkbox   = document.getElementById(checkboxId);
            if (!checkbox) return;

            // Toggle checked state
            checkbox.checked = !checkbox.checked;

            // Sync visual
            card.classList.toggle('is-active', checkbox.checked);
        }

        /* ── Status: hidden on create — always defaults to active ── */

        /* ── Password strength ──────────────────────────────────────────────────── */
        function togglePw(id, btn) {
            const inp = document.getElementById(id);
            if (!inp) return;
            const show = inp.type === 'password';
            inp.type = show ? 'text' : 'password';
            btn.querySelector('i').className = show ? 'ti ti-eye-off' : 'ti ti-eye';
        }

        (function initPwStrength() {
            const pw1  = document.getElementById('pw-field-1');
            const pw2  = document.getElementById('pw-field-2');
            const fill = document.getElementById('pw-strength-fill');
            const lbl  = document.getElementById('pw-strength-label');
            const matchHint = document.getElementById('pw-match-hint');

            if (!pw1 || !fill) return;

            const levels = [
                { score: 0,  color: '#dee2e6', text: 'Enter a password' },
                { score: 25, color: '#d63939', text: '⚠ Too short' },
                { score: 50, color: '#f59f00', text: 'Fair — add numbers or symbols' },
                { score: 75, color: '#4dabf7', text: 'Good — keep going!' },
                { score: 100,color: '#2fb344', text: '✓ Strong password' }
            ];

            function scorePassword(v) {
                if (!v) return 0;
                let s = 0;
                if (v.length >= 6)  s += 25;
                if (v.length >= 10) s += 25;
                if (/[A-Z]/.test(v) && /[a-z]/.test(v)) s += 25;
                if (/\d/.test(v) || /[^A-Za-z0-9]/.test(v)) s += 25;
                return s;
            }

            pw1.addEventListener('input', () => {
                const score = scorePassword(pw1.value);
                const l = levels.find(x => x.score === score) || levels[0];
                fill.style.width  = score + '%';
                fill.style.background = l.color;
                lbl.textContent   = l.text;
                lbl.style.color   = l.color === '#dee2e6' ? 'var(--uf-muted)' : l.color;
                checkMatch();
            });

            if (pw2) pw2.addEventListener('input', checkMatch);

            function checkMatch() {
                if (!matchHint || !pw2) return;
                if (!pw2.value) { matchHint.textContent = ''; return; }
                if (pw1.value === pw2.value) {
                    matchHint.innerHTML = '<span style="color:#2fb344">✓ Passwords match</span>';
                } else {
                    matchHint.innerHTML = '<span style="color:#d63939">✗ Passwords do not match</span>';
                }
            }
        })();

        /* ── Submit button loading state ─────────────────────────────────────────── */
        document.getElementById('user-form')?.addEventListener('submit', function() {
            const btn = document.getElementById('submit-btn');
            if (btn) btn.classList.add('loading');
        });
    </script>
{% endblock %}
