{% extends 'layouts/admin.html.twig' %}
{% block title %}Learning Stats · {{ user.fullName }} - {{ parent() }}{% endblock %}
{% block page_title %}
    <span class="d-flex align-items-center gap-2">
        <span style="width:36px;height:36px;border-radius:10px;background:#f3f0ff;color:#7c3aed;display:grid;place-items:center;font-size:18px"><i class="ti ti-chart-bar"></i></span>
        Learning Stats — {{ user.fullName }}
    </span>
{% endblock %}
{% block breadcrumb %}
    <ol class="breadcrumb breadcrumb-arrows" aria-label="breadcrumbs">
        <li class="breadcrumb-item"><a href="{{ path('admin_users_index') }}"><i class="ti ti-users me-1"></i>Users</a></li>
        <li class="breadcrumb-item"><a href="{{ path('admin_users_show', {id: user.id}) }}">{{ user.fullName }}</a></li>
        <li class="breadcrumb-item active">Learning Stats</li>
    </ol>
{% endblock %}
{% block page_actions %}
    <div class="col-auto ms-auto d-print-none">
        <a href="{{ path('admin_users_show', {id: user.id}) }}" class="btn btn-ghost-secondary" style="border-radius:10px"><i class="ti ti-arrow-left me-1"></i> Back to Profile</a>
    </div>
{% endblock %}
{% block content %}
<style>
.st-card{background:#fff;border:1px solid #e3e8f0;border-radius:14px;box-shadow:0 2px 16px rgba(124,58,237,.07);overflow:hidden;margin-bottom:20px;animation:stFade .4s ease both}
@keyframes stFade{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:translateY(0)}}
.st-card-header{padding:16px 22px 14px;border-bottom:1px solid #e3e8f0;display:flex;align-items:center;gap:10px}
.st-card-body{padding:24px 22px}
.st-ico{width:32px;height:32px;border-radius:8px;display:grid;place-items:center;font-size:16px}
.current-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}
@media(max-width:700px){.current-stats{grid-template-columns:1fr 1fr}}
.cs-item{text-align:center;padding:14px;border-radius:10px;background:#f8fafc;border:1px solid #e3e8f0}
.cs-val{font-size:1.5rem;font-weight:800;color:#1a1f36;line-height:1}
.cs-lbl{font-size:.7rem;color:#6c7a99;font-weight:600;text-transform:uppercase;letter-spacing:.04em;margin-top:4px}
.stat-input-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}
@media(max-width:700px){.stat-input-grid{grid-template-columns:1fr}}
.sic{border:2px solid #e3e8f0;border-radius:12px;padding:20px 18px;background:#f8fafc;transition:border-color .2s,box-shadow .2s}
.sic:focus-within{border-color:#7c3aed;box-shadow:0 0 0 3px rgba(124,58,237,.1);background:#fff}
.sic-ico{width:38px;height:38px;border-radius:10px;display:grid;place-items:center;font-size:18px;margin-bottom:12px}
.sic-lbl{font-size:.78rem;font-weight:700;color:#6c7a99;text-transform:uppercase;letter-spacing:.05em;margin-bottom:8px}
.sic-inp{width:100%;border:1.5px solid #e3e8f0;border-radius:9px;padding:10px 14px;font-size:1.4rem;font-weight:800;color:#1a1f36;background:#fff;outline:none;transition:border-color .2s;-moz-appearance:textfield}
.sic-inp::-webkit-outer-spin-button,.sic-inp::-webkit-inner-spin-button{-webkit-appearance:none}
.sic-inp:focus{border-color:#7c3aed;box-shadow:0 0 0 3px rgba(124,58,237,.1)}
.sic-hint{font-size:.72rem;color:#6c7a99;margin-top:7px}
.cmp{display:none;align-items:center;gap:6px;margin-top:8px;font-size:.75rem}
.cmp .old{color:#6c7a99;text-decoration:line-through}.cmp .arr{color:#94a3b8}.cmp .nw{font-weight:700}
</style>

<div style="max-width:820px;margin:0 auto">
    <div class="st-card">
        <div class="st-card-header">
            <div class="st-ico" style="background:#f3f0ff;color:#7c3aed"><i class="ti ti-trending-up"></i></div>
            <span style="font-weight:700;font-size:.88rem;color:#1a1f36">Current Stats for {{ user.firstName }}</span>
        </div>
        <div class="st-card-body">
            <div class="current-stats">
                <div class="cs-item"><div class="cs-val" style="color:#7c3aed">{{ stats.totalXP }}</div><div class="cs-lbl"><i class="ti ti-star"></i> Total XP</div></div>
                <div class="cs-item"><div class="cs-val" style="color:#0891b2">{{ stats.wordsLearned }}</div><div class="cs-lbl"><i class="ti ti-vocabulary"></i> Words</div></div>
                <div class="cs-item"><div class="cs-val" style="color:#059669">{{ stats.totalMinutesStudied }}</div><div class="cs-lbl"><i class="ti ti-clock"></i> Minutes</div></div>
                <div class="cs-item">
                    <div class="cs-val" style="font-size:1rem">{% if stats.lastStudySession %}{{ stats.lastStudySession|date('M d, Y') }}{% else %}<span style="color:#6c7a99">—</span>{% endif %}</div>
                    <div class="cs-lbl"><i class="ti ti-calendar"></i> Last Session</div>
                </div>
            </div>
        </div>
    </div>

    <div class="st-card" style="animation-delay:.08s">
        <div class="st-card-header">
            <div class="st-ico" style="background:#f3f0ff;color:#7c3aed"><i class="ti ti-pencil"></i></div>
            <span style="font-weight:700;font-size:.88rem;color:#1a1f36">Edit Learning Stats</span>
            <span style="margin-left:auto;font-size:.74rem;color:#6c7a99">Saved immediately on submit</span>
        </div>
        <div class="st-card-body">
            <form method="post" action="{{ path('admin_users_stats', {id: user.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('stats' ~ user.id) }}">
                <div class="stat-input-grid">
                    <div class="sic">
                        <div class="sic-ico" style="background:#f3f0ff;color:#7c3aed"><i class="ti ti-star"></i></div>
                        <div class="sic-lbl">Total XP</div>
                        <input type="number" name="totalXP" min="0" value="{{ stats.totalXP }}" class="sic-inp" oninput="cmp('xp',{{ stats.totalXP }},this.value)">
                        <div class="cmp" id="cmp-xp"><span class="old">{{ stats.totalXP }}</span><span class="arr">→</span><span class="nw" id="nw-xp"></span></div>
                        <div class="sic-hint">Experience points total</div>
                    </div>
                    <div class="sic">
                        <div class="sic-ico" style="background:#ecfeff;color:#0891b2"><i class="ti ti-vocabulary"></i></div>
                        <div class="sic-lbl">Words Learned</div>
                        <input type="number" name="wordsLearned" min="0" value="{{ stats.wordsLearned }}" class="sic-inp" oninput="cmp('words',{{ stats.wordsLearned }},this.value)">
                        <div class="cmp" id="cmp-words"><span class="old">{{ stats.wordsLearned }}</span><span class="arr">→</span><span class="nw" id="nw-words"></span></div>
                        <div class="sic-hint">Vocabulary items mastered</div>
                    </div>
                    <div class="sic">
                        <div class="sic-ico" style="background:#d1fae5;color:#059669"><i class="ti ti-clock"></i></div>
                        <div class="sic-lbl">Minutes Studied</div>
                        <input type="number" name="totalMinutesStudied" min="0" value="{{ stats.totalMinutesStudied }}" class="sic-inp" oninput="cmp('mins',{{ stats.totalMinutesStudied }},this.value)">
                        <div class="cmp" id="cmp-mins"><span class="old">{{ stats.totalMinutesStudied }}</span><span class="arr">→</span><span class="nw" id="nw-mins"></span></div>
                        <div class="sic-hint">Total study time in minutes</div>
                    </div>
                </div>
                <div style="display:flex;align-items:center;justify-content:space-between;margin-top:24px;padding-top:20px;border-top:1px solid #e3e8f0">
                    <a href="{{ path('admin_users_show', {id: user.id}) }}" style="padding:10px 20px;border-radius:10px;border:1.5px solid #e3e8f0;color:#6c7a99;font-size:.85rem;font-weight:600;text-decoration:none"><i class="ti ti-x me-1"></i> Cancel</a>
                    <button type="submit" style="padding:12px 32px;border-radius:11px;background:linear-gradient(135deg,#7c3aed,#4f46e5);color:#fff;font-size:.88rem;font-weight:700;border:none;cursor:pointer;box-shadow:0 4px 14px rgba(124,58,237,.35);display:inline-flex;align-items:center;gap:8px">
                        <i class="ti ti-device-floppy"></i> Save Stats
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function cmp(key, orig, val) {
    const el = document.getElementById('cmp-'+key);
    const nw = document.getElementById('nw-'+key);
    const n  = parseInt(val)||0;
    el.style.display = n !== orig ? 'flex' : 'none';
    nw.textContent = n;
    nw.style.color = n > orig ? '#059669' : '#dc2626';
}
</script>
{% endblock %}
