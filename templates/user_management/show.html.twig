{% extends 'admin/base.html.twig' %}

{% block title %}{{ user.fullName }} - User Details - {{ parent() }}{% endblock %}

{% block page_title %}
    <i class="ti ti-user-circle me-2"></i> {{ user.fullName }}
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb breadcrumb-arrows" aria-label="breadcrumbs">
        <li class="breadcrumb-item"><a href="{{ path('admin_users_index') }}">Users</a></li>
        <li class="breadcrumb-item active" aria-current="page">{{ user.fullName }}</li>
    </ol>
{% endblock %}

{% block page_actions %}
    <div class="col-auto ms-auto d-print-none">
        <div class="btn-list">
            <a href="{{ path('admin_users_edit', {id: user.id}) }}" class="btn btn-primary">
                <i class="ti ti-pencil icon"></i>
                Edit
            </a>
            <a href="{{ path('admin_users_index') }}" class="btn">
                <i class="ti ti-arrow-left icon"></i>
                Back
            </a>
        </div>
    </div>
{% endblock %}

{% block body %}
    <div class="row row-deck row-cards">
        {# User Profile Card #}
        <div class="col-md-4">
            <div class="card">
                <div class="card-body text-center">
                    <span class="avatar avatar-xl mb-3" style="background-image: url(https://ui-avatars.com/api/?name={{ user.firstName }}+{{ user.lastName }}&size=200&background=206bc4&color=fff)"></span>
                    <h3 class="m-0 mb-1">{{ user.fullName }}</h3>
                    <div class="text-muted">{{ user.email }}</div>
                    <div class="mt-3">
                        {% if user.isPremium %}
                            <span class="badge bg-yellow-lt">
                                <i class="ti ti-crown"></i> Premium Member
                            </span>
                        {% else %}
                            <span class="badge bg-blue-lt">Free Account</span>
                        {% endif %}

                        {% if user.status == 'active' %}
                            <span class="badge bg-green-lt ms-1">
                                <i class="ti ti-check"></i> Active
                            </span>
                        {% elseif user.status == 'suspended' %}
                            <span class="badge bg-yellow-lt ms-1">
                                <i class="ti ti-alert-triangle"></i> Suspended
                            </span>
                        {% else %}
                            <span class="badge bg-red-lt ms-1">
                                <i class="ti ti-x"></i> Deleted
                            </span>
                        {% endif %}
                    </div>
                </div>
                <div class="card-footer">
                    <div class="row">
                        <div class="col">
                            <a href="mailto:{{ user.email }}" class="btn w-100">
                                <i class="ti ti-mail"></i>
                                Email
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            {# Quick Actions Card #}
            <div class="card mt-3">
                <div class="card-header">
                    <h3 class="card-title">Quick Actions</h3>
                </div>
                <div class="card-body">
                    {# Status Actions #}
                    {% if user.status == 'active' %}
                        <form method="post" action="{{ path('admin_users_suspend', {id: user.id}) }}" class="mb-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('suspend' ~ user.id) }}">
                            <button type="submit" class="btn btn-warning w-100" onclick="return confirm('Are you sure you want to suspend this user?')">
                                <i class="ti ti-player-pause"></i> Suspend User
                            </button>
                        </form>
                    {% elseif user.status == 'suspended' %}
                        <form method="post" action="{{ path('admin_users_activate', {id: user.id}) }}" class="mb-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('activate' ~ user.id) }}">
                            <button type="submit" class="btn btn-success w-100">
                                <i class="ti ti-check"></i> Activate User
                            </button>
                        </form>
                    {% endif %}

                    {# Premium Actions - FIXED: Changed PREMIUM_MONTHLY/YEARLY to MONTHLY/YEARLY #}
                    {% if not user.isPremium %}
                        <form method="post" action="{{ path('admin_users_premium_upgrade', {id: user.id}) }}" class="mb-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('premium' ~ user.id) }}">
                            <div class="mb-2">
                                <select name="plan" class="form-select">
                                    <option value="MONTHLY">Monthly Premium ($9.99/mo)</option>
                                    <option value="YEARLY">Yearly Premium ($99/yr)</option>
                                </select>
                            </div>
                            <button type="submit" class="btn btn-info w-100">
                                <i class="ti ti-crown"></i> Upgrade to Premium
                            </button>
                        </form>
                    {% else %}
                        <form method="post" action="{{ path('admin_users_premium_downgrade', {id: user.id}) }}" class="mb-2">
                            <input type="hidden" name="_token" value="{{ csrf_token('downgrade' ~ user.id) }}">
                            <button type="submit" class="btn btn-secondary w-100" onclick="return confirm('Downgrade this user to free plan?')">
                                <i class="ti ti-arrow-down"></i> Downgrade to Free
                            </button>
                        </form>
                    {% endif %}

                    <hr>

                    {# Delete Action #}
                    {% if user.status != 'deleted' %}
                        <form method="post" action="{{ path('admin_users_delete', {id: user.id}) }}" id="deleteForm">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                            <button type="button" class="btn btn-danger w-100" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal">
                                <i class="ti ti-trash"></i> Delete User
                            </button>
                        </form>
                    {% endif %}
                </div>
            </div>
        </div>

        {# User Information and Stats #}
        <div class="col-md-8">
            {# Account Information #}
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">Account Information</h3>
                </div>
                <div class="card-body">
                    <div class="datagrid">
                        <div class="datagrid-item">
                            <div class="datagrid-title">User ID</div>
                            <div class="datagrid-content">#{{ user.id }}</div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Email Address</div>
                            <div class="datagrid-content">
                                <a href="mailto:{{ user.email }}">{{ user.email }}</a>
                            </div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Full Name</div>
                            <div class="datagrid-content">{{ user.fullName }}</div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Account Status</div>
                            <div class="datagrid-content">
                                {% if user.status == 'active' %}
                                    <span class="status status-green">
                                        <span class="status-dot"></span>
                                        Active
                                    </span>
                                {% elseif user.status == 'suspended' %}
                                    <span class="status status-yellow">
                                        <span class="status-dot"></span>
                                        Suspended
                                    </span>
                                {% else %}
                                    <span class="status status-red">
                                        <span class="status-dot"></span>
                                        Deleted
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Subscription Plan</div>
                            <div class="datagrid-content">
                                {% if user.isPremium %}
                                    <span class="badge bg-yellow">
                                        <i class="ti ti-crown"></i>
                                        {{ user.subscriptionPlan == 'MONTHLY' ? 'Monthly Premium' : 'Yearly Premium' }}
                                    </span>
                                {% else %}
                                    <span class="badge bg-blue">FREE</span>
                                {% endif %}
                            </div>
                        </div>
                        {% if user.subscriptionExpiry %}
                        <div class="datagrid-item">
                            <div class="datagrid-title">Subscription Expires</div>
                            <div class="datagrid-content">
                                {{ user.subscriptionExpiry|date('F j, Y - H:i') }}
                                {% if user.subscriptionExpiry < date() %}
                                    <span class="badge bg-red ms-2">Expired</span>
                                {% endif %}
                            </div>
                        </div>
                        {% endif %}
                        <div class="datagrid-item">
                            <div class="datagrid-title">User Roles</div>
                            <div class="datagrid-content">
                                {% for role in user.roles %}
                                    <span class="badge bg-primary me-1">
                                        {{ role|replace({'ROLE_': ''}) }}
                                    </span>
                                {% endfor %}
                            </div>
                        </div>
                        {% if user.lastPaymentStatus %}
                        <div class="datagrid-item">
                            <div class="datagrid-title">Last Payment</div>
                            <div class="datagrid-content">
                                {% if user.lastPaymentStatus == 'success' %}
                                    <span class="badge bg-success">{{ user.lastPaymentStatus|upper }}</span>
                                {% else %}
                                    <span class="badge bg-danger">{{ user.lastPaymentStatus|upper }}</span>
                                {% endif %}
                            </div>
                        </div>
                        {% endif %}
                        <div class="datagrid-item">
                            <div class="datagrid-title">Member Since</div>
                            <div class="datagrid-content">{{ user.createdAt|date('F j, Y') }}</div>
                        </div>
                    </div>
                </div>
            </div>

            {# Learning Statistics #}
            {% if user.learningStats %}
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Learning Statistics</h3>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-6 col-md-3">
                            <div class="text-center">
                                <div class="text-muted mb-2">
                                    <i class="ti ti-clock" style="font-size: 2rem;"></i>
                                </div>
                                <div class="h1">{{ user.learningStats.totalMinutesStudied }}</div>
                                <div class="text-muted">Minutes Studied</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-center">
                                <div class="text-muted mb-2">
                                    <i class="ti ti-vocabulary" style="font-size: 2rem;"></i>
                                </div>
                                <div class="h1">{{ user.learningStats.wordsLearned }}</div>
                                <div class="text-muted">Words Learned</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-center">
                                <div class="text-muted mb-2">
                                    <i class="ti ti-star" style="font-size: 2rem;"></i>
                                </div>
                                <div class="h1">{{ user.learningStats.totalXP }}</div>
                                <div class="text-muted">Total XP</div>
                            </div>
                        </div>
                        <div class="col-6 col-md-3">
                            <div class="text-center">
                                <div class="text-muted mb-2">
                                    <i class="ti ti-calendar" style="font-size: 2rem;"></i>
                                </div>
                                <div class="h1">
                                    {% if user.learningStats.lastStudySession %}
                                        {{ user.learningStats.lastStudySession|date('M d') }}
                                    {% else %}
                                        <span class="text-muted">-</span>
                                    {% endif %}
                                </div>
                                <div class="text-muted">Last Session</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
