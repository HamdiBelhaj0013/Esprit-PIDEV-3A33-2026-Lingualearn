{% extends 'base.html.twig' %}

{% block title %}Users Management - {{ parent() }}{% endblock %}

{% block page_title %}
    <i class="ti ti-users me-2"></i> Users Management
{% endblock %}

{% block page_actions %}
    <div class="col-auto ms-auto d-print-none">
        <a href="{{ path('admin_users_new') }}" class="btn btn-primary">
            <i class="ti ti-plus icon"></i>
            Create User
        </a>
    </div>
{% endblock %}

{% block body %}
    {# Statistics Cards #}
    <div class="row row-deck row-cards mb-3">
        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="subheader">Total Users</div>
                    </div>
                    <div class="h1 mb-3">{{ statistics.total }}</div>
                    <div class="d-flex mb-2">
                        <div class="text-muted">All registered users</div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="subheader">Active Users</div>
                    </div>
                    <div class="h1 mb-3 text-success">{{ statistics.active }}</div>
                    <div class="d-flex mb-2">
                        <div class="text-muted">Currently active accounts</div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="subheader">Premium Users</div>
                    </div>
                    <div class="h1 mb-3 text-info">{{ statistics.premium }}</div>
                    <div class="d-flex mb-2">
                        <div class="text-muted">
                            <i class="ti ti-crown text-yellow"></i> Premium members
                        </div>
                    </div>
                </div>
            </div>
        </div>
        
        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="subheader">Suspended</div>
                    </div>
                    <div class="h1 mb-3 text-warning">{{ statistics.suspended }}</div>
                    <div class="d-flex mb-2">
                        <div class="text-muted">Suspended accounts</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Search and Filter #}
    <div class="card mb-3">
        <div class="card-body">
            <form method="get" action="{{ path('admin_users_index') }}">
                <div class="row g-3">
                    <div class="col-md-10">
                        <div class="input-icon">
                            <span class="input-icon-addon">
                                <i class="ti ti-search"></i>
                            </span>
                            <input type="text" 
                                   name="search" 
                                   value="{{ search }}" 
                                   class="form-control" 
                                   placeholder="Search by name or email...">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="ti ti-search"></i> Search
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    {# Users Table #}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">All Users ({{ totalUsers }})</h3>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-striped">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>User</th>
                        <th>Email</th>
                        <th>Status</th>
                        <th>Subscription</th>
                        <th>Created</th>
                        <th class="w-1">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for user in users %}
                    <tr>
                        <td class="text-muted">
                            #{{ user.id }}
                        </td>
                        <td>
                            <div class="d-flex py-1 align-items-center">
                                <span class="avatar me-2" style="background-image: url(https://ui-avatars.com/api/?name={{ user.firstName }}+{{ user.lastName }}&background=random)"></span>
                                <div class="flex-fill">
                                    <div class="font-weight-medium">{{ user.fullName }}</div>
                                    <div class="text-muted">
                                        {% for role in user.roles %}
                                            {% if role != 'ROLE_USER' %}
                                                <span class="badge badge-sm bg-blue-lt">{{ role|replace({'ROLE_': ''}) }}</span>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="text-muted">{{ user.email }}</div>
                        </td>
                        <td>
                            {% if user.status == 'active' %}
                                <span class="badge bg-success me-1"></span> Active
                            {% elseif user.status == 'suspended' %}
                                <span class="badge bg-warning me-1"></span> Suspended
                            {% else %}
                                <span class="badge bg-danger me-1"></span> Deleted
                            {% endif %}
                        </td>
                        <td>
                            {% if user.isPremium %}
                                <span class="badge bg-yellow">
                                    <i class="ti ti-crown"></i> {{ user.subscriptionPlan }}
                                </span>
                            {% else %}
                                <span class="badge bg-secondary">FREE</span>
                            {% endif %}
                        </td>
                        <td class="text-muted">
                            {{ user.createdAt|date('M d, Y') }}
                        </td>
                        <td>
                            <div class="btn-list flex-nowrap">
                                <a href="{{ path('admin_users_show', {id: user.id}) }}" 
                                   class="btn btn-sm btn-ghost-primary">
                                    <i class="ti ti-eye"></i>
                                </a>
                                <a href="{{ path('admin_users_edit', {id: user.id}) }}" 
                                   class="btn btn-sm btn-ghost-primary">
                                    <i class="ti ti-pencil"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="empty">
                                <div class="empty-img"><img src="https://cdn.jsdelivr.net/npm/@tabler/icons@latest/icons/outline/users.svg" height="128" alt="">
                                </div>
                                <p class="empty-title">No users found</p>
                                <p class="empty-subtitle text-muted">
                                    Try adjusting your search or filter to find what you're looking for.
                                </p>
                                <div class="empty-action">
                                    <a href="{{ path('admin_users_new') }}" class="btn btn-primary">
                                        <i class="ti ti-plus icon"></i>
                                        Create your first user
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
        
        {# Pagination #}
        {% if totalPages > 1 %}
        <div class="card-footer d-flex align-items-center">
            <p class="m-0 text-muted">
                Showing <span>{{ ((currentPage - 1) * 20) + 1 }}</span> 
                to <span>{{ min(currentPage * 20, totalUsers) }}</span> 
                of <span>{{ totalUsers }}</span> entries
            </p>
            <ul class="pagination m-0 ms-auto">
                {% if currentPage > 1 %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('admin_users_index', {page: currentPage - 1, search: search}) }}">
                        <i class="ti ti-chevron-left"></i> prev
                    </a>
                </li>
                {% endif %}
                
                {% for page in 1..totalPages %}
                    {% if page == currentPage or (page >= currentPage - 2 and page <= currentPage + 2) or page == 1 or page == totalPages %}
                        <li class="page-item {{ page == currentPage ? 'active' : '' }}">
                            <a class="page-link" href="{{ path('admin_users_index', {page: page, search: search}) }}">
                                {{ page }}
                            </a>
                        </li>
                    {% elseif page == currentPage - 3 or page == currentPage + 3 %}
                        <li class="page-item disabled">
                            <span class="page-link">…</span>
                        </li>
                    {% endif %}
                {% endfor %}
                
                {% if currentPage < totalPages %}
                <li class="page-item">
                    <a class="page-link" href="{{ path('admin_users_index', {page: currentPage + 1, search: search}) }}">
                        next <i class="ti ti-chevron-right"></i>
                    </a>
                </li>
                {% endif %}
            </ul>
        </div>
        {% endif %}
    </div>
{% endblock %}
