{% extends 'base.html.twig' %}

{% block title %}Users Management - {{ parent() }}{% endblock %}
{% block page_title %}
    <i class="ti ti-users me-2"></i> Users Management
{% endblock %}
{% block page_actions %}
    <div class="col-auto ms-auto d-print-none">
        <a href="{{ path('admin_users_new') }}" class="btn btn-primary">
            <i class="ti ti-plus icon"></i>
            Create User
        </a>
    </div>
{% endblock %}
{% block body %}
    <div class="card mb-3">
        <div class="card-body">
            <form method="get" action="{{ path('admin_users_index') }}">
                <div class="row g-2">
                    <div class="col-md-2">
                        <input type="text" name="search" value="{{ filters.search|default('') }}" class="form-control" placeholder="Name or Email">
                    </div>
                    <div class="col-md-2">
                        <select name="status" class="form-select">
                            <option value="">All Status</option>
                            <option value="active" {{ filters.status == 'active' ? 'selected' : '' }}>Active</option>
                            <option value="suspended" {{ filters.status == 'suspended' ? 'selected' : '' }}>Suspended</option>
                            <option value="deleted" {{ filters.status == 'deleted' ? 'selected' : '' }}>Deleted</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="role" class="form-select">
                            <option value="">All Roles</option>
                            <option value="ROLE_USER" {{ filters.role == 'ROLE_USER' ? 'selected' : '' }}>User</option>
                            <option value="ROLE_ADMIN" {{ filters.role == 'ROLE_ADMIN' ? 'selected' : '' }}>Admin</option>
                            <option value="ROLE_TEACHER" {{ filters.role == 'ROLE_TEACHER' ? 'selected' : '' }}>Teacher</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="subscriptionPlan" class="form-select">
                            <option value="">All Plans</option>
                            <option value="FREE" {{ filters.subscriptionPlan == 'FREE' ? 'selected' : '' }}>Free</option>
                            <option value="MONTHLY" {{ filters.subscriptionPlan == 'MONTHLY' ? 'selected' : '' }}>Monthly</option>
                            <option value="YEARLY" {{ filters.subscriptionPlan == 'YEARLY' ? 'selected' : '' }}>Yearly</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <select name="isPremium" class="form-select">
                            <option value="">Premium?</option>
                            <option value="1" {{ filters.isPremium == '1' or filters.isPremium == true ? 'selected' : '' }}>Yes</option>
                            <option value="0" {{ filters.isPremium == '0' or filters.isPremium == false ? 'selected' : '' }}>No</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <select name="sort" class="form-select">
                            <option value="u.createdAt" {{ filters.sort == 'u.createdAt' ? 'selected' : '' }}>Recent</option>
                            <option value="u.firstName" {{ filters.sort == 'u.firstName' ? 'selected' : '' }}>First Name</option>
                            <option value="u.lastName" {{ filters.sort == 'u.lastName' ? 'selected' : '' }}>Last Name</option>
                            <option value="u.email" {{ filters.sort == 'u.email' ? 'selected' : '' }}>Email</option>
                            <option value="u.status" {{ filters.sort == 'u.status' ? 'selected' : '' }}>Status</option>
                            <option value="u.isPremium" {{ filters.sort == 'u.isPremium' ? 'selected' : '' }}>Premium</option>
                            <option value="u.subscriptionPlan" {{ filters.sort == 'u.subscriptionPlan' ? 'selected' : '' }}>Plan</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <select name="direction" class="form-select">
                            <option value="DESC" {{ filters.direction == 'DESC' ? 'selected' : '' }}>Desc</option>
                            <option value="ASC"  {{ filters.direction == 'ASC' ? 'selected' : '' }}>Asc</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-search"></i>
                        </button>
                    </div>
                    <div class="col-auto">
                        <a href="{{ path('admin_users_index') }}" class="btn btn-secondary" title="Reset all filters">
                            <i class="ti ti-x"></i>
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>
    <div class="card">
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-striped">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>User</th>
                    <th>Email</th>
                    <th>Status</th>
                    <th>Subscription</th>
                    <th>Created</th>
                    <th class="w-1">Actions</th>
                </tr>
                </thead>
                <tbody>
                {% for user in users %}
                    <tr>
                        <td class="text-muted">#{{ user.id }}</td>
                        <td>
                            <div class="d-flex py-1 align-items-center">
                                <span class="avatar me-2" style="background-image: url(https://ui-avatars.com/api/?name={{ user.firstName }}+{{ user.lastName }}&background=random)"></span>
                                <div class="flex-fill">
                                    <div class="font-weight-medium">{{ user.fullName }}</div>
                                    <div class="text-muted">
                                        {% for role in user.roles %}
                                            {% if role != 'ROLE_USER' %}
                                                <span class="badge badge-sm bg-blue-lt">
                                                    {{ role|replace({'ROLE_': ''}) }}
                                                </span>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td><div class="text-muted">{{ user.email }}</div></td>
                        <td>
                            {% if user.status == 'active' %}
                                <span class="badge bg-success me-1"></span> Active
                            {% elseif user.status == 'suspended' %}
                                <span class="badge bg-warning me-1"></span> Suspended
                            {% else %}
                                <span class="badge bg-danger me-1"></span> Deleted
                            {% endif %}
                        </td>
                        <td>
                            {% if user.isPremium %}
                                <span class="badge bg-yellow">
                                    <i class="ti ti-crown"></i>
                                    {{ user.subscriptionPlan == 'MONTHLY' ? 'Monthly' : (user.subscriptionPlan == 'YEARLY' ? 'Yearly' : 'Premium') }}
                                </span>
                            {% else %}
                                <span class="badge bg-secondary">Free</span>
                            {% endif %}
                        </td>
                        <td class="text-muted">{{ user.createdAt|date('M d, Y') }}</td>
                        <td>
                            <div class="btn-list flex-nowrap">
                                <a href="{{ path('admin_users_show', {id: user.id}) }}" class="btn btn-sm btn-ghost-primary">
                                    <i class="ti ti-eye"></i>
                                </a>
                                <a href="{{ path('admin_users_edit', {id: user.id}) }}" class="btn btn-sm btn-ghost-primary">
                                    <i class="ti ti-pencil"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="empty">
                                <p class="empty-title">No users found</p>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
        {% if totalPages > 1 %}
            <div class="card-footer d-flex align-items-center">
                <ul class="pagination m-0 ms-auto">
                    {% if currentPage > 1 %}
                        <li class="page-item">
                            <a class="page-link"
                               href="{{ path('admin_users_index', filters|merge({'page': currentPage - 1})) }}">
                                <i class="ti ti-chevron-left"></i> prev
                            </a>
                        </li>
                    {% endif %}
                    {% for page in 1..totalPages %}
                        {% if page == currentPage %}
                            <li class="page-item active">
                                <a class="page-link" href="{{ path('admin_users_index', filters|merge({'page': page})) }}">{{ page }}</a>
                            </li>
                        {% else %}
                            <li class="page-item">
                                <a class="page-link" href="{{ path('admin_users_index', filters|merge({'page': page})) }}">{{ page }}</a>
                            </li>
                        {% endif %}
                    {% endfor %}
                    {% if currentPage < totalPages %}
                        <li class="page-item">
                            <a class="page-link"
                               href="{{ path('admin_users_index', filters|merge({'page': currentPage + 1})) }}">
                                next <i class="ti ti-chevron-right"></i>
                            </a>
                        </li>
                    {% endif %}
                </ul>
            </div>
        {% endif %}
    </div>
{% endblock %}
