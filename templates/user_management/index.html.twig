{% extends 'layouts/admin.html.twig' %}

{% block title %}Users Management - {{ parent() }}{% endblock %}

{% block page_title %}
    <span class="d-flex align-items-center gap-2">
        <span style="width:36px;height:36px;border-radius:10px;background:#edf2ff;color:#3b5bdb;display:grid;place-items:center;font-size:18px">
            <i class="ti ti-users"></i>
        </span>
        Users Management
        <span class="badge bg-blue-lt text-blue ms-1" style="font-size:.75rem">{{ totalUsers }}</span>
    </span>
{% endblock %}

{% block page_actions %}
    <div class="col-auto ms-auto d-print-none" style="display:flex;gap:8px;align-items:center">
        <a href="{{ path('admin_users_export_csv', filters ?? {}) }}"
           style="display:inline-flex;align-items:center;gap:6px;padding:7px 14px;border-radius:9px;border:1.5px solid #e3e8f0;background:#fff;color:#6c7a99;font-size:.78rem;font-weight:700;text-decoration:none;transition:all .2s"
           onmouseover="this.style.borderColor='#3b5bdb';this.style.color='#3b5bdb'"
           onmouseout="this.style.borderColor='#e3e8f0';this.style.color='#6c7a99'">
            <i class="ti ti-download"></i> Export CSV
        </a>
        <button type="button" id="ai-panel-toggle" onclick="toggleAiPanel()"
                style="display:inline-flex;align-items:center;gap:7px;padding:7px 14px;border-radius:9px;border:1.5px solid #e9d5ff;background:#faf5ff;color:#7c3aed;font-size:.78rem;font-weight:700;cursor:pointer;transition:all .2s;position:relative"
                onmouseover="this.style.background='#ede9fe';this.style.borderColor='#7c3aed'"
                onmouseout="this.style.background='#faf5ff';this.style.borderColor='#e9d5ff'">
            <span style="position:relative;display:inline-flex;align-items:center">
                <i class="ti ti-robot" style="font-size:15px"></i>
                <span id="ai-pulse-dot" style="position:absolute;top:-3px;right:-3px;width:7px;height:7px;border-radius:50%;background:#7c3aed;animation:aiPulse 2s infinite"></span>
            </span>
            AI Assistant
        </button>
        <a href="{{ path('admin_users_new') }}" class="btn btn-primary d-flex align-items-center gap-2" style="border-radius:10px;font-weight:600;box-shadow:0 4px 12px rgba(59,91,219,.3)">
            <i class="ti ti-user-plus"></i> Create User
        </a>
    </div>
{% endblock %}

{% block content %}
    <style>
        :root {
            --ix-primary:  #3b5bdb;
            --ix-success:  #2fb344;
            --ix-warn:     #f59f00;
            --ix-danger:   #d63939;
            --ix-muted:    #6c7a99;
            --ix-border:   #e3e8f0;
            --ix-bg:       #f8fafc;
            --ix-radius:   12px;
            --ix-shadow:   0 2px 16px rgba(59,91,219,.07);
            --ai-violet:        #7c3aed;
            --ai-violet-lt:     #f5f3ff;
            --ai-violet-border: #ddd6fe;
        }

        /* ── Stats ── */
        .stats-strip { display:flex;gap:10px;flex-wrap:wrap;margin-bottom:20px; }
        .stat-card {
            flex:1 1 140px;max-width:200px;padding:14px 16px;border-radius:12px;
            border:1px solid var(--ix-border);background:#fff;box-shadow:var(--ix-shadow);
            transition:transform .2s,box-shadow .2s;position:relative;overflow:hidden;
        }
        .stat-card::before { content:'';position:absolute;top:0;left:0;right:0;height:3px;border-radius:99px 99px 0 0; }
        .stat-card.total::before   { background:var(--ix-primary); }
        .stat-card.active::before  { background:var(--ix-success); }
        .stat-card.premium::before { background:var(--ix-warn); }
        .stat-card.new::before     { background:#cc5de8; }
        .stat-card.suspended::before { background:var(--ix-danger); }
        .stat-card:hover { transform:translateY(-2px);box-shadow:0 8px 24px rgba(59,91,219,.12); }
        .stat-num   { font-size:1.6rem;font-weight:800;line-height:1;color:#1a1f36; }
        .stat-label { font-size:.7rem;color:var(--ix-muted);font-weight:600;margin-top:4px;text-transform:uppercase;letter-spacing:.04em; }
        .stat-icon  { position:absolute;right:16px;top:50%;transform:translateY(-50%);font-size:2rem;opacity:.07; }

        /* ── Filter bar ── */
        .filter-bar { background:#fff;border:1px solid var(--ix-border);border-radius:var(--ix-radius);padding:16px 20px;box-shadow:var(--ix-shadow);margin-bottom:16px; }
        .filter-bar .form-control,.filter-bar .form-select { border:1.5px solid var(--ix-border);border-radius:8px;font-size:.82rem;padding:8px 12px;transition:border-color .2s,box-shadow .2s; }
        .filter-bar .form-control:focus,.filter-bar .form-select:focus { border-color:var(--ix-primary);box-shadow:0 0 0 3px rgba(59,91,219,.1);outline:none; }
        .filter-btn { padding:8px 18px;border-radius:8px;font-weight:600;font-size:.82rem;cursor:pointer;border:none;display:inline-flex;align-items:center;gap:6px;transition:all .15s; }
        .filter-btn.search { background:var(--ix-primary);color:#fff;box-shadow:0 2px 8px rgba(59,91,219,.3); }
        .filter-btn.search:hover { background:#3451c7; }
        .filter-btn.reset  { background:#f1f3f9;color:var(--ix-muted); }
        .filter-btn.reset:hover { background:#ffe3e3;color:var(--ix-danger); }

        /* ── Table ── */
        .ux-table-card { border-radius:var(--ix-radius);border:1px solid var(--ix-border);overflow:hidden;box-shadow:var(--ix-shadow);background:#fff; }
        .ux-table { width:100%;border-collapse:collapse; }
        .ux-table thead th { background:var(--ix-bg);padding:12px 16px;font-size:.74rem;font-weight:700;color:var(--ix-muted);text-transform:uppercase;letter-spacing:.06em;border-bottom:1.5px solid var(--ix-border);white-space:nowrap; }
        .ux-table tbody tr { border-bottom:1px solid var(--ix-border);transition:background .15s;animation:rowFadeIn .35s ease both; }
        .ux-table tbody tr:last-child { border-bottom:none; }
        .ux-table tbody tr:hover { background:#f8fafc; }
        {% for i in range(1,30) %}.ux-table tbody tr:nth-child({{ i }}) { animation-delay:{{ (i*0.03)|round(2) }}s; }{% endfor %}
        @keyframes rowFadeIn { from{opacity:0;transform:translateX(-8px)} to{opacity:1;transform:translateX(0)} }
        .ux-table td { padding:12px 16px;vertical-align:middle;font-size:.85rem; }

        .user-cell { display:flex;align-items:center;gap:12px; }
        .user-avatar { width:38px;height:38px;border-radius:10px;object-fit:cover;flex-shrink:0;border:2px solid var(--ix-border); }
        .user-name  { font-weight:700;color:#1a1f36;font-size:.88rem; }
        .user-roles { display:flex;gap:4px;flex-wrap:wrap;margin-top:2px; }

        .ux-status { display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:6px;font-size:.74rem;font-weight:700; }
        .ux-status .dot { width:6px;height:6px;border-radius:50%;flex-shrink:0; }
        .ux-status.active    { background:#d3f9d8;color:#1a6130; } .ux-status.active .dot    { background:var(--ix-success); }
        .ux-status.suspended { background:#fff3bf;color:#7d4a00; } .ux-status.suspended .dot { background:var(--ix-warn); }
        .ux-status.deleted   { background:#ffe3e3;color:#7d1717; } .ux-status.deleted .dot   { background:var(--ix-danger); }

        .plan-badge { display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:6px;font-size:.74rem;font-weight:700; }
        .plan-badge.premium { background:#fff3bf;color:#7d4a00; }
        .plan-badge.free    { background:#f1f3f9;color:var(--ix-muted); }

        .action-btns { display:flex;gap:6px; }
        .act-btn { width:32px;height:32px;border-radius:8px;display:grid;place-items:center;border:1.5px solid var(--ix-border);background:#fff;color:var(--ix-muted);font-size:15px;transition:all .15s;text-decoration:none; }
        .act-btn:hover.view { border-color:var(--ix-primary);color:var(--ix-primary);background:#edf2ff; }
        .act-btn:hover.edit { border-color:#2f9e44;color:#2f9e44;background:#ebfbee; }
        .act-btn:hover.ai   { border-color:var(--ai-violet);color:var(--ai-violet);background:var(--ai-violet-lt); }

        /* ── Bulk toolbar ── */
        .bulk-toolbar { display:none;align-items:center;gap:10px;padding:10px 16px;background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:10px;margin-bottom:12px;animation:rowFadeIn .25s ease; }
        .bulk-toolbar.visible { display:flex; }
        .bulk-count { font-size:.82rem;font-weight:700;color:#1d4ed8; }
        .bulk-btn { padding:6px 14px;border-radius:7px;font-size:.78rem;font-weight:700;cursor:pointer;border:1.5px solid;display:inline-flex;align-items:center;gap:5px;transition:all .15s;background:#fff; }
        .bulk-btn.activate { border-color:#2fb344;color:#1a6130; } .bulk-btn.activate:hover { background:#d3f9d8; }
        .bulk-btn.suspend  { border-color:#f59f00;color:#7d4a00; } .bulk-btn.suspend:hover  { background:#fff3bf; }
        .bulk-btn.delete   { border-color:#d63939;color:#7d1717; } .bulk-btn.delete:hover   { background:#ffe3e3; }
        .ux-table thead th.cb-col,.ux-table td.cb-col { width:40px;text-align:center;padding-left:14px; }
        .row-checkbox { width:16px;height:16px;accent-color:var(--ix-primary);cursor:pointer; }
        .ux-table tbody tr.selected { background:#eff6ff !important; }

        /* ── Pagination ── */
        .ux-pagination { display:flex;align-items:center;gap:4px; }
        .ux-page-btn { width:34px;height:34px;border-radius:8px;display:grid;place-items:center;font-size:.82rem;font-weight:600;border:1.5px solid var(--ix-border);background:#fff;color:var(--ix-muted);text-decoration:none;transition:all .15s; }
        .ux-page-btn:hover  { border-color:var(--ix-primary);color:var(--ix-primary);background:#edf2ff; }
        .ux-page-btn.active { border-color:var(--ix-primary);background:var(--ix-primary);color:#fff;pointer-events:none; }
        .ux-page-btn.nav    { width:auto;padding:0 10px;gap:4px;display:flex;align-items:center; }

        .empty-state { padding:60px 20px;text-align:center; }
        .empty-state-icon  { font-size:3rem;margin-bottom:12px;opacity:.3; }
        .empty-state-title { font-weight:700;color:#1a1f36;margin-bottom:6px; }
        .empty-state-sub   { color:var(--ix-muted);font-size:.85rem; }

        @keyframes fadeSlideUp { from{opacity:0;transform:translateY(12px)} to{opacity:1;transform:translateY(0)} }
        .stats-strip  { animation:fadeSlideUp .4s ease both; }
        .filter-bar   { animation:fadeSlideUp .4s ease both .05s; }
        .ux-table-card{ animation:fadeSlideUp .4s ease both .1s; }

        /* ══════════════════════════════════════════════════════
           AI PANEL
        ══════════════════════════════════════════════════════ */
        @keyframes aiPulse      { 0%,100%{transform:scale(1);opacity:1} 50%{transform:scale(1.5);opacity:.5} }
        @keyframes panelSlideDown { from{opacity:0;transform:translateY(-10px)} to{opacity:1;transform:translateY(0)} }

        .ai-panel { display:none;background:#fff;border:1.5px solid var(--ai-violet-border);border-radius:16px;margin-bottom:16px;overflow:hidden;box-shadow:0 8px 32px rgba(124,58,237,.12);animation:panelSlideDown .3s ease both; }
        .ai-panel.open { display:block; }

        .ai-tabs { display:flex;border-bottom:1.5px solid var(--ai-violet-border);background:var(--ai-violet-lt); }
        .ai-tab  { flex:1;padding:12px 16px;text-align:center;font-size:.8rem;font-weight:700;color:#9ca3af;cursor:pointer;border:none;background:transparent;transition:all .2s;display:flex;align-items:center;justify-content:center;gap:6px; }
        .ai-tab.active { color:var(--ai-violet);background:#fff;border-bottom:2px solid var(--ai-violet);margin-bottom:-1.5px; }
        .ai-tab-pane { display:none;padding:20px; }
        .ai-tab-pane.active { display:block; }

        .ai-search-input-wrap { display:flex;gap:8px;margin-bottom:12px; }
        .ai-search-input { flex:1;padding:10px 16px;border-radius:10px;border:1.5px solid var(--ai-violet-border);font-size:.88rem;outline:none;transition:border-color .2s,box-shadow .2s; }
        .ai-search-input:focus { border-color:var(--ai-violet);box-shadow:0 0 0 3px rgba(124,58,237,.12); }
        .ai-search-btn { padding:10px 20px;border-radius:10px;background:var(--ai-violet);color:#fff;border:none;font-weight:700;font-size:.85rem;cursor:pointer;display:flex;align-items:center;gap:6px;transition:all .2s; }
        .ai-search-btn:hover { background:#6d28d9;box-shadow:0 4px 12px rgba(124,58,237,.3); }
        .ai-search-btn:disabled { opacity:.5;cursor:not-allowed; }

        .ai-chips { display:flex;gap:6px;flex-wrap:wrap;margin-bottom:4px; }
        .ai-chip  { padding:5px 12px;border-radius:99px;font-size:.74rem;font-weight:600;background:var(--ai-violet-lt);color:var(--ai-violet);border:1.5px solid var(--ai-violet-border);cursor:pointer;transition:all .15s; }
        .ai-chip:hover { background:#ede9fe;border-color:var(--ai-violet); }

        .ai-reasoning { background:#eff6ff;border:1.5px solid #bfdbfe;border-radius:10px;padding:12px 16px;font-size:.82rem;color:#1e40af;margin-top:12px;display:none;line-height:1.5; }
        .ai-reasoning.show { display:block; }
        .ai-reasoning strong { display:block;margin-bottom:4px;font-size:.74rem;text-transform:uppercase;letter-spacing:.04em; }

        .ai-result-badge { display:inline-flex;align-items:center;gap:5px;padding:4px 10px;border-radius:6px;font-size:.72rem;font-weight:700;margin-top:8px; }
        .ai-result-badge.found { background:#d3f9d8;color:#1a6130; }
        .ai-result-badge.empty { background:#ffe3e3;color:#7d1717; }
        .ai-result-badge.error { background:#fff3bf;color:#7d4a00; }

        .ux-table tbody tr.ai-match { background:#faf5ff !important;outline:1.5px solid var(--ai-violet-border); }
        .ux-table tbody tr.ai-match td:first-child { border-left:3px solid var(--ai-violet); }
        .ux-table tbody tr.ai-hidden { display:none; }

        /* ── AI Chat ── */
        .ai-chat-msgs { height:300px;overflow-y:auto;padding:4px 0;margin-bottom:12px;display:flex;flex-direction:column;gap:10px; }
        .ai-chat-msgs::-webkit-scrollbar { width:4px; }
        .ai-chat-msgs::-webkit-scrollbar-thumb { background:var(--ai-violet-border);border-radius:99px; }
        .chat-msg { max-width:82%;padding:10px 14px;border-radius:12px;font-size:.84rem;line-height:1.55; }
        .chat-msg.user      { align-self:flex-end;background:var(--ai-violet);color:#fff;border-bottom-right-radius:4px; }
        .chat-msg.assistant { align-self:flex-start;background:var(--ai-violet-lt);color:#1a1f36;border:1px solid var(--ai-violet-border);border-bottom-left-radius:4px; }

        /* ── Action result card inside chat ── */
        .chat-action-card {
            align-self:flex-start;width:calc(82% + 2px);
            border-radius:12px;border-bottom-left-radius:4px;
            overflow:hidden;font-size:.82rem;
            border:1.5px solid var(--ai-violet-border);
            animation:rowFadeIn .3s ease both;
        }
        .chat-action-header {
            display:flex;align-items:center;gap:8px;padding:10px 14px;
            font-weight:700;font-size:.78rem;text-transform:uppercase;letter-spacing:.05em;
        }
        .chat-action-header.success { background:#d3f9d8;color:#1a6130; }
        .chat-action-header.error   { background:#ffe3e3;color:#7d1717; }
        .chat-action-header.info    { background:#eff6ff;color:#1d4ed8; }
        .chat-action-body { padding:12px 14px;background:#fff;color:#374151;line-height:1.5; }
        .chat-action-body .data-row { display:flex;gap:8px;padding:3px 0;border-bottom:1px solid var(--ix-border);font-size:.8rem; }
        .chat-action-body .data-row:last-child { border-bottom:none; }
        .chat-action-body .data-key { color:var(--ix-muted);font-weight:600;min-width:110px;flex-shrink:0; }
        .chat-action-body .data-val { color:#1a1f36;font-weight:500;word-break:break-all; }
        .chat-action-body .temp-pass {
            margin-top:8px;padding:8px 12px;background:#fef3c7;border:1.5px dashed #f59f00;
            border-radius:8px;font-family:monospace;font-size:.88rem;color:#92400e;
            display:flex;align-items:center;gap:8px;
        }

        .chat-typing { align-self:flex-start;background:var(--ai-violet-lt);border:1px solid var(--ai-violet-border);padding:10px 16px;border-radius:12px;border-bottom-left-radius:4px;display:none; }
        .chat-typing span { display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--ai-violet);animation:typingBounce 1s infinite; }
        .chat-typing span:nth-child(2) { animation-delay:.15s; }
        .chat-typing span:nth-child(3) { animation-delay:.3s; }
        @keyframes typingBounce { 0%,60%,100%{transform:translateY(0)} 30%{transform:translateY(-6px)} }

        .ai-chat-input-wrap { display:flex;gap:8px; }
        .ai-chat-input { flex:1;padding:10px 14px;border-radius:10px;border:1.5px solid var(--ai-violet-border);font-size:.85rem;resize:none;outline:none;transition:border-color .2s,box-shadow .2s;line-height:1.4; }
        .ai-chat-input:focus { border-color:var(--ai-violet);box-shadow:0 0 0 3px rgba(124,58,237,.1); }
        .ai-chat-starter-chips { display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px; }

        /* ── Capabilities panel ── */
        .ai-caps { display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-bottom:12px; }
        .ai-cap-btn {
            padding:8px 12px;border-radius:9px;font-size:.76rem;font-weight:600;
            background:#fff;border:1.5px solid var(--ai-violet-border);color:var(--ai-violet);
            cursor:pointer;transition:all .15s;display:flex;align-items:center;gap:7px;text-align:left;
        }
        .ai-cap-btn:hover { background:var(--ai-violet-lt);border-color:var(--ai-violet); }
        .ai-cap-btn i { font-size:1rem;flex-shrink:0; }

        /* ── Insight panel ── */
        .insight-overlay { position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:1040;display:none;opacity:0;transition:opacity .25s; }
        .insight-overlay.open { display:block;opacity:1; }
        .insight-panel { position:fixed;top:0;right:-420px;width:420px;height:100vh;background:#fff;z-index:1050;box-shadow:-8px 0 40px rgba(0,0,0,.15);display:flex;flex-direction:column;transition:right .3s cubic-bezier(.4,0,.2,1);overflow:hidden; }
        .insight-panel.open { right:0; }
        .insight-header { padding:20px 20px 16px;border-bottom:1px solid var(--ix-border);background:linear-gradient(135deg,#faf5ff 0%,#eff6ff 100%);display:flex;align-items:center;justify-content:space-between; }
        .insight-close { width:32px;height:32px;border-radius:8px;border:1.5px solid var(--ix-border);background:#fff;cursor:pointer;display:grid;place-items:center;color:var(--ix-muted);font-size:15px;transition:all .15s; }
        .insight-close:hover { border-color:var(--ix-danger);color:var(--ix-danger);background:#ffe3e3; }
        .insight-body { flex:1;overflow-y:auto;padding:20px; }
        .insight-user-card { display:flex;align-items:center;gap:12px;padding:14px;background:var(--ai-violet-lt);border:1px solid var(--ai-violet-border);border-radius:12px;margin-bottom:16px; }
        .insight-avatar { width:48px;height:48px;border-radius:12px;object-fit:cover;border:2px solid var(--ai-violet-border); }
        .insight-text-wrap { padding:16px;background:#f8fafc;border:1px solid var(--ix-border);border-radius:12px;line-height:1.65;font-size:.85rem;color:#374151;margin-bottom:16px; }
        .insight-text-wrap.loading { display:flex;align-items:center;gap:8px;color:var(--ix-muted);font-style:italic; }
        .insight-actions { display:grid;grid-template-columns:1fr 1fr;gap:8px; }
        .insight-act-btn { padding:9px 14px;border-radius:9px;font-size:.8rem;font-weight:700;text-align:center;text-decoration:none;display:flex;align-items:center;justify-content:center;gap:5px;border:1.5px solid var(--ix-border);background:#fff;color:var(--ix-muted);transition:all .15s; }
        .insight-act-btn:hover { border-color:var(--ix-primary);color:var(--ix-primary);background:#edf2ff; }

        /* ── Toast notifications ── */
        #toast-container { position:fixed;bottom:24px;right:24px;z-index:9999;display:flex;flex-direction:column;gap:10px;pointer-events:none; }
        .toast-notif {
            display:flex;align-items:flex-start;gap:12px;padding:14px 18px;border-radius:12px;
            background:#fff;box-shadow:0 8px 32px rgba(0,0,0,.15);min-width:280px;max-width:380px;
            pointer-events:all;border-left:4px solid;
            animation:toastIn .35s cubic-bezier(.22,1,.36,1) both;
        }
        .toast-notif.removing { animation:toastOut .3s ease forwards; }
        @keyframes toastIn  { from{opacity:0;transform:translateX(40px)} to{opacity:1;transform:translateX(0)} }
        @keyframes toastOut { from{opacity:1;transform:translateX(0)} to{opacity:0;transform:translateX(40px)} }
        .toast-notif.success { border-color:#2fb344; }
        .toast-notif.error   { border-color:#d63939; }
        .toast-notif.info    { border-color:#3b5bdb; }
        .toast-notif.warning { border-color:#f59f00; }
        .toast-icon { font-size:1.2rem;flex-shrink:0;margin-top:1px; }
        .toast-notif.success .toast-icon { color:#2fb344; }
        .toast-notif.error   .toast-icon { color:#d63939; }
        .toast-notif.info    .toast-icon { color:#3b5bdb; }
        .toast-notif.warning .toast-icon { color:#f59f00; }
        .toast-body { flex:1; }
        .toast-title { font-weight:700;font-size:.84rem;color:#1a1f36;margin-bottom:2px; }
        .toast-msg   { font-size:.78rem;color:var(--ix-muted);line-height:1.4; }
        .toast-close { background:none;border:none;color:var(--ix-muted);cursor:pointer;padding:0;font-size:14px;flex-shrink:0; }

        @keyframes spin { from{transform:rotate(0deg)} to{transform:rotate(360deg)} }
    </style>

    {# ── Toast container ── #}
    <div id="toast-container"></div>

    {# ── Stats Strip ── #}
    {% if statistics is defined %}
        <div class="stats-strip">
            <div class="stat-card total">
                <div class="stat-num">{{ statistics.total ?? totalUsers }}</div>
                <div class="stat-label">Total Users</div>
                <i class="ti ti-users stat-icon"></i>
            </div>
            <div class="stat-card active">
                <div class="stat-num">{{ statistics.active ?? '—' }}</div>
                <div class="stat-label">Active</div>
                <i class="ti ti-circle-check stat-icon"></i>
            </div>
            <div class="stat-card premium">
                <div class="stat-num">{{ statistics.premium ?? '—' }}</div>
                <div class="stat-label">Premium</div>
                {% if statistics.total is defined and statistics.total > 0 %}
                    <div style="font-size:.7rem;color:#b45309;margin-top:4px;font-weight:600">
                        ↑ {{ ((statistics.premium / statistics.total) * 100)|round(1) }}% conversion
                    </div>
                {% endif %}
                <i class="ti ti-crown stat-icon"></i>
            </div>
            <div class="stat-card new">
                <div class="stat-num">{{ statistics.newThisMonth ?? '—' }}</div>
                <div class="stat-label">New This Month</div>
                <i class="ti ti-sparkles stat-icon"></i>
            </div>
            <div class="stat-card suspended">
                <div class="stat-num">{{ statistics.suspended ?? '—' }}</div>
                <div class="stat-label">Suspended</div>
                <i class="ti ti-ban stat-icon"></i>
            </div>
        </div>
    {% endif %}

    {# ══════════════════════════════════════════════════════════
