                <button type="button" class="ai-chip" onclick="chatStarter('How many users are at churn risk?')">Churn risk</button>
                <button type="button" class="ai-chip" onclick="chatStarter('Summarize platform health')">Platform health</button>
                <button type="button" class="ai-chip" onclick="chatStarter('Delete all suspended users')">Delete suspended</button>
                <button type="button" class="ai-chip" onclick="chatStarter('Create a test user named Test User with email test@example.com')">Create user</button>
                <button type="button" class="ai-chip" onclick="chatStarter('Upgrade all premium expiring users to YEARLY plan')">Upgrade expiring</button>
                <button type="button" class="ai-chip" onclick="chatStarter('Draft a win-back email for churned users')">Win-back email</button>
            </div>
            <div class="ai-chat-msgs" id="ai-chat-msgs">
