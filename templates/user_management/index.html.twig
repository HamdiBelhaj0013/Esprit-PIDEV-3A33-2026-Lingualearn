    <script>
        /* ════════════════════════════════════════════════════════
           TOAST NOTIFICATIONS
        ════════════════════════════════════════════════════════ */
        function showToast(type, title, message, duration = 5000) {
            const icons = { success:'ti-circle-check', error:'ti-circle-x', info:'ti-info-circle', warning:'ti-alert-triangle' };
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `toast-notif ${type}`;
            toast.innerHTML = `
                <i class="ti ${icons[type] || icons.info} toast-icon"></i>
                <div class="toast-body">
                    <div class="toast-title">${title}</div>
                    ${message ? `<div class="toast-msg">${message}</div>` : ''}
                </div>
                <button class="toast-close" onclick="removeToast(this.parentElement)"><i class="ti ti-x"></i></button>
            `;
            container.appendChild(toast);
            setTimeout(() => removeToast(toast), duration);
        }

        function removeToast(el) {
            if (!el || !el.parentElement) return;
            el.classList.add('removing');
            setTimeout(() => el.remove(), 300);
        }

        /* ════════════════════════════════════════════════════════
           BULK SELECTION
        ════════════════════════════════════════════════════════ */
        const selectAll   = document.getElementById('select-all');
        const toolbar     = document.getElementById('bulk-toolbar');
        const countEl     = document.getElementById('bulk-count-num');
        const actionInput = document.getElementById('bulk-action-input');

        function getChecked() { return document.querySelectorAll('.user-checkbox:checked'); }

        function updateToolbar() {
            const checked = getChecked();
            const n = checked.length;
            countEl.textContent = n;
            toolbar.classList.toggle('visible', n > 0);
            selectAll.indeterminate = n > 0 && n < document.querySelectorAll('.user-checkbox').length;
            selectAll.checked = n > 0 && n === document.querySelectorAll('.user-checkbox').length;
            document.querySelectorAll('tr[data-id]').forEach(row => {
                const cb = row.querySelector('.user-checkbox');
                row.classList.toggle('selected', cb && cb.checked);
            });
        }

        selectAll.addEventListener('change', function() {
            document.querySelectorAll('.user-checkbox').forEach(cb => cb.checked = this.checked);
            updateToolbar();
        });
        document.querySelectorAll('.user-checkbox').forEach(cb => cb.addEventListener('change', updateToolbar));

        function submitBulk(action) {
            const checked = getChecked();
            if (!checked.length) return;
            if (action === 'delete'  && !confirm(`Delete ${checked.length} user(s)? This cannot be undone.`)) return;
            if (action === 'suspend' && !confirm(`Suspend ${checked.length} user(s)?`)) return;
            actionInput.value = action;
            document.getElementById('bulk-form').submit();
        }

        function clearSelection() {
            document.querySelectorAll('.user-checkbox, #select-all').forEach(cb => cb.checked = false);
            updateToolbar();
        }

        /* ════════════════════════════════════════════════════════
           AI PANEL
        ════════════════════════════════════════════════════════ */
        function toggleAiPanel() {
            const panel = document.getElementById('ai-panel');
            panel.classList.toggle('open');
        }

        function switchAiTab(tab, btn) {
            document.querySelectorAll('.ai-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.ai-tab-pane').forEach(p => p.classList.remove('active'));
            if (btn) btn.classList.add('active');
            document.getElementById('ai-tab-' + tab).classList.add('active');
        }

        function aiChip(text) {
            document.getElementById('ai-search-input').value = text;
            runAiSearch();
        }

        let aiMatchedIds = null;

        function runAiSearch() {
            const query = document.getElementById('ai-search-input').value.trim();
            if (!query) return;

            const btn = document.getElementById('ai-search-btn');
            const reasoning = document.getElementById('ai-reasoning');
            btn.disabled = true;
            btn.innerHTML = '<i class="ti ti-loader-2" style="animation:spin 1s linear infinite"></i> Thinking…';

            fetch('{{ path('admin_ai_search') }}', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({query})
            })
                .then(r => r.json())
                .then(data => {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="ti ti-robot"></i> Search';
                    reasoning.classList.add('show');
                    document.getElementById('ai-reasoning-text').textContent = data.reasoning || '';

                    const badge = document.getElementById('ai-result-badge');
                    const ids = data.ids || [];
                    aiMatchedIds = ids;

                    if (data.ids === undefined || data.error) {
                        badge.innerHTML = `<span class="ai-result-badge error"><i class="ti ti-alert-triangle"></i> ${data.reasoning || 'Error'}</span>`;
                        return;
                    }

                    badge.innerHTML = ids.length > 0
                        ? `<span class="ai-result-badge found"><i class="ti ti-check"></i> ${data.summary}</span>`
                        : `<span class="ai-result-badge empty"><i class="ti ti-mood-empty"></i> No matches found</span>`;

                    document.querySelectorAll('tr[data-id]').forEach(row => {
                        const rowId = parseInt(row.dataset.id);
                        if (ids.includes(rowId)) {
                            row.classList.add('ai-match');
                            row.classList.remove('ai-hidden');
                        } else {
                            row.classList.remove('ai-match');
                            row.classList.add('ai-hidden');
                        }
                    });
                })
                .catch(() => {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="ti ti-robot"></i> Search';
                    reasoning.classList.add('show');
                    document.getElementById('ai-reasoning-text').textContent = 'AI service unavailable. Run: ollama serve';
                    document.getElementById('ai-result-badge').innerHTML = `<span class="ai-result-badge error"><i class="ti ti-wifi-off"></i> Offline</span>`;
                });
        }

        function clearAiSearch() {
            aiMatchedIds = null;
            document.querySelectorAll('tr[data-id]').forEach(row => row.classList.remove('ai-match', 'ai-hidden'));
            document.getElementById('ai-reasoning').classList.remove('show');
            document.getElementById('ai-search-input').value = '';
        }

        /* ════════════════════════════════════════════════════════
           AI CHAT — with real action result rendering
        ════════════════════════════════════════════════════════ */
        let chatHistory = [];

        /* Action labels + icons for display */
        const ACTION_META = {
            CREATE_USER:     { label: 'User Created',       icon: 'ti-user-plus',      color: 'success' },
            DELETE_USERS:    { label: 'Users Deleted',      icon: 'ti-trash',          color: 'error'   },
            SUSPEND_USERS:   { label: 'Users Suspended',    icon: 'ti-player-pause',   color: 'warning' },
            ACTIVATE_USERS:  { label: 'Users Activated',    icon: 'ti-circle-check',   color: 'success' },
            CHANGE_PLAN:     { label: 'Plan Updated',       icon: 'ti-crown',          color: 'info'    },
            CHANGE_ROLE:     { label: 'Roles Updated',      icon: 'ti-shield',         color: 'info'    },
            RESET_PASSWORD:  { label: 'Password Reset',     icon: 'ti-key',            color: 'warning' },
            EXPORT_USER_IDS: { label: 'Export Ready',       icon: 'ti-download',       color: 'info'    },
        };

        function chatStarter(text) {
            document.getElementById('ai-chat-input').value = text;
            document.getElementById('chat-starter-chips').style.display = 'none';
            sendChat();
        }

        function quickAction(text) {
            // Open the chat tab and fire the command
            document.querySelectorAll('.ai-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.ai-tab-pane').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.ai-tab')[1].classList.add('active');
            document.getElementById('ai-tab-chat').classList.add('active');
            chatStarter(text);
        }

        function appendMsg(role, content) {
            const msgs   = document.getElementById('ai-chat-msgs');
            const typing = document.getElementById('chat-typing');
            const div    = document.createElement('div');
            div.className = 'chat-msg ' + role;
            div.textContent = content;
            msgs.insertBefore(div, typing);
            msgs.scrollTop = msgs.scrollHeight;
        }

        function appendActionCard(action, actionResult) {
            if (!action || action === 'READ_ONLY' || !actionResult) return;

            const msgs   = document.getElementById('ai-chat-msgs');
            const typing = document.getElementById('chat-typing');
            const meta   = ACTION_META[action] || { label: action, icon: 'ti-bolt', color: 'info' };
            const ok     = actionResult.success;
            const headerClass = ok ? meta.color : 'error';

            let bodyHtml = `<div class="data-row"><span class="data-key">Message</span><span class="data-val">${escHtml(actionResult.message || '')}</span></div>`;

            if (ok && actionResult.affectedIds?.length) {
                bodyHtml += `<div class="data-row"><span class="data-key">Affected IDs</span><span class="data-val">${actionResult.affectedIds.join(', ')}</span></div>`;
            }

            if (ok && actionResult.data) {
                const d = actionResult.data;
                if (d.name)  bodyHtml += `<div class="data-row"><span class="data-key">Name</span><span class="data-val">${escHtml(d.name)}</span></div>`;
                if (d.email) bodyHtml += `<div class="data-row"><span class="data-key">Email</span><span class="data-val">${escHtml(d.email)}</span></div>`;
                if (d.id)    bodyHtml += `<div class="data-row"><span class="data-key">User ID</span><span class="data-val">#${d.id}</span></div>`;
                if (d.plan)  bodyHtml += `<div class="data-row"><span class="data-key">Plan</span><span class="data-val">${escHtml(d.plan)}</span></div>`;
                if (d.password) {
                    bodyHtml += `<div class="temp-pass"><i class="ti ti-key"></i> Temp password: <strong>${escHtml(d.password)}</strong></div>`;
                }
            }

            if (ok && actionResult.tempPassword) {
                bodyHtml += `<div class="temp-pass"><i class="ti ti-key"></i> New password: <strong>${escHtml(actionResult.tempPassword)}</strong></div>`;
            }

            if (ok && actionResult.ids?.length) {
                bodyHtml += `<div class="data-row"><span class="data-key">IDs</span><span class="data-val">${actionResult.ids.join(', ')}</span></div>`;
            }

            const card = document.createElement('div');
            card.className = 'chat-action-card';
            card.innerHTML = `
                <div class="chat-action-header ${headerClass}">
                    <i class="ti ${meta.icon}"></i> ${meta.label}
                </div>
                <div class="chat-action-body">${bodyHtml}</div>
            `;
            msgs.insertBefore(card, typing);
            msgs.scrollTop = msgs.scrollHeight;

            // Also show a toast
            if (ok) {
                showToast(meta.color === 'error' ? 'warning' : meta.color, meta.label, actionResult.message);
            } else {
                showToast('error', 'Action Failed', actionResult.message);
            }
        }

        function escHtml(str) {
            return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
        }

        function sendChat() {
            const input = document.getElementById('ai-chat-input');
            const msg   = input.value.trim();
            if (!msg) return;
            input.value = '';
            document.getElementById('chat-starter-chips').style.display = 'none';

            chatHistory.push({role: 'user', content: msg});
            appendMsg('user', msg);

            const typing = document.getElementById('chat-typing');
            typing.style.display = 'flex';
            document.getElementById('ai-chat-msgs').scrollTop = document.getElementById('ai-chat-msgs').scrollHeight;

            fetch('{{ path('admin_ai_chat') }}', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({messages: chatHistory})
            })
                .then(r => r.json())
                .then(data => {
                    typing.style.display = 'none';

                    // Clean the reply — strip any leaked JSON the model may have narrated
                    const rawReply = data.reply || data.error || 'No response.';
                    const cleanReply = sanitizeReply(rawReply, data.action, data.actionResult);

                    chatHistory.push({role: 'assistant', content: cleanReply});
                    appendMsg('assistant', cleanReply);

                    // Render action result card if there was a real action
                    if (data.action && data.action !== 'READ_ONLY' && data.actionResult) {
                        appendActionCard(data.action, data.actionResult);
                    }
                })
                .catch(() => {
                    typing.style.display = 'none';
                    appendMsg('assistant', '⚠️ AI service unavailable. Make sure Ollama is running: ollama serve');
                    showToast('error', 'AI Offline', 'Run: ollama serve');
                });
        }

        /**
         * Sanitize the reply text shown in the chat bubble.
         *
         * The model (especially llama3) sometimes narrates its own JSON output like:
         *   "Here is the response: {"action":"CREATE_USER",...} Let me know what's next!"
         *
         * This function strips those JSON blobs from the visible reply and,
         * if an action succeeded, replaces an empty/useless reply with a clean summary.
         */
        function sanitizeReply(reply, action, actionResult) {
            // Remove ```json ... ``` fences
            let clean = reply.replace(/```json[\s\S]*?```/gi, '').replace(/```[\s\S]*?```/gi, '');

            // Remove bare {...} JSON objects (brace-balanced removal)
            clean = removeBraceBlocks(clean);

            // Collapse excessive whitespace
            clean = clean.replace(/\s{2,}/g, ' ').trim();

            // If the reply is now empty or just punctuation, generate a fallback
            if (!clean || /^[\s.,!?:;-]*$/.test(clean)) {
                if (action && action !== 'READ_ONLY' && actionResult?.success) {
                    return actionResult.message || 'Action completed successfully.';
                }
                if (action && action !== 'READ_ONLY' && actionResult && !actionResult.success) {
                    return 'Action failed: ' + (actionResult.message || 'Unknown error.');
                }
                return 'Done.';
            }

            return clean;
        }

        /**
         * Remove balanced {...} brace blocks from a string.
         * Handles nested braces correctly.
         */
        function removeBraceBlocks(str) {
            let result = '';
            let depth  = 0;
            for (let i = 0; i < str.length; i++) {
                if (str[i] === '{') { depth++; continue; }
                if (str[i] === '}') { depth = Math.max(0, depth - 1); continue; }
                if (depth === 0) result += str[i];
            }
            return result;
        }

        /* ════════════════════════════════════════════════════════
           INSIGHT PANEL
        ════════════════════════════════════════════════════════ */
        function openInsight(userId, name, email, avatarName) {
            document.getElementById('insight-panel-name').textContent  = name;
            document.getElementById('insight-panel-email').textContent = email;
            document.getElementById('insight-avatar').src = `https://ui-avatars.com/api/?name=${avatarName}&background=random&size=96`;
            document.getElementById('insight-text').className = 'insight-text-wrap loading';
            document.getElementById('insight-text').innerHTML = '<i class="ti ti-loader-2" style="animation:spin 1s linear infinite"></i> Analyzing user profile…';
            document.getElementById('insight-actions').style.display = 'none';
            document.getElementById('insight-view-link').href = `/admin/users/${userId}`;
            document.getElementById('insight-edit-link').href = `/admin/users/${userId}/edit`;
            document.getElementById('insight-overlay').classList.add('open');
            document.getElementById('insight-panel').classList.add('open');

            fetch('{{ path('admin_ai_insight') }}', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({userId})
            })
                .then(r => r.json())
                .then(data => {
                    const wrap = document.getElementById('insight-text');
                    wrap.className = 'insight-text-wrap';
                    wrap.textContent = data.insight || data.error || 'No insight available.';
                    document.getElementById('insight-actions').style.display = 'grid';
                })
                .catch(() => {
                    const wrap = document.getElementById('insight-text');
                    wrap.className = 'insight-text-wrap';
                    wrap.textContent = 'AI service unavailable. Run: ollama serve';
                });
        }

        function closeInsight() {
            document.getElementById('insight-overlay').classList.remove('open');
            document.getElementById('insight-panel').classList.remove('open');
        }

        document.addEventListener('keydown', e => { if (e.key === 'Escape') closeInsight(); });
    </script>
{% endblock %}
