                <button type="button" onclick="clearAiSearch()" style="margin-top:8px;padding:4px 10px;border-radius:6px;font-size:.74rem;font-weight:600;background:#fff;border:1.5px solid #bfdbfe;color:#1d4ed8;cursor:pointer;display:inline-flex;align-items:center;gap:4px">
                    <i class="ti ti-x"></i> Clear filter
