{% extends 'layouts/admin.html.twig' %}

{% block title %}Notifications · {{ user.fullName }} — {{ parent() }}{% endblock %}

{% block page_title %}
    <span class="d-flex align-items-center gap-2">
        <span style="width:36px;height:36px;border-radius:10px;background:#ecfeff;color:#0891b2;display:grid;place-items:center;font-size:18px">
            <i class="ti ti-bell-ringing"></i>
        </span>
        Notifications · {{ user.fullName }}
    </span>
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb breadcrumb-arrows" aria-label="breadcrumbs">
        <li class="breadcrumb-item"><a href="{{ path('admin_users_index') }}"><i class="ti ti-users me-1"></i>Users</a></li>
        <li class="breadcrumb-item"><a href="{{ path('admin_users_show', {id: user.id}) }}">{{ user.fullName }}</a></li>
        <li class="breadcrumb-item active" aria-current="page">Notifications</li>
    </ol>
{% endblock %}

{% block page_actions %}
    <div class="col-auto ms-auto d-print-none">
        <div class="d-flex gap-2">
            <a href="{{ path('admin_users_show', {id: user.id}) }}"
               class="btn btn-ghost-secondary" style="border-radius:10px">
                <i class="ti ti-arrow-left me-1"></i> Back to Profile
            </a>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="container-xl">

        {% for type, messages in app.flashes %}
            {% for msg in messages %}
                <div class="alert alert-{{ type == 'danger' ? 'danger' : (type == 'warning' ? 'warning' : 'success') }} alert-dismissible fade show mb-3" role="alert">
                    {{ msg }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="row g-4">

            {# ── SEND FORM ──────────────────────────────────────── #}
            <div class="col-lg-4">
                <div class="card" style="border-radius:16px;border:1.5px solid #e2e8f0">
                    <div class="card-header bg-white fw-semibold d-flex align-items-center gap-2"
                         style="border-radius:14px 14px 0 0;border-bottom:1.5px solid #f1f5f9">
                        <i class="ti ti-send text-primary"></i>
                        Send Notification
                    </div>
                    <div class="card-body">
                        <form method="POST" action="{{ path('admin_users_notify', {id: user.id}) }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('notify' ~ user.id) }}">

                            <div class="mb-3">
                                <label class="form-label fw-medium">Type</label>
                                <select name="type" class="form-select">
                                    {% for value, label in notificationTypes %}
                                        <option value="{{ value }}">{{ label }}</option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-medium">Message</label>
                                <textarea name="message" class="form-control" rows="5"
                                          placeholder="Write your message here…" required></textarea>
                            </div>

                            <button type="submit" class="btn btn-primary w-100"
                                    style="border-radius:10px;font-weight:600">
                                <i class="ti ti-bell-ringing me-1"></i> Send Notification
                            </button>
                        </form>
                    </div>
                    <div class="card-footer bg-white text-muted small"
                         style="border-radius:0 0 14px 14px;border-top:1.5px solid #f1f5f9">
                        <i class="ti ti-user me-1"></i>
                        <a href="{{ path('admin_users_show', {id: user.id}) }}" class="text-reset">{{ user.fullName }}</a>
                        &nbsp;·&nbsp; {{ user.email }}
                    </div>
                </div>
            </div>

            {# ── NOTIFICATION HISTORY ───────────────────────────── #}
            <div class="col-lg-8">
                <div class="card" style="border-radius:16px;border:1.5px solid #e2e8f0">
                    <div class="card-header bg-white d-flex align-items-center justify-content-between"
                         style="border-radius:14px 14px 0 0;border-bottom:1.5px solid #f1f5f9">
                    <span class="fw-semibold d-flex align-items-center gap-2">
                        <i class="ti ti-history text-secondary"></i>
                        History
                        {% if unreadCount > 0 %}
                            <span class="badge bg-danger">{{ unreadCount }} unread</span>
                        {% endif %}
                    </span>
                        {% if unreadCount > 0 %}
                            <form method="POST" action="{{ path('admin_users_notifications_read_all', {id: user.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('notif_read_all' ~ user.id) }}">
                                <button type="submit" class="btn btn-sm btn-outline-secondary" style="border-radius:8px">
                                    <i class="ti ti-checks me-1"></i>Mark all read
                                </button>
                            </form>
                        {% endif %}
                    </div>

                    <div class="card-body p-0">
                        {% if recentNotifications|length == 0 %}
                            <div class="text-center text-muted py-5">
                                <i class="ti ti-bell-off" style="font-size:2.5rem;opacity:.3"></i>
                                <p class="mt-2 mb-0">No notifications sent yet.</p>
                            </div>
                        {% else %}
                            <div class="list-group list-group-flush">
                                {% for n in recentNotifications %}
                                    {% set colours = {
                                        'info':    'bg-info-lt text-info',
                                        'warning': 'bg-warning-lt text-warning',
                                        'success': 'bg-success-lt text-success',
                                        'premium': 'bg-purple-lt text-purple',
                                        'system':  'bg-secondary-lt text-secondary'
                                    } %}
                                    <div class="list-group-item px-4 py-3"
                                         style="{{ not n.isRead ? 'background:#f8faff;border-left:3px solid #3b5bdb' : '' }}">

                                        <div class="d-flex align-items-center justify-content-between mb-2">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="badge {{ colours[n.type] ?? 'bg-secondary-lt text-secondary' }}">
                                            {{ n.type|upper }}
                                        </span>
                                                {% if not n.isRead %}
                                                    <span class="badge bg-danger-lt text-danger">Unread</span>
                                                {% endif %}
                                                {% if n.metadata.reply_to is defined %}
                                                    <span class="badge bg-light text-muted border">
                                                <i class="ti ti-corner-down-right"></i> Reply
                                            </span>
                                                {% endif %}
                                            </div>
                                            <small class="text-muted text-nowrap">
                                                {{ n.createdAt|date('d M Y, H:i') }}
                                            </small>
                                        </div>

                                        <p class="mb-2 {{ n.isRead ? 'text-muted' : 'fw-medium' }}">
                                            {{ n.message }}
                                        </p>

                                        <div class="d-flex flex-wrap gap-2">
                                            {% if not n.isRead %}
                                                <form method="POST" action="{{ path('admin_users_notification_read', {id: n.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('notif_read' ~ n.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-success" style="border-radius:8px">
                                                        <i class="ti ti-check me-1"></i>Mark as read
                                                    </button>
                                                </form>
                                            {% endif %}

                                            {% if n.metadata.reply_to is not defined %}
                                                <button class="btn btn-sm btn-outline-primary" type="button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target="#reply-{{ n.id }}"
                                                        style="border-radius:8px">
                                                    <i class="ti ti-corner-down-right me-1"></i>Reply
                                                </button>
                                            {% endif %}
                                        </div>

                                        {% if n.metadata.reply_to is not defined %}
                                            <div class="collapse mt-3" id="reply-{{ n.id }}">
                                                <form method="POST" action="{{ path('admin_users_notification_reply', {id: n.id}) }}">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('notif_reply' ~ n.id) }}">
                                                    <div class="input-group">
                                                        <input type="text" name="reply" class="form-control form-control-sm"
                                                               placeholder="Type your reply…" required>
                                                        <button type="submit" class="btn btn-sm btn-primary">
                                                            <i class="ti ti-send"></i>
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        {% endif %}

                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

        </div>
    </div>
{% endblock %}
