{% extends 'base.html.twig' %}

{% block title %}{% block page_title %}Dashboard{% endblock %}{% endblock %}

{% block body %}
<div class="page">
    {# ===== USER SIDEBAR ===== #}
    <aside class="navbar navbar-vertical navbar-expand-lg" data-bs-theme="dark">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#user-sidebar-menu" aria-controls="user-sidebar-menu"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <h1 class="navbar-brand navbar-brand-autodark">
                <a href="{{ path('user_dashboard') }}" class="d-flex align-items-center text-decoration-none">
                    <i class="ti ti-language fs-1 me-2"></i>
                    <span class="fw-bold">LinguaLearn</span>
                </a>
            </h1>

            <div class="collapse navbar-collapse" id="user-sidebar-menu">
                <ul class="navbar-nav pt-lg-3">
                    {# Dashboard #}
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.attributes.get('_route') == 'user_dashboard' %}active{% endif %}"
                           href="{{ path('user_dashboard') }}">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-home"></i>
                            </span>
                            <span class="nav-link-title">Dashboard</span>
                        </a>
                    </li>

                    {# My Profile #}
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-user"></i>
                            </span>
                            <span class="nav-link-title">My Profile</span>
                        </a>
                    </li>

                    {# My Courses #}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#navbar-courses"
                           data-bs-toggle="dropdown" data-bs-auto-close="false"
                           role="button" aria-expanded="false">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-book-2"></i>
                            </span>
                            <span class="nav-link-title">My Courses</span>
                        </a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" href="#">
                                <i class="ti ti-list me-2"></i>All Courses
                            </a>
                            <a class="dropdown-item" href="#">
                                <i class="ti ti-progress me-2"></i>In Progress
                            </a>
                            <a class="dropdown-item" href="#">
                                <i class="ti ti-check me-2"></i>Completed
                            </a>
                        </div>
                    </li>

                    {# Exercises & Quizzes #}
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-clipboard-check"></i>
                            </span>
                            <span class="nav-link-title">Exercises</span>
                            <span class="badge badge-sm bg-success ms-auto">3 New</span>
                        </a>
                    </li>

                    {# Practice Tests #}
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-certificate"></i>
                            </span>
                            <span class="nav-link-title">Practice Tests</span>
                        </a>
                    </li>

                    {# Divider #}
                    <li class="nav-item my-2">
                        <hr class="navbar-divider">
                    </li>

                    {# Community #}
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-messages"></i>
                            </span>
                            <span class="nav-link-title">Forum</span>
                        </a>
                    </li>

                    {# Progress & Stats #}
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-chart-line"></i>
                            </span>
                            <span class="nav-link-title">My Progress</span>
                        </a>
                    </li>

                    {# Support #}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#navbar-support"
                           data-bs-toggle="dropdown" data-bs-auto-close="false"
                           role="button" aria-expanded="false">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-help"></i>
                            </span>
                            <span class="nav-link-title">Support</span>
                        </a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" href="#">
                                <i class="ti ti-question-mark me-2"></i>FAQ
                            </a>
                            <a class="dropdown-item" href="#">
                                <i class="ti ti-message-circle me-2"></i>Contact Support
                            </a>
                        </div>
                    </li>

                    {# Admin Section (only for admins) #}
                    {% if is_granted('ROLE_ADMIN') %}
                        <li class="nav-item my-2">
                            <hr class="navbar-divider">
                            <div class="nav-item-title px-3 text-muted small">Administration</div>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('admin_dashboard') }}">
                                <span class="nav-link-icon d-md-none d-lg-inline-block">
                                    <i class="ti ti-dashboard"></i>
                                </span>
                                <span class="nav-link-title">Admin Panel</span>
                            </a>
                        </li>
                    {% endif %}
                </ul>

                {# User Progress Widget in Sidebar #}
                <div class="card card-sm mt-auto mb-3 mx-3" style="background: rgba(255,255,255,0.1);">
                    <div class="card-body">
                        <div class="d-flex align-items-center text-white">
                            <div class="flex-fill">
                                <div class="small opacity-75 mb-1">Learning Streak</div>
                                <div class="h3 mb-0">
                                    <i class="ti ti-flame text-orange"></i> 7 days
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </aside>

    {# ===== MAIN CONTENT AREA ===== #}
    <div class="page-wrapper">
        {# Enhanced Header #}
        <header class="navbar navbar-expand-md d-print-none sticky-top">
            <div class="container-xl">
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                        data-bs-target="#navbar-menu" aria-controls="navbar-menu"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-nav flex-row order-md-last">
                    {# Search Bar #}
                    <div class="nav-item d-none d-md-flex me-3">
                        <div class="input-icon">
                            <span class="input-icon-addon">
                                <i class="ti ti-search"></i>
                            </span>
                            <input type="text" class="form-control" placeholder="Search courses..." aria-label="Search">
                        </div>
                    </div>

                    {# Notifications Dropdown #}
                    <div class="nav-item dropdown d-none d-md-flex me-3">
                        <a href="#" class="nav-link px-0" data-bs-toggle="dropdown" tabindex="-1" aria-label="Show notifications">
                            <i class="ti ti-bell icon"></i>
                            <span class="badge bg-red badge-pill badge-blink"></span>
                        </a>
                        <div class="dropdown-menu dropdown-menu-arrow dropdown-menu-end dropdown-menu-card">
                            <div class="card">
                                <div class="card-header">
                                    <h3 class="card-title">Notifications</h3>
                                </div>
                                <div class="list-group list-group-flush list-group-hoverable">
                                    <div class="list-group-item">
                                        <div class="row align-items-center">
                                            <div class="col-auto">
                                                <span class="status-dot status-dot-animated bg-success d-block"></span>
                                            </div>
                                            <div class="col text-truncate">
                                                <a href="#" class="text-body d-block">New lesson available</a>
                                                <div class="d-block text-muted text-truncate mt-n1">
                                                    Spanish Grammar - Present Tense
                                                </div>
                                            </div>
                                            <div class="col-auto">
                                                <small class="text-muted">2m</small>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="list-group-item">
                                        <div class="row align-items-center">
                                            <div class="col-auto">
                                                <span class="status-dot d-block"></span>
                                            </div>
                                            <div class="col text-truncate">
                                                <a href="#" class="text-body d-block">Quiz completed</a>
                                                <div class="d-block text-muted text-truncate mt-n1">
                                                    You scored 85%!
                                                </div>
                                            </div>
                                            <div class="col-auto">
                                                <small class="text-muted">1h</small>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="card-footer text-center">
                                    <a href="#" class="btn btn-sm">View all notifications</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# User Menu #}
                    <div class="nav-item dropdown">
                        <a href="#" class="nav-link d-flex lh-1 text-reset p-0" data-bs-toggle="dropdown" aria-label="Open user menu">
                            <span class="avatar avatar-sm" style="background-image: url(https://ui-avatars.com/api/?name={{ app.user ? app.user.userIdentifier : 'User' }}&background=667eea&color=fff)"></span>
                            <div class="d-none d-xl-block ps-2">
                                <div>{{ app.user ? app.user.userIdentifier : 'Guest' }}</div>
                                <div class="mt-1 small text-muted">{{ is_granted('ROLE_ADMIN') ? 'Administrator' : 'Learner' }}</div>
                            </div>
                        </a>
                        <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                            <a href="#" class="dropdown-item">
                                <i class="ti ti-user me-2"></i>Profile
                            </a>
                            <a href="#" class="dropdown-item">
                                <i class="ti ti-settings me-2"></i>Settings
                            </a>
                            <div class="dropdown-divider"></div>
                            <a href="{{ path('app_logout') }}" class="dropdown-item">
                                <i class="ti ti-logout me-2"></i>Logout
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        {# Page Header #}
        {% block page_header %}
            <div class="page-header d-print-none">
                <div class="container-xl">
                    <div class="row g-2 align-items-center">
                        <div class="col">
                            <div class="page-pretitle">
                                {% block page_pretitle %}{% endblock %}
                            </div>
                            <h2 class="page-title">
                                {{ block('page_title') }}
                            </h2>
                            {% block breadcrumb %}{% endblock %}
                        </div>
                        <div class="col-auto ms-auto d-print-none">
                            <div class="btn-list">
                                {% block page_actions %}{% endblock %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        {% endblock %}

        {# Flash Messages #}
        {% include 'components/_flash_messages.html.twig' ignore missing %}

        {# Page Body - USE 'content' BLOCK #}
        <div class="page-body">
            <div class="container-xl">
                {% block content %}{% endblock %}
            </div>
        </div>

        {# Enhanced Footer #}
        <footer class="footer footer-transparent d-print-none mt-auto">
            <div class="container-xl">
                <div class="row text-center align-items-center">
                    <div class="col-12 col-lg-auto mt-3 mt-lg-0">
                        <ul class="list-inline list-inline-dots mb-0">
                            <li class="list-inline-item">
                                <a href="#" class="link-secondary text-decoration-none">
                                    <i class="ti ti-book me-1"></i>Documentation
                                </a>
                            </li>
                            <li class="list-inline-item">
                                <a href="#" class="link-secondary text-decoration-none">
                                    <i class="ti ti-help me-1"></i>Support
                                </a>
                            </li>
                            <li class="list-inline-item">
                                <a href="#" class="link-secondary text-decoration-none">
                                    <i class="ti ti-shield-lock me-1"></i>Privacy
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div class="col-lg-auto ms-lg-auto">
                        <ul class="list-inline list-inline-dots mb-0">
                            <li class="list-inline-item">
                                <span class="text-muted">
                                    Made with <i class="ti ti-heart text-red"></i> by LinguaLearn Team
                                </span>
                            </li>
                            <li class="list-inline-item">
                                &copy; {{ 'now'|date('Y') }} LinguaLearn. All rights reserved.
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </footer>
    </div>
</div>

{# Quick Actions Floating Button #}
<div class="position-fixed bottom-0 end-0 p-3" style="z-index: 1050;">
    <div class="dropdown dropup">
        <button class="btn btn-primary rounded-circle shadow-lg" type="button"
                data-bs-toggle="dropdown" aria-expanded="false" style="width: 60px; height: 60px;">
            <i class="ti ti-plus fs-2"></i>
        </button>
        <ul class="dropdown-menu dropdown-menu-end">
            <li><a class="dropdown-item" href="#"><i class="ti ti-book-2 me-2"></i>Start New Course</a></li>
            <li><a class="dropdown-item" href="#"><i class="ti ti-clipboard-check me-2"></i>Take Practice Test</a></li>
            <li><a class="dropdown-item" href="#"><i class="ti ti-message-circle me-2"></i>Ask Question</a></li>
        </ul>
    </div>
</div>
{% endblock %}
