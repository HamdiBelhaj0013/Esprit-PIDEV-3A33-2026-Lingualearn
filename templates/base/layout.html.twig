<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    <meta http-equiv="X-UA-Compatible" content="ie=edge"/>
    <title>{% block title %}Language Learning Platform{% endblock %}</title>

    {# Tabler CSS #}
    <link href="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta17/dist/css/tabler.min.css" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" rel="stylesheet"/>

    {# Custom CSS #}
    {% block stylesheets %}{% endblock %}

    <style>
        .navbar-brand-image {
            height: 2rem;
        }
    </style>
</head>
<body>
<div class="page">
    {# Sidebar #}
    {% include 'components/_sidebar.html.twig' %}

    {# Header #}
    <header class="navbar navbar-expand-md d-print-none">
        <div class="container-xl">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbar-menu" aria-controls="navbar-menu" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <h1 class="navbar-brand navbar-brand-autodark d-none-navbar-horizontal pe-0 pe-md-3">
                <a href="{{ path('app_home') }}">
                    <i class="ti ti-language fs-1"></i> Language Learning
                </a>
            </h1>

            <div class="navbar-nav flex-row order-md-last">
                {# Notifications #}
                {% include 'components/_notifications.html.twig' %}

                {# User Menu #}
                {% include 'components/_user_menu.html.twig' %}
            </div>
        </div>
    </header>

    {# Page Content #}
    <div class="page-wrapper">
        {# Page header #}
        {% block page_header %}
            <div class="page-header d-print-none">
                <div class="container-xl">
                    <div class="row g-2 align-items-center">
                        <div class="col">
                            <h2 class="page-title">
                                {% block page_title %}Dashboard{% endblock %}
                            </h2>
                            {% block breadcrumb %}{% endblock %}
                        </div>
                        {% block page_actions %}{% endblock %}
                    </div>
                </div>
            </div>
        {% endblock %}

        {# Flash Messages #}
        {% include 'components/_flash_messages.html.twig' %}

        {# Page body #}
        <div class="page-body">
            <div class="container-xl">
                {% block body %}{% endblock %}
            </div>
        </div>

        {# Footer #}
        {% include 'components/_footer.html.twig' %}
    </div>
</div>

{# Tabler JS #}
<script src="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta17/dist/js/tabler.min.js"></script>

{# Custom JS #}
{% block javascripts %}{% endblock %}
</body>
</html>
