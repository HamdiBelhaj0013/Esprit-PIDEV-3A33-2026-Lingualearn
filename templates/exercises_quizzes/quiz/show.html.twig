{% extends 'layouts/admin.html.twig' %}

{% block title %}{{ quiz.title }}{% endblock %}
{% block page_title %}{{ quiz.title }}{% endblock %}

{% block breadcrumb %}
<ol class="breadcrumb breadcrumb-arrows" aria-label="breadcrumbs">
    <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
    <li class="breadcrumb-item"><a href="{{ path('quiz_index') }}">Quiz</a></li>
    <li class="breadcrumb-item active" aria-current="page">{{ quiz.title }}</li>
</ol>
{% endblock %}

{% block page_actions %}
<div class="col-auto ms-auto d-print-none">
    <div class="btn-list">
        <a href="{{ path('quiz_edit', {'id': quiz.id}) }}" class="btn eq-btn eq-btn-primary">
            <i class="ti ti-edit me-1"></i> Modifier
        </a>
        <button type="button" class="btn btn-danger eq-btn" data-bs-toggle="modal" data-bs-target="#deleteModal">
            <i class="ti ti-trash me-1"></i> Supprimer
        </button>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('exercises_quizzes/_eq_styles.html.twig') }}
{% endblock %}

{% block content %}
<div class="eq-page-wrap">
    <div class="row g-3">
        <div class="col-12 col-lg-8">
            <div class="card eq-card mb-0">
                <div class="card-header">
                    <h3 class="card-title mb-0"><i class="ti ti-info-circle me-2"></i>Informations du quiz</h3>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-sm-6">
                            <div class="text-muted small text-uppercase fw-bold mb-1">Titre</div>
                            <div class="fw-semibold">{{ quiz.title }}</div>
                        </div>

                        <div class="col-sm-6">
                            <div class="text-muted small text-uppercase fw-bold mb-1">Leçon</div>
                            {% if quiz.lesson %}
                                <span class="badge eq-badge bg-azure-lt text-dark">{{ quiz.lesson.title }}</span>
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </div>

                        <div class="col-sm-6">
                            <div class="text-muted small text-uppercase fw-bold mb-1">Score de réussite</div>
                            <span class="badge eq-badge bg-success-lt text-success">{{ quiz.passingScore }} %</span>
                        </div>

                        <div class="col-sm-6">
                            <div class="text-muted small text-uppercase fw-bold mb-1">Nombre de questions</div>
                            <span class="badge eq-badge bg-primary-lt text-primary">{{ quiz.questionCount }} questions</span>
                        </div>

                        <div class="col-sm-6">
                            <div class="text-muted small text-uppercase fw-bold mb-1">Difficulté</div>
                            <span class="badge eq-badge bg-azure-lt text-dark">{{ quiz.difficulty }}/5</span>
                        </div>

                        <div class="col-sm-6">
                            <div class="text-muted small text-uppercase fw-bold mb-1">Compétences</div>
                            {% if quiz.skillCodes is not empty %}
                                {% for code in quiz.skillCodes %}
                                    <span class="badge eq-badge bg-success-lt text-success me-1">{{ code }}</span>
                                {% endfor %}
                            {% else %}
                                <span class="text-muted">—</span>
                            {% endif %}
                        </div>

                        <div class="col-sm-6">
                            <div class="text-muted small text-uppercase fw-bold mb-1">Créé le</div>
                            <div>{{ quiz.createdAt ? quiz.createdAt|date('d/m/Y H:i') : '—' }}</div>
                        </div>

                        <div class="col-sm-6">
                            <div class="text-muted small text-uppercase fw-bold mb-1">Modifié le</div>
                            <div>{{ quiz.updatedAt ? quiz.updatedAt|date('d/m/Y H:i') : '—' }}</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card eq-card mt-3">
                <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
                    <h3 class="card-title mb-0"><i class="ti ti-list me-2"></i>Exercices ({{ quiz.exercices|length }})</h3>
                    <a href="{{ path('exercice_index') }}?quiz_id={{ quiz.id }}" class="btn btn-sm eq-btn eq-btn-primary">Voir tout</a>
                </div>

                <div class="card-body p-0">
                    <div class="list-group list-group-flush">
                        {% for exercice in quiz.exercices %}
                            <a href="{{ path('exercice_show', { id: exercice.id }) }}" class="list-group-item list-group-item-action d-flex align-items-center py-3">
                                <span class="badge bg-azure-lt text-dark me-2 flex-shrink-0">#{{ exercice.id }}</span>
                                <span class="flex-grow-1 text-truncate me-2">
                                    {{ exercice.question|slice(0, 60) }}{% if exercice.question|length > 60 %}...{% endif %}
                                </span>
                                <span class="badge bg-primary-lt text-primary flex-shrink-0 me-1">{{ exercice.type }}</span>
                                <span class="badge bg-secondary-lt text-secondary flex-shrink-0 me-1" title="Difficulté">{{ exercice.difficulty }}/5</span>
                                {% for code in exercice.skillCodes|slice(0, 3) %}
                                    <span class="badge bg-success-lt text-success flex-shrink-0 me-1">{{ code }}</span>
                                {% endfor %}
                                <i class="ti ti-chevron-right text-muted ms-2 flex-shrink-0"></i>
                            </a>
                        {% else %}
                            <div class="list-group-item text-muted text-center py-4">
                                Aucun exercice. <a href="{{ path('exercice_new') }}?quiz={{ quiz.id }}">Ajouter un exercice</a>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>

        <div class="col-12 col-lg-4">
            <div class="card eq-card mb-3">
                <div class="card-header">
                    <h3 class="card-title mb-0">Statistiques</h3>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-around text-center">
                        <div>
                            <div class="text-muted small">Tentatives</div>
                            <div class="h4 mb-0 text-primary">0</div>
                        </div>
                        <div>
                            <div class="text-muted small">Score moyen</div>
                            <div class="h4 mb-0 text-primary">0 %</div>
                        </div>
                        <div>
                            <div class="text-muted small">Réussite</div>
                            <div class="h4 mb-0 text-success">0 %</div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card eq-card">
                <div class="card-header">
                    <h3 class="card-title mb-0">Actions</h3>
                </div>
                <div class="card-body d-grid gap-2">
                    <a href="{{ path('quiz_edit', {'id': quiz.id}) }}" class="btn eq-btn eq-btn-primary">
                        <i class="ti ti-edit me-2"></i> Modifier le quiz
                    </a>
                    <a href="{{ path('exercice_new') }}?quiz={{ quiz.id }}" class="btn eq-btn eq-btn-outline">
                        <i class="ti ti-plus me-2"></i> Ajouter un exercice
                    </a>
                    <a href="{{ path('quiz_index') }}" class="btn eq-btn eq-btn-outline">
                        <i class="ti ti-arrow-left me-2"></i> Retour à la liste
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

{# Modal suppression #}
<div class="modal modal-blur fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            <div class="modal-status bg-danger"></div>
            <div class="modal-body text-center py-4">
                <i class="ti ti-trash icon mb-2 text-danger" style="font-size: 3rem;"></i>
                <h3>Supprimer ce quiz ?</h3>
                <p class="text-muted mb-0">Cette action est irréversible.</p>
            </div>
            <div class="modal-footer">
                <div class="w-100 row g-2">
                    <div class="col">
                        <button type="button" class="btn w-100" data-bs-dismiss="modal">Annuler</button>
                    </div>
                    <div class="col">
                        <form method="post" action="{{ path('quiz_delete', {'id': quiz.id}) }}" class="d-inline w-100">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ quiz.id) }}">
                            <button type="submit" class="btn btn-danger w-100">
                                <i class="ti ti-trash me-1"></i> Supprimer
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}