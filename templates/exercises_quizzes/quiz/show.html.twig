{% extends 'base.html.twig' %}

{% block title %}{{ quiz.title }}{% endblock %}

{% block page_title %}{{ quiz.title }}{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb breadcrumb-arrows" aria-label="breadcrumbs">
        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
        <li class="breadcrumb-item"><a href="{{ path('quiz_index') }}">Quizzes</a></li>
        <li class="breadcrumb-item active" aria-current="page">{{ quiz.title }}</li>
    </ol>
{% endblock %}

{% block page_actions %}
    <div class="col-auto ms-auto d-print-none">
        <div class="btn-list">
            <a href="{{ path('quiz_edit', {'id': quiz.id}) }}" class="btn btn-primary">
                <i class="ti ti-edit icon"></i>
                Edit Quiz
            </a>
            <button type="button" class="btn btn-danger" 
                    data-bs-toggle="modal" 
                    data-bs-target="#deleteModal">
                <i class="ti ti-trash icon"></i>
                Delete
            </button>
        </div>
    </div>
{% endblock %}

{% block body %}
<div class="row row-deck row-cards">
    {# Quiz Info Card #}
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Quiz Information</h3>
            </div>
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item">
                        <div class="datagrid-title">Title</div>
                        <div class="datagrid-content">{{ quiz.title }}</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Pass Score</div>
                        <div class="datagrid-content">
                            <span class="badge bg-success-lt">{{ quiz.passingScore }}%</span>
                        </div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Question Count</div>
                        <div class="datagrid-content">
                            <span class="badge badge-outline text-blue">
                                {{ quiz.questionCount }} questions
                            </span>
                        </div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Created</div>
                        <div class="datagrid-content">{{ quiz.createdAt|date('F d, Y H:i') }}</div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Last Updated</div>
                        <div class="datagrid-content">{{ quiz.updatedAt|date('F d, Y H:i') }}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Statistics Card #}
    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Statistics</h3>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-12">
                        <div class="mb-3">
                            <div class="text-muted mb-1">Total Attempts</div>
                            <div class="h3 mb-0">0</div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="mb-3">
                            <div class="text-muted mb-1">Average Score</div>
                            <div class="h3 mb-0">0%</div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="mb-3">
                            <div class="text-muted mb-1">Pass Rate</div>
                            <div class="h3 mb-0">0%</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Quick Actions #}
        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Quick Actions</h3>
            </div>
            <div class="list-group list-group-flush">
                <a href="{{ path('quiz_edit', {'id': quiz.id}) }}" class="list-group-item list-group-item-action">
                    <i class="ti ti-edit icon me-2"></i>
                    Edit Quiz
                </a>
                <a href="#" class="list-group-item list-group-item-action">
                    <i class="ti ti-copy icon me-2"></i>
                    Duplicate Quiz
                </a>
                <a href="#" class="list-group-item list-group-item-action">
                    <i class="ti ti-download icon me-2"></i>
                    Export Results
                </a>
                <a href="{{ path('quiz_index') }}" class="list-group-item list-group-item-action">
                    <i class="ti ti-arrow-left icon me-2"></i>
                    Back to Quizzes
                </a>
            </div>
        </div>
    </div>
</div>

{# Delete Modal #}
<div class="modal modal-blur fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-status bg-danger"></div>
            <div class="modal-body text-center py-4">
                <i class="ti ti-trash icon mb-2" style="font-size: 3rem; color: #dc3545;"></i>
                <h3>Delete Quiz</h3>
                <div class="text-muted">Are you sure you want to delete this quiz? This action cannot be undone.</div>
            </div>
            <div class="modal-footer">
                <div class="w-100">
                    <div class="row">
                        <div class="col"><a href="#" class="btn btn-white w-100" data-bs-dismiss="modal">
                            Cancel
                        </a></div>
                        <div class="col">
                            <form method="post" action="{{ path('quiz_delete', {'id': quiz.id}) }}" style="display: inline;">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ quiz.id) }}">
                                <button type="submit" class="btn btn-danger w-100">
                                    <i class="ti ti-trash icon me-2"></i>
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}