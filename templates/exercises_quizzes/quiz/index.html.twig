{% extends 'base.html.twig' %}

{% block title %}Liste des quiz{% endblock %}

{% block stylesheets %}
{{ parent() }}
{{ include('exercises_quizzes/_eq_styles.html.twig') }}
<style>
    .table-vcenter td, .table-vcenter th {
        vertical-align: middle;
        text-align: center;
    }
    .btn-animated {
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .btn-animated:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0,0,0,0.1);
    }
    .quiz-card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075);
    }
    .sortable {
        cursor: pointer;
    }
    .sortable:hover {
        background-color: rgba(0,0,0,0.02);
    }
    /* Amélioration de la visibilité des champs de recherche et filtrage */
    .form-control-rounded {
        border-radius: 50px;
        border: 1px solid #e2e8f0;
        color: #1e293b !important; /* Texte plus sombre (Slate 800) */
        font-weight: 500;
        background-color: #ffffff;
    }
    .form-control-rounded::placeholder {
        color: #94a3b8 !important; /* Placeholder plus visible (Slate 400) */
    }
    .form-control-rounded:focus {
        border-color: #206bc4;
        box-shadow: 0 0 0 0.25rem rgba(32, 107, 196, 0.15);
    }
    #status-filter {
        color: #1e293b !important;
        font-weight: 500;
    }
    #status-filter option {
        color: #1e293b;
        background-color: #fff;
    }
    .table thead th {
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-weight: 700;
        color: #64748b; /* Slate 500 */
        background-color: #f8fafc; /* Slate 50 */
        border-bottom: 2px solid #e2e8f0;
    }
    .btn-icon {
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 0.5rem;
    }
    .badge {
        font-weight: 600;
        padding: 0.35em 0.65em;
    }
</style>
{% endblock %}

{% block body %}
<div class="container-xl">
    <div class="page-header d-print-none mb-4">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title text-primary">
                    <i class="ti ti-list-check me-2"></i> Gestion des Quiz
                </h2>
            </div>
            <div class="col-auto ms-auto">
                <a href="{{ path('quiz_new') }}" class="btn eq-btn-create">
                    <i class="ti ti-plus me-2"></i> Créer un Quiz
                </a>
            </div>
        </div>
    </div>

    <div class="card eq-index-card quiz-card shadow-sm">
        <div class="card-header bg-light-lt py-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small text-muted mb-1">Recherche</label>
                    <div class="input-icon">
                        <span class="input-icon-addon"><i class="ti ti-search"></i></span>
                        <input type="text" id="search" placeholder="Titre ou description..." class="form-control form-control-rounded ps-5" autocomplete="off">
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label small text-muted mb-1">Statut</label>
                    <select id="status-filter" class="form-select form-control-rounded">
                        <option value="">Tous</option>
                        <option value="active">Actifs</option>
                        <option value="inactive">Inactifs</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted mb-1">Leçon</label>
                    <select id="lesson-filter" class="form-select form-control-rounded">
                        <option value="">Toutes les leçons</option>
                        {% for lesson in lessons %}
                        <option value="{{ lesson.id }}">{{ lesson.title }}</option>
                        {% endfor %}
                    </select>
                </div>
                <div class="col-md-3 text-md-end">
                    <button type="button" id="reset-filters" class="btn btn-sm eq-btn-reset">
                        <i class="ti ti-filter-off me-1"></i> Réinitialiser
                    </button>
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-vcenter card-table table-hover eq-table" id="quiz-table">
                <thead class="bg-light">
                    <tr>
                        <th data-field="id" class="sortable w-1">ID <i class="ti ti-arrows-sort"></i></th>
                        <th data-field="title" class="sortable text-start">Titre <i class="ti ti-arrows-sort"></i></th>
                        <th class="text-start">Leçon</th>
                        <th class="text-center">Exercices</th>
                        <th data-field="updatedAt" class="sortable text-center">Modifié <i class="ti ti-arrows-sort"></i></th>
                        <th data-field="enabled" class="sortable text-center">Statut <i class="ti ti-arrows-sort"></i></th>
                        <th class="text-center w-1">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {# Rempli par AJAX #}
                </tbody>
            </table>
        </div>
        <div class="card-footer d-flex align-items-center bg-white border-0">
            <p class="m-0 text-muted" id="total-count">Chargement...</p>
        </div>
    </div>
</div>

{# Modal de suppression — doit avoir id deleteModal et form id deleteForm pour le JS #}
<div class="modal modal-blur fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-status bg-danger"></div>
            <div class="modal-body text-center py-4">
                <i class="ti ti-alert-triangle text-danger mb-2" style="font-size: 2.5rem;"></i>
                <h3 class="mb-2">Supprimer ce quiz ?</h3>
                <p class="text-muted mb-0"><span id="deleteItemName"></span></p>
                <p class="text-muted small mt-1">Cette action est irréversible.</p>
            </div>
            <div class="modal-footer">
                <div class="w-100 row g-2">
                    <div class="col"><button type="button" class="btn w-100" data-bs-dismiss="modal">Annuler</button></div>
                    <div class="col">
                        <form method="post" action="" id="deleteForm" class="d-inline w-100">
                            <input type="hidden" name="_token" value="">
                            <button type="submit" class="btn btn-danger w-100"><i class="ti ti-trash me-1"></i> Supprimer</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    let sortField = 'id';
    let sortOrder = 'DESC';
    function escapeHtml(s) { const d = document.createElement('div'); d.textContent = s || ''; return d.innerHTML; }

    function fetchData() {
        const search = document.getElementById('search').value.trim();
        const status = document.getElementById('status-filter').value;
        const lessonId = document.getElementById('lesson-filter').value;
        const url = new URL('{{ path('quiz_ajax_list') }}', window.location.origin);
        url.searchParams.set('search', search);
        if (status) url.searchParams.set('status', status);
        if (lessonId) url.searchParams.set('lesson_id', lessonId);
        url.searchParams.set('sortField', sortField);
        url.searchParams.set('sortOrder', sortOrder);

        fetch(url)
            .then(response => response.json())
            .then(data => {
                const tbody = document.querySelector('#quiz-table tbody');
                tbody.innerHTML = '';
                
                if (data.quizzes.length === 0) {
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">
                                <i class="ti ti-mood-empty fs-1 mb-2"></i>
                                <p class="mb-0">Aucun quiz trouvé.</p>
                            </td>
                        </tr>
                    `;
                } else {
                    data.quizzes.forEach(quiz => {
                        const lessonCell = quiz.lessonTitle ? `<span class="badge bg-azure-lt">${escapeHtml(quiz.lessonTitle)}</span>` : '<span class="text-muted">—</span>';
                        const row = `
                            <tr>
                                <td class="text-muted">#${quiz.id}</td>
                                <td class="text-start">
                                    <div class="fw-bold text-dark">${escapeHtml(quiz.title)}</div>
                                    <div class="text-muted small">Créé le ${escapeHtml(quiz.createdAt)}</div>
                                </td>
                                <td class="text-start">${lessonCell}</td>
                                <td class="text-center">
                                    <a href="${quiz.exercisesUrl}" class="badge bg-blue-lt text-reset text-decoration-none">${quiz.exerciseCount} exercice(s)</a>
                                </td>
                                <td class="text-center text-muted">${escapeHtml(quiz.updatedAt)}</td>
                                <td class="text-center">
                                    <div class="form-check form-switch justify-content-center d-flex">
                                        <input class="form-check-input toggle-status" type="checkbox" data-url="${quiz.toggleUrl}" ${quiz.enabled ? 'checked' : ''}>
                                    </div>
                                </td>
                                <td class="text-center">
                                    <div class="btn-list justify-content-center">
                                        <a href="${quiz.showUrl}" class="btn btn-icon btn-outline-info" title="Voir"><i class="ti ti-eye"></i></a>
                                        <a href="${quiz.editUrl}" class="btn btn-icon btn-outline-primary" title="Modifier"><i class="ti ti-edit"></i></a>
                                        <button type="button" class="btn btn-icon btn-outline-danger delete-btn" title="Supprimer" data-bs-toggle="modal" data-bs-target="#deleteModal" data-delete-url="${quiz.deleteUrl}" data-delete-token="${escapeHtml(quiz.deleteToken || '')}" data-item-name="${escapeHtml(quiz.title)}"><i class="ti ti-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        `;
                        tbody.insertAdjacentHTML('beforeend', row);
                    });
                }
                document.getElementById('total-count').textContent = `${data.total} quiz au total`;
                attachEventListeners();
            });
    }

    function attachEventListeners() {
        // Toggle Status
        document.querySelectorAll('.toggle-status').forEach(checkbox => {
            checkbox.addEventListener('change', function() {
                fetch(this.dataset.url, { method: 'POST' })
                    .then(response => response.json())
                    .then(data => {
                        if (!data.success) {
                            this.checked = !this.checked;
                            alert('Erreur lors du changement de statut');
                        }
                    });
            });
        });

        // Delete Button Modal
        document.querySelectorAll('.delete-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                const modal = document.getElementById('deleteModal');
                const form = document.getElementById('deleteForm');
                const itemName = document.getElementById('deleteItemName');
                const tokenInput = form ? form.querySelector('input[name="_token"]') : null;
                if (form) form.action = this.dataset.deleteUrl || '';
                if (itemName) itemName.textContent = this.dataset.itemName || '';
                if (tokenInput && this.dataset.deleteToken) tokenInput.value = this.dataset.deleteToken;
            });
        });
    }

    // Search input
    let timeout = null;
    document.getElementById('search').addEventListener('input', () => {
        clearTimeout(timeout);
        timeout = setTimeout(fetchData, 300);
    });

    document.getElementById('status-filter').addEventListener('change', fetchData);
    document.getElementById('lesson-filter').addEventListener('change', fetchData);
    document.getElementById('reset-filters').addEventListener('click', () => {
        document.getElementById('search').value = '';
        document.getElementById('status-filter').value = '';
        document.getElementById('lesson-filter').value = '';
        fetchData();
    });

    // Sorting
    document.querySelectorAll('.sortable').forEach(th => {
        th.addEventListener('click', () => {
            const field = th.dataset.field;
            if (sortField === field) {
                sortOrder = sortOrder === 'ASC' ? 'DESC' : 'ASC';
            } else {
                sortField = field;
                sortOrder = 'ASC';
            }
            
            // Update icons
            document.querySelectorAll('.sortable i').forEach(icon => {
                icon.className = 'ti ti-arrows-sort';
            });
            const icon = th.querySelector('i');
            icon.className = sortOrder === 'ASC' ? 'ti ti-sort-ascending' : 'ti ti-sort-descending';
            
            fetchData();
        });
    });

    // Initial fetch
    fetchData();
});
</script>
{% endblock %}
