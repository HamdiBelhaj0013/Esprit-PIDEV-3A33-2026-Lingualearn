{# templates/exercises_quizzes/quiz/edit.html.twig #}
{% extends 'layouts/admin.html.twig' %}

{% block title %}Modifier le quiz — {{ quiz.title }}{% endblock %}
{% block page_title %}Modifier le quiz{% endblock %}

{% block breadcrumb %}
<ol class="breadcrumb breadcrumb-arrows" aria-label="breadcrumbs">
    <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
    <li class="breadcrumb-item"><a href="{{ path('quiz_index') }}">Quiz</a></li>
    <li class="breadcrumb-item"><a href="{{ path('quiz_show', { id: quiz.id }) }}">{{ quiz.title }}</a></li>
    <li class="breadcrumb-item active" aria-current="page">Modifier</li>
</ol>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('exercises_quizzes/_eq_styles.html.twig') }}
{% endblock %}

{% block content %}
<div class="eq-page-wrap">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">
            <div class="card eq-card shadow-sm">

                <div class="card-header">
                    <h3 class="card-title"><i class="ti ti-edit me-2"></i>{{ quiz.title }}</h3>
                </div>

                {{ form_start(form, { attr: { class: 'eq-quiz-form eq-form' } }) }}

                <div class="card-body">
                    <div class="mb-4">
                        <div class="eq-section-title">Contexte</div>
                        {{ form_row(form.lesson, { label: 'Leçon associée', attr: { class: 'form-select' } }) }}
                    </div>

                    <div class="mb-4">
                        <div class="eq-section-title">Informations générales</div>
                        {{ form_row(form.title, { attr: { class: 'form-control' } }) }}
                        {{ form_row(form.description, { attr: { class: 'form-control', rows: 3 } }) }}
                    </div>

                    <div class="mb-4">
                        <div class="eq-section-title">Paramètres</div>
                        <div class="row g-3">
                            <div class="col-md-6">{{ form_row(form.passingScore, { attr: { class: 'form-control' } }) }}</div>
                            <div class="col-md-6">{{ form_row(form.questionCount, { attr: { class: 'form-control' } }) }}</div>
                        </div>
                        <div class="row g-3 mt-2">
                            <div class="col-md-6">{{ form_row(form.difficulty, { attr: { class: 'form-select' } }) }}</div>
                            <div class="col-12">{{ form_row(form.skillCodesText, { attr: { class: 'form-control', rows: 3 } }) }}</div>
                        </div>
                    </div>

                    <div class="mb-0">
                        <div class="eq-section-title">Statut</div>
                        {{ form_row(form.enabled, { row_attr: { class: 'mb-0' } }) }}
                    </div>
                </div>

                <div class="card-footer d-flex justify-content-center justify-content-md-end gap-2 flex-wrap">
                    <a href="{{ path('quiz_show', { id: quiz.id }) }}" class="btn eq-btn eq-btn-outline">
                        <i class="ti ti-arrow-left me-1"></i> Annuler
                    </a>
                    <button type="submit" class="btn eq-btn eq-btn-primary">
                        <i class="ti ti-device-floppy me-1"></i> Enregistrer
                    </button>
                </div>

                {{ form_end(form) }}

            </div>
        </div>
    </div>
</div>
{% endblock %}
