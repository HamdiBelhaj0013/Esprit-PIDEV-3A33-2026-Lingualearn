{# templates/exercises_quizzes/exercice/_form.html.twig #}
{% extends 'layouts/admin.html.twig' %}

{% block title %}{{ is_edit ? 'Modifier' : 'Créer' }} un Exercice{% endblock %}

{% block content %}
<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-forms me-2"></i>
                    {{ is_edit ? 'Modifier l\'exercice' : 'Nouvel exercice' }}
                </h3>
            </div>

            {{ form_start(form) }}
            <div class="card-body">
                <div class="mb-3">
                    {{ form_label(form.type, 'Type d\'exercice', {'label_attr': {'class': 'form-label required'}}) }}
                    {{ form_widget(form.type, {'attr': {'class': 'form-control', 'placeholder': 'Ex: QCM, Vrai/Faux, Texte à trous'}}) }}
                    {{ form_errors(form.type) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.question, 'Question', {'label_attr': {'class': 'form-label required'}}) }}
                    {{ form_widget(form.question, {'attr': {'class': 'form-control', 'rows': 4, 'placeholder': 'Saisissez la question ici...'}}) }}
                    {{ form_errors(form.question) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.options, 'Options de réponse', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.options, {'attr': {'class': 'form-control', 'rows': 6}}) }}
                    {{ form_errors(form.options) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.correctAnswer, 'Réponse correcte', {'label_attr': {'class': 'form-label required'}}) }}
                    {{ form_widget(form.correctAnswer, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.correctAnswer) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.aiGenerated, 'Généré par IA', {'label_attr': {'class': 'form-label'}}) }}
                    {{ form_widget(form.aiGenerated, {'attr': {'class': 'form-select'}}) }}
                    {{ form_errors(form.aiGenerated) }}
                </div>
            </div>

            <div class="card-footer bg-transparent">
                <div class="btn-list justify-content-end">
                    <a href="{{ path('exercice_index') }}" class="btn btn-outline-secondary">
                        <i class="ti ti-arrow-left me-2"></i>Annuler
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="ti ti-device-floppy me-2"></i>
                        {{ is_edit ? 'Mettre à jour' : 'Créer l\'exercice' }}
                    </button>
                </div>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}

