
{# templates/exercises_quizzes/exercice/_form.html.twig #}
{# Fragment uniquement : utilisé dans les pages admin qui étendent déjà layouts/admin.html.twig #}
<div class="row justify-content-center">
    <div class="col-12 col-lg-9">
        <div class="card eq-card shadow-sm">

            <div class="card-header">
                <h3 class="card-title mb-0">
                    <i class="ti ti-forms me-2"></i>
                    {{ is_edit ? 'Modifier l\'exercice' : 'Nouvel exercice' }}
                </h3>
            </div>

            {{ form_errors(form) }}{{ form_start(form, { attr: { class: 'eq-form' } }) }}
            <div class="card-body">
                <div class="mb-4">
                    <div class="eq-section-title">Contexte</div>
                    <div class="mb-3">
                        {{ form_label(form.quiz, null, { label_attr: { class: 'form-label required' } }) }}
                        {{ form_widget(form.quiz, { attr: { class: 'form-select' } }) }}
                        {{ form_errors(form.quiz) }}
                    </div>
                </div>

                <div class="mb-4">
                    <div class="eq-section-title">Type & énoncé</div>
                    <div class="mb-3">
                        {{ form_label(form.type, null, { label_attr: { class: 'form-label required' } }) }}
                        {{ form_widget(form.type, { attr: { class: 'form-select' } }) }}
                        {{ form_errors(form.type) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.question, null, { label_attr: { class: 'form-label required' } }) }}
                        {{ form_widget(form.question, { attr: { class: 'form-control', rows: 4, placeholder: 'Saisissez la question...' } }) }}
                        {{ form_errors(form.question) }}
                    </div>
                </div>

                <div class="mb-4">
                    <div class="eq-section-title">Réponses</div>
                    <div class="mb-3">
                        {{ form_label(form.optionsText, null, { label_attr: { class: 'form-label' } }) }}
                        {{ form_widget(form.optionsText, { attr: { class: 'form-control font-monospace', rows: 5, placeholder: "Une option par ligne\nOption 1\nOption 2" } }) }}
                        {{ form_help(form.optionsText) }}
                        {{ form_errors(form.optionsText) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.correctAnswer, null, { label_attr: { class: 'form-label required' } }) }}
                        {{ form_widget(form.correctAnswer, { attr: { class: 'form-control', placeholder: 'La bonne réponse (doit figurer dans les options)' } }) }}
                        {{ form_errors(form.correctAnswer) }}
                    </div>
                </div>

                <div class="mb-4">
                    <div class="eq-section-title">Compétences & difficulté</div>
                    <div class="mb-3">
                        {{ form_label(form.difficulty, null, { label_attr: { class: 'form-label' } }) }}
                        {{ form_widget(form.difficulty, { attr: { class: 'form-select' } }) }}
                        {{ form_help(form.difficulty) }}
                        {{ form_errors(form.difficulty) }}
                    </div>
                    <div class="mb-3">
                        {{ form_label(form.skillCodesText, null, { label_attr: { class: 'form-label' } }) }}
                        {{ form_widget(form.skillCodesText, { attr: { class: 'form-control font-monospace', rows: 3, placeholder: "grammar\nvocab\nlistening" } }) }}
                        {{ form_help(form.skillCodesText) }}
                        {{ form_errors(form.skillCodesText) }}
                    </div>
                </div>

                <div class="mb-0">
                    <div class="eq-section-title">Métadonnées</div>
                    <div class="mb-3">
                        {{ form_label(form.enabled, null, { label_attr: { class: 'form-label' } }) }}
                        {{ form_widget(form.enabled, { attr: { class: 'form-select' } }) }}
                        {{ form_help(form.enabled) }}
                        {{ form_errors(form.enabled) }}
                    </div>
                    <div class="mb-0">
                        {{ form_label(form.aiGenerated, null, { label_attr: { class: 'form-label' } }) }}
                        {{ form_widget(form.aiGenerated, { attr: { class: 'form-select' } }) }}
                        {{ form_errors(form.aiGenerated) }}
                    </div>
                </div>
            </div>

            <div class="card-footer d-flex justify-content-center justify-content-md-end gap-2 flex-wrap">
                <a href="{{ path('exercice_index') }}" class="btn eq-btn eq-btn-outline">
                    <i class="ti ti-arrow-left me-1"></i> Annuler
                </a>
                <button type="submit" class="btn eq-btn eq-btn-primary">
                    <i class="ti ti-device-floppy me-1"></i>
                    {{ is_edit ? 'Enregistrer' : 'Créer l\'exercice' }}
                </button>
            </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
