{% extends 'admin/base_html.twig' %}

{% block title %}Exercice #{{ exercice.id }}{% endblock %}

{% block page_title %}
    <i class="ti ti-puzzle me-2"></i>
    Détails de l'exercice #{{ exercice.id }}
{% endblock %}

{% block page_actions %}
    <div class="col-auto ms-auto">
        <div class="btn-list">
            <a href="{{ path('exercice_index') }}" class="btn btn-outline-secondary">
                <i class="ti ti-arrow-left me-2"></i>
                Retour à la liste
            </a>
            <a href="{{ path('exercice_edit', {'id': exercice.id}) }}" class="btn btn-primary">
                <i class="ti ti-edit me-2"></i>
                Modifier
            </a>
            <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
                <i class="ti ti-trash me-2"></i>
                Supprimer
            </button>
        </div>
    </div>
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-lg-8 mx-auto">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-info-circle me-2"></i>
                    Informations de l'exercice
                </h3>
            </div>
            <div class="card-body">
                <div class="datagrid">
                    <div class="datagrid-item">
                        <div class="datagrid-title">ID</div>
                        <div class="datagrid-content">
                            <span class="badge bg-secondary-lt">#{{ exercice.id }}</span>
                        </div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Type</div>
                        <div class="datagrid-content">
                            <span class="badge bg-primary-lt">{{ exercice.type }}</span>
                        </div>
                    </div>
                    <div class="datagrid-item">
                        <div class="datagrid-title">Généré par IA</div>
                        <div class="datagrid-content">
                            {% if exercice.aiGenerated %}
                                <span class="badge bg-info-lt">
                                    <i class="ti ti-robot me-1"></i>
                                    Oui
                                </span>
                            {% else %}
                                <span class="badge bg-secondary-lt">
                                    <i class="ti ti-user me-1"></i>
                                    Non
                                </span>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-help me-2"></i>
                    Question
                </h3>
            </div>
            <div class="card-body">
                <div class="markdown">
                    {{ exercice.question }}
                </div>
            </div>
        </div>

        {% if exercice.options is not empty %}
        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-list me-2"></i>
                    Options de réponse
                </h3>
            </div>
            <div class="list-group list-group-flush">
                {% for option in exercice.options %}
                    <div class="list-group-item">
                        <div class="row align-items-center">
                            <div class="col-auto">
                                <span class="badge bg-azure-lt">{{ loop.index }}</span>
                            </div>
                            <div class="col text-truncate">
                                {{ option }}
                            </div>
                            {% if option == exercice.correctAnswer %}
                            <div class="col-auto">
                                <span class="badge bg-success">
                                    <i class="ti ti-check me-1"></i>
                                    Correcte
                                </span>
                            </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
        {% endif %}

        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-circle-check me-2"></i>
                    Réponse correcte
                </h3>
            </div>
            <div class="card-body">
                <div class="alert alert-success mb-0">
                    <div class="d-flex">
                        <div>
                            <i class="ti ti-check icon alert-icon"></i>
                        </div>
                        <div>
                            <strong>{{ exercice.correctAnswer }}</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{# Delete Modal #}
<div class="modal modal-blur fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-status bg-danger"></div>
            <div class="modal-body text-center py-4">
                <i class="ti ti-alert-triangle icon mb-2 text-danger icon-lg"></i>
                <h3>Êtes-vous sûr ?</h3>
                <div class="text-muted">Voulez-vous vraiment supprimer cet exercice ? Cette action est irréversible.</div>
            </div>
            <div class="modal-footer">
                <div class="w-100">
                    <div class="row">
                        <div class="col">
                            <button type="button" class="btn w-100" data-bs-dismiss="modal">
                                Annuler
                            </button>
                        </div>
                        <div class="col">
                            <form action="{{ path('exercice_delete', {'id': exercice.id}) }}" method="POST">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ exercice.id) }}">
                                <button type="submit" class="btn btn-danger w-100">
                                    Supprimer
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
