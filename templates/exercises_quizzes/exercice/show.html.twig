{% extends 'layouts/admin.html.twig' %}

{% block title %}Exercice #{{ exercice.id }}{% endblock %}
{% block page_title %}<i class="ti ti-puzzle me-2"></i>Exercice #{{ exercice.id }}{% endblock %}

{% block page_actions %}
<div class="col-auto ms-auto">
    <div class="btn-list">
        <a href="{{ path('exercice_index') }}" class="btn eq-btn eq-btn-outline">
            <i class="ti ti-arrow-left me-1"></i> Liste
        </a>
        <a href="{{ path('exercice_edit', {'id': exercice.id}) }}" class="btn eq-btn eq-btn-primary">
            <i class="ti ti-edit me-1"></i> Modifier
        </a>
        <button type="button" class="btn btn-danger eq-btn eq-btn-danger" data-bs-toggle="modal" data-bs-target="#deleteModal">
            <i class="ti ti-trash me-1"></i> Supprimer
        </button>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    {{ include('exercises_quizzes/_eq_styles.html.twig') }}
{% endblock %}

{% block content %}
<div class="eq-page-wrap">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-9">

            <div class="card eq-card mb-3">
                <div class="card-header">
                    <h3 class="card-title"><i class="ti ti-info-circle me-2"></i>Informations</h3>
                </div>
                <div class="card-body">
                    <div class="datagrid eq-datagrid">
                        <div class="datagrid-item">
                            <div class="datagrid-title">ID</div>
                            <div class="datagrid-content">
                                <span class="badge eq-badge bg-secondary-lt">#{{ exercice.id }}</span>
                            </div>
                        </div>

                        <div class="datagrid-item">
                            <div class="datagrid-title">Quiz</div>
                            <div class="datagrid-content">
                                {% if exercice.quiz %}
                                    <a href="{{ path('quiz_show', { id: exercice.quiz.id }) }}" class="text-primary fw-semibold">
                                        {{ exercice.quiz.title }}
                                    </a>
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="datagrid-item">
                            <div class="datagrid-title">Type</div>
                            <div class="datagrid-content">
                                <span class="badge eq-badge bg-primary-lt text-primary">{{ exercice.type }}</span>
                            </div>
                        </div>

                        <div class="datagrid-item">
                            <div class="datagrid-title">Difficulté</div>
                            <div class="datagrid-content">
                                <span class="badge eq-badge bg-azure-lt text-dark">{{ exercice.difficulty }}/5</span>
                            </div>
                        </div>

                        <div class="datagrid-item">
                            <div class="datagrid-title">Compétences</div>
                            <div class="datagrid-content">
                                {% if exercice.skillCodes is not empty %}
                                    {% for code in exercice.skillCodes %}
                                        <span class="badge eq-badge bg-success-lt text-success me-1">{{ code }}</span>
                                    {% endfor %}
                                {% else %}
                                    <span class="text-muted">—</span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="datagrid-item">
                            <div class="datagrid-title">Activé</div>
                            <div class="datagrid-content">
                                {% if exercice.enabled %}
                                    <span class="badge eq-badge bg-success-lt text-success"><i class="ti ti-check me-1"></i> Oui</span>
                                {% else %}
                                    <span class="badge eq-badge bg-warning-lt text-warning"><i class="ti ti-x me-1"></i> Non</span>
                                {% endif %}
                            </div>
                        </div>

                        <div class="datagrid-item">
                            <div class="datagrid-title">Généré par IA</div>
                            <div class="datagrid-content">
                                {% if exercice.aiGenerated %}
                                    <span class="badge eq-badge bg-info-lt text-info"><i class="ti ti-robot me-1"></i> Oui</span>
                                {% else %}
                                    <span class="badge eq-badge bg-secondary-lt text-muted"><i class="ti ti-user me-1"></i> Non</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card eq-card mb-3">
                <div class="card-header">
                    <h3 class="card-title"><i class="ti ti-help me-2"></i>Question</h3>
                </div>
                <div class="card-body">
                    <p class="mb-0 fs-5 text-dark lh-base">{{ exercice.question }}</p>
                </div>
            </div>

            {% if exercice.options is not empty %}
                <div class="card eq-card mb-3">
                    <div class="card-header">
                        <h3 class="card-title"><i class="ti ti-list me-2"></i>Options</h3>
                    </div>
                    <div class="list-group list-group-flush">
                        {% for option in exercice.options %}
                            <div class="list-group-item d-flex align-items-center eq-list-item">
                                <span class="badge eq-badge bg-azure-lt me-2">{{ loop.index }}</span>
                                <span class="flex-grow-1">{{ option }}</span>
                                {% if option == exercice.correctAnswer %}
                                    <span class="badge eq-badge bg-success-lt text-success"><i class="ti ti-check me-1"></i> Correcte</span>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            <div class="card eq-card">
                <div class="card-header">
                    <h3 class="card-title"><i class="ti ti-circle-check me-2"></i>Réponse correcte</h3>
                </div>
                <div class="card-body">
                    <div class="alert alert-success mb-0 d-flex align-items-center py-3">
                        <i class="ti ti-check me-2 fs-3"></i>
                        <strong class="fs-5">{{ exercice.correctAnswer }}</strong>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

{# Modal suppression #}
<div class="modal modal-blur fade" id="deleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
            <div class="modal-status bg-danger"></div>
            <div class="modal-body text-center py-4">
                <i class="ti ti-alert-triangle text-danger mb-2" style="font-size: 3rem;"></i>
                <h3>Supprimer cet exercice ?</h3>
                <p class="text-muted mb-0">Cette action est irréversible.</p>
            </div>
            <div class="modal-footer">
                <div class="w-100 row g-2">
                    <div class="col"><button type="button" class="btn w-100" data-bs-dismiss="modal">Annuler</button></div>
                    <div class="col">
                        <form action="{{ path('exercice_delete', {'id': exercice.id}) }}" method="POST" class="d-inline w-100">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ exercice.id) }}">
                            <button type="submit" class="btn btn-danger w-100"><i class="ti ti-trash me-1"></i> Supprimer</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}