{% extends 'layouts/user.html.twig' %}

{% block title %}{{ is_edit ? 'Modifier la planification' : 'Planifier un quiz' }}{% endblock %}
{% block page_title %}{{ is_edit ? 'Modifier la planification' : 'Planifier un quiz' }}{% endblock %}

{% block content %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h2 class="card-title mb-0 h5">
                        <i class="ti ti-calendar-event me-2"></i>
                        {{ quiz.title }}
                    </h2>
                    <p class="text-muted small mb-0 mt-1">Leçon : {{ lesson.title }}</p>
                    <p class="text-primary small mb-0 mt-2">Choisissez la date et l'heure de révision. Vous pourrez modifier ou annuler depuis la liste des quiz.</p>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                    {{ form_row(form.scheduledAt, { label: 'Date et heure' }) }}
                    {{ form_row(form.note, { label: 'Note (optionnel)' }) }}
                    <div class="d-flex gap-2 mt-3">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-device-floppy me-1"></i>
                            {{ is_edit ? 'Enregistrer' : 'Planifier' }}
                        </button>
                        <a href="{{ path('learn_practice') }}" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
