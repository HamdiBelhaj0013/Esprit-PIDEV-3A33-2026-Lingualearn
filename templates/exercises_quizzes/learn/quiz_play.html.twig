                    <div class="d-flex gap-2">
                        <a href="{{ path('learn_practice') }}" class="btn btn-ghost-secondary btn-sm">
                            <i class="ti ti-arrow-left me-1"></i> Retour aux quiz
                        </a>
                        <a href="{{ path('lesson_show', { id: lesson.id }) }}" class="btn btn-ghost-secondary btn-sm">
                            Voir la leçon
                        </a>
                    </div>
                </div>
                {% if quiz.description %}
                    <p class="mb-0 mt-2 text-muted small">{{ quiz.description }}</p>
                {% endif %}
                <p class="mb-0 mt-1 small"><strong>{{ exercices|length }}</strong> question(s) — Score minimum pour réussir : <strong>{{ quiz.passingScore }} %</strong></p>
            </div>
            <div class="card-body">
                <form method="post" action="{{ path('learn_lesson_quiz_submit', { id: lesson.id }) }}" class="eq-form">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('learn_quiz_submit') }}">
                    {% for exercice in exercices %}
                        <div class="eq-exercice-block">
                            <p class="fw-bold text-dark mb-3"><span class="text-primary">Q{{ loop.index }}.</span> {{ exercice.question }}</p>
