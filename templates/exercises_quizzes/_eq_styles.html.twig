{# Design system Exercices & Quiz — couleurs, typo, structure, boutons #}
<style>
    :root {
        --eq-primary: #206bc4;
        --eq-primary-hover: #1a5aa0;
        --eq-primary-lt: #e8f1fc;
        --eq-success: #2fb344;
        --eq-success-lt: #e8f7eb;
        --eq-danger: #d63939;
        --eq-danger-hover: #b82e2e;
        --eq-radius: 12px;
        --eq-radius-sm: 8px;
        --eq-shadow: 0 1px 3px rgba(0,0,0,.06);
        --eq-shadow-hover: 0 4px 12px rgba(0,0,0,.08);
        --eq-transition: 0.2s ease;
    }
    .eq-page-wrap { max-width: 900px; margin: 0 auto; }
    .eq-card {
        border-radius: var(--eq-radius);
        box-shadow: var(--eq-shadow);
        border: 0;
        overflow: hidden;
    }
    .eq-card .card-header {
        background: linear-gradient(135deg, var(--eq-primary-lt) 0%, #f0f4f8 100%);
        border-bottom: 1px solid rgba(32, 107, 196, 0.12);
        padding: 1rem 1.25rem;
        font-weight: 600;
        color: #1e293b;
        letter-spacing: -0.01em;
    }
    .eq-card .card-header .card-title { margin: 0; font-size: 1.1rem; }
    .eq-card .card-body { padding: 1.25rem 1.5rem; }
    .eq-card .card-footer {
        background: #fafbfc;
        border-top: 1px solid #eaeef2;
        padding: 1rem 1.5rem;
    }
    .eq-section-title {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--eq-primary);
        margin-bottom: 0.75rem;
        padding-bottom: 0.35rem;
        border-bottom: 2px solid var(--eq-primary-lt);
    }
    .eq-form .form-label { font-weight: 600; color: #334155; }
    .eq-form .form-control, .eq-form .form-select {
        border-radius: var(--eq-radius-sm);
        border-color: #e2e8f0;
        transition: var(--eq-transition);
    }
    .eq-form .form-control:focus, .eq-form .form-select:focus {
        border-color: var(--eq-primary);
        box-shadow: 0 0 0 3px rgba(32, 107, 196, 0.15);
    }
    .eq-btn {
        border-radius: var(--eq-radius-sm);
        font-weight: 600;
        padding: 0.5rem 1rem;
        transition: var(--eq-transition);
    }
    .eq-btn-primary {
        background: var(--eq-primary);
        border-color: var(--eq-primary);
        color: #fff;
    }
    .eq-btn-primary:hover {
        background: var(--eq-primary-hover);
        border-color: var(--eq-primary-hover);
        color: #fff;
        transform: translateY(-1px);
        box-shadow: var(--eq-shadow-hover);
    }
    .eq-btn-outline {
        border: 2px solid #e2e8f0;
        color: #475569;
        background: #fff;
    }
    .eq-btn-outline:hover {
        border-color: var(--eq-primary);
        color: var(--eq-primary);
        background: var(--eq-primary-lt);
    }
    .eq-btn-danger:hover {
        background: var(--eq-danger-hover);
        border-color: var(--eq-danger-hover);
        transform: translateY(-1px);
    }
    .eq-datagrid .datagrid-title { font-weight: 600; color: #64748b; }
    .eq-datagrid .datagrid-content { color: #1e293b; }
    .eq-list-item:hover { background: var(--eq-primary-lt); }
    .eq-badge { border-radius: 6px; font-weight: 600; }
    .eq-page-title {
        text-align: center;
        font-weight: 700;
        color: #1e293b;
        margin-bottom: 1.5rem;
        font-size: 1.5rem;
    }
    /* Listes (index) */
    .eq-index-card { border-radius: var(--eq-radius); box-shadow: var(--eq-shadow); border: 0; }
    .eq-index-card .card-header {
        background: linear-gradient(135deg, var(--eq-primary-lt) 0%, #f8fafc 100%);
        border-bottom: 1px solid rgba(32, 107, 196, 0.1);
        padding: 1rem 1.25rem;
    }
    .eq-index-card .card-footer { background: #fafbfc; border-top: 1px solid #eaeef2; }
    .eq-btn-create {
        background: var(--eq-primary);
        border-color: var(--eq-primary);
        color: #fff;
        font-weight: 600;
        border-radius: var(--eq-radius-sm);
        padding: 0.5rem 1.25rem;
        transition: var(--eq-transition);
    }
    .eq-btn-create:hover {
        background: var(--eq-primary-hover);
        border-color: var(--eq-primary-hover);
        color: #fff;
        transform: translateY(-2px);
        box-shadow: var(--eq-shadow-hover);
    }
    .eq-table thead th {
        font-weight: 700;
        color: #64748b;
        background: #f8fafc;
        border-bottom: 2px solid #e2e8f0;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        font-size: 0.75rem;
    }
    .eq-table tbody tr { transition: var(--eq-transition); }
    .eq-table tbody tr:hover { background: var(--eq-primary-lt); }
    .eq-table .btn-icon {
        width: 2.25rem;
        height: 2.25rem;
        border-radius: var(--eq-radius-sm);
        transition: var(--eq-transition);
    }
    .eq-table .btn-icon:hover { transform: scale(1.08); }
    .eq-btn-reset {
        border-radius: var(--eq-radius-sm);
        font-weight: 500;
        color: #64748b;
        border: 1px solid #e2e8f0;
        background: #fff;
        transition: var(--eq-transition);
    }
    .eq-btn-reset:hover {
        color: var(--eq-primary);
        border-color: var(--eq-primary);
        background: var(--eq-primary-lt);
    }
</style>
