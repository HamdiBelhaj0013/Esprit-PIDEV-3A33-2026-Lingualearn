<div class="nav-item dropdown d-none d-md-flex me-3">
    <a href="#" class="nav-link px-0" data-bs-toggle="dropdown" tabindex="-1" aria-label="Show notifications">
        <i class="ti ti-bell" style="font-size: 1.25rem;"></i>
        {% if app.user and app.user.notifications|default([])|length > 0 %}
            <span class="badge bg-red badge-notification badge-blink"></span>
        {% endif %}
    </a>
    <div class="dropdown-menu dropdown-menu-arrow dropdown-menu-end dropdown-menu-card" style="width: 22rem; border-radius: 12px; border: 1px solid #e5e7eb;">
        <div class="card" style="border: none;">
            <div class="card-header d-flex align-items-center justify-content-between" style="border-bottom: 1px solid #f1f5f9;">
                <h3 class="card-title mb-0" style="font-weight: 700; font-size: 0.9375rem;">Notifications</h3>
                <a href="#" class="btn btn-sm btn-ghost-primary">Mark all read</a>
            </div>
            <div class="list-group list-group-flush list-group-hoverable" style="max-height: 320px; overflow-y: auto;">
                <div class="list-group-item">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <span class="status-dot bg-muted d-block"></span>
                        </div>
                        <div class="col text-truncate">
                            <span class="text-body d-block">No new notifications</span>
                            <div class="d-block text-muted text-truncate mt-n1 small">
                                You're all caught up!
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
