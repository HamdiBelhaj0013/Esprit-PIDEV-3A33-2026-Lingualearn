<div class="modal modal-blur fade" id="confirmDeleteModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-sm modal-dialog-centered" role="document">
        <div class="modal-content">
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            <div class="modal-status bg-danger"></div>
            <div class="modal-body text-center py-4">
                <i class="ti ti-alert-triangle icon mb-2 text-danger icon-lg"></i>
                <h3>Êtes-vous sûr?</h3>
                <div class="text-muted">Voulez-vous vraiment supprimer cet élément? Cette action est irréversible.</div>
            </div>
            <div class="modal-footer">
                <div class="w-100">
                    <div class="row">
                        <div class="col">
                            <button type="button" class="btn w-100" data-bs-dismiss="modal">
                                Annuler
                            </button>
                        </div>
                        <div class="col">
                            <button type="submit" class="btn btn-danger w-100" id="confirmDeleteButton">
                                Supprimer
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        var confirmDeleteModal = new bootstrap.Modal(document.getElementById('confirmDeleteModal'));
        var deleteButtons = document.querySelectorAll('[data-bs-toggle="modal"][data-bs-target="#confirmDeleteModal"]');

        deleteButtons.forEach(function(button) {
            button.addEventListener('click', function(e) {
                e.preventDefault();
                var formId = this.dataset.formId;
                var form = document.getElementById(formId);

                if (form) {
                    var confirmBtn = document.getElementById('confirmDeleteButton');
                    confirmBtn.onclick = function() {
                        form.submit();
                    };
                    confirmDeleteModal.show();
                }
            });
        });
    });
</script>