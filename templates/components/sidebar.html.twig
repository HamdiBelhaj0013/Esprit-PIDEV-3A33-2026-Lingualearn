{% set route = app.request.attributes.get('_route') %}

{# ─── Unread notifications count ─── #}
{% set unreadCount = 0 %}
{% if app.user is not null %}
    {% for n in app.user.notifications %}
        {% if not n.isRead %}{% set unreadCount = unreadCount + 1 %}{% endif %}
    {% endfor %}
{% endif %}

{# ─── OVERLAY ─── #}
<div class="sidebar-overlay" id="sidebarOverlay"></div>

{# ─── SIDEBAR ─── #}
<aside class="sidebar" id="sidebar">

    <a href="{{ path('app_homepage') }}" class="sidebar-logo">
        <div class="sidebar-logo-icon">L</div>
        <span class="sidebar-logo-text">Lingua<span>Learn</span></span>
    </a>

    {% if app.user %}
        <div class="sidebar-user">
            <div class="user-avatar {{ app.user.isPremium ? 'premium' : '' }}">
                {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
            </div>
            <div class="user-info">
                <div class="user-name">{{ app.user.firstName }} {{ app.user.lastName }}</div>
                <div class="user-plan {{ app.user.isPremium ? 'premium' : 'free' }}">
                    {{ app.user.isPremium ? '👑 ' ~ app.user.subscriptionPlan : 'Free Plan' }}
                </div>
            </div>
        </div>
    {% endif %}

    <nav class="sidebar-nav">

        <span class="nav-section-label">Main</span>

        <a href="{{ path('user_dashboard') }}"
           class="nav-item {{ route == 'user_dashboard' ? 'active' : '' }}">
            <span class="nav-icon">🏠</span> Dashboard
        </a>

        <a href="{{ path('language_select') }}"
           class="nav-item {{ route starts with 'language_' or route starts with 'course_' or route starts with 'lesson_' ? 'active' : '' }}">
            <span class="nav-icon">📚</span> My Courses
        </a>

        <a href="{{ path('learn_practice') }}"
           class="nav-item {{ route starts with 'learn_practice' or route == 'learn_skills_index' ? 'active' : '' }}">
            <span class="nav-icon">🧩</span> Practice
        </a>
        <a href="{{ path('ressources') }}" class="nav-item">
            <span class="nav-icon">💬</span> Forum
        </a>
        <a href="{{ path('app_user_faq_index') }}" class="nav-item active"><span class="nav-icon">❓</span> FAQ</a>
        <a href="{{ path('app_user_reclamation_index') }}" class="nav-item"><span class="nav-icon">💬</span> Mes réclamations</a>

        {% if app.user and app.user.isPremium %}
            <a href="{{ path('mock_tests_index') }}"
               class="nav-item {{ route starts with 'mock_tests' ? 'active' : '' }}">
                <span class="nav-icon">📝</span> Mock Tests
            </a>
        {% else %}
            <a href="{{ path('pricing') }}" class="nav-item nav-item-pro"
               title="Upgrade to access Mock Tests">
                <span class="nav-icon">📝</span> Mock Tests
                <span class="nav-badge nav-badge-gold">PRO</span>
            </a>
        {% endif %}

        <span class="nav-section-label">Account</span>

        <a href="{{ path('user_profile') }}"
           class="nav-item {{ route starts with 'user_profile' ? 'active' : '' }}">
            <span class="nav-icon">👤</span> My Profile
        </a>

        <a href="{{ path('app_user_notifications') }}"
           class="nav-item {{ route == 'app_user_notifications' ? 'active' : '' }}">
            <span class="nav-icon">🔔</span> Notifications
            {% if unreadCount > 0 %}
                <span class="nav-badge nav-badge-orange">{{ unreadCount }}</span>
            {% endif %}
        </a>


        <a href="{{ path('pricing') }}"
           class="nav-item {{ route == 'pricing' ? 'active' : '' }}">
            <span class="nav-icon">👑</span> Plans & Billing
        </a>

        {% if app.user and not app.user.isPremium %}
            <div class="sidebar-upgrade">
                <div class="sidebar-upgrade-label">✦ Go Premium</div>
                <p>Unlock all courses, mock tests & AI practice.</p>
                <a href="{{ path('pricing') }}" class="sidebar-upgrade-btn">Upgrade Now →</a>
            </div>
        {% endif %}

    </nav>

    <div class="sidebar-bottom">
        <a href="{{ path('app_logout') }}" class="nav-item nav-item-logout">
            <span class="nav-icon">🚪</span> Log Out
        </a>
    </div>

</aside>

{# ─── HAMBURGER (mobile) ─── #}
<button class="hamburger-btn" id="hamburgerBtn" aria-label="Toggle menu">
    <span></span><span></span><span></span>
</button>

<style>
    .sidebar-overlay {
        display: none;
        position: fixed; inset: 0;
        background: rgba(13,21,38,.4);
        z-index: 45;
        backdrop-filter: blur(2px);
    }
    .sidebar-overlay.visible { display: block; }

    .sidebar {
        position: fixed;
        top: 0; left: 0; bottom: 0;
        width: 260px;
        background: #ffffff;
        border-right: 1px solid #e2e8f2;
        display: flex; flex-direction: column;
        z-index: 50;
        transition: transform .3s ease;
        overflow-y: auto; overflow-x: hidden;
        scrollbar-width: thin;
        scrollbar-color: #e2e8f2 transparent;
    }

    .sidebar-logo {
        padding: 1.4rem 1.5rem;
        border-bottom: 1px solid #e2e8f2;
        display: flex; align-items: center; gap: .75rem;
        text-decoration: none; flex-shrink: 0;
    }
    .sidebar-logo:hover { text-decoration: none; }
    .sidebar-logo-icon {
        width: 34px; height: 34px; border-radius: 10px;
        background: linear-gradient(135deg, #2563eb, #3b82f6);
        display: flex; align-items: center; justify-content: center;
        font-family: 'Fraunces', serif; font-size: 1rem; font-weight: 400;
        color: #fff; flex-shrink: 0;
    }
    .sidebar-logo-text {
        font-family: 'Fraunces', serif; font-size: 1.3rem; font-weight: 400;
        color: #0d1526; letter-spacing: -.01em;
    }
    .sidebar-logo-text span { color: #2563eb; }

    .sidebar-user {
        padding: 1.1rem 1.5rem;
        border-bottom: 1px solid #e2e8f2;
        display: flex; align-items: center; gap: .85rem;
        flex-shrink: 0;
    }
    .user-avatar {
        width: 40px; height: 40px; border-radius: 50%;
        background: linear-gradient(135deg, #2563eb, #3b82f6);
        display: flex; align-items: center; justify-content: center;
        font-family: 'Fraunces', serif; font-size: 1rem; font-weight: 400;
        color: #fff; flex-shrink: 0;
    }
    .user-avatar.premium { background: linear-gradient(135deg, #ca8a04, #fbbf24); }
    .user-info { flex: 1; min-width: 0; }
    .user-name {
        font-size: .85rem; font-weight: 600; color: #0d1526;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .user-plan {
        font-size: .68rem; font-family: 'DM Mono', monospace;
        letter-spacing: .08em; text-transform: uppercase; margin-top: .15rem;
    }
    .user-plan.free    { color: #7a87a0; }
    .user-plan.premium { color: #ca8a04; }

    .sidebar-nav { flex: 1; padding: .75rem 0; overflow-y: auto; }

    .nav-section-label {
        font-family: 'DM Mono', monospace; font-size: .58rem;
        letter-spacing: .22em; text-transform: uppercase;
        color: #7a87a0; padding: .85rem 1.5rem .3rem; display: block;
    }

    .nav-item {
        display: flex; align-items: center; gap: .75rem;
        padding: .62rem 1.5rem;
        font-size: .84rem; font-weight: 500;
        color: #7a87a0; text-decoration: none;
        transition: color .2s, background .2s;
        position: relative;
    }
    .nav-item:hover { color: #0d1526; background: #f7f9fc; text-decoration: none; }
    .nav-item.active { color: #2563eb; background: #eff6ff; font-weight: 600; }
    .nav-item.active::before {
        content: ''; position: absolute;
        left: 0; top: 4px; bottom: 4px;
        width: 3px; background: #2563eb; border-radius: 0 3px 3px 0;
    }
    .nav-icon { font-size: 1.05rem; width: 20px; text-align: center; flex-shrink: 0; }

    .nav-item-pro { opacity: .75; }
    .nav-item-pro:hover { opacity: 1; }

    .nav-item-logout { color: #dc2626; }
    .nav-item-logout:hover { color: #dc2626; background: #fef2f2; }

    .nav-badge {
        margin-left: auto; padding: .15rem .5rem; border-radius: 100px;
        font-size: .6rem; font-weight: 700;
        font-family: 'DM Mono', monospace;
        background: #2563eb; color: #fff; flex-shrink: 0;
    }
    .nav-badge-gold   { background: #ca8a04; color: #fff; }
    .nav-badge-orange { background: #ea580c; color: #fff; }

    .sidebar-upgrade {
        margin: .75rem 1rem;
        background: linear-gradient(135deg, #fefce8, #fff9c3);
        border: 1.5px solid rgba(202,138,4,.2);
        border-radius: 12px; padding: .9rem 1rem;
    }
    .sidebar-upgrade-label {
        font-size: .68rem; font-family: 'DM Mono', monospace;
        letter-spacing: .1em; text-transform: uppercase;
        color: #ca8a04; margin-bottom: .35rem;
    }
    .sidebar-upgrade p { font-size: .75rem; color: #92400e; line-height: 1.5; margin: 0 0 .6rem; }
    .sidebar-upgrade-btn {
        display: block; text-align: center; padding: .45rem .75rem; border-radius: 8px;
        background: linear-gradient(135deg, #ca8a04, #fbbf24);
        color: #fff; font-size: .75rem; font-weight: 700;
        text-decoration: none; transition: opacity .2s, transform .2s;
    }
    .sidebar-upgrade-btn:hover { opacity: .9; transform: translateY(-1px); color: #fff; text-decoration: none; }

    .sidebar-bottom { padding: .75rem 0; border-top: 1px solid #e2e8f2; flex-shrink: 0; }

    .hamburger-btn {
        display: none;
        position: fixed; top: .85rem; left: 1rem; z-index: 60;
        width: 38px; height: 38px; border-radius: 12px;
        border: 1.5px solid #e2e8f2; background: #fff;
        align-items: center; justify-content: center;
        flex-direction: column; gap: 4px; cursor: pointer;
        box-shadow: 0 2px 8px rgba(13,21,38,.08);
    }
    .hamburger-btn span { width: 16px; height: 1.5px; background: #0d1526; display: block; border-radius: 2px; }

    @media (max-width: 768px) {
        .sidebar { transform: translateX(-260px); }
        .sidebar.open { transform: translateX(0); box-shadow: 4px 0 24px rgba(13,21,38,.12); }
        .hamburger-btn { display: flex; }
    }
</style>

<script>
    (function () {
        const sidebar   = document.getElementById('sidebar');
        const overlay   = document.getElementById('sidebarOverlay');
        const hamburger = document.getElementById('hamburgerBtn');
        function open()  { sidebar.classList.add('open');    overlay.classList.add('visible');    }
        function close() { sidebar.classList.remove('open'); overlay.classList.remove('visible'); }
        hamburger?.addEventListener('click', () => sidebar.classList.contains('open') ? close() : open());
        overlay?.addEventListener('click', close);
        document.addEventListener('keydown', e => { if (e.key === 'Escape') close(); });
    })();
</script>
