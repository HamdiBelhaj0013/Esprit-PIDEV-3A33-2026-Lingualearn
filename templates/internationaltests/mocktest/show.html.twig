{% extends 'layouts/admin.html.twig' %}

{% block title %}{{ mockTest.title }} - {{ parent() }}{% endblock %}

{% block page_title %}
    <i class="ti ti-file-text me-2"></i> {{ mockTest.title }}
{% endblock %}

{% block page_actions %}
    <div class="col-auto ms-auto d-print-none">
        <a href="{{ path('mocktest_edit', {id: mockTest.id}) }}" class="btn btn-primary me-2">
            <i class="ti ti-pencil icon"></i>
            Edit
        </a>
        <a href="{{ path('mocktest_index') }}" class="btn btn-secondary">
            <i class="ti ti-arrow-left icon"></i>
            Back to List
        </a>
    </div>
{% endblock %}

{% block content %}
    <div class="row">
        {# Main Information Card #}
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Test Information</h3>
                    <div class="card-actions">
                        <span class="badge {{ mockTest.isActive ? 'bg-success' : 'bg-warning' }} badge-lg">
                            {{ mockTest.isActive ? 'Active' : 'Inactive' }}
                        </span>
                    </div>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label text-muted">Title</label>
                                <div class="h3">{{ mockTest.title }}</div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label text-muted">Test Type</label>
                                <div>
                                    <span class="badge bg-azure-lt fs-3">{{ mockTest.testType }}</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label text-muted">Duration</label>
                                <div class="h4">
                                    <i class="ti ti-clock text-blue me-2"></i>
                                    {{ mockTest.durationMinutes }} minutes
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="mb-3">
                                <label class="form-label text-muted">Platform Language ID</label>
                                <div class="h4">
                                    <i class="ti ti-world text-purple me-2"></i>
                                    {{ mockTest.platformLanguageId }}
                                </div>
                            </div>
                        </div>
                    </div>

                    <hr>

                    <div class="row">
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label text-muted">Created At</label>
                                <div>
                                    <i class="ti ti-calendar me-2"></i>
                                    {{ mockTest.createdAt|date('Y-m-d H:i:s') }}
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label text-muted">Last Updated</label>
                                <div>
                                    <i class="ti ti-clock me-2"></i>
                                    {{ mockTest.updatedAt ? mockTest.updatedAt|date('Y-m-d H:i:s') : 'Never' }}
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="mb-3">
                                <label class="form-label text-muted">Test ID</label>
                                <div>
                                    <code>#{{ mockTest.id }}</code>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Questions List #}
            <div class="card mt-3">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-help me-2"></i>
                        Test Questions
                        <span class="badge bg-blue ms-2">{{ mockTest.testQuestions|length }}</span>
                    </h3>
                    <div class="card-actions">
                        <a href="{{ path('testquestion_new') }}?mockTest={{ mockTest.id }}" class="btn btn-sm btn-primary">
                            <i class="ti ti-plus"></i>
                            Add Question
                        </a>
                    </div>
                </div>
                {% if mockTest.testQuestions|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-vcenter card-table">
                            <thead>
                                <tr>
                                    <th>Section</th>
                                    <th>Question</th>
                                    <th>Points</th>
                                    <th>Options</th>
                                    <th>Status</th>
                                    <th class="w-1">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for question in mockTest.testQuestions %}
                                <tr>
                                    <td>
                                        <span class="badge bg-purple-lt">{{ question.sectionCategory }}</span>
                                    </td>
                                    <td>
                                        <div class="text-truncate" style="max-width: 300px;">
                                            {{ question.questionText }}
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-success">{{ question.points }} pts</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-info">{{ question.options|length }} options</span>
                                    </td>
                                    <td>
                                        <span class="badge {{ question.isActive ? 'bg-success' : 'bg-warning' }}">
                                            {{ question.isActive ? 'Active' : 'Inactive' }}
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-list flex-nowrap">
                                            <a href="{{ path('testquestion_show', {id: question.id}) }}" 
                                               class="btn btn-sm btn-ghost-primary" title="View">
                                                <i class="ti ti-eye"></i>
                                            </a>
                                            <a href="{{ path('testquestion_edit', {id: question.id}) }}" 
                                               class="btn btn-sm btn-ghost-primary" title="Edit">
                                                <i class="ti ti-pencil"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="card-body">
                        <div class="empty">
                            <div class="empty-img">
                                <i class="ti ti-help" style="font-size: 96px; opacity: 0.2;"></i>
                            </div>
                            <p class="empty-title">No questions yet</p>
                            <p class="empty-subtitle text-muted">
                                This test doesn't have any questions. Add questions to get started.
                            </p>
                            <div class="empty-action">
                                <a href="{{ path('testquestion_new') }}?mockTest={{ mockTest.id }}" 
                                   class="btn btn-primary">
                                    <i class="ti ti-plus icon"></i>
                                    Add First Question
                                </a>
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        {# Sidebar #}
        <div class="col-md-4">
            {# Statistics Card #}
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Statistics</h3>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <div class="row align-items-center">
                            <div class="col">
                                <div class="text-muted">Total Questions</div>
                                <div class="h2 mb-0">{{ mockTest.testQuestions|length }}</div>
                            </div>
                            <div class="col-auto">
                                <i class="ti ti-help text-blue" style="font-size: 2.5rem;"></i>
                            </div>
                        </div>
                    </div>

                    {% set totalPoints = 0 %}
                    {% for question in mockTest.testQuestions %}
                        {% set totalPoints = totalPoints + question.points %}
                    {% endfor %}

                    <div class="mb-3">
                        <div class="row align-items-center">
                            <div class="col">
                                <div class="text-muted">Total Points</div>
                                <div class="h2 mb-0">{{ totalPoints }}</div>
                            </div>
                            <div class="col-auto">
                                <i class="ti ti-star text-yellow" style="font-size: 2.5rem;"></i>
                            </div>
                        </div>
                    </div>

                    {% set sections = [] %}
                    {% for question in mockTest.testQuestions %}
                        {% if question.sectionCategory not in sections %}
                            {% set sections = sections|merge([question.sectionCategory]) %}
                        {% endif %}
                    {% endfor %}

                    <div class="mb-3">
                        <div class="row align-items-center">
                            <div class="col">
                                <div class="text-muted">Sections</div>
                                <div class="h2 mb-0">{{ sections|length }}</div>
                            </div>
                            <div class="col-auto">
                                <i class="ti ti-layout text-purple" style="font-size: 2.5rem;"></i>
                            </div>
                        </div>
                    </div>

                    <div>
                        <div class="row align-items-center">
                            <div class="col">
                                <div class="text-muted">Est. Completion</div>
                                <div class="h2 mb-0">
                                    {{ mockTest.durationMinutes }} min
                                </div>
                            </div>
                            <div class="col-auto">
                                <i class="ti ti-clock text-green" style="font-size: 2.5rem;"></i>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# Actions Card #}
            <div class="card mt-3">
                <div class="card-header">
                    <h3 class="card-title">Actions</h3>
                </div>
                <div class="list-group list-group-flush">
                    <a href="{{ path('mocktest_edit', {id: mockTest.id}) }}" 
                       class="list-group-item list-group-item-action">
                        <i class="ti ti-pencil me-2"></i>
                        Edit Test
                    </a>
                    <a href="{{ path('testquestion_new') }}?mockTest={{ mockTest.id }}" 
                       class="list-group-item list-group-item-action">
                        <i class="ti ti-plus me-2"></i>
                        Add Question
                    </a>
                    <div class="list-group-item">
                        <form method="post" 
                              action="{{ path('mocktest_delete', {id: mockTest.id}) }}" 
                              onsubmit="return confirm('Are you sure you want to delete this test and all its questions?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ mockTest.id) }}">
                            <button type="submit" class="btn btn-ghost-danger w-100">
                                <i class="ti ti-trash me-2"></i>
                                Delete Test
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            {# Sections Breakdown #}
            {% if sections|length > 0 %}
            <div class="card mt-3">
                <div class="card-header">
                    <h3 class="card-title">Section Breakdown</h3>
                </div>
                <div class="list-group list-group-flush">
                    {% for section in sections %}
                        {% set sectionQuestions = 0 %}
                        {% for question in mockTest.testQuestions %}
                            {% if question.sectionCategory == section %}
                                {% set sectionQuestions = sectionQuestions + 1 %}
                            {% endif %}
                        {% endfor %}
                        <div class="list-group-item">
                            <div class="row align-items-center">
                                <div class="col">
                                    <span class="badge bg-purple-lt">{{ section }}</span>
                                </div>
                                <div class="col-auto">
                                    <span class="badge bg-blue">{{ sectionQuestions }}</span>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
            {% endif %}
        </div>
    </div>
{% endblock %}

