{% extends 'layouts/admin.html.twig' %}

{% block title %}Mock Tests - {{ parent() }}{% endblock %}

{% block page_title %}
    <i class="ti ti-file-text me-2"></i> Mock Tests
{% endblock %}

{% block page_actions %}
    <div class="col-auto ms-auto d-print-none">
        <a href="{{ path('mocktest_new') }}" class="btn btn-primary">
            <i class="ti ti-plus icon"></i>
            Create Mock Test
        </a>
    </div>
{% endblock %}

{% block content %}
    {# Statistics Cards #}
    <div class="row row-cards mb-3">
        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="subheader">Total Tests</div>
                        <div class="ms-auto">
                            <button class="btn btn-sm btn-ghost-secondary" id="refreshStats" title="Refresh">
                                <i class="ti ti-refresh"></i>
                            </button>
                        </div>
                    </div>
                    <div class="h1 mb-0" id="statTotal">{{ statistics.total }}</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="subheader">Active</div>
                    <div class="h1 mb-0 text-success" id="statActive">{{ statistics.active }}</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="subheader">Inactive</div>
                    <div class="h1 mb-0 text-warning" id="statInactive">{{ statistics.inactive }}</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="subheader">Total Questions</div>
                    <div class="h1 mb-0 text-blue" id="statQuestions">{{ statistics.totalQuestions }}</div>
                </div>
            </div>
        </div>
    </div>

    {# Filters & Search Card #}
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title">Filters & Search</h3>
        </div>
        <div class="card-body">
            <div class="row g-2">
                {# Search Input #}
                <div class="col-md-4">
                    <div class="input-icon">
                        <span class="input-icon-addon">
                            <i class="ti ti-search"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control" 
                               placeholder="Search by title or test type..." />
                    </div>
                </div>

                {# Filter by Test Type #}
                <div class="col-md-2">
                    <select id="testTypeFilter" class="form-select">
                        <option value="">All Types</option>
                        {% for type in testTypes %}
                            <option value="{{ type }}">{{ type }}</option>
                        {% endfor %}
                    </select>
                </div>

                {# Filter by Status #}
                <div class="col-md-2">
                    <select id="statusFilter" class="form-select">
                        <option value="">All Status</option>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>

                {# Sort By #}
                <div class="col-md-2">
                    <select id="sortBy" class="form-select">
                        <option value="createdAt" selected>Sort by Date</option>
                        <option value="title">Sort by Title</option>
                        <option value="testType">Sort by Type</option>
                        <option value="durationMinutes">Sort by Duration</option>
                    </select>
                </div>

                {# Sort Order #}
                <div class="col-md-1">
                    <select id="sortOrder" class="form-select">
                        <option value="DESC" selected>↓ DESC</option>
                        <option value="ASC">↑ ASC</option>
                    </select>
                </div>

                {# Reset Button #}
                <div class="col-md-1">
                    <button id="resetFilters" class="btn btn-secondary w-100" title="Reset filters">
                        <i class="ti ti-refresh"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    {# Bulk Actions #}
    <div class="card mb-3" id="bulkActionsCard" style="display: none;">
        <div class="card-body">
            <div class="d-flex align-items-center">
                <span class="me-3">
                    <strong id="selectedCount">0</strong> test(s) selected
                </span>
                <button class="btn btn-success btn-sm me-2" id="bulkActivate">
                    <i class="ti ti-check"></i> Activate
                </button>
                <button class="btn btn-warning btn-sm me-2" id="bulkDeactivate">
                    <i class="ti ti-x"></i> Deactivate
                </button>
                <button class="btn btn-ghost-secondary btn-sm" id="clearSelection">
                    Clear Selection
                </button>
            </div>
        </div>
    </div>

    {# Main Table Card #}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                All Mock Tests 
                <span class="badge bg-blue ms-2" id="testCount">{{ mockTests|length }}</span>
            </h3>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-striped" id="testsTable">
                <thead>
                    <tr>
                        <th class="w-1">
                            <input type="checkbox" id="selectAll" class="form-check-input">
                        </th>
                        <th>ID</th>
                        <th>Title</th>
                        <th>Type</th>
                        <th>Duration</th>
                        <th>Questions</th>
                        <th>Status</th>
                        <th>Created</th>
                        <th class="w-1">Actions</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    {% for test in mockTests %}
                    <tr data-test-id="{{ test.id }}">
                        <td>
                            <input type="checkbox" class="form-check-input test-checkbox" value="{{ test.id }}">
                        </td>
                        <td class="text-muted">#{{ test.id }}</td>
                        <td>
                            <a href="{{ path('mocktest_show', {id: test.id}) }}" class="text-reset">
                                <strong>{{ test.title }}</strong>
                            </a>
                        </td>
                        <td>
                            <span class="badge bg-azure-lt">{{ test.testType }}</span>
                        </td>
                        <td>
                            <i class="ti ti-clock text-muted me-1"></i>
                            {{ test.durationMinutes }} min
                        </td>
                        <td>
                            <span class="badge bg-purple">{{ test.testQuestions|length }}</span>
                        </td>
                        <td>
                            <button class="btn btn-sm status-toggle" 
                                    data-test-id="{{ test.id }}"
                                    data-status="{{ test.isActive ? 'true' : 'false' }}">
                                {% if test.isActive %}
                                    <span class="badge bg-success">Active</span>
                                {% else %}
                                    <span class="badge bg-warning">Inactive</span>
                                {% endif %}
                            </button>
                        </td>
                        <td>
                            <span class="text-muted" title="{{ test.createdAt|date('Y-m-d H:i:s') }}">
                                {{ test.createdAt|date('Y-m-d') }}
                            </span>
                        </td>
                        <td>
                            <div class="btn-list flex-nowrap">
                                <a href="{{ path('mocktest_show', {id: test.id}) }}" 
                                   class="btn btn-sm btn-ghost-primary" title="View">
                                    <i class="ti ti-eye"></i>
                                </a>
                                <a href="{{ path('mocktest_edit', {id: test.id}) }}" 
                                   class="btn btn-sm btn-ghost-primary" title="Edit">
                                    <i class="ti ti-pencil"></i>
                                </a>
                                <form method="post" 
                                      action="{{ path('mocktest_delete', {id: test.id}) }}" 
                                      style="display:inline;" 
                                      onsubmit="return confirm('Are you sure you want to delete this test?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ test.id) }}">
                                    <button type="submit" class="btn btn-sm btn-ghost-danger" title="Delete">
                                        <i class="ti ti-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr id="emptyRow">
                        <td colspan="9" class="text-center py-5">
                            <div class="empty">
                                <div class="empty-img">
                                    <i class="ti ti-file-text" style="font-size: 128px; opacity: 0.2;"></i>
                                </div>
                                <p class="empty-title">No mock tests found</p>
                                <p class="empty-subtitle text-muted">
                                    Get started by creating your first mock test.
                                </p>
                                <div class="empty-action">
                                    <a href="{{ path('mocktest_new') }}" class="btn btn-primary">
                                        <i class="ti ti-plus icon"></i>
                                        Create your first mock test
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Elements
            const searchInput = document.getElementById('searchInput');
            const testTypeFilter = document.getElementById('testTypeFilter');
            const statusFilter = document.getElementById('statusFilter');
            const sortBy = document.getElementById('sortBy');
            const sortOrder = document.getElementById('sortOrder');
            const resetBtn = document.getElementById('resetFilters');
            const tableBody = document.getElementById('tableBody');
            const testCount = document.getElementById('testCount');
            const refreshStatsBtn = document.getElementById('refreshStats');
            
            // Bulk actions
            const selectAllCheckbox = document.getElementById('selectAll');
            const bulkActionsCard = document.getElementById('bulkActionsCard');
            const selectedCountSpan = document.getElementById('selectedCount');
            const bulkActivateBtn = document.getElementById('bulkActivate');
            const bulkDeactivateBtn = document.getElementById('bulkDeactivate');
            const clearSelectionBtn = document.getElementById('clearSelection');

            // AJAX Search function
            function performSearch() {
                const params = new URLSearchParams({
                    search: searchInput.value,
                    testType: testTypeFilter.value,
                    isActive: statusFilter.value,
                    sortBy: sortBy.value,
                    sortOrder: sortOrder.value
                });

                fetch('{{ path("mocktest_search") }}?' + params)
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            updateTable(data.data);
                            testCount.textContent = data.count;
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showNotification('Error loading data', 'danger');
                    });
            }

            // Update table with search results
            function updateTable(tests) {
                tableBody.innerHTML = '';

                if (tests.length === 0) {
                    tableBody.innerHTML = `
                        <tr id="emptyRow">
                            <td colspan="9" class="text-center py-5">
                                <div class="empty">
                                    <p class="empty-title">No results found</p>
                                    <p class="empty-subtitle text-muted">Try adjusting your filters</p>
                                </div>
                            </td>
                        </tr>
                    `;
                    return;
                }

                tests.forEach(test => {
                    const statusBadge = test.isActive 
                        ? '<span class="badge bg-success">Active</span>'
                        : '<span class="badge bg-warning">Inactive</span>';
                    
                    const row = `
                        <tr data-test-id="${test.id}">
                            <td>
                                <input type="checkbox" class="form-check-input test-checkbox" value="${test.id}">
                            </td>
                            <td class="text-muted">#${test.id}</td>
                            <td>
                                <a href="/internationaltests/mocktest/${test.id}" class="text-reset">
                                    <strong>${escapeHtml(test.title)}</strong>
                                </a>
                            </td>
                            <td><span class="badge bg-azure-lt">${escapeHtml(test.testType)}</span></td>
                            <td>
                                <i class="ti ti-clock text-muted me-1"></i>
                                ${test.durationMinutes} min
                            </td>
                            <td><span class="badge bg-purple">${test.questionsCount}</span></td>
                            <td>
                                <button class="btn btn-sm status-toggle" 
                                        data-test-id="${test.id}"
                                        data-status="${test.isActive}">
                                    ${statusBadge}
                                </button>
                            </td>
                            <td>
                                <span class="text-muted">${formatDate(test.createdAt)}</span>
                            </td>
                            <td>
                                <div class="btn-list flex-nowrap">
                                    <a href="/internationaltests/mocktest/${test.id}" 
                                       class="btn btn-sm btn-ghost-primary" title="View">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                    <a href="/internationaltests/mocktest/${test.id}/edit" 
                                       class="btn btn-sm btn-ghost-primary" title="Edit">
                                        <i class="ti ti-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    `;
                    tableBody.innerHTML += row;
                });

                // Reattach event listeners to new status toggle buttons
                attachStatusToggleListeners();
                attachCheckboxListeners();
            }

            // Toggle status (Active/Inactive)
            function attachStatusToggleListeners() {
                document.querySelectorAll('.status-toggle').forEach(button => {
                    button.addEventListener('click', function() {
                        const testId = this.dataset.testId;
                        const currentStatus = this.dataset.status === 'true';

                        fetch(`/internationaltests/mocktest/${testId}/toggle-status`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            }
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                this.dataset.status = data.isActive;
                                const badge = this.querySelector('.badge');
                                if (data.isActive) {
                                    badge.className = 'badge bg-success';
                                    badge.textContent = 'Active';
                                } else {
                                    badge.className = 'badge bg-warning';
                                    badge.textContent = 'Inactive';
                                }
                                showNotification(data.message, 'success');
                                refreshStats();
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            showNotification('Error toggling status', 'danger');
                        });
                    });
                });
            }

            // Refresh statistics
            function refreshStats() {
                fetch('{{ path("mocktest_stats_refresh") }}')
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            document.getElementById('statTotal').textContent = data.statistics.total;
                            document.getElementById('statActive').textContent = data.statistics.active;
                            document.getElementById('statInactive').textContent = data.statistics.inactive;
                            document.getElementById('statQuestions').textContent = data.statistics.totalQuestions;
                        }
                    })
                    .catch(error => console.error('Error refreshing stats:', error));
            }

            // Bulk selection
            function attachCheckboxListeners() {
                document.querySelectorAll('.test-checkbox').forEach(checkbox => {
                    checkbox.addEventListener('change', updateBulkActionsVisibility);
                });
            }

            function updateBulkActionsVisibility() {
                const checkboxes = document.querySelectorAll('.test-checkbox:checked');
                const count = checkboxes.length;
                
                selectedCountSpan.textContent = count;
                bulkActionsCard.style.display = count > 0 ? 'block' : 'none';
                
                selectAllCheckbox.checked = count > 0 && count === document.querySelectorAll('.test-checkbox').length;
            }

            function getSelectedIds() {
                return Array.from(document.querySelectorAll('.test-checkbox:checked'))
                    .map(cb => parseInt(cb.value));
            }

            // Bulk actions
            bulkActivateBtn.addEventListener('click', function() {
                const ids = getSelectedIds();
                if (ids.length === 0) return;

                if (confirm(`Activate ${ids.length} test(s)?`)) {
                    performBulkAction(ids, 'activate');
                }
            });

            bulkDeactivateBtn.addEventListener('click', function() {
                const ids = getSelectedIds();
                if (ids.length === 0) return;

                if (confirm(`Deactivate ${ids.length} test(s)?`)) {
                    performBulkAction(ids, 'deactivate');
                }
            });

            function performBulkAction(ids, action) {
                fetch('{{ path("mocktest_bulk_toggle") }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ ids, action })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showNotification(data.message, 'success');
                        performSearch();
                        refreshStats();
                        clearSelection();
                    } else {
                        showNotification(data.message, 'danger');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showNotification('Error performing bulk action', 'danger');
                });
            }

            function clearSelection() {
                document.querySelectorAll('.test-checkbox').forEach(cb => cb.checked = false);
                selectAllCheckbox.checked = false;
                updateBulkActionsVisibility();
            }

            selectAllCheckbox.addEventListener('change', function() {
                document.querySelectorAll('.test-checkbox').forEach(cb => {
                    cb.checked = this.checked;
                });
                updateBulkActionsVisibility();
            });

            clearSelectionBtn.addEventListener('click', clearSelection);

            // Event listeners for filters
            searchInput.addEventListener('keyup', performSearch);
            testTypeFilter.addEventListener('change', performSearch);
            statusFilter.addEventListener('change', performSearch);
            sortBy.addEventListener('change', performSearch);
            sortOrder.addEventListener('change', performSearch);
            refreshStatsBtn.addEventListener('click', refreshStats);

            // Reset filters
            resetBtn.addEventListener('click', function() {
                searchInput.value = '';
                testTypeFilter.value = '';
                statusFilter.value = '';
                sortBy.value = 'createdAt';
                sortOrder.value = 'DESC';
                performSearch();
            });

            // Utility functions
            function escapeHtml(text) {
                const map = {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#039;'
                };
                return text.replace(/[&<>"']/g, m => map[m]);
            }

            function formatDate(dateString) {
                const date = new Date(dateString);
                return date.toLocaleDateString('en-US', { 
                    year: 'numeric', 
                    month: '2-digit', 
                    day: '2-digit' 
                });
            }

            function showNotification(message, type = 'info') {
                // Simple notification - you can replace with your preferred notification library
                const alertDiv = document.createElement('div');
                alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed top-0 end-0 m-3`;
                alertDiv.style.zIndex = '9999';
                alertDiv.innerHTML = `
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                document.body.appendChild(alertDiv);
                
                setTimeout(() => {
                    alertDiv.remove();
                }, 3000);
            }

            // Initialize
            attachStatusToggleListeners();
            attachCheckboxListeners();
        });
    </script>
{% endblock %}

