{% extends 'base.html.twig' %}

{% block title %}Create Mock Test - {{ parent() }}{% endblock %}

{% block page_title %}
    <i class="ti ti-plus me-2"></i> Create Mock Test
{% endblock %}

{% block page_actions %}
    <div class="col-auto ms-auto d-print-none">
        <a href="{{ path('mocktest_index') }}" class="btn btn-secondary">
            <i class="ti ti-arrow-left icon"></i>
            Back to List
        </a>
    </div>
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Mock Test Information</h3>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">{{ form_label(form.title) }}</label>
                            {{ form_widget(form.title, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.title) }}
                            <small class="form-hint">Enter a descriptive title for the mock test</small>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label required">{{ form_label(form.testType) }}</label>
                            {{ form_widget(form.testType, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.testType) }}
                            <small class="form-hint">Select the type of international test</small>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">{{ form_label(form.durationMinutes) }}</label>
                            <div class="input-group">
                                {{ form_widget(form.durationMinutes, {'attr': {'class': 'form-control', 'min': '1'}}) }}
                                <span class="input-group-text">minutes</span>
                            </div>
                            {{ form_errors(form.durationMinutes) }}
                            <small class="form-hint">Total duration of the test in minutes</small>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label required">{{ form_label(form.platformLanguageId) }}</label>
                            {{ form_widget(form.platformLanguageId, {'attr': {'class': 'form-control'}}) }}
                            {{ form_errors(form.platformLanguageId) }}
                            <small class="form-hint">Platform language identifier</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">{{ form_label(form.isActive) }}</label>
                        <div class="form-check form-switch">
                            {{ form_widget(form.isActive, {'attr': {'class': 'form-check-input', 'role': 'switch'}}) }}
                            <label class="form-check-label">Enable this test immediately</label>
                        </div>
                        {{ form_errors(form.isActive) }}
                        <small class="form-hint">Active tests are available for students to take</small>
                    </div>

                    <div class="card-footer bg-transparent mt-3">
                        <div class="d-flex">
                            <a href="{{ path('mocktest_index') }}" class="btn btn-link">Cancel</a>
                            <button type="submit" class="btn btn-primary ms-auto">
                                <i class="ti ti-check icon"></i>
                                Create Mock Test
                            </button>
                        </div>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>

            {# Helper Card #}
            <div class="card mt-3">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-info-circle me-2"></i>
                        Tips for Creating Mock Tests
                    </h3>
                </div>
                <div class="card-body">
                    <ul class="mb-0">
                        <li>Choose a clear, descriptive title that indicates the test type and level</li>
                        <li>Set appropriate duration based on the number and complexity of questions</li>
                        <li>You can add questions to the test after creation</li>
                        <li>Tests can be activated/deactivated at any time</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
