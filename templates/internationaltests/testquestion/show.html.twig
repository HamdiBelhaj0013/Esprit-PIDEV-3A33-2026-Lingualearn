{% extends 'layouts/admin.html.twig' %}

{% block title %}Question #{{ testQuestion.id }} - {{ parent() }}{% endblock %}

{% block page_title %}
    <i class="ti ti-help me-2"></i> Question #{{ testQuestion.id }}
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb breadcrumb-arrows" aria-label="breadcrumbs">
        <li class="breadcrumb-item"><a href="{{ path('testquestion_index') }}">Test Questions</a></li>
        <li class="breadcrumb-item active" aria-current="page">Question #{{ testQuestion.id }}</li>
    </ol>
{% endblock %}

{% block page_actions %}
    <div class="col-auto ms-auto d-print-none">
        <div class="btn-list">
            <a href="{{ path('testquestion_edit', {id: testQuestion.id}) }}" class="btn btn-primary">
                <i class="ti ti-pencil"></i>
                Edit
            </a>
            <form method="post" 
                  action="{{ path('testquestion_delete', {id: testQuestion.id}) }}" 
                  style="display:inline;" 
                  onsubmit="return confirm('Are you sure you want to delete this question?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ testQuestion.id) }}">
                <button type="submit" class="btn btn-danger">
                    <i class="ti ti-trash"></i>
                    Delete
                </button>
            </form>
        </div>
    </div>
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-8">
            {# Question Details #}
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">Question Details</h3>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Mock Test</label>
                        <div>
                            <a href="{{ path('mocktest_show', {id: testQuestion.mockTest.id}) }}" class="btn btn-outline-primary">
                                <i class="ti ti-file-text"></i>
                                {{ testQuestion.mockTest.title }}
                            </a>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Section Category</label>
                        <div>
                            <span class="badge bg-purple-lt fs-3">{{ testQuestion.sectionCategory }}</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Question Text</label>
                        <div class="card card-body bg-light">
                            {{ testQuestion.questionText }}
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Answer Options</label>
                        <div class="list-group">
                            {% for option in testQuestion.options %}
                                <div class="list-group-item {% if option == testQuestion.correctAnswer %}list-group-item-success{% endif %}">
                                    <div class="row align-items-center">
                                        <div class="col-auto">
                                            {% if option == testQuestion.correctAnswer %}
                                                <i class="ti ti-check text-success"></i>
                                            {% else %}
                                                <i class="ti ti-circle"></i>
                                            {% endif %}
                                        </div>
                                        <div class="col">
                                            {{ option }}
                                            {% if option == testQuestion.correctAnswer %}
                                                <span class="badge bg-success ms-2">Correct Answer</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Correct Answer</label>
                        <div>
                            <span class="badge bg-success fs-4">{{ testQuestion.correctAnswer }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            {# Question Info Card #}
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">Information</h3>
                </div>
                <div class="card-body">
                    <div class="datagrid">
                        <div class="datagrid-item">
                            <div class="datagrid-title">Question ID</div>
                            <div class="datagrid-content">#{{ testQuestion.id }}</div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Points</div>
                            <div class="datagrid-content">
                                <span class="badge bg-success">{{ testQuestion.points }} points</span>
                            </div>
                        </div>
                        <div class="datagrid-item">
                            <div class="datagrid-title">Number of Options</div>
                            <div class="datagrid-content">
                                <span class="badge bg-info">{{ testQuestion.options|length }}</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {# JSON Preview Card #}
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Options (JSON)</h3>
                </div>
                <div class="card-body">
                    <pre class="bg-light p-3 rounded"><code>{{ testQuestion.options|json_encode(constant('JSON_PRETTY_PRINT')) }}</code></pre>
                </div>
            </div>
        </div>
    </div>
{% endblock %}


