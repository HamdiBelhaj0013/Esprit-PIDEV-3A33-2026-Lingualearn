{% extends 'layouts/admin.html.twig' %}

{% block title %}Test Questions - {{ parent() }}{% endblock %}

{% block page_title %}
    <i class="ti ti-help me-2"></i> Test Questions
{% endblock %}

{% block page_actions %}
    <div class="col-auto ms-auto d-print-none">
        <a href="{{ path('testquestion_new') }}" class="btn btn-primary">
            <i class="ti ti-plus icon"></i>
            Create Question
        </a>
    </div>
{% endblock %}

{% block content %}
    {# Statistics Cards #}
    <div class="row row-cards mb-3">
        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="subheader">Total Questions</div>
                        <div class="ms-auto">
                            <button class="btn btn-sm btn-ghost-secondary" id="refreshStats" title="Refresh">
                                <i class="ti ti-refresh"></i>
                            </button>
                        </div>
                    </div>
                    <div class="h1 mb-0" id="statTotal">{{ statistics.total }}</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="subheader">Active</div>
                    <div class="h1 mb-0 text-success" id="statActive">{{ statistics.active }}</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="subheader">Inactive</div>
                    <div class="h1 mb-0 text-warning" id="statInactive">{{ statistics.inactive }}</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="subheader">Total Points</div>
                    <div class="h1 mb-0 text-blue" id="statPoints">{{ statistics.totalPoints }}</div>
                </div>
            </div>
        </div>
    </div>

    {# Filters & Search Card #}
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title">Filters & Search</h3>
        </div>
        <div class="card-body">
            <div class="row g-2">
                {# Search Input #}
                <div class="col-md-3">
                    <div class="input-icon">
                        <span class="input-icon-addon">
                            <i class="ti ti-search"></i>
                        </span>
                        <input type="text" id="searchInput" class="form-control" 
                               placeholder="Search questions..." />
                    </div>
                </div>

                {# Filter by Section #}
                <div class="col-md-2">
                    <select id="sectionFilter" class="form-select">
                        <option value="">All Sections</option>
                        {% for category in categories %}
                            <option value="{{ category }}">{{ category }}</option>
                        {% endfor %}
                    </select>
                </div>

                {# Filter by Mock Test #}
                <div class="col-md-2">
                    <select id="mockTestFilter" class="form-select">
                        <option value="">All Tests</option>
                        {% for test in mockTests %}
                            <option value="{{ test.id }}">{{ test.title }}</option>
                        {% endfor %}
                    </select>
                </div>

                {# Filter by Status #}
                <div class="col-md-2">
                    <select id="statusFilter" class="form-select">
                        <option value="">All Status</option>
                        <option value="active">Active</option>
                        <option value="inactive">Inactive</option>
                    </select>
                </div>

                {# Sort By #}
                <div class="col-md-2">
                    <select id="sortBy" class="form-select">
                        <option value="createdAt" selected>Sort by Date</option>
                        <option value="questionText">Sort by Question</option>
                        <option value="sectionCategory">Sort by Section</option>
                        <option value="points">Sort by Points</option>
                        <option value="mockTest">Sort by Test</option>
                    </select>
                </div>

                {# Sort Order & Reset #}
                <div class="col-md-1">
                    <select id="sortOrder" class="form-select">
                        <option value="DESC" selected>↓</option>
                        <option value="ASC">↑</option>
                    </select>
                </div>
            </div>
            <div class="row g-2 mt-2">
                <div class="col-auto">
                    <button id="resetFilters" class="btn btn-secondary">
                        <i class="ti ti-refresh"></i> Reset Filters
                    </button>
                </div>
            </div>
        </div>
    </div>

    {# Bulk Actions #}
    <div class="card mb-3" id="bulkActionsCard" style="display: none;">
        <div class="card-body">
            <div class="d-flex align-items-center">
                <span class="me-3">
                    <strong id="selectedCount">0</strong> question(s) selected
                </span>
                <button class="btn btn-success btn-sm me-2" id="bulkActivate">
                    <i class="ti ti-check"></i> Activate
                </button>
                <button class="btn btn-warning btn-sm me-2" id="bulkDeactivate">
                    <i class="ti ti-x"></i> Deactivate
                </button>
                <button class="btn btn-ghost-secondary btn-sm" id="clearSelection">
                    Clear Selection
                </button>
            </div>
        </div>
    </div>

    {# Main Table Card #}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                All Test Questions 
                <span class="badge bg-blue ms-2" id="questionCount">{{ testQuestions|length }}</span>
            </h3>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-striped" id="questionsTable">
                <thead>
                    <tr>
                        <th class="w-1">
                            <input type="checkbox" id="selectAll" class="form-check-input">
                        </th>
                        <th>ID</th>
                        <th>Mock Test</th>
                        <th>Section</th>
                        <th>Question</th>
                        <th>Points</th>
                        <th>Options</th>
                        <th>Status</th>
                        <th class="w-1">Actions</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    {% for question in testQuestions %}
                    <tr data-question-id="{{ question.id }}">
                        <td>
                            <input type="checkbox" class="form-check-input question-checkbox" value="{{ question.id }}">
                        </td>
                        <td class="text-muted">#{{ question.id }}</td>
                        <td>
                            <a href="{{ path('mocktest_show', {id: question.mockTest.id}) }}">
                                {{ question.mockTest.title }}
                            </a>
                        </td>
                        <td>
                            <span class="badge bg-purple-lt">{{ question.sectionCategory }}</span>
                        </td>
                        <td>
                            <div class="text-truncate" style="max-width: 300px;">
                                {{ question.questionText }}
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-success">{{ question.points }} pts</span>
                        </td>
                        <td>
                            <span class="badge bg-info">{{ question.options|length }} options</span>
                        </td>
                        <td>
                            <button class="btn btn-sm status-toggle" 
                                    data-question-id="{{ question.id }}"
                                    data-status="{{ question.isActive ? 'true' : 'false' }}">
                                {% if question.isActive %}
                                    <span class="badge bg-success">Active</span>
                                {% else %}
                                    <span class="badge bg-warning">Inactive</span>
                                {% endif %}
                            </button>
                        </td>
                        <td>
                            <div class="btn-list flex-nowrap">
                                <a href="{{ path('testquestion_show', {id: question.id}) }}" 
                                   class="btn btn-sm btn-ghost-primary" title="View">
                                    <i class="ti ti-eye"></i>
                                </a>
                                <a href="{{ path('testquestion_edit', {id: question.id}) }}" 
                                   class="btn btn-sm btn-ghost-primary" title="Edit">
                                    <i class="ti ti-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-ghost-danger" title="Delete"
                                        onclick="openDeleteModal('{{ question.id }}', '{{ question.questionText|slice(0,40)|e('js') }}...', '{{ path('testquestion_delete', {id: question.id}) }}', '{{ csrf_token('delete' ~ question.id) }}')">
                                    <i class="ti ti-trash"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr id="emptyRow">
                        <td colspan="9" class="text-center py-5">
                            <div class="empty">
                                <div class="empty-img">
                                    <i class="ti ti-help" style="font-size: 128px; opacity: 0.2;"></i>
                                </div>
                                <p class="empty-title">No test questions found</p>
                                <p class="empty-subtitle text-muted">
                                    Get started by creating your first test question.
                                </p>
                                <div class="empty-action">
                                    <a href="{{ path('testquestion_new') }}" class="btn btn-primary">
                                        <i class="ti ti-plus icon"></i>
                                        Create your first question
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Elements
            const searchInput = document.getElementById('searchInput');
            const sectionFilter = document.getElementById('sectionFilter');
            const mockTestFilter = document.getElementById('mockTestFilter');
            const statusFilter = document.getElementById('statusFilter');
            const sortBy = document.getElementById('sortBy');
            const sortOrder = document.getElementById('sortOrder');
            const resetBtn = document.getElementById('resetFilters');
            const tableBody = document.getElementById('tableBody');
            const questionCount = document.getElementById('questionCount');
            const refreshStatsBtn = document.getElementById('refreshStats');
            
            // Bulk actions
            const selectAllCheckbox = document.getElementById('selectAll');
            const bulkActionsCard = document.getElementById('bulkActionsCard');
            const selectedCountSpan = document.getElementById('selectedCount');
            const bulkActivateBtn = document.getElementById('bulkActivate');
            const bulkDeactivateBtn = document.getElementById('bulkDeactivate');
            const clearSelectionBtn = document.getElementById('clearSelection');

            // AJAX Search function
            function performSearch() {
                const params = new URLSearchParams({
                    search: searchInput.value,
                    section: sectionFilter.value,
                    mockTest: mockTestFilter.value,
                    isActive: statusFilter.value,
                    sortBy: sortBy.value,
                    sortOrder: sortOrder.value
                });

                fetch('{{ path("testquestion_search") }}?' + params)
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            updateTable(data.data);
                            questionCount.textContent = data.count;
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showNotification('Error loading data', 'danger');
                    });
            }

            // Update table with search results
            function updateTable(questions) {
                tableBody.innerHTML = '';

                if (questions.length === 0) {
                    tableBody.innerHTML = `
                        <tr id="emptyRow">
                            <td colspan="9" class="text-center py-5">
                                <div class="empty">
                                    <p class="empty-title">No results found</p>
                                    <p class="empty-subtitle text-muted">Try adjusting your filters</p>
                                </div>
                            </td>
                        </tr>
                    `;
                    return;
                }

                questions.forEach(question => {
                    const statusBadge = question.isActive 
                        ? '<span class="badge bg-success">Active</span>'
                        : '<span class="badge bg-warning">Inactive</span>';
                    
                    const row = `
                        <tr data-question-id="${question.id}">
                            <td>
                                <input type="checkbox" class="form-check-input question-checkbox" value="${question.id}">
                            </td>
                            <td class="text-muted">#${question.id}</td>
                            <td>
                                <a href="/internationaltests/mocktest/${question.mockTestId}">
                                    ${escapeHtml(question.mockTestTitle || 'N/A')}
                                </a>
                            </td>
                            <td><span class="badge bg-purple-lt">${escapeHtml(question.sectionCategory)}</span></td>
                            <td>
                                <div class="text-truncate" style="max-width: 300px;">
                                    ${escapeHtml(question.questionText)}
                                </div>
                            </td>
                            <td><span class="badge bg-success">${question.points} pts</span></td>
                            <td><span class="badge bg-info">${question.optionsCount} options</span></td>
                            <td>
                                <button class="btn btn-sm status-toggle" 
                                        data-question-id="${question.id}"
                                        data-status="${question.isActive}">
                                    ${statusBadge}
                                </button>
                            </td>
                            <td>
                                <div class="btn-list flex-nowrap">
                                    <a href="/internationaltests/testquestion/${question.id}" 
                                       class="btn btn-sm btn-ghost-primary" title="View">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                    <a href="/internationaltests/testquestion/${question.id}/edit" 
                                       class="btn btn-sm btn-ghost-primary" title="Edit">
                                        <i class="ti ti-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    `;
                    tableBody.innerHTML += row;
                });

                // Reattach event listeners
                attachStatusToggleListeners();
                attachCheckboxListeners();
            }

            // Toggle status (Active/Inactive)
            function attachStatusToggleListeners() {
                document.querySelectorAll('.status-toggle').forEach(button => {
                    button.addEventListener('click', function() {
                        const questionId = this.dataset.questionId;
                        
                        fetch(`/internationaltests/testquestion/${questionId}/toggle-status`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            }
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                this.dataset.status = data.isActive;
                                const badge = this.querySelector('.badge');
                                if (data.isActive) {
                                    badge.className = 'badge bg-success';
                                    badge.textContent = 'Active';
                                } else {
                                    badge.className = 'badge bg-warning';
                                    badge.textContent = 'Inactive';
                                }
                                showNotification(data.message, 'success');
                                refreshStats();
                            }
                        })
                        .catch(error => {
                            console.error('Error:', error);
                            showNotification('Error toggling status', 'danger');
                        });
                    });
                });
            }

            // Refresh statistics
            function refreshStats() {
                fetch('{{ path("testquestion_stats_refresh") }}')
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            document.getElementById('statTotal').textContent = data.statistics.total;
                            document.getElementById('statActive').textContent = data.statistics.active;
                            document.getElementById('statInactive').textContent = data.statistics.inactive;
                            document.getElementById('statPoints').textContent = data.statistics.totalPoints;
                        }
                    })
                    .catch(error => console.error('Error refreshing stats:', error));
            }

            // Bulk selection
            function attachCheckboxListeners() {
                document.querySelectorAll('.question-checkbox').forEach(checkbox => {
                    checkbox.addEventListener('change', updateBulkActionsVisibility);
                });
            }

            function updateBulkActionsVisibility() {
                const checkboxes = document.querySelectorAll('.question-checkbox:checked');
                const count = checkboxes.length;
                
                selectedCountSpan.textContent = count;
                bulkActionsCard.style.display = count > 0 ? 'block' : 'none';
                
                selectAllCheckbox.checked = count > 0 && count === document.querySelectorAll('.question-checkbox').length;
            }

            function getSelectedIds() {
                return Array.from(document.querySelectorAll('.question-checkbox:checked'))
                    .map(cb => parseInt(cb.value));
            }

            // Bulk actions
            bulkActivateBtn.addEventListener('click', function() {
                const ids = getSelectedIds();
                if (ids.length === 0) return;
                openBulkModal('activate', ids);
            });

            bulkDeactivateBtn.addEventListener('click', function() {
                const ids = getSelectedIds();
                if (ids.length === 0) return;
                openBulkModal('deactivate', ids);
            });

            function performBulkAction(ids, action) {
                fetch('{{ path("testquestion_bulk_toggle") }}', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                    },
                    body: JSON.stringify({ ids, action })
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        showNotification(data.message, 'success');
                        performSearch();
                        refreshStats();
                        clearSelection();
                    } else {
                        showNotification(data.message, 'danger');
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    showNotification('Error performing bulk action', 'danger');
                });
            }

            function clearSelection() {
                document.querySelectorAll('.question-checkbox').forEach(cb => cb.checked = false);
                selectAllCheckbox.checked = false;
                updateBulkActionsVisibility();
            }

            selectAllCheckbox.addEventListener('change', function() {
                document.querySelectorAll('.question-checkbox').forEach(cb => {
                    cb.checked = this.checked;
                });
                updateBulkActionsVisibility();
            });

            clearSelectionBtn.addEventListener('click', clearSelection);

            // Event listeners for filters
            searchInput.addEventListener('keyup', performSearch);
            sectionFilter.addEventListener('change', performSearch);
            mockTestFilter.addEventListener('change', performSearch);
            statusFilter.addEventListener('change', performSearch);
            sortBy.addEventListener('change', performSearch);
            sortOrder.addEventListener('change', performSearch);
            refreshStatsBtn.addEventListener('click', refreshStats);

            // Reset filters
            resetBtn.addEventListener('click', function() {
                searchInput.value = '';
                sectionFilter.value = '';
                mockTestFilter.value = '';
                statusFilter.value = '';
                sortBy.value = 'createdAt';
                sortOrder.value = 'DESC';
                performSearch();
            });

            // Utility functions
            function escapeHtml(text) {
                const map = {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#039;'
                };
                return String(text).replace(/[&<>"']/g, m => map[m]);
            }

            function showNotification(message, type = 'info') {
                const alertDiv = document.createElement('div');
                alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed top-0 end-0 m-3`;
                alertDiv.style.zIndex = '9999';
                alertDiv.innerHTML = `
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                document.body.appendChild(alertDiv);
                
                setTimeout(() => {
                    alertDiv.remove();
                }, 3000);
            }

            // Initialize
            attachStatusToggleListeners();
            attachCheckboxListeners();
        });
    {# ═══ MODALE DELETE INDIVIDUEL ═══ #}
    <div id="deleteModal" class="modal-overlay">
        <div class="modal-box">
            <div class="modal-icon">🗑️</div>
            <h3 class="modal-title">Delete Question</h3>
            <p class="modal-msg">Are you sure you want to delete:<br><strong id="modalQuestionName"></strong><br>This action <strong>cannot be undone</strong>.</p>
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" onclick="closeDeleteModal()">
                    <i class="ti ti-x me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-danger" onclick="document.getElementById('deleteForm').submit()">
                    <i class="ti ti-trash me-1"></i> Yes, Delete
                </button>
            </div>
        </div>
    </div>
    <form id="deleteForm" method="post" style="display:none;">
        <input type="hidden" name="_token" id="deleteToken">
    </form>

    {# ═══ MODALE BULK ACTION ═══ #}
    <div id="bulkModal" class="modal-overlay">
        <div class="modal-box">
            <div class="modal-icon" id="bulkModalIcon">⚡</div>
            <h3 class="modal-title" id="bulkModalTitle">Confirm Action</h3>
            <p class="modal-msg" id="bulkModalMsg">Are you sure?</p>
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" onclick="closeBulkModal()">
                    <i class="ti ti-x me-1"></i> Cancel
                </button>
                <button type="button" class="btn btn-primary" id="bulkConfirmBtn">Confirm</button>
            </div>
        </div>
    </div>

    <style>
    .modal-overlay { display:none; position:fixed; inset:0; background:rgba(0,0,0,.5); z-index:9999; align-items:center; justify-content:center; backdrop-filter:blur(4px); }
    .modal-overlay.show-modal { display:flex; }
    .modal-box { background:#fff; border-radius:16px; padding:2.5rem 2rem; max-width:440px; width:90%; text-align:center; box-shadow:0 24px 60px rgba(0,0,0,.18); animation:modalIn .25s ease; }
    @keyframes modalIn { from{transform:translateY(-20px);opacity:0} to{transform:translateY(0);opacity:1} }
    .modal-icon { font-size:3rem; margin-bottom:1rem; }
    .modal-title { font-size:1.3rem; font-weight:700; color:#1a1a2e; margin-bottom:.5rem; }
    .modal-msg { color:#6c757d; font-size:.9rem; margin-bottom:1.75rem; line-height:1.6; }
    .modal-actions { display:flex; gap:.75rem; justify-content:center; }
    .modal-actions .btn { min-width:130px; border-radius:8px; font-weight:600; padding:.65rem 1.25rem; }
    </style>

    <script>
    function openDeleteModal(id, name, action, token) {
        document.getElementById('modalQuestionName').textContent = '"' + name + '"';
        document.getElementById('deleteForm').action = action;
        document.getElementById('deleteToken').value = token;
        document.getElementById('deleteModal').classList.add('show-modal');
    }
    function closeDeleteModal() {
        document.getElementById('deleteModal').classList.remove('show-modal');
    }

    let _bulkIds = [], _bulkAction = '';
    function openBulkModal(action, ids) {
        _bulkIds = ids; _bulkAction = action;
        const isActivate = action === 'activate';
        document.getElementById('bulkModalIcon').textContent = isActivate ? '✅' : '⏸️';
        document.getElementById('bulkModalTitle').textContent = isActivate ? 'Activate Questions' : 'Deactivate Questions';
        document.getElementById('bulkModalMsg').innerHTML = 'Are you sure you want to <strong>' + action + '</strong> <strong>' + ids.length + ' question(s)</strong>?';
        const btn = document.getElementById('bulkConfirmBtn');
        btn.className = 'btn ' + (isActivate ? 'btn-success' : 'btn-warning');
        btn.innerHTML = (isActivate ? '✅' : '⏸️') + ' Yes, ' + (isActivate ? 'Activate' : 'Deactivate');
        btn.onclick = function() { performBulkAction(_bulkIds, _bulkAction); closeBulkModal(); };
        document.getElementById('bulkModal').classList.add('show-modal');
    }
    function closeBulkModal() {
        document.getElementById('bulkModal').classList.remove('show-modal');
    }

    document.getElementById('deleteModal').addEventListener('click', function(e) { if(e.target===this) closeDeleteModal(); });
    document.getElementById('bulkModal').addEventListener('click', function(e) { if(e.target===this) closeBulkModal(); });
    </script>
{% endblock %}

