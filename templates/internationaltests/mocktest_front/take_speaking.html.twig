<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ mockTest.title }} — Speaking</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=Fraunces:ital,wght@0,300;0,400;1,300;1,400&family=DM+Mono:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
        :root{
            --ink:#0d1526;--ink-soft:#2c3a52;--muted:#7a87a0;--border:#e2e8f2;
            --white:#fff;--off-white:#f4f6fb;--surface:#eef1f8;
            --violet:#6d28d9;--violet-dark:#5b21b6;--violet-mid:#7c3aed;
            --violet-bg:#f5f3ff;--violet-light:#ede9fe;
            --green:#16a34a;--green-bg:#f0fdf4;
            --orange:#ea580c;--orange-bg:#fff7ed;
            --red:#dc2626;--red-bg:#fef2f2;
            --blue:#2563eb;--blue-bg:#eff6ff;
            --radius:12px;--radius-lg:20px;--radius-xl:28px;
        }
        html{scroll-behavior:smooth;}
        body{font-family:'Sora',sans-serif;background:var(--off-white);color:var(--ink);min-height:100vh;}

        /* TOPBAR */
        .topbar{position:sticky;top:0;z-index:40;background:var(--white);border-bottom:1.5px solid var(--border);padding:.85rem 2rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;}
        .brand{font-family:'Fraunces',serif;font-size:1.1rem;color:var(--ink);}
        .brand span{color:var(--violet);}
        .meta{display:flex;align-items:center;gap:.65rem;}
        .badge{font-family:'DM Mono',monospace;font-size:.58rem;letter-spacing:.12em;text-transform:uppercase;padding:.2rem .6rem;border-radius:5px;}
        .badge-violet{background:var(--violet-bg);color:var(--violet-dark);}
        .badge-blue{background:var(--blue-bg);color:var(--blue);}
        .badge-gray{background:var(--surface);color:var(--ink-soft);}
        .timer{display:flex;align-items:center;gap:.6rem;padding:.45rem 1.1rem;border-radius:100px;border:1.5px solid var(--border);background:var(--white);font-family:'DM Mono',monospace;font-size:1rem;transition:all .3s;}
        .timer.warning{border-color:var(--orange);background:var(--orange-bg);color:var(--orange);}
        .timer.danger{border-color:var(--red);background:var(--red-bg);color:var(--red);animation:blink 1s infinite;}
        @keyframes blink{0%,100%{opacity:1;}50%{opacity:.5;}}
        .progress-wrap{height:3px;background:var(--border);position:sticky;top:65px;z-index:39;}
        .progress-fill{height:100%;background:linear-gradient(90deg,var(--violet),var(--violet-mid));transition:width .4s;}

        /* BODY */
        .body{max-width:760px;margin:0 auto;padding:2rem 1.25rem 5rem;}

        /* LOADING STATE */
        .loading-card{background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius-xl);padding:3rem 2rem;text-align:center;margin-bottom:1.5rem;}
        .loading-spinner{width:44px;height:44px;border:3px solid var(--border);border-top-color:var(--violet);border-radius:50%;animation:spin .8s linear infinite;margin:0 auto 1.25rem;}
        @keyframes spin{to{transform:rotate(360deg);}}
        .loading-title{font-size:1rem;font-weight:600;color:var(--ink);margin-bottom:.35rem;}
        .loading-sub{font-size:.82rem;color:var(--muted);}

        /* SUBJECT CARD */
        .subject-card{background:linear-gradient(135deg,#5b21b6,#6d28d9,#7c3aed);border-radius:var(--radius-xl);padding:1.75rem 2rem;margin-bottom:1.5rem;color:var(--white);position:relative;overflow:hidden;display:none;}
        .subject-card::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 80% 20%,rgba(255,255,255,.08),transparent 60%);}
        .subject-label{font-family:'DM Mono',monospace;font-size:.6rem;letter-spacing:.18em;text-transform:uppercase;color:rgba(255,255,255,.6);margin-bottom:.5rem;}
        .subject-title{font-family:'Fraunces',serif;font-size:1.5rem;font-weight:400;font-style:italic;line-height:1.3;}
        .subject-instructions{font-size:.82rem;color:rgba(255,255,255,.7);margin-top:.65rem;line-height:1.6;}
        .exchange-counter{position:absolute;top:1.25rem;right:1.5rem;font-family:'DM Mono',monospace;font-size:.72rem;color:rgba(255,255,255,.7);background:rgba(255,255,255,.12);padding:.3rem .75rem;border-radius:100px;}

        /* CONVERSATION */
        .conversation{margin-bottom:1.5rem;display:flex;flex-direction:column;gap:.85rem;}
        .bubble{max-width:80%;animation:bubbleIn .3s ease;}
        @keyframes bubbleIn{from{opacity:0;transform:translateY(8px);}to{opacity:1;transform:translateY(0);}}
        .bubble-gemini{align-self:flex-start;}
        .bubble-user{align-self:flex-end;}
        .bubble-inner{padding:1rem 1.25rem;border-radius:var(--radius-lg);line-height:1.65;font-size:.92rem;}
        .bubble-gemini .bubble-inner{background:var(--white);border:1.5px solid var(--border);color:var(--ink);border-bottom-left-radius:4px;}
        .bubble-user .bubble-inner{background:var(--violet);color:var(--white);border-bottom-right-radius:4px;}
        .bubble-meta{font-family:'DM Mono',monospace;font-size:.6rem;color:var(--muted);margin-top:.3rem;letter-spacing:.05em;}
        .bubble-user .bubble-meta{text-align:right;}

        /* TYPING INDICATOR */
        .typing-bubble{align-self:flex-start;display:none;}
        .typing-inner{background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius-lg);border-bottom-left-radius:4px;padding:.85rem 1.25rem;display:flex;gap:5px;align-items:center;}
        .typing-dot{width:7px;height:7px;border-radius:50%;background:var(--muted);}
        .typing-dot:nth-child(1){animation:typing .9s ease infinite;}
        .typing-dot:nth-child(2){animation:typing .9s ease infinite .15s;}
        .typing-dot:nth-child(3){animation:typing .9s ease infinite .3s;}
        @keyframes typing{0%,100%{transform:translateY(0);}40%{transform:translateY(-5px);}}

        /* MICRO ZONE */
        .mic-zone{background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius-xl);padding:2rem;text-align:center;margin-bottom:1rem;display:none;}
        .mic-status-label{font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);margin-bottom:1.5rem;}
        .mic-btn-wrap{position:relative;display:inline-flex;flex-direction:column;align-items:center;gap:1rem;}

        /* Pulsation rings autour du micro */
        .mic-rings{position:absolute;inset:-20px;pointer-events:none;}
        .mic-ring{position:absolute;inset:0;border-radius:50%;border:2px solid var(--violet);opacity:0;}
        .recording .mic-ring:nth-child(1){animation:ring 1.5s ease-out infinite;}
        .recording .mic-ring:nth-child(2){animation:ring 1.5s ease-out infinite .5s;}
        .recording .mic-ring:nth-child(3){animation:ring 1.5s ease-out infinite 1s;}
        @keyframes ring{0%{transform:scale(.8);opacity:.6;}100%{transform:scale(1.6);opacity:0;}}

        .mic-btn{width:80px;height:80px;border-radius:50%;border:none;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:1.8rem;transition:all .25s;position:relative;z-index:1;}
        .mic-btn.idle{background:var(--violet-bg);color:var(--violet);box-shadow:0 4px 16px rgba(109,40,217,.15);}
        .mic-btn.idle:hover{background:var(--violet-light);transform:scale(1.05);}
        .mic-btn.recording{background:var(--red);color:var(--white);box-shadow:0 4px 24px rgba(220,38,38,.35);}
        .mic-btn.processing{background:var(--surface);color:var(--muted);cursor:not-allowed;}
        .mic-btn.speaking{background:var(--violet);color:var(--white);cursor:not-allowed;}
        .mic-btn.disabled{background:var(--surface);color:var(--border);cursor:not-allowed;}

        .mic-hint{font-size:.8rem;color:var(--muted);line-height:1.5;max-width:260px;text-align:center;}
        .transcript-preview{background:var(--violet-bg);border:1.5px solid var(--violet-light);border-radius:var(--radius);padding:.85rem 1.1rem;font-size:.88rem;color:var(--violet-dark);line-height:1.6;margin-top:.85rem;display:none;text-align:left;max-width:420px;width:100%;}
        .transcript-preview.visible{display:block;}
        .fluency-chip{font-family:'DM Mono',monospace;font-size:.6rem;color:var(--muted);margin-top:.4rem;letter-spacing:.05em;}

        /* SUBMIT BUTTON */
        .submit-zone{display:none;justify-content:center;margin-top:1rem;}
        .btn-submit{padding:.95rem 2.5rem;border-radius:100px;background:var(--violet);color:var(--white);font-family:'Sora',sans-serif;font-size:.95rem;font-weight:600;border:none;cursor:pointer;transition:all .22s;display:flex;align-items:center;gap:.65rem;}
        .btn-submit:hover{background:var(--violet-dark);transform:translateY(-2px);box-shadow:0 8px 24px rgba(109,40,217,.3);}

        /* MODAL */
        .modal-overlay{position:fixed;inset:0;background:rgba(13,21,38,.5);z-index:100;display:none;align-items:center;justify-content:center;padding:1.5rem;backdrop-filter:blur(4px);}
        .modal-overlay.open{display:flex;}
        .modal-box{background:var(--white);border-radius:var(--radius-xl);padding:2.25rem;max-width:400px;width:100%;text-align:center;animation:popIn .25s ease;}
        @keyframes popIn{from{transform:scale(.93);opacity:0;}to{transform:scale(1);opacity:1;}}
        .modal-icon{font-size:2.5rem;margin-bottom:1rem;}
        .modal-title{font-size:1.1rem;font-weight:700;margin-bottom:.5rem;}
        .modal-body{font-size:.875rem;color:var(--muted);line-height:1.7;margin-bottom:1.75rem;}
        .modal-actions{display:flex;gap:.75rem;}
        .modal-btn{flex:1;padding:.8rem;border-radius:100px;font-family:'Sora',sans-serif;font-size:.85rem;font-weight:600;cursor:pointer;border:none;transition:all .2s;}
        .modal-btn-cancel{background:var(--surface);color:var(--ink-soft);}
        .modal-btn-confirm{background:var(--violet);color:var(--white);}
        .modal-btn-confirm:hover{background:var(--violet-dark);}

        @media(max-width:768px){
            .topbar{padding:.75rem 1rem;}
            .meta{display:none;}
            .body{padding:1rem 1rem 4rem;}
            .bubble{max-width:92%;}
        }
    </style>
</head>
<body>

{# TOPBAR #}
<header class="topbar">
    <div class="brand">Lingua<span>Learn</span></div>
    <div class="meta">
        <span class="badge badge-gray">{{ mockTest.level }}</span>
        <span class="badge badge-blue">{{ mockTest.testType }}</span>
        <span class="badge badge-violet">🎙 Speaking</span>
    </div>
    <div class="timer" id="timerWrap">⏱ <span id="timerDisplay">{{ mockTest.durationMinutes < 10 ? '0' ~ mockTest.durationMinutes : mockTest.durationMinutes }}:00</span></div>
</header>
<div class="progress-wrap"><div class="progress-fill" id="progressFill" style="width:0%"></div></div>

<div class="body">

    {# LOADING STATE #}
    <div class="loading-card" id="loadingCard">
        <div class="loading-spinner"></div>
        <div class="loading-title">Preparing your conversation…</div>
        <div class="loading-sub">Gemini is generating a topic suited to your level</div>
    </div>

    {# SUBJECT CARD #}
    <div class="subject-card" id="subjectCard">
        <div class="subject-label">Conversation topic</div>
        <div class="subject-title" id="subjectTitle">—</div>
        <div class="subject-instructions" id="subjectInstructions">—</div>
        <div class="exchange-counter" id="exchangeCounter">0 / 5</div>
    </div>

    {# CONVERSATION BUBBLES #}
    <div class="conversation" id="conversation">
        <div class="typing-bubble" id="typingBubble">
            <div class="typing-inner">
                <div class="typing-dot"></div>
                <div class="typing-dot"></div>
                <div class="typing-dot"></div>
            </div>
        </div>
    </div>

    {# ZONE MICRO #}
    <div class="mic-zone" id="micZone">
        <div class="mic-status-label" id="micStatusLabel">Your turn to speak</div>
        <div class="mic-btn-wrap" id="micBtnWrap">
            <div class="mic-rings" id="micRings">
                <div class="mic-ring"></div>
                <div class="mic-ring"></div>
                <div class="mic-ring"></div>
            </div>
            <button type="button" class="mic-btn idle" id="micBtn" onclick="toggleRecording()">🎙</button>
            <div class="mic-hint" id="micHint">Press to speak, press again to stop</div>
        </div>
        <div class="transcript-preview" id="transcriptPreview"></div>
    </div>

    {# SOUMETTRE #}
    <div class="submit-zone" id="submitZone">
        <button type="button" class="btn-submit" onclick="openModal()">
            <span>Finish and get my score</span> <span>✓</span>
        </button>
    </div>

    {# FORM CACHÉ #}
    <form method="post" action="{{ path('mock_tests_submit_speaking', {id: mockTest.id}) }}" id="speakingForm" style="display:none;">
        <input type="hidden" name="_token" value="{{ csrf_token('mock_test_submit_' ~ mockTest.id) }}">
    </form>
</div>

{# MODAL #}
<div class="modal-overlay" id="modalConfirm">
    <div class="modal-box">
        <div class="modal-icon">🎙</div>
        <div class="modal-title">Submit the conversation?</div>
        <div class="modal-body">Your conversation will be analyzed by Gemini AI.<br><strong>This action cannot be undone.</strong></div>
        <div class="modal-actions">
            <button class="modal-btn modal-btn-cancel" onclick="closeModal()">← Continue</button>
            <button class="modal-btn modal-btn-confirm" onclick="doSubmit()">Submit ✓</button>
        </div>
    </div>
</div>

<script>
// ═══════════════════════════════════════════════
// CONFIG
// ═══════════════════════════════════════════════
const MOCK_TEST_ID    = {{ mockTest.id }};
const MAX_EXCHANGES   = 5;
const TRANSCRIBE_URL  = '{{ path("mock_tests_speaking_transcribe", {id: mockTest.id}) }}';
const CHAT_URL        = '{{ path("mock_tests_speaking_chat",       {id: mockTest.id}) }}';
const START_URL       = '{{ path("mock_tests_speaking_start",      {id: mockTest.id}) }}';

let exchangeCount    = 0;
let isRecording      = false;
let mediaRecorder    = null;
let audioChunks      = [];
let isProcessing     = false;
let isSpeaking       = false;
let conversationDone = false;
let lastFluency      = {};

// ═══════════════════════════════════════════════
// TIMER
// ═══════════════════════════════════════════════
const duration   = {{ mockTest.durationMinutes }} * 60;
let timeRemaining = duration;   // ← secondes restantes
let timerInterval = null;       // ← référence à l'intervalle
let autoSubmitted = false;
let timerStarted  = false;      // ← le timer n'a pas encore démarré

function updateTimerDisplay() {
    const mins = Math.floor(timeRemaining / 60), secs = timeRemaining % 60;
    document.getElementById('timerDisplay').textContent = `${mins<10?'0'+mins:mins}:${secs<10?'0'+secs:secs}`;
    document.getElementById('progressFill').style.width = ((duration - timeRemaining) / duration * 100) + '%';
    const tw = document.getElementById('timerWrap');
    if      (timeRemaining <= 60)  tw.className = 'timer danger';
    else if (timeRemaining <= 300) tw.className = 'timer warning';
    else                           tw.className = 'timer';
    if (timeRemaining <= 0 && !autoSubmitted) { autoSubmitted = true; pauseTimer(); doSubmit(); }
}

function startTimer() {
    if (timerInterval) return; // déjà en cours
    timerStarted = true;
    timerInterval = setInterval(() => {
        timeRemaining = Math.max(0, timeRemaining - 1);
        updateTimerDisplay();
    }, 1000);
    updateTimerDisplay();
}

function pauseTimer() {
    if (timerInterval) {
        clearInterval(timerInterval);
        timerInterval = null;
    }
}

// Initialiser l'affichage sans démarrer
updateTimerDisplay();

// ═══════════════════════════════════════════════
// DÉMARRAGE — Appel AJAX vers Gemini
// ═══════════════════════════════════════════════
async function startConversation() {
    try {
        const res  = await fetch(START_URL);
        const data = await res.json();
        if (!data.success) throw new Error('Start failed');

        // Afficher le sujet
        document.getElementById('loadingCard').style.display   = 'none';
        document.getElementById('subjectCard').style.display   = 'block';
        document.getElementById('subjectTitle').textContent    = data.subject;
        document.getElementById('subjectInstructions').textContent = data.instructions;

        // Première bulle Gemini
        const firstText = data.welcome + ' ' + data.firstQuestion;
        addBubble('gemini', firstText);

        // Gemini lit à voix haute
        await speakText(firstText);

        // Activer le micro + démarrer le timer maintenant que le test commence vraiment
        showMicZone();
        startTimer(); // ← le timer démarre seulement ici

    } catch(e) {
        console.error('Start error:', e);
        document.getElementById('loadingCard').innerHTML = '<div style="color:#dc2626;font-size:.9rem;">⚠️ Connection error. Please reload the page.</div>';
    }
}

// ═══════════════════════════════════════════════
// ENREGISTREMENT MICRO
// ═══════════════════════════════════════════════
async function toggleRecording() {
    if (isProcessing || isSpeaking || conversationDone) return;

    if (!isRecording) {
        await startRecording();
    } else {
        await stopRecording();
    }
}

async function startRecording() {
    try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        audioChunks  = [];
        mediaRecorder = new MediaRecorder(stream, { mimeType: 'audio/webm' });

        mediaRecorder.ondataavailable = e => { if (e.data.size > 0) audioChunks.push(e.data); };

        mediaRecorder.start(100);
        isRecording = true;
        setMicState('recording');

    } catch(e) {
        alert('Microphone not available. Please check your browser permissions.');
    }
}

async function stopRecording() {
    if (!mediaRecorder || mediaRecorder.state === 'inactive') return;

    return new Promise(resolve => {
        mediaRecorder.onstop = async () => {
            isRecording = false;
            setMicState('processing');
            document.getElementById('micStatusLabel').textContent = 'Transcribing…';

            const blob   = new Blob(audioChunks, { type: 'audio/webm' });
            const base64 = await blobToBase64(blob);

            // Stop toutes les tracks
            mediaRecorder.stream.getTracks().forEach(t => t.stop());

            await processAudio(base64);
            resolve();
        };
        mediaRecorder.stop();
    });
}

async function processAudio(base64Audio) {
    isProcessing = true;
    try {
        // Envoyer à AssemblyAI via notre endpoint
        const transcribeRes = await fetch(TRANSCRIBE_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ audio: base64Audio })
        });
        const transcribeData = await transcribeRes.json();

        let userText = '';
        if (transcribeData.success && transcribeData.text) {
            userText     = transcribeData.text;
            lastFluency  = transcribeData.fluencyMetrics || {};
        } else {
            // Fallback : message d'erreur
            userText = '[Transcription unavailable - please try again]';
        }

        // Afficher la transcription
        showTranscript(userText, lastFluency);

        // Ajouter bulle user
        addBubble('user', userText);
        exchangeCount++;
        updateExchangeCounter();

        // Envoyer à Gemini pour continuer la conversation
        await sendToGemini(userText);

    } catch(e) {
        console.error('Audio processing error:', e);
        setMicState('idle');
        document.getElementById('micStatusLabel').textContent = 'Error — try again';
    } finally {
        isProcessing = false;
    }
}

// ═══════════════════════════════════════════════
// ÉCHANGE AVEC GEMINI
// ═══════════════════════════════════════════════
async function sendToGemini(userText) {
    pauseTimer(); // ← pause pendant que l'IA génère + parle
    showTyping(true);

    try {
        const res  = await fetch(CHAT_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                userAnswer:     userText,
                exchangeNumber: exchangeCount,
                fluencyMetrics: lastFluency,
            })
        });
        const data = await res.json();
        showTyping(false);

        if (!data.success) throw new Error('Chat failed');

        // Réaction + question suivante
        const geminiText = data.reaction + (data.nextQuestion && data.nextQuestion !== 'null' ? ' ' + data.nextQuestion : '');
        addBubble('gemini', geminiText);

        // Gemini parle
        await speakText(geminiText);

        if (data.isFinished || exchangeCount >= MAX_EXCHANGES) {
            // Conversation terminée
            conversationDone = true;
            hideMicZone();
            document.getElementById('submitZone').style.display = 'flex';
            addSystemMessage('✅ Conversation finished — click the button to get your score');
        } else {
            // Prochain tour — reprendre le timer
            setMicState('idle');
            document.getElementById('micStatusLabel').textContent = 'Your turn to speak';
            document.getElementById('transcriptPreview').classList.remove('visible');
            startTimer(); // ← le timer reprend quand c'est le tour du user
        }

    } catch(e) {
        showTyping(false);
        console.error('Gemini error:', e);
        setMicState('idle');
    }
}

// ═══════════════════════════════════════════════
// TEXT-TO-SPEECH (Web Speech API)
// ═══════════════════════════════════════════════
function speakText(text) {
    return new Promise(resolve => {
        if (!window.speechSynthesis) { resolve(); return; }
        window.speechSynthesis.cancel();

        const utterance  = new SpeechSynthesisUtterance(text);
        const langMap    = { english:'en-US', french:'fr-FR', français:'fr-FR', spanish:'es-ES', german:'de-DE', italian:'it-IT', arabic:'ar-SA' };
        utterance.lang   = langMap['{{ mockTest.platformLanguage.name|lower }}'] || 'en-US';
        utterance.rate   = {{ mockTest.level == 'Beginner' ? 0.85 : (mockTest.level == 'Intermediate' ? 0.95 : 1.05) }};
        utterance.pitch  = 1.05;

        isSpeaking = true;
        setMicState('speaking');
        document.getElementById('micStatusLabel').textContent = 'Gemini speaking…';

        utterance.onend = utterance.onerror = () => {
            isSpeaking = false;
            if (!conversationDone) setMicState('idle');
            resolve();
        };
        window.speechSynthesis.speak(utterance);

        // Keep-alive pour Chrome
        const keepAlive = setInterval(() => {
            if (!isSpeaking) { clearInterval(keepAlive); return; }
            if (window.speechSynthesis.paused) window.speechSynthesis.resume();
        }, 5000);
    });
}

// ═══════════════════════════════════════════════
// UI HELPERS
// ═══════════════════════════════════════════════
function addBubble(role, text) {
    const conv = document.getElementById('conversation');
    const typingBubble = document.getElementById('typingBubble');

    const div = document.createElement('div');
    div.className = `bubble bubble-${role}`;
    div.innerHTML = `
        <div class="bubble-inner">${escapeHtml(text)}</div>
        <div class="bubble-meta">${role === 'gemini' ? '🤖 Gemini' : '👤 You'} · now</div>
    `;
    conv.insertBefore(div, typingBubble);
    div.scrollIntoView({ behavior: 'smooth', block: 'end' });
}

function addSystemMessage(text) {
    const conv = document.getElementById('conversation');
    const div  = document.createElement('div');
    div.style.cssText = 'text-align:center;font-family:"DM Mono",monospace;font-size:.7rem;color:var(--muted);padding:.5rem;';
    div.textContent = text;
    conv.appendChild(div);
    div.scrollIntoView({ behavior: 'smooth' });
}

function showTyping(show) {
    document.getElementById('typingBubble').style.display = show ? 'block' : 'none';
    if (show) document.getElementById('typingBubble').scrollIntoView({ behavior: 'smooth', block: 'end' });
}

function setMicState(state) {
    const btn  = document.getElementById('micBtn');
    const wrap = document.getElementById('micBtnWrap');
    btn.className = `mic-btn ${state}`;
    wrap.className = `mic-btn-wrap ${state === 'recording' ? 'recording' : ''}`;

    const icons = { idle:'🎙', recording:'⏹', processing:'⏳', speaking:'🔊', disabled:'🎙' };
    btn.textContent = icons[state] || '🎙';
    btn.disabled    = ['processing', 'speaking', 'disabled'].includes(state);
}

function showMicZone() {
    document.getElementById('micZone').style.display = 'block';
    document.getElementById('micZone').scrollIntoView({ behavior: 'smooth', block: 'end' });
}

function hideMicZone() {
    document.getElementById('micZone').style.display = 'none';
}

function showTranscript(text, fluency) {
    const el = document.getElementById('transcriptPreview');
    let html = `<strong>Your answer:</strong> ${escapeHtml(text)}`;
    if (fluency && fluency.wordsPerMinute) {
        html += `<div class="fluency-chip">⚡ ${fluency.wordsPerMinute} wpm · Confidence ${Math.round((fluency.avgConfidence||0)*100)}%</div>`;
    }
    el.innerHTML = html;
    el.classList.add('visible');
}

function updateExchangeCounter() {
    document.getElementById('exchangeCounter').textContent = `${exchangeCount} / ${MAX_EXCHANGES}`;
}

function blobToBase64(blob) {
    return new Promise(resolve => {
        const reader = new FileReader();
        reader.onload  = () => resolve(reader.result.split(',')[1]);
        reader.readAsDataURL(blob);
    });
}

function escapeHtml(text) {
    return text.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

// MODAL
function openModal()  { document.getElementById('modalConfirm').classList.add('open'); }
function closeModal() { document.getElementById('modalConfirm').classList.remove('open'); }
function doSubmit()   { document.getElementById('speakingForm').submit(); }
document.getElementById('modalConfirm').addEventListener('click', e => { if(e.target === e.currentTarget) closeModal(); });

// LANCEMENT
startConversation();
</script>
</body>
</html>
