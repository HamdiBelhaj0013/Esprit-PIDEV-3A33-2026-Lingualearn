<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Results — LinguaLearn</title>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=Fraunces:ital,wght@0,300;0,400;1,300;1,400&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
    <style>
        *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
        :root{--white:#fff;--off-white:#f7f9fc;--surface:#eef1f8;--ink:#0d1526;--ink-soft:#2c3a52;--muted:#7a87a0;--border:#e2e8f2;--blue:#2563eb;--blue-dark:#1d4ed8;--blue-bg:#eff6ff;--blue-mid:#3b82f6;--green:#16a34a;--green-bg:#f0fdf4;--orange:#ea580c;--orange-bg:#fff7ed;--violet:#7c3aed;--violet-bg:#f5f3ff;--gold:#ca8a04;--gold-bg:#fefce8;--red:#dc2626;--red-bg:#fef2f2;--sidebar-w:260px;--radius:12px;--radius-lg:20px;}
        body{font-family:'Sora',sans-serif;background:var(--off-white);color:var(--ink);min-height:100vh;}

        /* SIDEBAR */
        .sidebar{position:fixed;top:0;left:0;bottom:0;width:var(--sidebar-w);background:var(--white);border-right:1px solid var(--border);display:flex;flex-direction:column;z-index:50;transition:transform .3s;}
        .sidebar-logo{padding:1.5rem 1.5rem 1.25rem;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:.75rem;text-decoration:none;}
        .sidebar-logo-text{font-family:'Fraunces',serif;font-size:1.3rem;font-weight:400;color:var(--ink);}
        .sidebar-logo-text span{color:var(--blue);}
        .sidebar-user{padding:1.25rem 1.5rem;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:.85rem;}
        .user-avatar{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--blue-mid));display:flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-size:1rem;color:var(--white);flex-shrink:0;}
        .user-avatar.premium{background:linear-gradient(135deg,var(--gold),#fbbf24);}
        .user-info{flex:1;min-width:0;}
        .user-name{font-size:.85rem;font-weight:600;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
        .user-plan{font-size:.7rem;font-family:'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase;margin-top:.1rem;}
        .user-plan.free{color:var(--muted);}.user-plan.premium{color:var(--gold);}
        .sidebar-nav{flex:1;padding:1rem 0;overflow-y:auto;}
        .nav-section-label{font-family:'DM Mono',monospace;font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);padding:.75rem 1.5rem .35rem;display:block;}
        .nav-item{display:flex;align-items:center;gap:.75rem;padding:.65rem 1.5rem;font-size:.84rem;font-weight:500;color:var(--muted);text-decoration:none;transition:color .2s,background .2s;position:relative;}
        .nav-item:hover{color:var(--ink);background:var(--off-white);}
        .nav-item.active{color:var(--blue);background:var(--blue-bg);font-weight:600;}
        .nav-item.active::before{content:'';position:absolute;left:0;top:4px;bottom:4px;width:3px;background:var(--blue);border-radius:0 3px 3px 0;}
        .nav-icon{font-size:1.1rem;width:20px;text-align:center;}
        .main{margin-left:var(--sidebar-w);min-height:100vh;display:flex;flex-direction:column;}
        .topbar{position:sticky;top:0;z-index:40;background:rgba(255,255,255,.92);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:.85rem 2rem;display:flex;align-items:center;justify-content:space-between;}
        .page-heading{font-family:'Fraunces',serif;font-size:1.25rem;font-weight:400;color:var(--ink);}
        .page-sub{font-size:.78rem;color:var(--muted);margin-top:.1rem;}
        .topbar-right{display:flex;align-items:center;gap:.75rem;}
        .topbar-btn{width:38px;height:38px;border-radius:var(--radius);border:1.5px solid var(--border);background:transparent;display:flex;align-items:center;justify-content:center;text-decoration:none;font-size:1.1rem;color:var(--ink-soft);transition:border-color .2s,background .2s;}
        .topbar-btn:hover{border-color:var(--blue);background:var(--blue-bg);color:var(--blue);}
        .hamburger-btn{display:none;width:38px;height:38px;border-radius:var(--radius);border:1.5px solid var(--border);background:transparent;align-items:center;justify-content:center;cursor:pointer;flex-direction:column;gap:4px;}
        .hamburger-btn span{width:16px;height:1.5px;background:var(--ink);display:block;border-radius:2px;}
        .page-content{padding:2rem;flex:1;}
        .reveal{opacity:0;transform:translateY(16px);transition:opacity .5s,transform .5s;}
        .reveal.visible{opacity:1;transform:translateY(0);}
        .d1{transition-delay:.08s}.d2{transition-delay:.16s}.d3{transition-delay:.24s}.d4{transition-delay:.32s}.d5{transition-delay:.40s}

        /* ── GRADE HERO ── */
        .grade-hero{background:linear-gradient(135deg,#0d1526,#1e3a5f);border-radius:var(--radius-lg);padding:2rem 2.5rem;display:flex;align-items:center;gap:2.5rem;margin-bottom:2rem;position:relative;overflow:hidden;}
        .grade-hero::before{content:'';position:absolute;top:-40px;right:-40px;width:200px;height:200px;border-radius:50%;background:radial-gradient(circle,rgba(37,99,235,.25) 0%,transparent 70%);}
        .grade-circle{width:90px;height:90px;border-radius:50%;border:2.5px solid rgba(255,255,255,.2);display:flex;flex-direction:column;align-items:center;justify-content:center;flex-shrink:0;}
        .grade-value{font-family:'Fraunces',serif;font-size:2rem;font-weight:300;color:#fff;line-height:1;}
        .grade-label{font-family:'DM Mono',monospace;font-size:.55rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.4);margin-top:.2rem;}
        .grade-info{flex:1;}
        .grade-title{font-family:'Fraunces',serif;font-size:1.35rem;font-weight:300;color:#fff;margin-bottom:.4rem;}
        .grade-title em{font-style:italic;color:#93c5fd;}
        .grade-meta{font-size:.8rem;color:rgba(255,255,255,.5);margin-bottom:1rem;}
        .grade-pills{display:flex;gap:.65rem;flex-wrap:wrap;}
        .grade-pill{display:inline-flex;align-items:center;gap:.35rem;padding:.3rem .85rem;border-radius:100px;font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.06em;}
        .gp-streak{background:rgba(202,138,4,.15);color:#fbbf24;border:1px solid rgba(202,138,4,.3);}
        .gp-consistency{background:rgba(37,99,235,.15);color:#93c5fd;border:1px solid rgba(37,99,235,.3);}
        .gp-platform{background:rgba(22,163,74,.15);color:#86efac;border:1px solid rgba(22,163,74,.3);}
        .gp-platform.below{background:rgba(220,38,38,.12);color:#fca5a5;border:1px solid rgba(220,38,38,.2);}

        /* ── STATS GRID (6 cards) ── */
        .stats-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem;margin-bottom:1.75rem;}
        .stat-card{background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius-lg);padding:1.25rem 1.5rem;}
        .stat-label{font-family:'DM Mono',monospace;font-size:.6rem;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);margin-bottom:.5rem;}
        .stat-value{font-family:'Fraunces',serif;font-size:1.9rem;font-weight:300;color:var(--ink);}
        .stat-value.green{color:var(--green);}.stat-value.blue{color:var(--blue);}.stat-value.gold{color:var(--gold);}.stat-value.orange{color:var(--orange);}.stat-value.violet{color:var(--violet);}
        .stat-sub{font-size:.72rem;color:var(--muted);margin-top:.2rem;}

        /* ── BODY GRID ── */
        .body-grid{display:grid;grid-template-columns:1fr 380px;gap:1.5rem;margin-bottom:1.75rem;}
        .card{background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;}
        .card-head{padding:1.1rem 1.5rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;}
        .card-title{font-family:'Fraunces',serif;font-size:1rem;font-weight:300;color:var(--ink);}
        .card-title em{font-style:italic;color:var(--blue);}
        .card-body{padding:1.25rem 1.5rem;}

        /* ── PROGRESSION CHART (CSS bars) ── */
        .progression-list{display:flex;flex-direction:column;gap:.75rem;}
        .prog-item{display:flex;align-items:center;gap.75rem;gap:.85rem;}
        .prog-date{font-family:'DM Mono',monospace;font-size:.65rem;color:var(--muted);width:44px;flex-shrink:0;}
        .prog-bar-wrap{flex:1;height:8px;background:var(--surface);border-radius:4px;overflow:hidden;}
        .prog-bar-fill{height:100%;border-radius:4px;transition:width 1.2s ease;}
        .prog-score{font-family:'DM Mono',monospace;font-size:.68rem;color:var(--muted);width:36px;text-align:right;flex-shrink:0;}
        .prog-test{font-size:.72rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:120px;}

        /* Trend indicator */
        .trend-badge{display:inline-flex;align-items:center;gap:.4rem;padding:.3rem .85rem;border-radius:100px;font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.06em;}
        .tb-improving{background:var(--green-bg);color:var(--green);}
        .tb-stable{background:var(--blue-bg);color:var(--blue);}
        .tb-declining{background:var(--orange-bg);color:var(--orange);}
        .tb-insufficient{background:var(--surface);color:var(--muted);}

        /* ── LEVELS BY LEVEL ── */
        .level-row{display:flex;align-items:center;gap:1rem;padding:.85rem 0;border-bottom:1px solid var(--border);}
        .level-row:last-child{border-bottom:none;}
        .level-icon{width:38px;height:38px;border-radius:10px;display:flex;align-items:center;justify-content:center;font-size:1.1rem;flex-shrink:0;}
        .li-green{background:var(--green-bg);}.li-blue{background:var(--blue-bg);}.li-violet{background:var(--violet-bg);}.li-gray{background:var(--surface);}
        .level-info{flex:1;}
        .level-name{font-size:.85rem;font-weight:600;color:var(--ink);}
        .level-meta{font-size:.72rem;color:var(--muted);margin-top:.1rem;}
        .level-right{text-align:right;}
        .level-score{font-family:'Fraunces',serif;font-size:1.1rem;font-weight:300;color:var(--ink);}
        .level-not-started{font-size:.72rem;color:var(--muted);font-style:italic;}

        /* ── WEAKNESS SECTIONS ── */
        .weakness-item{margin-bottom:.9rem;}
        .weakness-header{display:flex;align-items:center;justify-content:space-between;margin-bottom:.3rem;}
        .weakness-name{font-size:.82rem;font-weight:500;color:var(--ink);}
        .weakness-pct{font-family:'DM Mono',monospace;font-size:.68rem;}
        .weakness-pct.good{color:var(--green);}.weakness-pct.average{color:var(--orange);}.weakness-pct.weak{color:var(--red);}
        .weakness-bar{height:7px;background:var(--surface);border-radius:4px;overflow:hidden;}
        .weakness-fill{height:100%;border-radius:4px;transition:width 1.2s ease;}
        .wf-good{background:var(--green);}.wf-average{background:var(--orange);}.wf-weak{background:var(--red);}

        /* ── RECOMMENDATIONS ── */
        .reco-item{display:flex;align-items:flex-start;gap:.75rem;padding:.75rem;border-radius:var(--radius);margin-bottom:.65rem;}
        .reco-item:last-child{margin-bottom:0;}
        .reco-item.warning{background:var(--orange-bg);border:1px solid rgba(234,88,12,.15);}
        .reco-item.success{background:var(--green-bg);border:1px solid rgba(22,163,74,.15);}
        .reco-item.info{background:var(--blue-bg);border:1px solid rgba(37,99,235,.12);}
        .reco-icon{font-size:1.1rem;flex-shrink:0;margin-top:.05rem;}
        .reco-text{font-size:.82rem;line-height:1.5;}
        .reco-text.warning{color:var(--orange);}.reco-text.success{color:var(--green);}.reco-text.info{color:var(--blue);}

        /* ── BY CATEGORY ── */
        .category-grid{display:grid;grid-template-columns:1fr 1fr;gap:.75rem;}
        .category-card{padding:.85rem 1rem;border-radius:var(--radius);border:1.5px solid var(--border);background:var(--off-white);}
        .category-name{font-family:'DM Mono',monospace;font-size:.62rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);margin-bottom:.35rem;}
        .category-score{font-family:'Fraunces',serif;font-size:1.3rem;font-weight:300;color:var(--ink);}
        .category-label{font-size:.7rem;margin-top:.15rem;}
        .cl-excellent{color:var(--green);}.cl-good{color:var(--blue);}.cl-average{color:var(--orange);}.cl-poor{color:var(--red);}

        /* ── TABLE HISTORIQUE ── */
        .results-card{background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;}
        .table-wrap{overflow-x:auto;}
        table{width:100%;border-collapse:collapse;}
        th{font-family:'DM Mono',monospace;font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);padding:.85rem 1.5rem;text-align:left;border-bottom:1px solid var(--border);white-space:nowrap;}
        td{padding:.9rem 1.5rem;border-bottom:1px solid var(--border);font-size:.84rem;vertical-align:middle;}
        tr:last-child td{border-bottom:none;}
        tr:hover td{background:var(--off-white);}
        .score-pill{display:inline-flex;align-items:center;gap:.35rem;padding:.3rem .8rem;border-radius:100px;font-family:'DM Mono',monospace;font-size:.72rem;}
        .sp-excellent{background:var(--green-bg);color:var(--green);}
        .sp-good{background:var(--blue-bg);color:var(--blue);}
        .sp-average{background:var(--orange-bg);color:var(--orange);}
        .sp-poor{background:var(--red-bg);color:var(--red);}
        .view-link{color:var(--blue);text-decoration:none;font-size:.8rem;font-weight:600;}
        .view-link:hover{text-decoration:underline;}
        .level-badge{font-family:'DM Mono',monospace;font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;padding:.18rem .55rem;border-radius:4px;}
        .lb-beginner{background:var(--green-bg);color:var(--green);}
        .lb-intermediate{background:var(--blue-bg);color:var(--blue);}
        .lb-advanced{background:var(--violet-bg);color:var(--violet);}
        .passed-badge{font-size:.7rem;font-weight:600;}
        .pb-pass{color:var(--green);}.pb-fail{color:var(--orange);}

        /* EMPTY */
        .empty-state{text-align:center;padding:4rem 2rem;color:var(--muted);}
        .empty-icon{font-size:3rem;margin-bottom:1rem;display:block;}
        .btn-primary{display:inline-flex;align-items:center;gap:.5rem;padding:.7rem 1.5rem;background:var(--blue);color:var(--white);border-radius:100px;text-decoration:none;font-size:.85rem;font-weight:600;transition:background .2s;}
        .btn-primary:hover{background:var(--blue-dark);}

        /* RESPONSIVE */
        @media(max-width:1200px){.body-grid{grid-template-columns:1fr;}.stats-grid{grid-template-columns:repeat(2,1fr);}}
        @media(max-width:768px){:root{--sidebar-w:0px;}.sidebar{transform:translateX(-260px);width:260px;}.sidebar.open{transform:translateX(0);}.main{margin-left:0;}.hamburger-btn{display:flex;}.page-content{padding:1.25rem;}.stats-grid{grid-template-columns:1fr 1fr;}.hide-mobile{display:none;}}
        .sidebar-overlay{display:none;position:fixed;inset:0;background:rgba(13,21,38,.4);z-index:45;}
        .sidebar-overlay.visible{display:block;}
    </style>
</head>
<body>
<aside class="sidebar" id="sidebar">
    <a href="{{ path('app_homepage') }}" class="sidebar-logo"><div class="sidebar-logo-text">Lingua<span>Learn</span></div></a>
    <div class="sidebar-user">
        <div class="user-avatar {{ user.isPremium ? 'premium' : '' }}">{{ user.firstName|first|upper }}{{ user.lastName|first|upper }}</div>
        <div class="user-info">
            <div class="user-name">{{ user.fullName }}</div>
            <div class="user-plan {{ user.isPremium ? 'premium' : 'free' }}">{{ user.isPremium ? '★ ' ~ user.subscriptionPlan : 'Free Plan' }}</div>
        </div>
    </div>
    <nav class="sidebar-nav">
        <span class="nav-section-label">Main</span>
        <a href="{{ path('user_dashboard') }}" class="nav-item"><span class="nav-icon">⊞</span> Dashboard</a>
        <a href="#" class="nav-item"><span class="nav-icon">📚</span> My Courses</a>
        <a href="{{ path('learn_practice') }}" class="nav-item"><span class="nav-icon">🧩</span> Practice</a>
        <a href="{{ path('mock_tests_index') }}" class="nav-item active"><span class="nav-icon">📝</span> Mock Tests</a>
        <span class="nav-section-label">Account</span>
        <a href="{{ path('user_profile') }}" class="nav-item"><span class="nav-icon">👤</span> My Profile</a>
        <a href="#" class="nav-item"><span class="nav-icon">🔔</span> Notifications</a>
        <a href="#" class="nav-item"><span class="nav-icon">👑</span> Subscription</a>
        <span class="nav-section-label">System</span>
        <a href="{{ path('app_logout') }}" class="nav-item"><span class="nav-icon">→</span> Log Out</a>
    </nav>
</aside>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="main">
    <header class="topbar">
        <div style="display:flex;align-items:center;gap:1rem;">
            <button class="hamburger-btn" id="hamburgerBtn"><span></span><span></span><span></span></button>
            <div>
                <div class="page-heading">My Performance</div>
                <div class="page-sub">{{ results|length }} test{{ results|length != 1 ? 's' : '' }} — Full analysis</div>
            </div>
        </div>
        <div class="topbar-right">
            <a href="{{ path('mock_tests_index') }}" class="topbar-btn" title="Take a test">＋</a>
        </div>
    </header>

    <main class="page-content">

    {% if results|length > 0 %}
        {% set report = performanceReport %}
        {% set gs     = report.globalStats %}
        {% set trend  = report.progressionTrend %}
        {% set streak = report.streakData %}
        {% set pc     = report.platformComparison %}

        {# ── GRADE HERO ── #}
        <div class="grade-hero reveal">
            <div class="grade-circle">
                <div class="grade-value">{{ report.performanceGrade }}</div>
                <div class="grade-label">Grade</div>
            </div>
            <div class="grade-info">
                <div class="grade-title">Your <em>Performance Report</em></div>
                <div class="grade-meta">
                    {{ gs.total }} tests · Pass rate {{ gs.passRate }}% · Consistency {{ report.consistencyIndex|round }}%
                </div>
                <div class="grade-pills">
                    {% if streak.current > 0 %}
                        <span class="grade-pill gp-streak">🔥 {{ streak.current }}-day streak</span>
                    {% endif %}
                    <span class="grade-pill gp-consistency">📊 Consistency {{ report.consistencyIndex|round }}%</span>
                    <span class="grade-pill gp-platform {{ pc.isAboveAvg ? '' : 'below' }}">
                        {{ pc.isAboveAvg ? '↑' : '↓' }} {{ pc.diffLabel }}
                    </span>
                </div>
            </div>
        </div>

        {# ── 6 STAT CARDS ── #}
        <div class="stats-grid">
            <div class="stat-card reveal">
                <div class="stat-label">Tests Taken</div>
                <div class="stat-value blue">{{ gs.total }}</div>
                <div class="stat-sub">{{ gs.passed }} passed · {{ gs.failed }} failed</div>
            </div>
            <div class="stat-card reveal d1">
                <div class="stat-label">Average Score</div>
                <div class="stat-value">{{ gs.avgScore }} <span style="font-size:.9rem;color:var(--muted)">/ {{ totalScore }}</span></div>
                <div class="stat-sub">Pass rate {{ gs.passRate }}%</div>
            </div>
            <div class="stat-card reveal d2">
                <div class="stat-label">Best Score</div>
                <div class="stat-value green">{{ gs.bestScore }} <span style="font-size:.9rem;color:var(--muted)">/ {{ totalScore }}</span></div>
                <div class="stat-sub">Personal record</div>
            </div>
            <div class="stat-card reveal d3">
                <div class="stat-label">Consistency Index</div>
                <div class="stat-value {{ report.consistencyIndex >= 70 ? 'blue' : (report.consistencyIndex >= 40 ? 'gold' : 'orange') }}">
                    {{ report.consistencyIndex|round }}<span style="font-size:.9rem;color:var(--muted)">%</span>
                </div>
                <div class="stat-sub">Score regularity</div>
            </div>
            <div class="stat-card reveal d4">
                <div class="stat-label">Platform Rank</div>
                <div class="stat-value {{ pc.isAboveAvg ? 'green' : 'orange' }}">
                    {{ pc.percentile }}<span style="font-size:.9rem;color:var(--muted)">%</span>
                </div>
                <div class="stat-sub">{{ pc.diffLabel }}</div>
            </div>
            <div class="stat-card reveal d4">
                <div class="stat-label">Best Streak</div>
                <div class="stat-value gold">{{ streak.longest }}</div>
                <div class="stat-sub">days · Current: {{ streak.current }}</div>
            </div>
        </div>

        {# ── BODY GRID ── #}
        <div class="body-grid">

            {# LEFT : Progression + By Level + By Category #}
            <div style="display:flex;flex-direction:column;gap:1.25rem;">

                {# Progression Chart #}
                <div class="card reveal">
                    <div class="card-head">
                        <div class="card-title">Score <em>Progression</em></div>
                        <span class="trend-badge tb-{{ trend.trend }}">{{ trend.trendLabel }}</span>
                    </div>
                    <div class="card-body">
                        {% if trend.history is not empty %}
                            <div class="progression-list">
                                {% for item in trend.history %}
                                    {% set pct = (item.score / totalScore * 100)|round %}
                                    {% set color = item.score >= 16 ? '#16a34a' : (item.score >= 12 ? '#2563eb' : (item.score >= 8 ? '#ea580c' : '#dc2626')) %}
                                    <div class="prog-item">
                                        <span class="prog-date">{{ item.date }}</span>
                                        <div class="prog-bar-wrap">
                                            <div class="prog-bar-fill" style="width:{{ pct }}%;background:{{ color }};"></div>
                                        </div>
                                        <span class="prog-score">{{ item.score|number_format(1) }}</span>
                                        <span class="prog-test">{{ item.test }}</span>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p style="color:var(--muted);font-size:.85rem;">Not enough data to show progression.</p>
                        {% endif %}
                    </div>
                </div>

                {# By Level #}
                <div class="card reveal d1">
                    <div class="card-head">
                        <div class="card-title">Performance by <em>Level</em></div>
                    </div>
                    <div class="card-body">
                        {% for levelKey, levelData in report.byLevel %}
                            <div class="level-row">
                                <div class="level-icon {{ levelKey == 'Beginner' ? 'li-green' : (levelKey == 'Intermediate' ? 'li-blue' : 'li-violet') }}">
                                    {{ levelKey == 'Beginner' ? '🌱' : (levelKey == 'Intermediate' ? '📘' : '🏆') }}
                                </div>
                                <div class="level-info">
                                    <div class="level-name">{{ levelKey }}</div>
                                    <div class="level-meta">
                                        {% if levelData.total > 0 %}
                                            {{ levelData.total }} test{{ levelData.total > 1 ? 's' : '' }} · Pass rate {{ levelData.passRate }}%
                                        {% else %}
                                            Not started
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="level-right">
                                    {% if levelData.avgScore is not null %}
                                        <div class="level-score">{{ levelData.avgScore }} <span style="font-size:.75rem;color:var(--muted)">avg</span></div>
                                        <div style="font-size:.68rem;color:{{ levelData.status == 'passed' ? 'var(--green)' : 'var(--orange)' }};">
                                            Best: {{ levelData.best|number_format(1) }}/{{ totalScore }}
                                        </div>
                                    {% else %}
                                        <div class="level-not-started">—</div>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                {# By Category #}
                {% if report.byCategory is not empty %}
                <div class="card reveal d2">
                    <div class="card-head">
                        <div class="card-title">By <em>Category</em></div>
                    </div>
                    <div class="card-body">
                        <div class="category-grid">
                            {% for cat in report.byCategory %}
                                <div class="category-card">
                                    <div class="category-name">{{ cat.category }}</div>
                                    <div class="category-score">{{ cat.avgScore }}<span style="font-size:.8rem;color:var(--muted)"> /{{ totalScore }}</span></div>
                                    <div class="category-label cl-{{ cat.label }}">{{ cat.count }} test{{ cat.count > 1 ? 's' : '' }} · {{ cat.pct }}%</div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>
                </div>
                {% endif %}

            </div>

            {# RIGHT : Weakness + Recommendations #}
            <div style="display:flex;flex-direction:column;gap:1.25rem;">

                {# Weakness Sections #}
                {% if report.weaknessSections is not empty %}
                <div class="card reveal d1">
                    <div class="card-head">
                        <div class="card-title">Section <em>Weaknesses</em></div>
                        <span style="font-family:'DM Mono',monospace;font-size:.65rem;color:var(--muted);">All tests</span>
                    </div>
                    <div class="card-body">
                        {% for section in report.weaknessSections %}
                            <div class="weakness-item">
                                <div class="weakness-header">
                                    <span class="weakness-name">{{ section.section }}</span>
                                    <span class="weakness-pct {{ section.status }}">{{ section.score }}%</span>
                                </div>
                                <div class="weakness-bar">
                                    <div class="weakness-fill wf-{{ section.status }}" style="width:{{ section.score }}%;"></div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                {# Recommendations #}
                {% if report.recommendations is not empty %}
                <div class="card reveal d2">
                    <div class="card-head">
                        <div class="card-title">🎯 <em>Recommendations</em></div>
                    </div>
                    <div class="card-body">
                        {% for reco in report.recommendations %}
                            <div class="reco-item {{ reco.type }}">
                                <span class="reco-icon">{{ reco.icon }}</span>
                                <span class="reco-text {{ reco.type }}">{{ reco.message }}</span>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}

                {# By Test Type #}
                {% if report.byTestType is not empty %}
                <div class="card reveal d3">
                    <div class="card-head">
                        <div class="card-title">By <em>Test Type</em></div>
                    </div>
                    <div class="card-body">
                        {% for typeData in report.byTestType %}
                            <div style="display:flex;align-items:center;justify-content:space-between;padding:.6rem 0;border-bottom:1px solid var(--border);">
                                <div>
                                    <div style="font-size:.85rem;font-weight:600;">{{ typeData.type }}</div>
                                    <div style="font-size:.72rem;color:var(--muted);">{{ typeData.count }} test{{ typeData.count > 1 ? 's' : '' }}</div>
                                </div>
                                <div style="text-align:right;">
                                    <div style="font-family:'Fraunces',serif;font-size:1.1rem;font-weight:300;">{{ typeData.avgScore }}</div>
                                    <div class="cl-{{ typeData.label }}" style="font-size:.7rem;">{{ typeData.label }}</div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

        {# ── HISTORIQUE TABLE ── #}
        <div class="results-card reveal d3">
            <div class="card-head">
                <div class="card-title">Test <em>History</em></div>
                <span style="font-family:'DM Mono',monospace;font-size:.65rem;color:var(--muted);">{{ results|length }} total</span>
            </div>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Test</th>
                            <th>Level</th>
                            <th>Type</th>
                            <th>Score</th>
                            <th>Status</th>
                            <th class="hide-mobile">Date</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for result in results %}
                            {% set s = result.overallScore %}
                            {% set isPassed = s >= passScore %}
                            {% set test = result.mockTest %}
                            {% if s >= 16 %}{% set pillClass = 'sp-excellent' %}
                            {% elseif s >= 12 %}{% set pillClass = 'sp-good' %}
                            {% elseif s >= 8 %}{% set pillClass = 'sp-average' %}
                            {% else %}{% set pillClass = 'sp-poor' %}{% endif %}
                            <tr>
                                <td style="font-weight:600;">{{ test.title }}</td>
                                <td><span class="level-badge lb-{{ test.level|lower }}">{{ test.level }}</span></td>
                                <td style="color:var(--muted);">{{ test.testType }}</td>
                                <td><span class="score-pill {{ pillClass }}">{{ s|number_format(1) }} / {{ totalScore }}</span></td>
                                <td><span class="passed-badge {{ isPassed ? 'pb-pass' : 'pb-fail' }}">{{ isPassed ? '✓ Passed' : '✗ Failed' }}</span></td>
                                <td class="hide-mobile" style="color:var(--muted);font-size:.78rem;">{{ result.dateTaken|date('d/m/Y H:i') }}</td>
                                <td><a href="{{ path('mock_tests_result', {id: test.id, resultId: result.id}) }}" class="view-link">View →</a></td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    {% else %}
        <div class="empty-state">
            <span class="empty-icon">📊</span>
            <div style="font-family:'Fraunces',serif;font-size:1.4rem;font-weight:300;color:var(--ink);margin-bottom:.5rem;">No results yet</div>
            <div style="font-size:.85rem;margin-bottom:1.5rem;">Take your first mock test to see your full performance analysis here.</div>
            <a href="{{ path('mock_tests_index') }}" class="btn-primary">Browse Mock Tests →</a>
        </div>
    {% endif %}
    </main>
</div>

<script>
    const sidebar=document.getElementById('sidebar'),overlay=document.getElementById('sidebarOverlay'),hamburger=document.getElementById('hamburgerBtn');
    hamburger.addEventListener('click',()=>{sidebar.classList.toggle('open');overlay.classList.toggle('visible');});
    overlay.addEventListener('click',()=>{sidebar.classList.remove('open');overlay.classList.remove('visible');});
    const ro=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');ro.unobserve(e.target);}});},{threshold:0.06});
    document.querySelectorAll('.reveal').forEach(el=>ro.observe(el));
</script>
</body>
</html>
