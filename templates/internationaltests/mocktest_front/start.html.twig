<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ mockTest.title }} — LinguaLearn</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=Fraunces:ital,wght@0,300;0,400;1,300;1,400&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --white: #ffffff; --off-white: #f7f9fc; --surface: #eef1f8;
            --ink: #0d1526; --ink-soft: #2c3a52; --muted: #7a87a0;
            --border: #e2e8f2; --blue: #2563eb; --blue-dark: #1d4ed8;
            --blue-bg: #eff6ff; --blue-mid: #3b82f6;
            --green: #16a34a; --green-bg: #f0fdf4;
            --orange: #ea580c; --orange-bg: #fff7ed;
            --violet: #7c3aed; --violet-bg: #f5f3ff;
            --gold: #ca8a04; --gold-bg: #fefce8;
            --sidebar-w: 260px; --radius: 12px; --radius-lg: 20px;
        }
        html { scroll-behavior: smooth; }
        body { font-family: 'Sora', sans-serif; background: var(--off-white); color: var(--ink); min-height: 100vh; }
        .sidebar { position: fixed; top: 0; left: 0; bottom: 0; width: var(--sidebar-w); background: var(--white); border-right: 1px solid var(--border); display: flex; flex-direction: column; z-index: 50; transition: transform .3s ease; }
        .sidebar-logo { padding: 1.5rem 1.5rem 1.25rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: .75rem; text-decoration: none; }
        .sidebar-logo-text { font-family: 'Fraunces', serif; font-size: 1.3rem; font-weight: 400; color: var(--ink); }
        .sidebar-logo-text span { color: var(--blue); }
        .sidebar-user { padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: .85rem; }
        .user-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--blue), var(--blue-mid)); display: flex; align-items: center; justify-content: center; font-family: 'Fraunces', serif; font-size: 1rem; color: var(--white); flex-shrink: 0; }
        .user-avatar.premium { background: linear-gradient(135deg, var(--gold), #fbbf24); }
        .user-info { flex: 1; min-width: 0; }
        .user-name { font-size: .85rem; font-weight: 600; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .user-plan { font-size: .7rem; font-family: 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; margin-top: .1rem; }
        .user-plan.free { color: var(--muted); } .user-plan.premium { color: var(--gold); }
        .sidebar-nav { flex: 1; padding: 1rem 0; overflow-y: auto; }
        .nav-section-label { font-family: 'DM Mono', monospace; font-size: .6rem; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); padding: .75rem 1.5rem .35rem; display: block; }
        .nav-item { display: flex; align-items: center; gap: .75rem; padding: .65rem 1.5rem; font-size: .84rem; font-weight: 500; color: var(--muted); text-decoration: none; transition: color .2s, background .2s; position: relative; }
        .nav-item:hover { color: var(--ink); background: var(--off-white); }
        .nav-item.active { color: var(--blue); background: var(--blue-bg); font-weight: 600; }
        .nav-item.active::before { content: ''; position: absolute; left: 0; top: 4px; bottom: 4px; width: 3px; background: var(--blue); border-radius: 0 3px 3px 0; }
        .nav-icon { font-size: 1.1rem; width: 20px; text-align: center; }
        .main { margin-left: var(--sidebar-w); min-height: 100vh; display: flex; flex-direction: column; }
        .topbar { position: sticky; top: 0; z-index: 40; background: rgba(255,255,255,.92); backdrop-filter: blur(20px); border-bottom: 1px solid var(--border); padding: .85rem 2rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
        .topbar-left { display: flex; align-items: center; gap: 1rem; }
        .page-heading { font-family: 'Fraunces', serif; font-size: 1.25rem; font-weight: 400; color: var(--ink); }
        .page-sub { font-size: .78rem; color: var(--muted); margin-top: .1rem; }
        .topbar-right { display: flex; align-items: center; gap: .75rem; }
        .topbar-btn { width: 38px; height: 38px; border-radius: var(--radius); border: 1.5px solid var(--border); background: transparent; display: flex; align-items: center; justify-content: center; text-decoration: none; font-size: 1.1rem; color: var(--ink-soft); transition: border-color .2s, background .2s; }
        .topbar-btn:hover { border-color: var(--blue); background: var(--blue-bg); color: var(--blue); }
        .hamburger-btn { display: none; width: 38px; height: 38px; border-radius: var(--radius); border: 1.5px solid var(--border); background: transparent; align-items: center; justify-content: center; cursor: pointer; flex-direction: column; gap: 4px; }
        .hamburger-btn span { width: 16px; height: 1.5px; background: var(--ink); display: block; border-radius: 2px; }
        .page-content { padding: 2rem; flex: 1; display: flex; justify-content: center; }
        .breadcrumb { display: flex; align-items: center; gap: .5rem; font-size: .78rem; color: var(--muted); margin-bottom: 1.5rem; }
        .breadcrumb a { color: var(--blue); text-decoration: none; font-weight: 500; }

        /* ─── START PAGE CENTERED CARD ─── */
        .start-wrap { width: 100%; max-width: 620px; }

        .start-card {
            background: var(--white);
            border: 1.5px solid var(--border);
            border-radius: var(--radius-lg);
            overflow: hidden;
        }
        .start-card-top {
            background: linear-gradient(135deg, #0d1526, #1e3a5f);
            padding: 2.5rem 2rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }
        .start-card-top::before {
            content: '';
            position: absolute; top: -50px; right: -50px;
            width: 200px; height: 200px; border-radius: 50%;
            background: radial-gradient(circle, rgba(37,99,235,.3) 0%, transparent 70%);
        }
        .start-type-badge {
            display: inline-block; margin-bottom: 1rem;
            padding: .3rem .9rem; border-radius: 100px;
            font-family: 'DM Mono', monospace; font-size: .62rem; letter-spacing: .1em;
            text-transform: uppercase; background: rgba(255,255,255,.1);
            color: rgba(255,255,255,.8); border: 1px solid rgba(255,255,255,.15);
        }
        .start-title { font-family: 'Fraunces', serif; font-size: 1.6rem; font-weight: 300; color: #fff; margin-bottom: .75rem; line-height: 1.2; }
        .start-lang { font-size: .8rem; color: rgba(255,255,255,.5); font-family: 'DM Mono', monospace; }

        .start-stats {
            display: grid; grid-template-columns: repeat(3, 1fr);
            gap: 0; border-bottom: 1px solid var(--border);
        }
        .start-stat {
            padding: 1.25rem 1rem; text-align: center;
            border-right: 1px solid var(--border);
        }
        .start-stat:last-child { border-right: none; }
        .start-stat-val { font-family: 'Fraunces', serif; font-size: 1.5rem; font-weight: 300; color: var(--ink); }
        .start-stat-label { font-family: 'DM Mono', monospace; font-size: .6rem; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-top: .2rem; }

        .start-rules { padding: 1.5rem 2rem; border-bottom: 1px solid var(--border); }
        .start-rules-title { font-size: .82rem; font-weight: 600; color: var(--ink-soft); margin-bottom: .85rem; }
        .rule-item { display: flex; align-items: flex-start; gap: .75rem; padding: .4rem 0; font-size: .82rem; color: var(--ink-soft); }
        .rule-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--blue); flex-shrink: 0; margin-top: .5rem; }

        .start-actions { padding: 1.5rem 2rem; display: flex; gap: .85rem; }

        .btn-begin {
            flex: 1; padding: .85rem;
            background: var(--blue); color: var(--white);
            border: none; border-radius: 100px;
            font-family: 'Sora', sans-serif; font-size: .9rem; font-weight: 600;
            text-decoration: none; text-align: center; cursor: pointer;
            transition: all .2s;
        }
        .btn-begin:hover { background: var(--blue-dark); transform: translateY(-1px); box-shadow: 0 6px 18px rgba(37,99,235,.28); }

        .btn-back {
            padding: .85rem 1.5rem;
            background: transparent; color: var(--muted);
            border: 1.5px solid var(--border); border-radius: 100px;
            font-family: 'Sora', sans-serif; font-size: .85rem; font-weight: 500;
            text-decoration: none; text-align: center; cursor: pointer;
            transition: all .2s;
        }
        .btn-back:hover { border-color: var(--ink-soft); color: var(--ink-soft); }

        .reveal { opacity: 0; transform: translateY(16px); transition: opacity .5s ease, transform .5s ease; }
        .reveal.visible { opacity: 1; transform: translateY(0); }

        @media (max-width: 768px) {
            :root { --sidebar-w: 0px; }
            .sidebar { transform: translateX(-260px); width: 260px; }
            .sidebar.open { transform: translateX(0); }
            .main { margin-left: 0; }
            .hamburger-btn { display: flex; }
            .page-content { padding: 1.25rem; }
            .topbar { padding: .75rem 1.25rem; }
            .start-actions { flex-direction: column; }
        }
        .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(13,21,38,.4); z-index: 45; }
        .sidebar-overlay.visible { display: block; }
    </style>
</head>
<body>

<aside class="sidebar" id="sidebar">
    <a href="{{ path('app_homepage') }}" class="sidebar-logo">
        <div class="sidebar-logo-text">Lingua<span>Learn</span></div>
    </a>
    <div class="sidebar-user">
        <div class="user-avatar {{ user.isPremium ? 'premium' : '' }}">
            {{ user.firstName|first|upper }}{{ user.lastName|first|upper }}
        </div>
        <div class="user-info">
            <div class="user-name">{{ user.fullName }}</div>
            <div class="user-plan {{ user.isPremium ? 'premium' : 'free' }}">
                {{ user.isPremium ? '★ ' ~ user.subscriptionPlan : 'Free Plan' }}
            </div>
        </div>
    </div>
    <nav class="sidebar-nav">
        <span class="nav-section-label">Main</span>
        <a href="{{ path('user_dashboard') }}" class="nav-item"><span class="nav-icon">⊞</span> Dashboard</a>
        <a href="#" class="nav-item"><span class="nav-icon">📚</span> My Courses</a>
        <a href="#" class="nav-item"><span class="nav-icon">🧩</span> Practice</a>
        <a href="{{ path('mock_tests_index') }}" class="nav-item active"><span class="nav-icon">📝</span> Mock Tests</a>
        <span class="nav-section-label">Account</span>
        <a href="{{ path('user_profile') }}" class="nav-item"><span class="nav-icon">👤</span> My Profile</a>
        <a href="#" class="nav-item"><span class="nav-icon">🔔</span> Notifications</a>
        <a href="#" class="nav-item"><span class="nav-icon">👑</span> Subscription</a>
        <span class="nav-section-label">System</span>
        <a href="{{ path('app_logout') }}" class="nav-item"><span class="nav-icon">→</span> Log Out</a>
    </nav>
</aside>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="main">
    <header class="topbar">
        <div class="topbar-left">
            <button class="hamburger-btn" id="hamburgerBtn"><span></span><span></span><span></span></button>
            <div>
                <div class="page-heading">Ready to start?</div>
                <div class="page-sub">{{ mockTest.testType }} · {{ mockTest.level }}</div>
            </div>
        </div>
        <div class="topbar-right">
            <a href="{{ path('mock_tests_levels', {langId: mockTest.platformLanguage.id}) }}" class="topbar-btn" title="Back">←</a>
        </div>
    </header>

    <main class="page-content">
        <div class="start-wrap">

            {# Breadcrumb #}
            <div class="breadcrumb" style="margin-bottom:1.25rem;">
                <a href="{{ path('mock_tests_index') }}">Mock Tests</a>
                <span style="color:var(--border);">›</span>
                <a href="{{ path('mock_tests_by_level', {langId: mockTest.platformLanguage.id, level: mockTest.level}) }}">{{ mockTest.level }}</a>
                <span style="color:var(--border);">›</span>
                <span>{{ mockTest.title }}</span>
            </div>

            <div class="start-card reveal">
                {# Top banner #}
                <div class="start-card-top">
                    <div class="start-type-badge">{{ mockTest.testType }}</div>
                    <div class="start-title">{{ mockTest.title }}</div>
                    <div class="start-lang">
                        {{ mockTest.platformLanguage ? '🌐 ' ~ mockTest.platformLanguage.name : '' }}
                        · {{ mockTest.level }}
                    </div>
                </div>

                {# Stats #}
                <div class="start-stats">
                    <div class="start-stat">
                        <div class="start-stat-val">{{ questionsToTake }}</div>
                        <div class="start-stat-label">Questions</div>
                    </div>
                    <div class="start-stat">
                        <div class="start-stat-val">{{ mockTest.durationMinutes }}'</div>
                        <div class="start-stat-label">Duration</div>
                    </div>
                    <div class="start-stat">
                        <div class="start-stat-val">{{ availableCount }}</div>
                        <div class="start-stat-label">Pool size</div>
                    </div>
                </div>

                {# Rules #}
                <div class="start-rules">
                    <div class="start-rules-title">📋 Before you begin</div>
                    <div class="rule-item"><span class="rule-dot"></span>{{ questionsToTake }} questions will be randomly selected from a pool of {{ availableCount }}</div>
                    <div class="rule-item"><span class="rule-dot"></span>You have {{ mockTest.durationMinutes }} minutes to complete the test</div>
                    <div class="rule-item"><span class="rule-dot"></span>Each question is worth a certain number of points — choose carefully</div>
                    <div class="rule-item"><span class="rule-dot"></span>You cannot go back once you submit</div>
                    <div class="rule-item"><span class="rule-dot"></span>Your score and a detailed analysis will be shown at the end</div>
                </div>

                {# Actions #}
                <div class="start-actions">
                    <a href="{{ path('mock_tests_by_level', {langId: mockTest.platformLanguage.id, level: mockTest.level}) }}" class="btn-back">← Go back</a>
                    <a href="{{ path('mock_tests_take', {id: mockTest.id}) }}" class="btn-begin">Begin Test →</a>
                </div>
            </div>

        </div>
    </main>
</div>

<script>
    const sidebar = document.getElementById('sidebar'), overlay = document.getElementById('sidebarOverlay'), hamburger = document.getElementById('hamburgerBtn');
    hamburger.addEventListener('click', () => { sidebar.classList.toggle('open'); overlay.classList.toggle('visible'); });
    overlay.addEventListener('click', () => { sidebar.classList.remove('open'); overlay.classList.remove('visible'); });
    const ro = new IntersectionObserver(entries => { entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); ro.unobserve(e.target); } }); }, { threshold: 0.06 });
    document.querySelectorAll('.reveal').forEach(el => ro.observe(el));
</script>
</body>
</html>
