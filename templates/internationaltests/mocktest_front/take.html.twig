<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ mockTest.title }} — In Progress</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=Fraunces:ital,wght@0,300;0,400;1,300;1,400&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
    <style>
        *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
        :root{--white:#fff;--off-white:#f7f9fc;--surface:#eef1f8;--ink:#0d1526;--ink-soft:#2c3a52;--muted:#7a87a0;--border:#e2e8f2;--blue:#2563eb;--blue-dark:#1d4ed8;--blue-bg:#eff6ff;--blue-mid:#3b82f6;--green:#16a34a;--green-bg:#f0fdf4;--orange:#ea580c;--orange-bg:#fff7ed;--violet:#7c3aed;--violet-bg:#f5f3ff;--gold:#ca8a04;--radius:12px;--radius-lg:20px;}
        html{scroll-behavior:smooth;}
        body{font-family:'Sora',sans-serif;background:var(--off-white);color:var(--ink);min-height:100vh;}

        /* TOPBAR */
        .exam-topbar{position:sticky;top:0;z-index:40;background:var(--white);border-bottom:1.5px solid var(--border);padding:.85rem 2rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;}
        .exam-brand{font-family:'Fraunces',serif;font-size:1.1rem;font-weight:400;color:var(--ink);}
        .exam-brand span{color:var(--blue);}
        .exam-info{display:flex;align-items:center;gap:.85rem;}
        .exam-title{font-size:.85rem;font-weight:600;color:var(--ink);}
        .exam-badge{font-family:'DM Mono',monospace;font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;padding:.2rem .6rem;border-radius:5px;background:var(--blue-bg);color:var(--blue);}
        .exam-badge.violet{background:var(--violet-bg);color:var(--violet);}

        /* TIMER */
        .timer-wrap{display:flex;align-items:center;gap:.65rem;padding:.5rem 1rem;border-radius:100px;border:1.5px solid var(--border);background:var(--white);font-family:'DM Mono',monospace;font-size:1rem;color:var(--ink);transition:all .3s;}
        .timer-wrap.warning{border-color:var(--orange);background:var(--orange-bg);color:var(--orange);}
        .timer-wrap.danger{border-color:#dc2626;background:#fef2f2;color:#dc2626;animation:pulse 1s ease infinite;}
        @keyframes pulse{0%,100%{opacity:1;}50%{opacity:.6;}}

        /* PROGRESS */
        .progress-bar-wrap{height:4px;background:var(--border);position:sticky;top:65px;z-index:39;}
        .progress-bar-fill{height:100%;background:linear-gradient(90deg,var(--blue),var(--blue-mid));transition:width .4s ease;}

        /* LAYOUT */
        .exam-body{max-width:780px;margin:0 auto;padding:2rem 1.25rem;}

        /* DOTS NAV */
        .question-nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:1.75rem;}
        .question-counter{font-family:'DM Mono',monospace;font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);}
        .question-dots{display:flex;gap:.4rem;flex-wrap:wrap;}
        .q-dot{width:28px;height:6px;border-radius:3px;background:var(--border);transition:background .3s;cursor:pointer;}
        .q-dot.answered{background:var(--green);}
        .q-dot.current{background:var(--blue);}

        /* QUESTION CARD */
        .question-card{background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;margin-bottom:1.25rem;animation:slideIn .3s ease;}
        @keyframes slideIn{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}
        .question-card-header{padding:1.1rem 1.75rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:1rem;}
        .question-number{font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);}
        .question-section{font-family:'DM Mono',monospace;font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;padding:.2rem .6rem;border-radius:5px;background:var(--violet-bg);color:var(--violet);}
        .question-type-badge{font-family:'DM Mono',monospace;font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;padding:.2rem .6rem;border-radius:5px;background:var(--blue-bg);color:var(--blue);}
        .question-points{font-family:'DM Mono',monospace;font-size:.65rem;color:var(--gold);}
        .question-text-wrap{padding:1.75rem 1.75rem 1.25rem;}
        .question-text{font-size:.97rem;line-height:1.8;color:var(--ink);}

        /* OPTIONS */
        .options-list{padding:0 1.75rem 1.75rem;display:flex;flex-direction:column;gap:.65rem;}
        .option-item{position:relative;}
        .option-item input[type="radio"]{position:absolute;opacity:0;width:0;height:0;}
        .option-item input[type="checkbox"]{position:absolute;opacity:0;width:0;height:0;}
        .option-label{display:flex;align-items:flex-start;gap:1rem;padding:.9rem 1.1rem;border-radius:var(--radius);border:1.5px solid var(--border);cursor:pointer;transition:all .2s;background:var(--off-white);user-select:none;}
        .option-label:hover{border-color:var(--blue-mid);background:var(--blue-bg);}
        .option-item input[type="radio"]:checked + .option-label,
        .option-item input[type="checkbox"]:checked + .option-label{border-color:var(--blue);background:var(--blue-bg);box-shadow:0 0 0 3px rgba(37,99,235,.1);}
        .option-letter{width:32px;height:32px;border-radius:50%;flex-shrink:0;border:1.5px solid var(--border);background:var(--white);display:flex;align-items:center;justify-content:center;font-family:'DM Mono',monospace;font-size:.75rem;color:var(--muted);transition:all .2s;}
        .option-item input[type="radio"]:checked + .option-label .option-letter,
        .option-item input[type="checkbox"]:checked + .option-label .option-letter{background:var(--blue);border-color:var(--blue);color:var(--white);}
        .option-text{font-size:.9rem;line-height:1.6;color:var(--ink-soft);padding-top:.18rem;flex:1;}

        /* MULTIPLE CHOICE HINT */
        .multiple-hint{margin:0 1.75rem 1rem;padding:.65rem 1rem;background:var(--blue-bg);border-radius:var(--radius);font-size:.8rem;color:var(--blue);border:1px solid rgba(37,99,235,.15);}

        /* NO OPTIONS */
        .no-options-warning{padding:1.25rem 1.75rem;background:var(--orange-bg);border-radius:var(--radius);border:1.5px solid rgba(234,88,12,.2);font-size:.85rem;color:var(--orange);}

        /* NAV BUTTONS */
        .nav-actions{display:flex;align-items:center;justify-content:space-between;margin-top:1.25rem;padding-top:1rem;}
        .btn-prev{padding:.7rem 1.5rem;border-radius:100px;font-family:'Sora',sans-serif;font-size:.85rem;font-weight:500;cursor:pointer;border:1.5px solid var(--border);background:transparent;color:var(--muted);transition:all .2s;}
        .btn-prev:hover:not(:disabled){border-color:var(--ink-soft);color:var(--ink-soft);}
        .btn-prev:disabled{opacity:.35;cursor:not-allowed;}
        .btn-next{padding:.7rem 1.75rem;border-radius:100px;background:var(--blue);color:var(--white);font-family:'Sora',sans-serif;font-size:.85rem;font-weight:600;border:none;cursor:pointer;transition:all .2s;}
        .btn-next:hover{background:var(--blue-dark);transform:translateY(-1px);}
        .btn-submit-final{padding:.7rem 2rem;border-radius:100px;background:var(--green);color:var(--white);font-family:'Sora',sans-serif;font-size:.85rem;font-weight:600;border:none;cursor:pointer;transition:all .2s;}
        .btn-submit-final:hover{background:#15803d;transform:translateY(-1px);box-shadow:0 6px 18px rgba(22,163,74,.3);}

        .question-page{display:none;}
        .question-page.active{display:block;}

        /* ── MODALS ── */
        .modal-overlay{position:fixed;inset:0;background:rgba(13,21,38,.55);z-index:100;display:flex;align-items:center;justify-content:center;padding:1.5rem;opacity:0;pointer-events:none;transition:opacity .25s;}
        .modal-overlay.open{opacity:1;pointer-events:all;}
        .modal-box{background:var(--white);border-radius:var(--radius-lg);padding:2rem 2.25rem;max-width:440px;width:100%;box-shadow:0 24px 64px rgba(13,21,38,.18);transform:translateY(16px) scale(.97);transition:transform .25s;}
        .modal-overlay.open .modal-box{transform:translateY(0) scale(1);}
        .modal-icon{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.4rem;margin:0 auto 1.25rem;}
        .modal-icon.warn{background:var(--orange-bg);}
        .modal-icon.confirm{background:var(--green-bg);}
        .modal-icon.leave{background:#fef2f2;}
        .modal-title{font-family:'Fraunces',serif;font-size:1.2rem;font-weight:400;color:var(--ink);text-align:center;margin-bottom:.5rem;}
        .modal-body{font-size:.88rem;color:var(--muted);text-align:center;line-height:1.7;margin-bottom:1.75rem;}
        .modal-body strong{color:var(--ink);}
        .modal-unanswered{display:flex;align-items:center;justify-content:center;gap:.5rem;margin:.75rem 0;padding:.65rem 1.25rem;background:var(--orange-bg);border-radius:var(--radius);font-size:.85rem;font-weight:600;color:var(--orange);}
        .modal-actions{display:flex;gap:.75rem;}
        .modal-btn{flex:1;padding:.75rem 1rem;border-radius:100px;font-family:'Sora',sans-serif;font-size:.85rem;font-weight:600;cursor:pointer;transition:all .2s;border:none;text-align:center;}
        .modal-btn-cancel{background:var(--surface);color:var(--ink-soft);}
        .modal-btn-cancel:hover{background:var(--border);}
        .modal-btn-submit{background:var(--green);color:var(--white);}
        .modal-btn-submit:hover{background:#15803d;}
        .modal-btn-leave{background:#dc2626;color:var(--white);}
        .modal-btn-leave:hover{background:#b91c1c;}

        @media(max-width:768px){
            .exam-topbar{padding:.75rem 1rem;}
            .exam-info{display:none;}
            .exam-body{padding:1rem;}
            .question-dots{display:none;}
            .options-list,.question-text-wrap{padding-left:1rem;padding-right:1rem;}
        }
    </style>
</head>
<body>

<header class="exam-topbar">
    <div class="exam-brand">Lingua<span>Learn</span></div>
    <div class="exam-info">
        <span class="exam-title">{{ mockTest.title }}</span>
        <span class="exam-badge">{{ mockTest.testType }}</span>
        <span class="exam-badge violet">{{ mockTest.level }}</span>
        <span class="exam-badge" style="background:var(--green-bg);color:var(--green);">/ {{ totalScore }} pts</span>
    </div>
    <div class="timer-wrap" id="timerWrap">
        ⏱ <span id="timerDisplay">{% set m = mockTest.durationMinutes %}{{ m < 10 ? '0' ~ m : m }}:00</span>
    </div>
</header>

<div class="progress-bar-wrap">
    <div class="progress-bar-fill" id="progressFill" style="width:0%"></div>
</div>

<div class="exam-body">
    <div class="question-nav">
        <div class="question-counter">Question <span id="currentQNum">1</span> of {{ questions|length }}</div>
        <div class="question-dots" id="questionDots">
            {% for q in questions %}
                <div class="q-dot {{ loop.first ? 'current' : '' }}" data-index="{{ loop.index0 }}" title="Q{{ loop.index }}"></div>
            {% endfor %}
        </div>
    </div>

    <form method="post" action="{{ path('mock_tests_submit', {id: mockTest.id}) }}" id="examForm">
        <input type="hidden" name="_token" value="{{ csrf_token('mock_test_submit_' ~ mockTest.id) }}">

        {% for question in questions %}
            {% set qIndex = loop.index0 %}
            {% set letters = ['A','B','C','D','E','F','G','H'] %}
            {% set opts = question.options %}
            {% set qType = question.questionType %}
            {% set isMultiple = (qType == 'qcm_multiple') %}

            <div class="question-page {{ loop.first ? 'active' : '' }}" id="qPage{{ qIndex }}">
                <div class="question-card">
                    <div class="question-card-header">
                        <span class="question-number">Question {{ loop.index }}</span>
                        <span class="question-section">{{ question.sectionCategory }}</span>
                        <span class="question-type-badge">{{ qType|upper }}</span>
                        <span class="question-points">{{ question.points }} pt{{ question.points > 1 ? 's' : '' }}</span>
                    </div>

                    {# Reading Passage #}
                    {% if question.readingPassage %}
                    <div style="padding:1.5rem 1.75rem;background:var(--blue-bg);border-bottom:1px solid var(--border);">
                        <div style="font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;color:var(--blue);margin-bottom:.75rem;">📖 Reading Passage</div>
                        <div style="font-size:.92rem;line-height:1.8;color:var(--ink-soft);white-space:pre-wrap;">{{ question.readingPassage }}</div>
                    </div>
                    {% endif %}

                    <div class="question-text-wrap">
                        <div class="question-text">{{ question.questionText }}</div>
                    </div>

                    {% if isMultiple %}
                    <div class="multiple-hint">✓ Plusieurs réponses possibles — cochez toutes les bonnes réponses</div>
                    {% endif %}

                    <div class="options-list">
                        {% if opts is not empty %}
                            {% for key, val in opts %}
                                {% if val is mapping %}
                                    {% set displayText = val.text ?? val.value ?? val.label ?? (val|first) %}
                                {% else %}
                                    {% set displayText = val %}
                                {% endif %}
                                <div class="option-item">
                                    <input
                                        type="{{ isMultiple ? 'checkbox' : 'radio' }}"
                                        name="answers[{{ question.id }}]{{ isMultiple ? '[]' : '' }}"
                                        id="q{{ question.id }}_opt{{ loop.index0 }}"
                                        value="{{ displayText }}"
                                        onchange="markAnswered({{ qIndex }})"
                                    >
                                    <label for="q{{ question.id }}_opt{{ loop.index0 }}" class="option-label">
                                        <span class="option-letter">{{ letters[loop.index0] ?? loop.index }}</span>
                                        <span class="option-text">{{ displayText }}</span>
                                    </label>
                                </div>
                            {% endfor %}
                        {% else %}
                            <div class="no-options-warning">⚠️ Aucune option disponible pour cette question.</div>
                        {% endif %}
                    </div>
                </div>

                <div class="nav-actions">
                    <button type="button" class="btn-prev" onclick="goTo({{ qIndex - 1 }})" {{ loop.first ? 'disabled' : '' }}>← Previous</button>
                    {% if loop.last %}
                        <button type="button" class="btn-submit-final" onclick="openSubmitModal()">Submit Test ✓</button>
                    {% else %}
                        <button type="button" class="btn-next" onclick="goTo({{ qIndex + 1 }})">Next →</button>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </form>
</div>

<!-- ── MODAL : Unanswered questions warning ── -->
<div class="modal-overlay" id="modalUnanswered">
    <div class="modal-box">
        <div class="modal-icon warn">⚠️</div>
        <div class="modal-title">Questions sans réponse</div>
        <div class="modal-body">
            Vous avez <span id="unansweredCount"></span> question(s) sans réponse.<br>
            <div class="modal-unanswered"><span id="unansweredList"></span></div>
            Voulez-vous soumettre quand même ?
        </div>
        <div class="modal-actions">
            <button class="modal-btn modal-btn-cancel" onclick="closeModal('modalUnanswered')">← Continuer</button>
            <button class="modal-btn modal-btn-submit" onclick="doSubmit()">Soumettre quand même</button>
        </div>
    </div>
</div>

<!-- ── MODAL : Confirm submit (all answered) ── -->
<div class="modal-overlay" id="modalConfirm">
    <div class="modal-box">
        <div class="modal-icon confirm">✅</div>
        <div class="modal-title">Soumettre le test ?</div>
        <div class="modal-body">
            Toutes vos réponses sont enregistrées.<br>
            <strong>Vous ne pourrez plus les modifier après soumission.</strong>
        </div>
        <div class="modal-actions">
            <button class="modal-btn modal-btn-cancel" onclick="closeModal('modalConfirm')">← Retour</button>
            <button class="modal-btn modal-btn-submit" onclick="doSubmit()">Confirmer et soumettre</button>
        </div>
    </div>
</div>

<!-- ── MODAL : Leave / beforeunload ── -->
<div class="modal-overlay" id="modalLeave">
    <div class="modal-box">
        <div class="modal-icon leave">🚪</div>
        <div class="modal-title">Quitter le test ?</div>
        <div class="modal-body">
            Si vous quittez maintenant, votre progression sera <strong>perdue</strong> et le test sera compté comme abandonné.
        </div>
        <div class="modal-actions">
            <button class="modal-btn modal-btn-cancel" onclick="cancelLeave()">Rester</button>
            <button class="modal-btn modal-btn-leave" onclick="confirmLeave()">Quitter</button>
        </div>
    </div>
</div>

<script>
// ── Timer avec auto-submit robuste ──
const totalSeconds = {{ mockTest.durationMinutes }} * 60;
const startTime = Date.now();
const endTime = startTime + (totalSeconds * 1000);
let remaining = totalSeconds;
let timerInterval = null;
let hasAutoSubmitted = false;

const timerDisplay = document.getElementById('timerDisplay');
const timerWrap    = document.getElementById('timerWrap');
const progressFill = document.getElementById('progressFill');
const pad = n => String(n).padStart(2,'0');

function updateTimer() {
    // Calculer le temps restant basé sur l'heure réelle (plus précis)
    const now = Date.now();
    remaining = Math.max(0, Math.ceil((endTime - now) / 1000));

    // Mettre à jour l'affichage
    timerDisplay.textContent = pad(Math.floor(remaining/60)) + ':' + pad(remaining%60);
    progressFill.style.width = ((totalSeconds - remaining) / totalSeconds * 100) + '%';

    // Changer la couleur selon le temps restant
    if (remaining <= 60)       timerWrap.className = 'timer-wrap danger';
    else if (remaining <= 300) timerWrap.className = 'timer-wrap warning';

    // Auto-submit quand le temps est écoulé
    if (remaining <= 0 && !hasAutoSubmitted) {
        hasAutoSubmitted = true;
        clearInterval(timerInterval);
        console.log('⏰ Timer expired - Auto-submitting test...');
        console.log('📊 Time stats:', {
            totalSeconds: totalSeconds,
            elapsed: Math.floor((now - startTime) / 1000),
            remaining: remaining
        });

        // Fermer toutes les modales
        closeModal('modalUnanswered');
        closeModal('modalConfirm');
        closeModal('modalLeave');

        // Soumettre automatiquement
        setTimeout(() => {
            console.log('🚀 Executing auto-submit...');
            doSubmit();
        }, 100);
    }
}

// Démarrer le timer
timerInterval = setInterval(updateTimer, 1000);
updateTimer(); // Appel initial pour afficher immédiatement

let currentQ = 0;
const totalQ  = {{ questions|length }};
const answered = new Array(totalQ).fill(false);

function goTo(index) {
    if (index < 0 || index >= totalQ) return;
    document.getElementById('qPage' + currentQ).classList.remove('active');
    const dots = document.querySelectorAll('.q-dot');
    dots[currentQ].classList.remove('current');
    currentQ = index;
    document.getElementById('qPage' + currentQ).classList.add('active');
    dots[currentQ].classList.add('current');
    document.getElementById('currentQNum').textContent = currentQ + 1;
    window.scrollTo({top:0,behavior:'smooth'});
}

function markAnswered(qIndex) {
    answered[qIndex] = true;
    const dots = document.querySelectorAll('.q-dot');
    dots[qIndex].classList.add('answered');
    dots[currentQ].classList.add('current');
}

document.querySelectorAll('.q-dot').forEach((dot,i) => {
    dot.addEventListener('click', () => goTo(i));
});

// ── Modal management ──
function openModal(id) {
    document.getElementById(id).classList.add('open');
    document.body.style.overflow = 'hidden';
}
function closeModal(id) {
    document.getElementById(id).classList.remove('open');
    document.body.style.overflow = '';
}

function openSubmitModal() {
    const unanswered = answered.reduce((acc, a, i) => !a ? [...acc, i+1] : acc, []);
    if (unanswered.length > 0) {
        document.getElementById('unansweredCount').textContent = unanswered.length;
        document.getElementById('unansweredList').textContent = 'Questions : ' + unanswered.join(', ');
        openModal('modalUnanswered');
    } else {
        openModal('modalConfirm');
    }
}

function doSubmit() {
    console.log('📝 Submitting test...');
    // Prevent leave modal on intentional submit
    window.removeEventListener('click', interceptLinks);
    isSubmitting = true;
    clearInterval(timerInterval);

    // Close all modals before submitting
    closeModal('modalUnanswered');
    closeModal('modalConfirm');
    closeModal('modalLeave');

    const form = document.getElementById('examForm');
    if (form) {
        console.log('✅ Form found, submitting...');
        form.submit();
    } else {
        console.error('❌ Form not found!');
    }
}

// ── Leave / navigation interception ──
let isSubmitting = false;
let pendingHref  = null;

function interceptLinks(e) {
    if (isSubmitting) return;
    const link = e.target.closest('a[href]:not([href="#"])');
    if (link) {
        e.preventDefault();
        pendingHref = link.href;
        openModal('modalLeave');
    }
}

function cancelLeave() {
    pendingHref = null;
    closeModal('modalLeave');
}

function confirmLeave() {
    isSubmitting = true;
    clearInterval(timerInterval);
    if (pendingHref) window.location.href = pendingHref;
}

document.addEventListener('click', interceptLinks);

// Intercept browser back/forward
window.addEventListener('popstate', (e) => {
    if (!isSubmitting) {
        history.pushState(null, '', window.location.href);
        openModal('modalLeave');
    }
});
history.pushState(null, '', window.location.href);

// Intercept tab close / URL change
window.addEventListener('beforeunload', (e) => {
    if (!isSubmitting) {
        e.preventDefault();
        e.returnValue = '';
    }
});
</script>
</body>
</html>
