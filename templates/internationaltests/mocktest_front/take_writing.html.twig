<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ mockTest.title }} — Test d'Écriture</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=Fraunces:ital,wght@0,300;0,400;1,300;1,400&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
    <style>
        *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
        :root{--white:#fff;--off-white:#f7f9fc;--surface:#eef1f8;--ink:#0d1526;--ink-soft:#2c3a52;--muted:#7a87a0;--border:#e2e8f2;--blue:#2563eb;--blue-dark:#1d4ed8;--blue-bg:#eff6ff;--blue-mid:#3b82f6;--green:#16a34a;--green-bg:#f0fdf4;--orange:#ea580c;--orange-bg:#fff7ed;--violet:#7c3aed;--violet-bg:#f5f3ff;--gold:#ca8a04;--radius:12px;--radius-lg:20px;}
        html{scroll-behavior:smooth;}
        body{font-family:'Sora',sans-serif;background:var(--off-white);color:var(--ink);min-height:100vh;}

        .exam-topbar{position:sticky;top:0;z-index:40;background:var(--white);border-bottom:1.5px solid var(--border);padding:.85rem 2rem;display:flex;align-items:center;justify-content:space-between;gap:1rem;}
        .exam-brand{font-family:'Fraunces',serif;font-size:1.1rem;font-weight:400;color:var(--ink);}
        .exam-brand span{color:var(--blue);}
        .exam-info{display:flex;align-items:center;gap:.85rem;}
        .exam-title{font-size:.85rem;font-weight:600;color:var(--ink);}
        .exam-badge{font-family:'DM Mono',monospace;font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;padding:.2rem .6rem;border-radius:5px;background:var(--blue-bg);color:var(--blue);}
        .exam-badge.violet{background:var(--violet-bg);color:var(--violet);}

        .timer-wrap{display:flex;align-items:center;gap:.65rem;padding:.5rem 1rem;border-radius:100px;border:1.5px solid var(--border);background:var(--white);font-family:'DM Mono',monospace;font-size:1rem;color:var(--ink);transition:all .3s;}
        .timer-wrap.warning{border-color:var(--orange);background:var(--orange-bg);color:var(--orange);}
        .timer-wrap.danger{border-color:#dc2626;background:#fef2f2;color:#dc2626;animation:pulse 1s ease infinite;}
        @keyframes pulse{0%,100%{opacity:1;}50%{opacity:.6;}}

        .progress-bar-wrap{height:4px;background:var(--border);position:sticky;top:65px;z-index:39;}
        .progress-bar-fill{height:100%;background:linear-gradient(90deg,var(--orange),#f97316);transition:width .4s ease;}

        .exam-body{max-width:900px;margin:0 auto;padding:2rem 1.25rem;}

        .writing-card{background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;margin-bottom:1.25rem;animation:slideIn .3s ease;}
        @keyframes slideIn{from{opacity:0;transform:translateY(10px);}to{opacity:1;transform:translateY(0);}}
        .writing-card-header{padding:1.1rem 1.75rem;border-bottom:1px solid var(--border);display:flex;align-items:center;justify-content:space-between;gap:1rem;}
        .writing-label{font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;color:var(--muted);}
        .writing-badge{font-family:'DM Mono',monospace;font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;padding:.2rem .6rem;border-radius:5px;background:var(--orange-bg);color:var(--orange);}
        .writing-subject-wrap{padding:1.75rem 1.75rem 1.25rem;background:var(--orange-bg);border-bottom:1px solid rgba(234,88,12,.2);}
        .writing-subject-label{font-family:'DM Mono',monospace;font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;color:var(--orange);margin-bottom:.75rem;}
        .writing-subject{font-size:1.05rem;line-height:1.8;color:var(--ink);font-weight:500;white-space:pre-wrap;}
        .writing-textarea-wrap{padding:1.75rem;}
        .writing-textarea{width:100%;min-height:400px;padding:1.25rem;border:1.5px solid var(--border);border-radius:var(--radius);font-family:'Sora',sans-serif;font-size:.95rem;line-height:1.8;color:var(--ink);background:var(--off-white);resize:vertical;transition:all .2s;}
        .writing-textarea:focus{outline:none;border-color:var(--blue);background:var(--white);box-shadow:0 0 0 3px rgba(37,99,235,.1);}
        .writing-counter{font-family:'DM Mono',monospace;font-size:.75rem;color:var(--muted);text-align:right;margin-top:.5rem;}

        .submit-wrap{display:flex;justify-content:center;margin-top:1.5rem;}
        .btn-submit-writing{padding:.9rem 2.5rem;border-radius:100px;background:var(--orange);color:var(--white);font-family:'Sora',sans-serif;font-size:.95rem;font-weight:600;border:none;cursor:pointer;transition:all .2s;}
        .btn-submit-writing:hover{background:#c2410c;transform:translateY(-1px);box-shadow:0 6px 18px rgba(234,88,12,.3);}

        /* MODAL */
        .modal-overlay{position:fixed;inset:0;background:rgba(13,21,38,.55);z-index:100;display:none;align-items:center;justify-content:center;padding:1.5rem;}
        .modal-overlay.open{display:flex;}
        .modal-box{background:var(--white);border-radius:var(--radius-lg);padding:2rem 2.25rem;max-width:420px;width:100%;box-shadow:0 24px 64px rgba(13,21,38,.18);text-align:center;}
        .modal-icon{width:52px;height:52px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.4rem;margin:0 auto 1.25rem;background:var(--orange-bg);}
        .modal-title{font-size:1.1rem;font-weight:700;color:var(--ink);margin-bottom:.5rem;}
        .modal-body{font-size:.88rem;color:var(--muted);line-height:1.7;margin-bottom:1.75rem;}
        .modal-body strong{color:var(--ink);}
        .modal-actions{display:flex;gap:.75rem;}
        .modal-btn{flex:1;padding:.75rem;border-radius:100px;font-family:'Sora',sans-serif;font-size:.85rem;font-weight:600;cursor:pointer;border:none;transition:all .2s;}
        .modal-btn-cancel{background:var(--surface);color:var(--ink-soft);}
        .modal-btn-cancel:hover{background:var(--border);}
        .modal-btn-submit{background:var(--orange);color:var(--white);}
        .modal-btn-submit:hover{background:#c2410c;}

        @media(max-width:768px){
            .exam-topbar{padding:.75rem 1rem;}
            .exam-info{display:none;}
            .exam-body{padding:1rem;}
            .writing-textarea{min-height:300px;}
        }
    </style>
</head>
<body>

<header class="exam-topbar">
    <div class="exam-brand">Lingua<span>Learn</span></div>
    <div class="exam-info">
        <span class="exam-title">{{ mockTest.title }}</span>
        <span class="exam-badge">{{ mockTest.testType }}</span>
        <span class="exam-badge violet">{{ mockTest.level }}</span>
        <span class="exam-badge" style="background:var(--orange-bg);color:var(--orange);">Writing</span>
    </div>
    <div class="timer-wrap" id="timerWrap">
        ⏱ <span id="timerDisplay">{% set m = mockTest.durationMinutes %}{{ m < 10 ? '0' ~ m : m }}:00</span>
    </div>
</header>

<div class="progress-bar-wrap">
    <div class="progress-bar-fill" id="progressFill" style="width:0%"></div>
</div>

<div class="exam-body">
    <form method="post" action="{{ path('mock_tests_submit_writing', {id: mockTest.id}) }}" id="writingForm">
        <input type="hidden" name="_token" value="{{ csrf_token('mock_test_submit_' ~ mockTest.id) }}">

        <div class="writing-card">
            <div class="writing-card-header">
                <span class="writing-label">Test d'Écriture — {{ mockTest.level }}</span>
                <span class="writing-badge">✍️ Rédaction</span>
            </div>

            <div class="writing-subject-wrap">
                <div class="writing-subject-label">📝 Sujet généré par Gemini AI</div>
                <div class="writing-subject">{{ topicData.topic }}</div>
                {% if topicData.instructions %}
                <div style="margin-top:1rem;font-size:.88rem;color:var(--ink-soft);font-style:italic;">
                    {{ topicData.instructions }}
                </div>
                {% endif %}
                {% if topicData.wordCount %}
                <div style="margin-top:.75rem;font-family:'DM Mono',monospace;font-size:.75rem;color:var(--orange);">
                    📊 Nombre de mots recommandé : ~{{ topicData.wordCount }} mots
                </div>
                {% endif %}
            </div>

            <div class="writing-textarea-wrap">
                <textarea
                    name="essay"
                    class="writing-textarea"
                    placeholder="Commencez à écrire votre essai ici..."
                    oninput="updateWordCount(this)"
                    required
                ></textarea>
                <div class="writing-counter" id="wordCounter">0 mot</div>
            </div>
        </div>

        <div class="submit-wrap">
            <button type="button" class="btn-submit-writing" onclick="openConfirmModal()">
                Soumettre le test Writing ✓
            </button>
        </div>
    </form>
</div>

<!-- MODAL CONFIRMATION -->
<div class="modal-overlay" id="modalConfirmWriting">
    <div class="modal-box">
        <div class="modal-icon">✍️</div>
        <div class="modal-title">Soumettre le test Writing ?</div>
        <div class="modal-body">
            Vous êtes sur le point de soumettre votre test d'écriture.<br>
            <strong>Cette action est irréversible.</strong>
        </div>
        <div class="modal-actions">
            <button class="modal-btn modal-btn-cancel" onclick="closeConfirmModal()">← Continuer</button>
            <button class="modal-btn modal-btn-submit" onclick="doSubmitWriting()">Soumettre ✓</button>
        </div>
    </div>
</div>

<script>
// ── Timer avec auto-submit robuste (Writing) ──
const duration = {{ mockTest.durationMinutes }} * 60;
const startTime = Date.now();
const endTime = startTime + (duration * 1000);
let remaining = duration;
let timerInterval = null;
let hasAutoSubmitted = false;

const timerDisplay = document.getElementById('timerDisplay');
const timerWrap    = document.getElementById('timerWrap');
const progressFill = document.getElementById('progressFill');

function updateTimer() {
    const now = Date.now();
    remaining = Math.max(0, Math.ceil((endTime - now) / 1000));

    const mins = Math.floor(remaining / 60);
    const secs = remaining % 60;
    timerDisplay.textContent = `${mins < 10 ? '0' + mins : mins}:${secs < 10 ? '0' + secs : secs}`;
    progressFill.style.width = ((duration - remaining) / duration * 100) + '%';

    if (remaining <= 60)       timerWrap.className = 'timer-wrap danger';
    else if (remaining <= 300) timerWrap.className = 'timer-wrap warning';

    if (remaining <= 0 && !hasAutoSubmitted) {
        hasAutoSubmitted = true;
        clearInterval(timerInterval);
        console.log('⏰ Writing test timer expired - Auto-submitting...');

        setTimeout(() => {
            const form = document.getElementById('writingForm');
            if (form) {
                console.log('✅ Form found, submitting...');
                form.submit();
            } else {
                console.error('❌ Form not found!');
            }
        }, 100);
    }
}

timerInterval = setInterval(updateTimer, 1000);
updateTimer();

// Compteur de mots
function updateWordCount(textarea) {
    const text  = textarea.value.trim();
    const words = text ? text.split(/\s+/).length : 0;
    document.getElementById('wordCounter').textContent = words + ' mot' + (words > 1 ? 's' : '');
}

// Modal
function openConfirmModal() {
    document.getElementById('modalConfirmWriting').classList.add('open');
}
function closeConfirmModal() {
    document.getElementById('modalConfirmWriting').classList.remove('open');
}
function doSubmitWriting() {
    document.getElementById('writingForm').submit();
}
</script>

</body>
</html>
