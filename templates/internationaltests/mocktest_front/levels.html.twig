<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ language.name }} — Choose Level</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=Fraunces:ital,wght@0,300;0,400;1,300;1,400&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">
    <style>
        *,*::before,*::after{margin:0;padding:0;box-sizing:border-box;}
        :root{--white:#ffffff;--off-white:#f7f9fc;--surface:#eef1f8;--ink:#0d1526;--ink-soft:#2c3a52;--muted:#7a87a0;--border:#e2e8f2;--blue:#2563eb;--blue-dark:#1d4ed8;--blue-bg:#eff6ff;--blue-mid:#3b82f6;--green:#16a34a;--green-bg:#f0fdf4;--orange:#ea580c;--orange-bg:#fff7ed;--violet:#7c3aed;--violet-bg:#f5f3ff;--gold:#ca8a04;--gold-bg:#fefce8;--red:#dc2626;--red-bg:#fef2f2;--sidebar-w:260px;--radius:12px;--radius-lg:20px;}
        body{font-family:'Sora',sans-serif;background:var(--off-white);color:var(--ink);min-height:100vh;}
        .sidebar{position:fixed;top:0;left:0;bottom:0;width:var(--sidebar-w);background:var(--white);border-right:1px solid var(--border);display:flex;flex-direction:column;z-index:50;transition:transform .3s;}
        .sidebar-logo{padding:1.5rem 1.5rem 1.25rem;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:.75rem;text-decoration:none;}
        .sidebar-logo-text{font-family:'Fraunces',serif;font-size:1.3rem;font-weight:400;color:var(--ink);}
        .sidebar-logo-text span{color:var(--blue);}
        .sidebar-user{padding:1.25rem 1.5rem;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:.85rem;}
        .user-avatar{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--blue-mid));display:flex;align-items:center;justify-content:center;font-family:'Fraunces',serif;font-size:1rem;color:var(--white);flex-shrink:0;}
        .user-avatar.premium{background:linear-gradient(135deg,var(--gold),#fbbf24);}
        .user-info{flex:1;min-width:0;}
        .user-name{font-size:.85rem;font-weight:600;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;}
        .user-plan{font-size:.7rem;font-family:'DM Mono',monospace;letter-spacing:.08em;text-transform:uppercase;margin-top:.1rem;}
        .user-plan.free{color:var(--muted);}.user-plan.premium{color:var(--gold);}
        .sidebar-nav{flex:1;padding:1rem 0;overflow-y:auto;}
        .nav-section-label{font-family:'DM Mono',monospace;font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);padding:.75rem 1.5rem .35rem;display:block;}
        .nav-item{display:flex;align-items:center;gap:.75rem;padding:.65rem 1.5rem;font-size:.84rem;font-weight:500;color:var(--muted);text-decoration:none;transition:color .2s,background .2s;position:relative;}
        .nav-item:hover{color:var(--ink);background:var(--off-white);}
        .nav-item.active{color:var(--blue);background:var(--blue-bg);font-weight:600;}
        .nav-item.active::before{content:'';position:absolute;left:0;top:4px;bottom:4px;width:3px;background:var(--blue);border-radius:0 3px 3px 0;}
        .nav-icon{font-size:1.1rem;width:20px;text-align:center;}
        .main{margin-left:var(--sidebar-w);min-height:100vh;display:flex;flex-direction:column;}
        .topbar{position:sticky;top:0;z-index:40;background:rgba(255,255,255,.92);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:.85rem 2rem;display:flex;align-items:center;justify-content:space-between;}
        .page-heading{font-family:'Fraunces',serif;font-size:1.25rem;font-weight:400;color:var(--ink);}
        .page-sub{font-size:.78rem;color:var(--muted);margin-top:.1rem;}
        .topbar-right{display:flex;align-items:center;gap:.75rem;}
        .topbar-btn{width:38px;height:38px;border-radius:var(--radius);border:1.5px solid var(--border);background:transparent;display:flex;align-items:center;justify-content:center;text-decoration:none;font-size:1.1rem;color:var(--ink-soft);transition:border-color .2s,background .2s;}
        .topbar-btn:hover{border-color:var(--blue);background:var(--blue-bg);color:var(--blue);}
        .hamburger-btn{display:none;width:38px;height:38px;border-radius:var(--radius);border:1.5px solid var(--border);background:transparent;align-items:center;justify-content:center;cursor:pointer;flex-direction:column;gap:4px;}
        .hamburger-btn span{width:16px;height:1.5px;background:var(--ink);display:block;border-radius:2px;}
        .page-content{padding:2rem;flex:1;}
        .section-eyebrow{display:inline-flex;align-items:center;gap:.5rem;font-family:'DM Mono',monospace;font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:var(--blue);margin-bottom:.5rem;}
        .section-eyebrow::before{content:'';width:14px;height:2px;background:var(--blue);border-radius:2px;}
        .breadcrumb{display:flex;align-items:center;gap:.5rem;font-size:.78rem;color:var(--muted);margin-bottom:1.5rem;}
        .breadcrumb a{color:var(--blue);text-decoration:none;font-weight:500;}
        .reveal{opacity:0;transform:translateY(16px);transition:opacity .5s,transform .5s;}
        .reveal.visible{opacity:1;transform:translateY(0);}
        .d1{transition-delay:.08s}.d2{transition-delay:.16s}.d3{transition-delay:.24s}

        /* FLASH */
        .flash-error{background:var(--red-bg);border:1.5px solid rgba(220,38,38,.2);border-radius:var(--radius);padding:.85rem 1.1rem;font-size:.85rem;color:var(--red);margin-bottom:1.25rem;display:flex;align-items:center;gap:.6rem;}

        /* LEVELS GRID */
        .levels-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:1.25rem;margin-bottom:2rem;}

        .level-card{background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius-lg);padding:2rem 1.75rem;display:flex;flex-direction:column;gap:1rem;transition:all .3s;position:relative;overflow:hidden;}
        .level-card.unlocked{text-decoration:none;color:var(--ink);}
        .level-card.unlocked:hover{transform:translateY(-5px);box-shadow:0 16px 40px rgba(13,21,38,.1);}
        .level-card.locked{opacity:.6;cursor:not-allowed;background:var(--surface);}

        /* Barre couleur en haut */
        .level-card.unlocked::before{content:'';position:absolute;top:0;left:0;right:0;height:4px;opacity:0;transition:opacity .3s;}
        .level-card.unlocked:hover::before{opacity:1;}
        .level-card.beginner.unlocked::before{background:linear-gradient(90deg,var(--green),#4ade80);}
        .level-card.intermediate.unlocked::before{background:linear-gradient(90deg,var(--blue),var(--blue-mid));}
        .level-card.advanced.unlocked::before{background:linear-gradient(90deg,var(--violet),#a78bfa);}

        .level-icon{width:56px;height:56px;border-radius:var(--radius);display:flex;align-items:center;justify-content:center;font-size:1.6rem;}
        .li-green{background:var(--green-bg);}
        .li-blue{background:var(--blue-bg);}
        .li-violet{background:var(--violet-bg);}
        .li-gray{background:var(--surface);}

        .level-name{font-family:'Fraunces',serif;font-size:1.35rem;font-weight:400;color:var(--ink);}
        .level-desc{font-size:.82rem;color:var(--muted);line-height:1.6;}

        .level-footer{display:flex;align-items:center;justify-content:space-between;margin-top:auto;padding-top:1rem;border-top:1px solid var(--border);}
        .level-count{font-family:'DM Mono',monospace;font-size:.72rem;color:var(--muted);}
        .level-count strong{color:var(--ink);font-size:1.1rem;font-family:'Fraunces',serif;font-weight:300;}

        /* Score badge */
        .score-badge{display:inline-flex;align-items:center;gap:.35rem;padding:.25rem .7rem;border-radius:100px;font-family:'DM Mono',monospace;font-size:.65rem;font-weight:400;}
        .sb-pass{background:var(--green-bg);color:var(--green);}
        .sb-fail{background:var(--orange-bg);color:var(--orange);}
        .sb-none{background:var(--surface);color:var(--muted);}

        /* Lock icon */
        .lock-badge{display:inline-flex;align-items:center;gap:.4rem;padding:.3rem .75rem;border-radius:100px;font-size:.72rem;font-weight:600;background:var(--surface);color:var(--muted);border:1px solid var(--border);}

        /* PASS INFO */
        .pass-info{background:var(--blue-bg);border:1.5px solid rgba(37,99,235,.15);border-radius:var(--radius-lg);padding:1.25rem 1.75rem;margin-bottom:1.75rem;display:flex;align-items:center;gap:1rem;}
        .pass-info-icon{font-size:1.5rem;flex-shrink:0;}
        .pass-info-text{font-size:.85rem;color:var(--blue);line-height:1.6;}
        .pass-info-text strong{font-weight:700;}

        @media(max-width:1024px){.levels-grid{grid-template-columns:1fr 1fr;}}
        @media(max-width:768px){
            :root{--sidebar-w:0px;}
            .sidebar{transform:translateX(-260px);width:260px;}
            .sidebar.open{transform:translateX(0);}
            .main{margin-left:0;}
            .hamburger-btn{display:flex;}
            .page-content{padding:1.25rem;}
            .levels-grid{grid-template-columns:1fr;}
        }
        .sidebar-overlay{display:none;position:fixed;inset:0;background:rgba(13,21,38,.4);z-index:45;}
        .sidebar-overlay.visible{display:block;}
    </style>
</head>
<body>
<aside class="sidebar" id="sidebar">
    <a href="{{ path('app_homepage') }}" class="sidebar-logo">
        <div class="sidebar-logo-text">Lingua<span>Learn</span></div>
    </a>
    <div class="sidebar-user">
        <div class="user-avatar {{ user.isPremium ? 'premium' : '' }}">{{ user.firstName|first|upper }}{{ user.lastName|first|upper }}</div>
        <div class="user-info">
            <div class="user-name">{{ user.fullName }}</div>
            <div class="user-plan {{ user.isPremium ? 'premium' : 'free' }}">{{ user.isPremium ? '★ ' ~ user.subscriptionPlan : 'Free Plan' }}</div>
        </div>
    </div>
    <nav class="sidebar-nav">
        <span class="nav-section-label">Main</span>
        <a href="{{ path('user_dashboard') }}" class="nav-item"><span class="nav-icon">⊞</span> Dashboard</a>
        <a href="#" class="nav-item"><span class="nav-icon">📚</span> My Courses</a>
        <a href="{{ path('learn_practice') }}" class="nav-item"><span class="nav-icon">🧩</span> Practice</a>
        <a href="{{ path('mock_tests_index') }}" class="nav-item active"><span class="nav-icon">📝</span> Mock Tests</a>
        <span class="nav-section-label">Account</span>
        <a href="{{ path('user_profile') }}" class="nav-item"><span class="nav-icon">👤</span> My Profile</a>
        <a href="#" class="nav-item"><span class="nav-icon">🔔</span> Notifications</a>
        <a href="#" class="nav-item"><span class="nav-icon">👑</span> Subscription</a>
        <span class="nav-section-label">System</span>
        <a href="{{ path('app_logout') }}" class="nav-item"><span class="nav-icon">→</span> Log Out</a>
    </nav>
</aside>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="main">
    <header class="topbar">
        <div style="display:flex;align-items:center;gap:1rem;">
            <button class="hamburger-btn" id="hamburgerBtn"><span></span><span></span><span></span></button>
            <div>
                <div class="page-heading">{{ language.name }} — Levels</div>
                <div class="page-sub">Step 2 — Choose your level</div>
            </div>
        </div>
        <div class="topbar-right">
            <a href="{{ path('mock_tests_index') }}" class="topbar-btn" title="Back">←</a>
            <a href="{{ path('mock_tests_my_results') }}" class="topbar-btn" title="My Results">📊</a>
        </div>
    </header>

    <main class="page-content">

        {% for msg in app.flashes('error') %}
            <div class="flash-error">✗ {{ msg }}</div>
        {% endfor %}

        <div class="breadcrumb">
            <a href="{{ path('mock_tests_index') }}">Mock Tests</a>
            <span>›</span>
            <span>{{ language.name }}</span>
        </div>

        <div class="pass-info reveal">
            <span class="pass-info-icon">🎯</span>
            <div class="pass-info-text">
                Score <strong>{{ passScore }}/{{ totalScore }}</strong> or more to unlock the next level.
                Each test is scored out of <strong>{{ totalScore }}</strong> — 10 random questions per session.
            </div>
        </div>

        <div class="section-eyebrow">Choose your level</div>
        <div class="levels-grid">

            {% for level in levels %}
                {% set isUnlocked = unlockedLevels[level] ?? false %}
                {% set count = countByLevel[level] ?? 0 %}
                {% set best = bestScoreByLevel[level] ?? null %}
                {% set isPassed = best is not null and best >= passScore %}

                {% if isUnlocked %}
                    <a href="{{ path('mock_tests_by_level', {langId: language.id, level: level}) }}"
                       class="level-card unlocked {{ level|lower }} reveal d{{ loop.index0 }}">
                {% else %}
                    <div class="level-card locked {{ level|lower }} reveal d{{ loop.index0 }}">
                {% endif %}

                        <div class="level-icon
                            {% if level == 'Beginner' %}li-green
                            {% elseif level == 'Intermediate' %}li-blue
                            {% elseif level == 'Advanced' %}li-violet
                            {% endif %}
                            {% if not isUnlocked %}li-gray{% endif %}">
                            {% if not isUnlocked %}🔒
                            {% elseif level == 'Beginner' %}🌱
                            {% elseif level == 'Intermediate' %}📘
                            {% else %}🏆{% endif %}
                        </div>

                        <div>
                            <div class="level-name">{{ level }}</div>
                            <div class="level-desc">
                                {% if level == 'Beginner' %}Foundation vocabulary and basic grammar structures.
                                {% elseif level == 'Intermediate' %}Strengthen comprehension with complex structures.
                                {% else %}Master advanced topics for top-score performance.{% endif %}
                            </div>
                        </div>

                        <div class="level-footer">
                            <div class="level-count"><strong>{{ count }}</strong> tests</div>

                            {% if not isUnlocked %}
                                <span class="lock-badge">🔒 Locked</span>
                            {% elseif best is not null %}
                                <span class="score-badge {{ isPassed ? 'sb-pass' : 'sb-fail' }}">
                                    {{ isPassed ? '✓' : '✗' }} Best: {{ best|number_format(1) }}/{{ totalScore }}
                                </span>
                            {% else %}
                                <span class="score-badge sb-none">Not started</span>
                            {% endif %}
                        </div>

                {% if isUnlocked %}
                    </a>
                {% else %}
                    </div>
                {% endif %}
            {% endfor %}

        </div>

    </main>
</div>
<script>
    const sidebar=document.getElementById('sidebar'),overlay=document.getElementById('sidebarOverlay'),hamburger=document.getElementById('hamburgerBtn');
    hamburger.addEventListener('click',()=>{sidebar.classList.toggle('open');overlay.classList.toggle('visible');});
    overlay.addEventListener('click',()=>{sidebar.classList.remove('open');overlay.classList.remove('visible');});
    const ro=new IntersectionObserver(entries=>{entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');ro.unobserve(e.target);}});},{threshold:0.06});
    document.querySelectorAll('.reveal').forEach(el=>ro.observe(el));
</script>
</body>
</html>
