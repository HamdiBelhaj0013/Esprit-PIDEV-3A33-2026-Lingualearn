{% extends 'layouts/admin.html.twig' %}

{% block title %}Create Test Result - {{ parent() }}{% endblock %}

{% block page_title %}
    <i class="ti ti-plus me-2"></i> Create Test Result
{% endblock %}

{% block page_actions %}
    <div class="col-auto ms-auto d-print-none">
        <a href="{{ path('testresult_index') }}" class="btn btn-secondary">
            <i class="ti ti-arrow-left icon"></i>
            Back to List
        </a>
    </div>
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Test Result Information</h3>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">{{ form_label(form.mockTest) }}</label>
                            {{ form_widget(form.mockTest, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.mockTest) }}
                            <small class="form-hint">Select the mock test</small>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label required">{{ form_label(form.user) }}</label>
                            {{ form_widget(form.user, {'attr': {'class': 'form-select'}}) }}
                            {{ form_errors(form.user) }}
                            <small class="form-hint">Select the user who took the test</small>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label required">{{ form_label(form.overallScore) }}</label>
                            {{ form_widget(form.overallScore, {'attr': {'class': 'form-control', 'step': '0.01'}}) }}
                            {{ form_errors(form.overallScore) }}
                            <small class="form-hint">Enter the overall score</small>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">{{ form_label(form.aiPredictedScore) }}</label>
                            {{ form_widget(form.aiPredictedScore, {'attr': {'class': 'form-control', 'step': '0.01'}}) }}
                            {{ form_errors(form.aiPredictedScore) }}
                            <small class="form-hint">AI predicted score (optional)</small>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">{{ form_label(form.aiWeaknessReport) }}</label>
                        {{ form_widget(form.aiWeaknessReport, {'attr': {'class': 'form-control', 'rows': '6'}}) }}
                        {{ form_errors(form.aiWeaknessReport) }}
                        <small class="form-hint">Rapport de faiblesses détecté par l'IA (optionnel)</small>
                    </div>

                    <div class="card-footer bg-transparent mt-3">
                        <div class="d-flex">
                            <a href="{{ path('testresult_index') }}" class="btn btn-link">Cancel</a>
                            <button type="submit" class="btn btn-primary ms-auto">
                                <i class="ti ti-check icon"></i>
                                Create Test Result
                            </button>
                        </div>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>

            {# Helper Card #}
            <div class="card mt-3">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-info-circle me-2"></i>
                        Tips for Creating Test Results
                    </h3>
                </div>
                <div class="card-body">
                    <ul class="mb-0">
                        <li>Select the appropriate mock test and user</li>
                        <li>Enter the overall score achieved by the user</li>
                        <li>Optionally add AI predicted score for comparison</li>
                        <li>AI weakness report should be valid JSON format</li>
                        <li>Example JSON: {"grammar": "weak", "vocabulary": "strong"}</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

