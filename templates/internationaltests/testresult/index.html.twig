{% extends 'layouts/admin.html.twig' %}

{% block title %}Test Results - {{ parent() }}{% endblock %}

{% block page_title %}
    <i class="ti ti-chart-bar me-2"></i> Test Results
{% endblock %}

{% block page_actions %}
    <div class="col-auto ms-auto d-print-none">
        <a href="{{ path('testresult_new') }}" class="btn btn-primary">
            <i class="ti ti-plus icon"></i>
            Create Test Result
        </a>
    </div>
{% endblock %}

{% block content %}
    {# Statistics Cards #}
    <div class="row row-cards mb-3">
        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="subheader">Total Results</div>
                        <div class="ms-auto">
                            <button class="btn btn-sm btn-ghost-secondary" id="refreshStats" title="Refresh">
                                <i class="ti ti-refresh"></i>
                            </button>
                        </div>
                    </div>
                    <div class="h1 mb-0" id="statTotal">{{ statistics.total }}</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="subheader">Average Score</div>
                    <div class="h1 mb-0 text-success" id="statAvgScore">{{ statistics.avgScore }}</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="subheader">Average AI Score</div>
                    <div class="h1 mb-0 text-blue" id="statAvgAiScore">{{ statistics.avgScore }}</div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-3">
            <div class="card">
                <div class="card-body">
                    <div class="subheader">Mock Tests Covered</div>
                    <div class="h1 mb-0 text-purple" id="statMockTests">{{ statistics.totalMockTests }}</div>
                </div>
            </div>
        </div>
    </div>

    {# Filters & Search Card #}
    <div class="card mb-3">
        <div class="card-header">
            <h3 class="card-title">Filters & Search</h3>
        </div>
        <div class="card-body">
            <div class="row g-2">
                {# Filter by Mock Test #}
                <div class="col-md-3">
                    <select id="mockTestFilter" class="form-select">
                        <option value="">All Mock Tests</option>
                        {% for mockTest in mockTests %}
                            <option value="{{ mockTest.id }}">{{ mockTest.title }}</option>
                        {% endfor %}
                    </select>
                </div>

                {# Filter by User #}
                <div class="col-md-3">
                    <select id="userFilter" class="form-select">
                        <option value="">All Users</option>
                        {% for user in users %}
                            <option value="{{ user.id }}">{{ user.email }}</option>
                        {% endfor %}
                    </select>
                </div>

                {# Sort By #}
                <div class="col-md-2">
                    <select id="sortBy" class="form-select">
                        <option value="dateTaken" selected>Sort by Date</option>
                        <option value="overallScore">Sort by Score</option>
                        <option value="aiPredictedScore">Sort by AI Score</option>
                    </select>
                </div>

                {# Sort Order #}
                <div class="col-md-2">
                    <select id="sortOrder" class="form-select">
                        <option value="DESC" selected>↓ DESC</option>
                        <option value="ASC">↑ ASC</option>
                    </select>
                </div>

                {# Reset Button #}
                <div class="col-md-2">
                    <button id="resetFilters" class="btn btn-secondary w-100" title="Reset filters">
                        <i class="ti ti-refresh"></i> Reset
                    </button>
                </div>
            </div>
        </div>
    </div>

    {# Main Table Card #}
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">
                All Test Results 
                <span class="badge bg-blue ms-2" id="resultCount">{{ testResults|length }}</span>
            </h3>
        </div>
        <div class="table-responsive">
            <table class="table table-vcenter card-table table-striped" id="resultsTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>User</th>
                        <th>Mock Test</th>
                        <th>Overall Score</th>
                        <th>AI Predicted Score</th>
                        <th>Date Taken</th>
                        <th class="w-1">Actions</th>
                    </tr>
                </thead>
                <tbody id="tableBody">
                    {% for result in testResults %}
                    <tr data-result-id="{{ result.id }}">
                        <td class="text-muted">#{{ result.id }}</td>
                        <td>
                            <span class="text-reset">{{ result.user.email }}</span>
                        </td>
                        <td>
                            <a href="{{ path('mocktest_show', {id: result.mockTest.id}) }}" class="text-reset">
                                <strong>{{ result.mockTest.title }}</strong>
                            </a>
                        </td>
                        <td>
                            <span class="badge bg-success">{{ result.overallScore }}</span>
                        </td>
                        <td>
                            {% if result.aiPredictedScore %}
                                <span class="badge bg-blue">{{ result.aiPredictedScore }}</span>
                            {% else %}
                                <span class="text-muted">N/A</span>
                            {% endif %}
                        </td>
                        <td>
                            <span class="text-muted" title="{{ result.dateTaken|date('Y-m-d H:i:s') }}">
                                {{ result.dateTaken|date('Y-m-d') }}
                            </span>
                        </td>
                        <td>
                            <div class="btn-list flex-nowrap">
                                <a href="{{ path('testresult_show', {id: result.id}) }}"
                                   class="btn btn-sm btn-ghost-primary" title="View">
                                    <i class="ti ti-eye"></i>
                                </a>
                                <a href="{{ path('testresult_edit', {id: result.id}) }}"
                                   class="btn btn-sm btn-ghost-primary" title="Edit">
                                    <i class="ti ti-pencil"></i>
                                </a>
                                <form method="post"
                                      action="{{ path('testresult_delete', {id: result.id}) }}"
                                      style="display:inline;"
                                      onsubmit="return confirm('Are you sure you want to delete this test result?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ result.id) }}">
                                    <button type="submit" class="btn btn-sm btn-ghost-danger" title="Delete">
                                        <i class="ti ti-trash"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr id="emptyRow">
                        <td colspan="7" class="text-center py-5">
                            <div class="empty">
                                <div class="empty-img">
                                    <i class="ti ti-chart-bar" style="font-size: 128px; opacity: 0.2;"></i>
                                </div>
                                <p class="empty-title">No test results found</p>
                                <p class="empty-subtitle text-muted">
                                    Get started by creating your first test result.
                                </p>
                                <div class="empty-action">
                                    <a href="{{ path('testresult_new') }}" class="btn btn-primary">
                                        <i class="ti ti-plus icon"></i>
                                        Create your first test result
                                    </a>
                                </div>
                            </div>
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Elements
            const mockTestFilter = document.getElementById('mockTestFilter');
            const userFilter = document.getElementById('userFilter');
            const sortBy = document.getElementById('sortBy');
            const sortOrder = document.getElementById('sortOrder');
            const resetBtn = document.getElementById('resetFilters');
            const tableBody = document.getElementById('tableBody');
            const resultCount = document.getElementById('resultCount');
            const refreshStatsBtn = document.getElementById('refreshStats');

            // AJAX Search function
            function performSearch() {
                const params = new URLSearchParams({
                    mockTestId: mockTestFilter.value,
                    userId: userFilter.value,
                    sortBy: sortBy.value,
                    sortOrder: sortOrder.value
                });

                fetch('{{ path("testresult_search") }}?' + params)
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            updateTable(data.data);
                            resultCount.textContent = data.count;
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        showNotification('Error loading data', 'danger');
                    });
            }

            // Update table with search results
            function updateTable(results) {
                tableBody.innerHTML = '';

                if (results.length === 0) {
                    tableBody.innerHTML = `
                        <tr id="emptyRow">
                            <td colspan="7" class="text-center py-5">
                                <div class="empty">
                                    <p class="empty-title">No results found</p>
                                    <p class="empty-subtitle text-muted">Try adjusting your filters</p>
                                </div>
                            </td>
                        </tr>
                    `;
                    return;
                }

                results.forEach(result => {
                    const aiScoreBadge = result.aiPredictedScore
                        ? `<span class="badge bg-blue">${result.aiPredictedScore}</span>`
                        : '<span class="text-muted">N/A</span>';

                    const row = `
                        <tr data-result-id="${result.id}">
                            <td class="text-muted">#${result.id}</td>
                            <td>
                                <span class="text-reset">${escapeHtml(result.userEmail)}</span>
                            </td>
                            <td>
                                <a href="/internationaltests/mocktest/${result.mockTestId}" class="text-reset">
                                    <strong>${escapeHtml(result.mockTestTitle)}</strong>
                                </a>
                            </td>
                            <td><span class="badge bg-success">${result.overallScore}</span></td>
                            <td>${aiScoreBadge}</td>
                            <td>
                                <span class="text-muted">${formatDate(result.dateTaken)}</span>
                            </td>
                            <td>
                                <div class="btn-list flex-nowrap">
                                    <a href="/internationaltests/testresult/${result.id}"
                                       class="btn btn-sm btn-ghost-primary" title="View">
                                        <i class="ti ti-eye"></i>
                                    </a>
                                    <a href="/internationaltests/testresult/${result.id}/edit"
                                       class="btn btn-sm btn-ghost-primary" title="Edit">
                                        <i class="ti ti-pencil"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    `;
                    tableBody.innerHTML += row;
                });
            }

            // Refresh statistics
            function refreshStats() {
                fetch('{{ path("testresult_stats_refresh") }}')
                    .then(response => response.json())
                    .then(data => {
                        if (data.success) {
                            document.getElementById('statTotal').textContent = data.statistics.total;
                            document.getElementById('statAvgScore').textContent = data.statistics.avgScore;
                            document.getElementById('statAvgAiScore').textContent = data.statistics.avgAiScore;
                            document.getElementById('statMockTests').textContent = data.statistics.totalMockTests;
                        }
                    })
                    .catch(error => console.error('Error refreshing stats:', error));
            }

            // Event listeners for filters
            mockTestFilter.addEventListener('change', performSearch);
            userFilter.addEventListener('change', performSearch);
            sortBy.addEventListener('change', performSearch);
            sortOrder.addEventListener('change', performSearch);
            refreshStatsBtn.addEventListener('click', refreshStats);

            // Reset filters
            resetBtn.addEventListener('click', function() {
                mockTestFilter.value = '';
                userFilter.value = '';
                sortBy.value = 'dateTaken';
                sortOrder.value = 'DESC';
                performSearch();
            });

            // Utility functions
            function escapeHtml(text) {
                const map = {
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#039;'
                };
                return text.replace(/[&<>"']/g, m => map[m]);
            }

            function formatDate(dateString) {
                const date = new Date(dateString);
                return date.toLocaleDateString('en-US', {
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit'
                });
            }

            function showNotification(message, type = 'info') {
                const alertDiv = document.createElement('div');
                alertDiv.className = `alert alert-${type} alert-dismissible fade show position-fixed top-0 end-0 m-3`;
                alertDiv.style.zIndex = '9999';
                alertDiv.innerHTML = `
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                `;
                document.body.appendChild(alertDiv);

                setTimeout(() => {
                    alertDiv.remove();
                }, 3000);
            }
        });
    </script>
{% endblock %}

