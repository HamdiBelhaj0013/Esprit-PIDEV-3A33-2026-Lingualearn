<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Set new password — LinguaLearn</title>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600&family=Fraunces:ital,wght@0,300;0,400;1,300;1,400&display=swap" rel="stylesheet">
<style>
  *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
  :root{--blue:#2563eb;--blue-dark:#1d4ed8;--blue-bg:#eff6ff;--green:#16a34a;--green-bg:#f0fdf4;--border:#e2e8f2;--ink:#0d1526;--muted:#7a87a0;--off:#f7f9fc}
  body{font-family:'Sora',sans-serif;background:var(--off);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:1.5rem}
  .card{background:#fff;border:1.5px solid var(--border);border-radius:20px;padding:2.75rem 2.25rem;max-width:420px;width:100%;box-shadow:0 8px 40px rgba(13,21,38,.07)}
  .logo{font-family:'Fraunces',serif;font-size:1.5rem;color:var(--ink);text-decoration:none;display:block;margin-bottom:1.75rem}
  .logo span{color:var(--blue)}
  .icon{width:60px;height:60px;background:var(--green-bg);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.65rem;margin-bottom:1.1rem;border:1.5px solid rgba(22,163,74,.15)}
  h1{font-family:'Fraunces',serif;font-size:1.55rem;font-weight:300;color:var(--ink);margin-bottom:.55rem}
  .desc{font-size:.87rem;color:var(--muted);line-height:1.65;margin-bottom:1.6rem}
  .form-group{margin-bottom:1rem}
  label{display:block;font-size:.78rem;font-weight:600;color:var(--ink);margin-bottom:.4rem}
  .input-wrap{position:relative}
  input[type=password]{width:100%;padding:.72rem 2.8rem .72rem 1rem;border:1.5px solid var(--border);border-radius:10px;font-family:'Sora',sans-serif;font-size:.9rem;color:var(--ink);background:var(--off);outline:none;transition:border-color .2s,box-shadow .2s}
  input[type=password]:focus{border-color:var(--blue);background:#fff;box-shadow:0 0 0 3px rgba(37,99,235,.1)}
  .eye{position:absolute;right:.75rem;top:50%;transform:translateY(-50%);background:none;border:none;cursor:pointer;font-size:1rem;color:var(--muted);padding:0}
  .hint{font-size:.72rem;color:var(--muted);margin-top:.35rem}
  .strength{height:4px;border-radius:10px;background:var(--border);margin-top:.5rem;overflow:hidden}
  .strength-bar{height:100%;border-radius:10px;width:0;transition:width .3s,background .3s}
  .btn{width:100%;padding:.82rem;border-radius:100px;background:var(--blue);color:#fff;font-family:'Sora',sans-serif;font-size:.9rem;font-weight:600;border:none;cursor:pointer;margin-top:.5rem;transition:background .2s}
  .btn:hover{background:var(--blue-dark)}
  .flash-err{background:#fef2f2;border:1.5px solid rgba(220,38,38,.2);border-radius:10px;padding:.8rem 1rem;font-size:.84rem;color:#dc2626;margin-bottom:1.1rem}
  .back{display:block;text-align:center;margin-top:1.1rem;font-size:.82rem;color:var(--muted);text-decoration:none}
  .back:hover{color:var(--blue)}
</style>
</head>
<body>
<div class="card">
  <a href="/" class="logo">Lingua<span>Learn</span></a>
  <div class="icon">🛡️</div>
  <h1>Set a new password</h1>
  <p class="desc">Choose a strong password of at least 6 characters.</p>

  {% for msg in app.flashes('danger') %}<div class="flash-err">✗ {{ msg }}</div>{% endfor %}

  <form method="post" action="{{ path('password_reset_confirm') }}" id="resetForm">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">
    <input type="hidden" name="token" value="{{ token }}">
    <input type="hidden" name="email" value="{{ email }}">

    <div class="form-group">
      <label for="new_password">New password</label>
      <div class="input-wrap">
        <input type="password" id="new_password" name="new_password"
               placeholder="At least 6 characters" required minlength="6"
               oninput="checkStrength(this.value)">
        <button type="button" class="eye" onclick="togglePwd('new_password',this)">👁</button>
      </div>
      <div class="strength"><div class="strength-bar" id="strengthBar"></div></div>
      <div class="hint" id="strengthHint"></div>
    </div>

    <div class="form-group">
      <label for="confirm_password">Confirm password</label>
      <div class="input-wrap">
        <input type="password" id="confirm_password" name="confirm_password"
               placeholder="Repeat your password" required minlength="6">
        <button type="button" class="eye" onclick="togglePwd('confirm_password',this)">👁</button>
      </div>
    </div>

    <button type="submit" class="btn">Update password</button>
  </form>
  <a href="{{ path('app_login') }}" class="back">← Back to login</a>
</div>

<script>
function togglePwd(id, btn) {
    const el = document.getElementById(id);
    if (el.type === 'password') { el.type = 'text';     btn.textContent = '🙈'; }
    else                        { el.type = 'password'; btn.textContent = '👁';  }
}

function checkStrength(val) {
    const bar  = document.getElementById('strengthBar');
    const hint = document.getElementById('strengthHint');
    let score  = 0;
    if (val.length >= 6)  score++;
    if (val.length >= 10) score++;
    if (/[A-Z]/.test(val) && /[a-z]/.test(val)) score++;
    if (/\d/.test(val))   score++;
    if (/[^A-Za-z0-9]/.test(val)) score++;

    const levels = [
        { w:'0%',   bg:'var(--border)',  label:'' },
        { w:'25%',  bg:'#ef4444',        label:'Weak' },
        { w:'50%',  bg:'#f97316',        label:'Fair' },
        { w:'75%',  bg:'#eab308',        label:'Good' },
        { w:'100%', bg:'var(--green)',   label:'Strong' },
    ];
    const lvl = levels[Math.min(score, 4)];
    bar.style.width      = lvl.w;
    bar.style.background = lvl.bg;
    hint.textContent     = lvl.label;
    hint.style.color     = lvl.bg;
}

// Prevent submit if passwords don't match (client-side UX)
document.getElementById('resetForm').addEventListener('submit', function(e) {
    const a = document.getElementById('new_password').value;
    const b = document.getElementById('confirm_password').value;
    if (a !== b) {
        e.preventDefault();
        document.getElementById('confirm_password').style.borderColor = '#ef4444';
        document.getElementById('confirm_password').focus();
    }
});
</script>
</body>
</html>
