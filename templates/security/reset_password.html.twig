<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset password — LinguaLearn</title>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600&family=Fraunces:ital,wght@0,300;0,400;1,300;1,400&display=swap" rel="stylesheet">
    <style>
        *,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
        :root{--blue:#2563eb;--blue-dark:#1d4ed8;--blue-bg:#eff6ff;--green:#16a34a;--green-bg:#f0fdf4;--border:#e2e8f2;--ink:#0d1526;--muted:#7a87a0;--off:#f7f9fc}
        body{font-family:'Sora',sans-serif;background:var(--off);min-height:100vh;display:flex;align-items:center;justify-content:center;padding:1.5rem}
        .card{background:#fff;border:1.5px solid var(--border);border-radius:20px;padding:2.75rem 2.25rem;max-width:420px;width:100%;box-shadow:0 8px 40px rgba(13,21,38,.07)}
        .logo{font-family:'Fraunces',serif;font-size:1.5rem;color:var(--ink);text-decoration:none;display:block;margin-bottom:1.75rem}
        .logo span{color:var(--blue)}
        .icon{width:60px;height:60px;background:#fefce8;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.65rem;margin-bottom:1.1rem;border:1.5px solid rgba(202,138,4,.15)}
        h1{font-family:'Fraunces',serif;font-size:1.55rem;font-weight:300;color:var(--ink);margin-bottom:.55rem}
        .desc{font-size:.87rem;color:var(--muted);line-height:1.65;margin-bottom:1.6rem}
        label{display:block;font-size:.78rem;font-weight:600;color:var(--ink);margin-bottom:.4rem}
        input[type=password]{width:100%;padding:.72rem 1rem;border:1.5px solid var(--border);border-radius:10px;font-family:'Sora',sans-serif;font-size:.9rem;color:var(--ink);background:var(--off);outline:none;transition:border-color .2s,box-shadow .2s;margin-bottom:1rem}
        input[type=password]:focus{border-color:var(--blue);background:#fff;box-shadow:0 0 0 3px rgba(37,99,235,.1)}
        .btn{width:100%;padding:.82rem;border-radius:100px;background:var(--blue);color:#fff;font-family:'Sora',sans-serif;font-size:.9rem;font-weight:600;border:none;cursor:pointer;margin-top:.5rem;transition:background .2s}
        .btn:hover{background:var(--blue-dark)}
        .flash-ok{background:var(--green-bg);border:1.5px solid rgba(22,163,74,.2);border-radius:10px;padding:.8rem 1rem;font-size:.84rem;color:var(--green);margin-bottom:1.1rem}
        .flash-err{background:#fef2f2;border:1.5px solid rgba(220,38,38,.2);border-radius:10px;padding:.8rem 1rem;font-size:.84rem;color:#dc2626;margin-bottom:1.1rem}
        hr{border:none;border-top:1px solid var(--border);margin:1.4rem 0}
        .links{display:flex;justify-content:space-between;font-size:.82rem}
        .links a{color:var(--muted);text-decoration:none}
        .links a:hover{color:var(--blue)}
    </style>
</head>
<body>
<div class="card">
    <a href="/" class="logo">Lingua<span>Learn</span></a>
    <div class="icon">🔒</div>
    <h1>Set a new password</h1>
    <p class="desc">Choose a strong password for <strong>{{ email }}</strong>.</p>

    {% for msg in app.flashes('success') %}<div class="flash-ok">✓ {{ msg }}</div>{% endfor %}
    {% for msg in app.flashes('danger')  %}<div class="flash-err">✗ {{ msg }}</div>{% endfor %}

    <form method="post" action="{{ path('password_reset_confirm') }}">
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('reset_password') }}">
        <input type="hidden" name="token" value="{{ token }}">
        <input type="hidden" name="email" value="{{ email }}">

        <label for="new_password">New password</label>
        <input type="password" id="new_password" name="new_password" placeholder="At least 6 characters" required autofocus>

        <label for="confirm_password">Confirm password</label>
        <input type="password" id="confirm_password" name="confirm_password" placeholder="Repeat your password" required>

        <button type="submit" class="btn">Set new password</button>
    </form>

    <hr>
    <div class="links">
        <a href="{{ path('app_login') }}">← Back to login</a>
        <a href="{{ path('password_reset_request') }}">Request new link</a>
    </div>
</div>
</body>
</html>
