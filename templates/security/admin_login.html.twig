<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    <meta http-equiv="X-UA-Compatible" content="ie=edge"/>
    <title>Admin Login - LinguaLearn</title>

    {# Tabler CSS #}
    <link href="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta17/dist/css/tabler.min.css" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" rel="stylesheet"/>

    <style>
        .page-center {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        }
    </style>
</head>
<body class="d-flex flex-column">
<div class="page page-center">
    <div class="container container-tight py-4">
        <div class="text-center mb-4">
            {# FIXED: Changed from admin_dashboard to homepage - prevents error when not logged in #}
            <a href="{{ path('app_homepage') }}" class="navbar-brand navbar-brand-autodark">
                <i class="ti ti-shield-lock fs-1 text-white"></i>
                <span class="ms-2 fs-2 text-white">LinguaLearn Admin</span>
            </a>
        </div>

        <div class="card card-md">
            <div class="card-body">
                <h2 class="h2 text-center mb-4">
                    <i class="ti ti-user-shield text-primary"></i>
                    <br>Admin Login
                </h2>

                {# Show flash messages from SecurityController #}
                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger alert-dismissible" role="alert">
                        <div class="d-flex">
                            <div>
                                <i class="ti ti-alert-circle icon alert-icon"></i>
                            </div>
                            <div>{{ message }}</div>
                        </div>
                        <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
                    </div>
                {% endfor %}

                {% for message in app.flashes('warning') %}
                    <div class="alert alert-warning alert-dismissible" role="alert">
                        <div class="d-flex">
                            <div>
                                <i class="ti ti-alert-triangle icon alert-icon"></i>
                            </div>
                            <div>{{ message }}</div>
                        </div>
                        <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
                    </div>
                {% endfor %}

                {% if error %}
                    <div class="alert alert-danger alert-dismissible" role="alert">
                        <div class="d-flex">
                            <div>
                                <i class="ti ti-alert-circle icon alert-icon"></i>
                            </div>
                            <div>
                                <h4 class="alert-title">Authentication Failed</h4>
                                <div class="text-secondary">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                            </div>
                        </div>
                        <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
                    </div>
                {% endif %}

                {% if app.user %}
                    <div class="alert alert-info" role="alert">
                        <div class="d-flex">
                            <div>
                                <i class="ti ti-info-circle icon alert-icon"></i>
                            </div>
                            <div>
                                You are logged in as <strong>{{ app.user.userIdentifier }}</strong>.
                                <a href="{{ path('app_admin_logout') }}" class="alert-link">Logout</a>
                            </div>
                        </div>
                    </div>
                {% endif %}

                <form method="post" action="{{ path('app_admin_login') }}" autocomplete="off">
                    <div class="mb-3">
                        <label class="form-label" for="inputEmail">
                            <i class="ti ti-mail me-1"></i>Admin Email
                        </label>
                        <input
                            type="email"
                            value="{{ last_username }}"
                            name="email"
                            id="inputEmail"
                            class="form-control"
                            placeholder="admin@lingualearn.com"
                            autocomplete="email"
                            required
                            autofocus
                        >
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="inputPassword">
                            <i class="ti ti-lock me-1"></i>Password
                        </label>
                        <input
                            type="password"
                            name="password"
                            id="inputPassword"
                            class="form-control"
                            placeholder="Your secure password"
                            autocomplete="current-password"
                            required
                        >
                    </div>

                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                    <div class="mb-3">
                        <label class="form-check">
                            <input type="checkbox" name="_remember_me" class="form-check-input">
                            <span class="form-check-label">Remember me on this device</span>
                        </label>
                    </div>

                    <div class="form-footer">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="ti ti-login me-2"></i>Sign in to Admin Panel
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="text-center text-white mt-3">
            <small>
                <i class="ti ti-lock me-1"></i>
                Secure admin access only
            </small>
        </div>

        <div class="text-center mt-2">
            <small class="text-white">
                Not an admin? <a href="{{ path('app_login') }}" class="text-white text-decoration-underline">User Login</a>
            </small>
        </div>
    </div>
</div>

{# Tabler JS #}
<script src="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta17/dist/js/tabler.min.js"></script>
</body>
</html>
