<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Log In — LinguaLearn</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600&family=Fraunces:ital,wght@0,300;0,400;1,300;1,400&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">

    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

        :root {
            --white:     #ffffff;
            --off-white: #f7f9fc;
            --ink:       #0d1526;
            --ink-soft:  #2c3a52;
            --muted:     #7a87a0;
            --border:    #e2e8f2;
            --blue:      #2563eb;
            --blue-dark: #1d4ed8;
            --blue-bg:   #eff6ff;
            --green:     #16a34a;
            --green-bg:  #f0fdf4;
            --red:       #dc2626;
            --red-bg:    #fef2f2;
            --radius:    12px;
            --radius-lg: 20px;
        }

        html, body { height: 100%; }

        body {
            font-family: 'Sora', sans-serif;
            background: var(--off-white);
            color: var(--ink);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            position: relative;
            overflow: hidden;
        }

        body::before {
            content: '';
            position: fixed; inset: 0;
            background-image: radial-gradient(circle, #c7d2e8 1px, transparent 1px);
            background-size: 36px 36px;
            opacity: .5;
            pointer-events: none;
        }

        body::after {
            content: '';
            position: fixed; top: -120px; right: -120px;
            width: 600px; height: 600px;
            background: radial-gradient(circle, rgba(37,99,235,.07) 0%, transparent 68%);
            pointer-events: none;
        }

        .auth-wrap {
            position: relative; z-index: 1;
            width: 100%; max-width: 460px;
            padding: 1.5rem;
            animation: fadeUp .5s cubic-bezier(.2,.8,.4,1) both;
        }

        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(20px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        .auth-logo {
            text-align: center; margin-bottom: 2rem;
            text-decoration: none; display: block;
        }
        .auth-logo-name {
            font-family: 'Fraunces', serif;
            font-size: 1.75rem; font-weight: 400;
            color: var(--ink); letter-spacing: -.01em;
        }
        .auth-logo-name span { color: var(--blue); }
        .auth-logo-tag {
            font-family: 'DM Mono', monospace;
            font-size: .62rem; letter-spacing: .22em;
            text-transform: uppercase; color: var(--muted);
            margin-top: .3rem;
        }

        .auth-card {
            background: var(--white);
            border: 1.5px solid var(--border);
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: 0 20px 60px rgba(13,21,38,.08);
        }

        .auth-card::before {
            content: ''; display: block;
            height: 3px;
            background: linear-gradient(90deg, var(--blue), #60a5fa);
        }

        .auth-card-body { padding: 2.25rem 2.25rem 1.75rem; }

        .auth-heading {
            font-family: 'Fraunces', serif;
            font-size: 1.65rem; font-weight: 300;
            color: var(--ink); margin-bottom: .35rem;
            letter-spacing: -.01em;
        }
        .auth-heading em { font-style: italic; color: var(--blue); }
        .auth-subhead {
            font-size: .83rem; color: var(--muted);
            font-weight: 300; margin-bottom: 1.75rem;
        }

        .alert {
            display: flex; align-items: flex-start; gap: .65rem;
            padding: .85rem 1rem; border-radius: var(--radius);
            font-size: .82rem; line-height: 1.5; margin-bottom: 1.25rem;
        }
        .alert-icon { font-size: 1rem; flex-shrink: 0; margin-top: .05rem; }
        .alert-success { background: var(--green-bg); border: 1px solid rgba(22,163,74,.2); color: var(--green); }
        .alert-error   { background: var(--red-bg);   border: 1px solid rgba(220,38,38,.2);  color: var(--red); }
        .alert-warning { background: #fffbeb; border: 1px solid rgba(245,158,11,.2); color: #b45309; }
        .alert-info    { background: var(--blue-bg);  border: 1px solid rgba(37,99,235,.2);  color: var(--blue); }
        .alert strong  { font-weight: 600; }
        .alert a       { color: inherit; font-weight: 600; }

        .f-group { margin-bottom: 1.1rem; }

        .f-label {
            display: flex; justify-content: space-between; align-items: center;
            font-size: .78rem; font-weight: 600; color: var(--ink-soft);
            margin-bottom: .45rem; letter-spacing: .01em;
        }
        .f-label a {
            font-size: .72rem; font-weight: 400; color: var(--blue);
            text-decoration: none; transition: color .2s;
        }
        .f-label a:hover { color: var(--blue-dark); }

        .f-input-wrap { position: relative; }

        .f-input {
            width: 100%; padding: .7rem 1rem;
            border-radius: var(--radius); border: 1.5px solid var(--border);
            background: var(--off-white); font-family: 'Sora', sans-serif;
            font-size: .88rem; color: var(--ink); outline: none;
            transition: border-color .2s, background .2s, box-shadow .2s;
        }
        .f-input:focus {
            border-color: var(--blue); background: var(--white);
            box-shadow: 0 0 0 3px rgba(37,99,235,.1);
        }
        .f-input.has-icon { padding-right: 2.75rem; }

        .f-eye-btn {
            position: absolute; right: .85rem; top: 50%;
            transform: translateY(-50%);
            background: none; border: none; cursor: pointer;
            color: var(--muted); font-size: 1rem; padding: 0;
            transition: color .2s; line-height: 1;
        }
        .f-eye-btn:hover { color: var(--ink); }

        .f-row {
            display: flex; align-items: center;
            justify-content: space-between; margin-bottom: 1.5rem;
        }
        .f-check-label {
            display: flex; align-items: center; gap: .5rem;
            font-size: .8rem; color: var(--ink-soft); cursor: pointer;
        }
        .f-check {
            width: 15px; height: 15px; accent-color: var(--blue); cursor: pointer;
        }

        .btn-submit {
            width: 100%; padding: .82rem;
            border-radius: 100px; border: none;
            background: var(--blue); color: var(--white);
            font-family: 'Sora', sans-serif; font-size: .9rem; font-weight: 600;
            letter-spacing: .03em; cursor: pointer;
            transition: background .2s, transform .2s, box-shadow .2s;
            display: flex; align-items: center; justify-content: center; gap: .5rem;
        }
        .btn-submit:hover {
            background: var(--blue-dark);
            transform: translateY(-1px);
            box-shadow: 0 8px 24px rgba(37,99,235,.3);
        }
        .btn-submit:active { transform: translateY(0); }

        .auth-card-foot {
            padding: 1.1rem 2.25rem;
            border-top: 1px solid var(--border);
            background: var(--off-white);
            display: flex; align-items: center; justify-content: space-between;
            flex-wrap: wrap; gap: .5rem;
        }
        .auth-card-foot p { font-size: .8rem; color: var(--muted); }
        .auth-card-foot a { color: var(--blue); font-weight: 600; text-decoration: none; }
        .auth-card-foot a:hover { color: var(--blue-dark); }

        .auth-page-foot {
            text-align: center; margin-top: 1.5rem;
            font-size: .72rem; color: var(--muted);
            font-family: 'DM Mono', monospace;
        }
        .auth-page-foot a { color: var(--muted); text-decoration: none; transition: color .2s; }
        .auth-page-foot a:hover { color: var(--blue); }

        @media (max-width: 480px) {
            .auth-card-body { padding: 1.75rem 1.5rem 1.5rem; }
            .auth-card-foot { flex-direction: column; text-align: center; }
        }
    </style>
</head>
<body>

<div class="auth-wrap">

    <a href="{{ path('app_homepage') }}" class="auth-logo">
        <div class="auth-logo-name">Lingua<span>Learn</span></div>
        <div class="auth-logo-tag">AI-Powered Language Learning</div>
    </a>

    <div class="auth-card">
        <div class="auth-card-body">

            <h1 class="auth-heading">Welcome <em>back</em></h1>
            <p class="auth-subhead">Sign in to continue your learning journey</p>

            {% for msg in app.flashes('success') %}
                <div class="alert alert-success">
                    <span class="alert-icon">✓</span>
                    <span>{{ msg }}</span>
                </div>
            {% endfor %}

            {% if error %}
                {% if error.messageKey == 'unverified_email' %}
                    <div class="alert alert-warning">
                        <span class="alert-icon">✉</span>
                        <div>
                            <strong>Email not verified</strong><br>
                            Please verify your email before logging in.
                            <a href="{{ path('email_verify_resend_form') }}">Resend verification link →</a>
                        </div>
                    </div>
                {% else %}
                    <div class="alert alert-error">
                        <span class="alert-icon">✕</span>
                        <div>
                            <strong>Login failed</strong><br>
                            {{ error.messageKey|trans(error.messageData, 'security') }}
                        </div>
                    </div>
                {% endif %}
            {% endif %}

            {% if app.user %}
                <div class="alert alert-info">
                    <span class="alert-icon">ℹ</span>
                    <span>
                        Signed in as <strong>{{ app.user.userIdentifier }}</strong>.
                        <a href="{{ path('app_logout') }}">Sign out</a>
                    </span>
                </div>
            {% endif %}

            <form method="post" action="{{ path('app_login') }}" autocomplete="off" novalidate>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="f-group">
                    <label class="f-label" for="inputEmail">Email address</label>
                    <input
                        type="email"
                        id="inputEmail"
                        name="email"
                        class="f-input"
                        value="{{ last_username }}"
                        placeholder="you@example.com"
                        autocomplete="email"
                        autofocus
                        required
                    >
                </div>

                <div class="f-group">
                    <label class="f-label" for="inputPassword">
                        Password
                        <a href="{{ path('password_reset_request') }}">Forgot password?</a>
                    </label>
                    <div class="f-input-wrap">
                        <input
                            type="password"
                            id="inputPassword"
                            name="password"
                            class="f-input has-icon"
                            placeholder="••••••••••"
                            autocomplete="current-password"
                            required
                        >
                        <button type="button" class="f-eye-btn" id="pwToggle" aria-label="Toggle password">
                            <span id="pwIcon">👁</span>
                        </button>
                    </div>
                </div>

                <div class="f-row">
                    <label class="f-check-label">
                        <input type="checkbox" name="_remember_me" class="f-check">
                        Remember me
                    </label>
                </div>

                <button type="submit" class="btn-submit">
                    Sign in to LinguaLearn
                </button>
            </form>

        </div>

        <div class="auth-card-foot">
            <p>Don't have an account? <a href="{{ path('app_register') }}">Create one free</a></p>
            <a href="{{ path('app_admin_login') }}" style="font-size:.72rem;color:var(--muted);font-weight:400;">Admin access →</a>
        </div>
    </div>

    <div class="auth-page-foot">
        © {{ "now"|date("Y") }} LinguaLearn &nbsp;·&nbsp;
        <a href="#">Privacy</a> &nbsp;·&nbsp;
        <a href="#">Terms</a>
    </div>
</div>

<script>
    const pwInput  = document.getElementById('inputPassword');
    const pwToggle = document.getElementById('pwToggle');
    const pwIcon   = document.getElementById('pwIcon');
    pwToggle.addEventListener('click', () => {
        const isPassword = pwInput.type === 'password';
        pwInput.type = isPassword ? 'text' : 'password';
        pwIcon.textContent = isPassword ? '🙈' : '👁';
    });
</script>
</body>
</html>
