<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    <meta http-equiv="X-UA-Compatible" content="ie=edge"/>
    <title>{% block title %}LinguaLearn{% endblock %}</title>

    <link href="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta17/dist/css/tabler.min.css" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" rel="stylesheet"/>
    {% block stylesheets %}{% endblock %}
</head>
<body class="antialiased">
<div class="wrapper">

    {# ===== USER SIDEBAR ===== #}
    <aside class="navbar navbar-vertical navbar-expand-lg" data-bs-theme="dark">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                    data-bs-target="#user-sidebar-menu" aria-controls="user-sidebar-menu"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <h1 class="navbar-brand navbar-brand-autodark">
                <a href="{{ path('user_dashboard') }}">
                    <i class="ti ti-language fs-1 text-primary"></i>
                    <span class="ms-2">LinguaLearn</span>
                </a>
            </h1>

            <div class="collapse navbar-collapse" id="user-sidebar-menu">
                <ul class="navbar-nav pt-lg-3">

                    {# Dashboard #}
                    <li class="nav-item">
                        <a class="nav-link {% if app.request.attributes.get('_route') == 'user_dashboard' %}active{% endif %}"
                           href="{{ path('user_dashboard') }}">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-home"></i>
                            </span>
                            <span class="nav-link-title">Dashboard</span>
                        </a>
                    </li>

                    {# My Profile #}
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-user"></i>
                            </span>
                            <span class="nav-link-title">My Profile</span>
                        </a>
                    </li>

                    {# Courses #}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#navbar-courses"
                           data-bs-toggle="dropdown" data-bs-auto-close="false"
                           role="button" aria-expanded="false">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-book"></i>
                            </span>
                            <span class="nav-link-title">Courses</span>
                        </a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" href="#">
                                <i class="ti ti-list me-2"></i> Browse Courses
                            </a>
                            <a class="dropdown-item" href="#">
                                <i class="ti ti-book-2 me-2"></i> My Courses
                            </a>
                        </div>
                    </li>

                    {# Exercises & Quizzes #}
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-puzzle"></i>
                            </span>
                            <span class="nav-link-title">Exercises & Quizzes</span>
                        </a>
                    </li>

                    {# Mock Tests #}
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-certificate"></i>
                            </span>
                            <span class="nav-link-title">Mock Tests</span>
                        </a>
                    </li>

                    {# Forum #}
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-messages"></i>
                            </span>
                            <span class="nav-link-title">Forum</span>
                        </a>
                    </li>

                    {# Learning Stats #}
                    <li class="nav-item">
                        <a class="nav-link" href="#">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-chart-line"></i>
                            </span>
                            <span class="nav-link-title">My Progress</span>
                        </a>
                    </li>

                    {# Support #}
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#navbar-support"
                           data-bs-toggle="dropdown" data-bs-auto-close="false"
                           role="button" aria-expanded="false">
                            <span class="nav-link-icon d-md-none d-lg-inline-block">
                                <i class="ti ti-lifebuoy"></i>
                            </span>
                            <span class="nav-link-title">Support</span>
                        </a>
                        <div class="dropdown-menu">
                            <a class="dropdown-item" href="#">
                                <i class="ti ti-help me-2"></i> FAQ
                            </a>
                            <a class="dropdown-item" href="#">
                                <i class="ti ti-ticket me-2"></i> My Tickets
                            </a>
                            <a class="dropdown-item" href="#">
                                <i class="ti ti-plus me-2"></i> New Ticket
                            </a>
                        </div>
                    </li>

                    {# Subscription - highlight for free users #}
                    {% if app.user and not app.user.isPremium %}
                        <li class="nav-item mt-3">
                            <a class="nav-link text-yellow" href="#">
                                <span class="nav-link-icon d-md-none d-lg-inline-block">
                                    <i class="ti ti-crown"></i>
                                </span>
                                <span class="nav-link-title">Upgrade to Premium</span>
                            </a>
                        </li>
                    {% endif %}

                </ul>
            </div>

            {# User info at bottom of sidebar #}
            <div class="d-none d-lg-block border-top p-3">
                <div class="d-flex align-items-center">
                    <span class="avatar avatar-sm bg-blue-lt me-2">
                        {{ app.user ? app.user.firstName|first|upper : 'U' }}
                    </span>
                    <div class="flex-fill">
                        <div class="fw-bold text-white small">{{ app.user ? app.user.fullName : 'User' }}</div>
                        <div class="text-muted small">
                            {% if app.user and app.user.isPremium %}
                                <i class="ti ti-crown text-yellow"></i> Premium
                            {% else %}
                                Free Plan
                            {% endif %}
                        </div>
                    </div>
                    <a href="{{ path('app_logout') }}" class="text-muted ms-2" title="Logout">
                        <i class="ti ti-logout"></i>
                    </a>
                </div>
            </div>

        </div>
    </aside>

    {# ===== MAIN CONTENT ===== #}
    <div class="page-wrapper">

        {# Top navbar #}
        <div class="navbar-expand-md">
            <div class="collapse navbar-collapse" id="navbar-menu">
                <div class="navbar navbar-light">
                    <div class="container-xl">
                        <div class="navbar-nav flex-row order-md-last">

                            {# Notifications #}
                            <div class="nav-item me-3">
                                <a href="#" class="nav-link px-0">
                                    <i class="ti ti-bell fs-3"></i>
                                </a>
                            </div>

                            {# User dropdown #}
                            <div class="nav-item dropdown">
                                <a href="#" class="nav-link d-flex lh-1 text-reset p-0"
                                   data-bs-toggle="dropdown" aria-label="Open user menu">
                                    <span class="avatar avatar-sm bg-blue-lt">
                                        {{ app.user ? app.user.firstName|first|upper : 'U' }}
                                    </span>
                                    <div class="d-none d-xl-block ps-2">
                                        <div>{{ app.user ? app.user.fullName : 'User' }}</div>
                                        <div class="mt-1 small text-muted">
                                            {% if app.user and app.user.isPremium %}
                                                <i class="ti ti-crown text-yellow"></i> Premium Member
                                            {% else %}
                                                Free Plan
                                            {% endif %}
                                        </div>
                                    </div>
                                </a>
                                <div class="dropdown-menu dropdown-menu-end dropdown-menu-arrow">
                                    <a href="#" class="dropdown-item">
                                        <i class="ti ti-user me-2"></i> My Profile
                                    </a>
                                    <a href="#" class="dropdown-item">
                                        <i class="ti ti-settings me-2"></i> Settings
                                    </a>
                                    <div class="dropdown-divider"></div>
                                    <a href="{{ path('app_logout') }}" class="dropdown-item text-danger">
                                        <i class="ti ti-logout me-2"></i> Logout
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Page content #}
        <div class="page-body">
            <div class="container-xl">

                {# Flash messages #}
                {% for label, messages in app.flashes %}
                    {% for message in messages %}
                        <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible mt-3" role="alert">
                            <div class="d-flex">
                                <div>
                                    {% if label == 'success' %}<i class="ti ti-check alert-icon"></i>
                                    {% elseif label == 'warning' %}<i class="ti ti-alert-triangle alert-icon"></i>
                                    {% elseif label == 'danger' or label == 'error' %}<i class="ti ti-alert-circle alert-icon"></i>
                                    {% else %}<i class="ti ti-info-circle alert-icon"></i>{% endif %}
                                </div>
                                <div>{{ message }}</div>
                            </div>
                            <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
                        </div>
                    {% endfor %}
                {% endfor %}

                {# Page header #}
                {% block page_header %}
                    <div class="page-header d-print-none mt-3">
                        <div class="row align-items-center">
                            <div class="col">
                                {% block breadcrumb %}{% endblock %}
                                <h2 class="page-title">
                                    {% block page_title %}Dashboard{% endblock %}
                                </h2>
                            </div>
                            {% block page_actions %}{% endblock %}
                        </div>
                    </div>
                {% endblock %}

                {% block body %}{% endblock %}

            </div>
        </div>

        {# Footer #}
        <footer class="footer footer-transparent d-print-none">
            <div class="container-xl">
                <div class="row text-center align-items-center flex-row-reverse">
                    <div class="col-lg-auto ms-lg-auto">
                        <ul class="list-inline list-inline-dots mb-0">
                            <li class="list-inline-item">
                                <span class="text-muted">LinguaLearn &copy; {{ "now"|date("Y") }}</span>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </footer>

    </div>{# end page-wrapper #}
</div>{# end wrapper #}

<script src="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta17/dist/js/tabler.min.js"></script>
{% block javascripts %}{% endblock %}
</body>
</html>
