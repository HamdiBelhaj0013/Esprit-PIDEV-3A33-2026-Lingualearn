<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
    <meta http-equiv="X-UA-Compatible" content="ie=edge"/>
    <title>Create Admin - LinguaLearn Setup</title>

    <link href="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta17/dist/css/tabler.min.css" rel="stylesheet"/>
    <link href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css" rel="stylesheet"/>

    <style>
        .page-center { background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); }

        /* ── Step indicator ── */
        .steps { display:flex; align-items:center; justify-content:center; margin-bottom:2rem; }
        .step  { display:flex; flex-direction:column; align-items:center; gap:.35rem; flex:1; position:relative; }
        .step:not(:last-child)::after {
            content:''; position:absolute; top:18px; left:calc(50% + 18px);
            right:calc(-50% + 18px); height:2px; background:rgba(255,255,255,.35);
        }
        .step.done::after { background:rgba(255,255,255,.8); }
        .step-dot {
            width:36px; height:36px; border-radius:50%;
            background:rgba(255,255,255,.25); border:2px solid rgba(255,255,255,.5);
            display:flex; align-items:center; justify-content:center;
            font-size:.8rem; font-weight:700; color:#fff; transition:all .3s;
        }
        .step.active .step-dot { background:#fff; color:#f5576c; border-color:#fff; }
        .step.done   .step-dot { background:rgba(255,255,255,.9); color:#16a34a; border-color:#fff; }
        .step-label { font-size:.65rem; font-weight:600; color:rgba(255,255,255,.75); text-transform:uppercase; letter-spacing:.06em; white-space:nowrap; }
        .step.active .step-label { color:#fff; }

        /* ── Webcam ── */
        .cam-wrap { position:relative; border-radius:14px; overflow:hidden; background:#0d1526; aspect-ratio:4/3; margin-bottom:1rem; }
        #enrollVideo  { width:100%; height:100%; object-fit:cover; display:block; }
        #enrollCanvas { display:none; }
        .cam-ring { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; pointer-events:none; }
        .cam-ring-inner { width:140px; height:140px; border:2px solid rgba(245,87,108,.6); border-radius:50%; box-shadow:0 0 0 4px rgba(245,87,108,.12); animation:camPulse 2s ease-in-out infinite; }
        @keyframes camPulse {
            0%,100% { box-shadow:0 0 0 4px rgba(245,87,108,.12); }
            50%      { box-shadow:0 0 0 12px rgba(245,87,108,.04); }
        }
        .enroll-status { font-size:.82rem; padding:.5rem .75rem; border-radius:8px; margin-bottom:.75rem; text-align:center; display:none; }
        .enroll-status.info    { background:#eff6ff; color:#1e40af; display:block; }
        .enroll-status.error   { background:#fef2f2; color:#991b1b; display:block; }
        .enroll-status.success { background:#f0fdf4; color:#166534; display:block; }

        .tips { background:#fffbeb; border:1px solid #fde68a; border-radius:10px; padding:.75rem 1rem; margin-bottom:1rem; font-size:.78rem; color:#92400e; }
        .tips ul { margin:.35rem 0 0 1rem; }
        .tips li  { margin-bottom:.2rem; }
    </style>
</head>
<body class="d-flex flex-column">
<div class="page page-center">
    <div class="container container-tight py-4">

        <div class="text-center mb-4">
            <i class="ti ti-shield-check fs-1 text-white"></i>
            <h1 class="text-white mt-2">LinguaLearn Setup</h1>
            <p class="text-white-50">Create your first admin account</p>
        </div>

        {# ══════════════════════════════════════
           STATE 1 — Account creation form
        ══════════════════════════════════════ #}
        {% if not success %}

            <div class="steps">
                <div class="step active">
                    <div class="step-dot">1</div>
                    <div class="step-label">Account</div>
                </div>
                <div class="step">
                    <div class="step-dot">2</div>
                    <div class="step-label">Face ID</div>
                </div>
                <div class="step">
                    <div class="step-dot">3</div>
                    <div class="step-label">Done</div>
                </div>
            </div>

            <div class="card card-md">
                <div class="card-body">
                    <h2 class="h2 text-center mb-4">
                        <i class="ti ti-user-shield text-danger"></i><br>Create Admin Account
                    </h2>

                    <div class="alert alert-warning" role="alert">
                        <div class="d-flex">
                            <div><i class="ti ti-alert-triangle icon alert-icon"></i></div>
                            <div>
                                <h4 class="alert-title">Important!</h4>
                                <div class="text-secondary">This account will have full admin access. Keep these credentials safe!</div>
                            </div>
                        </div>
                    </div>

                    {% if error %}
                        <div class="alert alert-danger alert-dismissible" role="alert">
                            <div class="d-flex">
                                <div><i class="ti ti-alert-circle icon alert-icon"></i></div>
                                <div>
                                    <h4 class="alert-title">Error</h4>
                                    <div class="text-secondary">{{ error }}</div>
                                </div>
                            </div>
                            <a class="btn-close" data-bs-dismiss="alert" aria-label="close"></a>
                        </div>
                    {% endif %}

                    <form method="post" action="{{ path('setup_create_admin') }}" autocomplete="off">
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label" for="first_name"><i class="ti ti-user me-1"></i>First Name</label>
                                <input type="text" name="first_name" id="first_name" class="form-control" placeholder="Admin" required autofocus>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" for="last_name"><i class="ti ti-user me-1"></i>Last Name</label>
                                <input type="text" name="last_name" id="last_name" class="form-control" placeholder="User" required>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="email"><i class="ti ti-mail me-1"></i>Admin Email</label>
                            <input type="email" name="email" id="email" class="form-control" placeholder="admin@lingualearn.com" autocomplete="email" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="password"><i class="ti ti-lock me-1"></i>Password</label>
                            <input type="password" name="password" id="password" class="form-control" placeholder="Minimum 6 characters" autocomplete="new-password" required minlength="6">
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="confirm_password"><i class="ti ti-lock-check me-1"></i>Confirm Password</label>
                            <input type="password" name="confirm_password" id="confirm_password" class="form-control" placeholder="Re-enter your password" autocomplete="new-password" required minlength="6">
                        </div>
                        <div class="form-footer">
                            <button type="submit" class="btn btn-danger w-100 btn-lg">
                                <i class="ti ti-arrow-right me-2"></i>Continue to Face Enrollment →
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center text-white mt-3">
                <small>Need a regular user account? <a href="{{ path('app_register') }}" class="text-white">Register here</a></small>
            </div>

            {# ══════════════════════════════════════
           STATE 2 — Face enrollment
           token + user_id passed from controller
        ══════════════════════════════════════ #}
        {% else %}

            <div class="steps">
                <div class="step done">
                    <div class="step-dot"><i class="ti ti-check" style="font-size:.85rem"></i></div>
                    <div class="step-label">Account</div>
                </div>
                <div class="step active">
                    <div class="step-dot">2</div>
                    <div class="step-label">Face ID</div>
                </div>
                <div class="step" id="stepDone">
                    <div class="step-dot">3</div>
                    <div class="step-label">Done</div>
                </div>
            </div>

            <div class="card card-md" id="enrollCard">
                <div class="card-body">
                    <h2 class="h2 text-center mb-1">
                        <i class="ti ti-scan text-danger"></i><br>Enroll Your Face
                    </h2>
                    <p class="text-muted text-center mb-3" style="font-size:.85rem;">
                        Register your face so you can log in with Face ID next time.
                    </p>

                    <div class="tips">
                        <strong>Tips for best results:</strong>
                        <ul>
                            <li>Use good, even lighting — avoid strong backlighting</li>
                            <li>Face the camera directly, eyes open</li>
                            <li>Remove glasses if possible for first enrollment</li>
                            <li>Keep only your face in the frame</li>
                        </ul>
                    </div>

                    <div class="cam-wrap">
                        <video id="enrollVideo" autoplay playsinline muted></video>
                        <canvas id="enrollCanvas"></canvas>
                        <div class="cam-ring"><div class="cam-ring-inner"></div></div>
                    </div>

                    <div id="enrollStatus" class="enroll-status"></div>

                    <div class="d-grid gap-2">
                        <button type="button" class="btn btn-danger btn-lg" id="enrollBtn" onclick="doEnroll()">
                            <i class="ti ti-camera me-2"></i>Capture &amp; Enroll
                        </button>
                        <a href="{{ path('app_admin_login') }}" class="btn btn-outline-secondary" id="skipBtn">
                            Skip for now — go to login
                        </a>
                    </div>
                </div>
            </div>

            {# Success card shown after enrollment #}
            <div class="card card-md" id="doneCard" style="display:none;">
                <div class="card-body text-center py-5">
                    <div class="text-success mb-3">
                        <i class="ti ti-circle-check" style="font-size:4rem;"></i>
                    </div>
                    <h2 class="text-success">All Set!</h2>
                    <p class="text-muted mt-2 mb-4">Admin account created and face enrolled successfully.</p>
                    <a href="{{ path('app_admin_login') }}" class="btn btn-primary btn-lg">
                        <i class="ti ti-login me-2"></i>Go to Admin Login
                    </a>
                    <div class="mt-3">
                        <a href="{{ path('app_register') }}" class="btn btn-outline-secondary btn-sm">Create Regular User Account</a>
                    </div>
                </div>
            </div>

        {% endif %}

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@tabler/core@1.0.0-beta17/dist/js/tabler.min.js"></script>

{% if success %}
    <script>
        // Injected from controller — one-time setup token
        const SETUP_USER_ID = {{ user_id|json_encode|raw }};
        const SETUP_TOKEN   = {{ token|json_encode|raw }};

        let enrollStream = null;

        // Auto-start camera
        (function startCamera() {
            const video = document.getElementById('enrollVideo');
            navigator.mediaDevices.getUserMedia({ video: { width: 640, height: 480, facingMode: 'user' } })
                .then(stream => {
                    enrollStream = stream;
                    video.srcObject = stream;
                    setStatus('Camera ready. Position your face inside the ring then click Capture.', 'info');
                })
                .catch(err => {
                    console.error(err);
                    setStatus('Camera access denied. You can skip and enroll later from your admin profile.', 'error');
                });
        })();

        function setStatus(msg, type) {
            const el = document.getElementById('enrollStatus');
            el.textContent = msg;
            el.className = 'enroll-status ' + type;
        }

        async function doEnroll() {
            const video  = document.getElementById('enrollVideo');
            const canvas = document.getElementById('enrollCanvas');
            const btn    = document.getElementById('enrollBtn');

            if (!enrollStream) {
                setStatus('Camera not ready. Please allow camera access and refresh.', 'error');
                return;
            }

            btn.disabled = true;
            btn.innerHTML = '<i class="ti ti-loader ti-spin me-2"></i>Processing…';

            canvas.width  = video.videoWidth  || 640;
            canvas.height = video.videoHeight || 480;
            canvas.getContext('2d').drawImage(video, 0, 0);
            const imageB64 = canvas.toDataURL('image/jpeg', 0.88);

            try {
                const res = await fetch('{{ path("app_setup_enroll_face") }}', {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body:    JSON.stringify({
                        user_id: SETUP_USER_ID,
                        image:   imageB64,
                        token:   SETUP_TOKEN,
                    }),
                });

                // Check for non-JSON responses (HTML error pages, redirects)
                const contentType = res.headers.get('content-type') || '';
                if (!contentType.includes('application/json')) {
                    const text = await res.text();
                    console.error('Non-JSON response:', res.status, text.substring(0, 200));
                    setStatus(`Server error (${res.status}). Check that python app.py is running on port 5001.`, 'error');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="ti ti-camera me-2"></i>Retry Capture';
                    return;
                }

                const data = await res.json();

                if (data.success) {
                    setStatus('✓ Face enrolled successfully!', 'success');
                    if (enrollStream) { enrollStream.getTracks().forEach(t => t.stop()); }
                    document.getElementById('stepDone').classList.add('active');
                    setTimeout(() => {
                        document.getElementById('enrollCard').style.display = 'none';
                        document.getElementById('doneCard').style.display   = 'block';
                    }, 800);
                } else {
                    setStatus(data.message || 'Enrollment failed. Try again or skip.', 'error');
                    btn.disabled = false;
                    btn.innerHTML = '<i class="ti ti-camera me-2"></i>Retry Capture';
                }
            } catch (err) {
                console.error('Fetch error:', err);
                setStatus('Network error. Make sure python app.py is running on port 5001.', 'error');
                btn.disabled = false;
                btn.innerHTML = '<i class="ti ti-camera me-2"></i>Retry Capture';
            }
        }
    </script>
{% endif %}

</body>
</html>
