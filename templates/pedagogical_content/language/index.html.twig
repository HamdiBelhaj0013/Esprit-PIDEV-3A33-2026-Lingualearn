{% extends 'layouts/admin.html.twig' %}

{% block title %}Admin · Langues{% endblock %}

{% block page_title %}
    <i class="ti ti-language text-primary me-2"></i> Langues
{% endblock %}

{% block breadcrumb %}
<ol class="breadcrumb breadcrumb-icons p-2 rounded" style="background: rgba(32,107,196,0.1);">
    <li class="breadcrumb-item">
        <a href="{{ path('admin_dashboard') }}" style="color: #206bc4; text-decoration: none;">
            <i class="ti ti-home"></i> Tableau de bord
        </a>
    </li>
    <li class="breadcrumb-item">
        <a href="{{ path('admin_pedagogical_content_index') }}" style="color: #206bc4; text-decoration: none;">Contenu Pédagogique</a>
    </li>
    <li class="breadcrumb-item active" style="color: #206bc4;">Langues</li>
</ol>
{% endblock %}

{% block page_actions %}
<a href="{{ path('admin_language_new') }}" class="btn btn-primary shadow-sm" style="border-radius: 8px; font-weight: 600;">
    <i class="ti ti-plus me-1"></i> Créer une langue
</a>
{% endblock %}

{% block content %}
<div class="row g-4">

    <div class="col-12">
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-body p-3">
               <form method="get" action="{{ path('admin_language_index') }}" class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label fw-bold text-secondary small text-uppercase">
                            <i class="ti ti-search"></i> Rechercher
                        </label>
                        <input type="text" name="search" id="searchInput" class="form-control form-control-sm"
                               placeholder="Nom ou code..." value="{{ search }}" style="border-radius: 8px;">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase">
                            <i class="ti ti-filter"></i> Statut
                        </label>
                        <select name="enabled" id="enabledFilter" class="form-select form-select-sm" style="border-radius: 8px;">
                            <option value="">-- Tous --</option>
                            <option value="1" {% if enabled == '1' %}selected{% endif %}>Activées</option>
                            <option value="0" {% if enabled == '0' %}selected{% endif %}>Désactivées</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Tri</label>
                        <select name="sort" id="sortSelect" class="form-select form-select-sm" style="border-radius: 8px;">
                            <option value="name" {% if sort == 'name' %}selected{% endif %}>Nom</option>
                            <option value="code" {% if sort == 'code' %}selected{% endif %}>Code</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Ordre</label>
                        <select name="order" id="orderSelect" class="form-select form-select-sm" style="border-radius: 8px;">
                            <option value="ASC" {% if order == 'ASC' %}selected{% endif %}>↑</option>
                            <option value="DESC" {% if order == 'DESC' %}selected{% endif %}>↓</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            <i class="ti ti-search"></i>
                        </button>
                        <a href="{{ path('admin_language_index') }}" class="btn btn-secondary btn-sm w-100">
                            <i class="ti ti-x"></i>
                        </a>
                    </div>
                    <input type="hidden" name="page" id="pageInput" value="{{ pagination.currentPageNumber }}">
                </form>
            </div>
        </div>
    </div>

    <div id="loadingIndicator" class="text-center my-3" style="display: none;">
        <div class="spinner-border text-primary" style="width: 40px; height: 40px;"></div>
        <p class="text-secondary mt-2">Recherche en cours...</p>
    </div>

    <div class="col-12">
        <div class="card shadow-sm border-0 rounded-3">
            <div id="languageTableContainer" class="table-responsive p-3">
                {% include 'pedagogical_content/language/_table.html.twig' with { pagination: pagination } %}
            </div>
        </div>
    </div>

</div>
{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
.card { transition: transform 0.2s ease, box-shadow 0.2s ease; }
.card:hover { transform: translateY(-3px); box-shadow: 0 6px 18px rgba(32,107,196,0.12); }
.form-control:focus, .form-select:focus { border-color: #206bc4 !important; box-shadow: 0 0 0 3px rgba(32,107,196,0.15) !important; }
.table-hover tbody tr:hover { background-color: #f0f8ff; transition: 0.2s; }
</style>
{% endblock %}


{% block javascripts %}
{{ parent() }}
<script>
document.addEventListener('DOMContentLoaded', function () {

    const filterForm = document.getElementById('filterForm');
    const pageInput = document.getElementById('pageInput');

    const searchInput = document.getElementById('searchInput');
    const enabledFilter = document.getElementById('enabledFilter');
    const sortSelect = document.getElementById('sortSelect');
    const orderSelect = document.getElementById('orderSelect');

    const languageTableContainer = document.getElementById('languageTableContainer');
    const loadingIndicator = document.getElementById('loadingIndicator');

    function fetchTable() {
        const params = new URLSearchParams(new FormData(filterForm));
    console.log("FETCH URL =", '{{ path('admin_language_index') }}?' + params.toString()); // ✅ TEST

        loadingIndicator.style.display = 'block';
        languageTableContainer.style.opacity = '0.5';

        fetch('{{ path('admin_language_index') }}?' + params.toString(), {
            headers: {'X-Requested-With': 'XMLHttpRequest'}
        })
        .then(r => r.json())
        .then(data => {
            languageTableContainer.innerHTML = data.html;
            languageTableContainer.style.opacity = '1';
            loadingIndicator.style.display = 'none';
        })
        .catch(e => {
            console.error(e);
            loadingIndicator.style.display = 'none';
            languageTableContainer.style.opacity = '1';
        });
    }

    function resetToPage1() {
        pageInput.value = '1';
        fetchTable();
    }

    filterForm.addEventListener('submit', function(e) {
        e.preventDefault();
        fetchTable();
    });

    searchInput.addEventListener('keyup', function() {
        clearTimeout(window.searchTimeout);
        window.searchTimeout = setTimeout(resetToPage1, 300);
    });

    enabledFilter.addEventListener('change', resetToPage1);
    sortSelect.addEventListener('change', resetToPage1);
    orderSelect.addEventListener('change', resetToPage1);

    // Pagination click
    languageTableContainer.addEventListener('click', function (e) {
        const link = e.target.closest('.pagination a');
        if (!link) return;

        e.preventDefault();

        const url = new URL(link.href);
        const page = url.searchParams.get('page') || '1';
 console.log("CLICK PAGINATION -> page =", page);
        pageInput.value = page;
        fetchTable();
    });

});
</script>
{% endblock %}
