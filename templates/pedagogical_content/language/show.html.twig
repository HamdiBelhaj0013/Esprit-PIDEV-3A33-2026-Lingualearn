{% extends 'layouts/admin.html.twig' %}

{% block title %}Admin · {{ language.name }}{% endblock %}

{% block page_title %}
    <i class="ti ti-language text-primary me-2"></i> {{ language.name }}
{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb breadcrumb-icons p-2 rounded" style="background: rgba(32,107,196,0.1);">
        <li class="breadcrumb-item">
            <a href="{{ path('admin_dashboard') }}" style="color: #206bc4; text-decoration: none;">
                <i class="ti ti-home"></i> Tableau de bord
            </a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ path('admin_pedagogical_content_index') }}" style="color: #206bc4; text-decoration: none;">Contenu Pédagogique</a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ path('admin_language_index') }}" style="color: #206bc4; text-decoration: none;">Langues</a>
        </li>
        <li class="breadcrumb-item active" style="color: #206bc4;">{{ language.name }}</li>
    </ol>
{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_language_edit', {'id': language.id}) }}" class="btn btn-primary">
        <i class="ti ti-edit me-1"></i> Modifier
    </a>
    <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" data-form-id="deleteForm{{ language.id }}">
        <i class="ti ti-trash me-1"></i> Supprimer
    </button>
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-8">
            {# Language Information Card #}
            <div class="card shadow-sm border-0 rounded-3 mb-4">
                <div class="card-header bg-white border-bottom">
                    <h3 class="card-title mb-0">
                        <i class="ti ti-info-circle text-primary me-2"></i> Informations de la langue
                    </h3>
                </div>
                <div class="card-body">
                    <div class="row mb-4">
                        <div class="col-md-4">
                            <h5 class="text-muted mb-2 small text-uppercase fw-bold">Drapeau</h5>
                            <img src="{{ language.flagUrl }}" alt="{{ language.name }}"
                                 style="height: 80px; width: auto; object-fit: cover; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
                        </div>
                        <div class="col-md-4">
                            <h5 class="text-muted mb-2 small text-uppercase fw-bold">Nom</h5>
                            <p class="mb-0 fs-4 fw-semibold">{{ language.name }}</p>
                        </div>
                        <div class="col-md-4">
                            <h5 class="text-muted mb-2 small text-uppercase fw-bold">Code (ISO 639-1)</h5>
                            <p class="mb-0">
                            <span class="badge" style="background: linear-gradient(135deg, #206bc4 0%, #3b7dd8 100%); color: white; padding: 8px 16px; border-radius: 20px; font-weight: 600; font-size: 14px;">
                                {{ language.code|upper }}
                            </span>
                            </p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <h5 class="text-muted mb-2 small text-uppercase fw-bold">Statut</h5>
                            <p class="mb-0">
                                {% if language.isEnabled %}
                                    <span class="badge bg-success-lt text-success" style="font-size: 0.875rem; padding: 6px 12px;">
                                    <i class="ti ti-check me-1"></i> Activée
                                </span>
                                {% else %}
                                    <span class="badge bg-secondary-lt text-secondary" style="font-size: 0.875rem; padding: 6px 12px;">
                                    <i class="ti ti-x me-1"></i> Désactivée
                                </span>
                                {% endif %}
                            </p>
                        </div>
                        <div class="col-md-6">
                            <h5 class="text-muted mb-2 small text-uppercase fw-bold">ID</h5>
                            <p class="mb-0">
                                <span class="badge bg-secondary" style="font-size: 0.875rem; padding: 6px 12px;">
                                    {{ language.id }}
                                </span>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            {# Courses Card #}
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-white border-bottom">
                    <h3 class="card-title mb-0">
                        <i class="ti ti-book text-primary me-2"></i> Cours associés
                        <span class="badge bg-primary ms-2">{{ language.courses|length }}</span>
                    </h3>
                </div>
                <div class="card-body">
                    {% if language.courses|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-hover table-vcenter">
                                <thead style="background: #f8fafc;">
                                <tr>
                                    <th style="font-weight: 600; color: #64748b; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.5px;">Titre du cours</th>
                                    <th style="font-weight: 600; color: #64748b; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.5px;">Niveau</th>
                                    <th style="font-weight: 600; color: #64748b; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.5px;">Statut</th>
                                    <th style="font-weight: 600; color: #64748b; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.5px; width: 100px;">Actions</th>
                                </tr>
                                </thead>
                                <tbody>
                                {% for course in language.courses %}
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                <i class="ti ti-book me-2 text-primary"></i>
                                                <strong>{{ course.title }}</strong>
                                            </div>
                                        </td>
                                        <td>
                                            {% if course.level == 'beginner' %}
                                                <span class="badge bg-success-lt text-success">
                                                    <i class="ti ti-star me-1"></i> Débutant
                                                </span>
                                            {% elseif course.level == 'intermediate' %}
                                                <span class="badge bg-warning-lt text-warning">
                                                    <i class="ti ti-star-half me-1"></i> Intermédiaire
                                                </span>
                                            {% else %}
                                                <span class="badge bg-danger-lt text-danger">
                                                    <i class="ti ti-stars me-1"></i> Avancé
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            {% if course.status == 'published' %}
                                                <span class="badge bg-success-lt text-success">
                                                    <i class="ti ti-check-circle me-1"></i> Publié
                                                </span>
                                            {% elseif course.status == 'draft' %}
                                                <span class="badge bg-warning-lt text-warning">
                                                    <i class="ti ti-pencil me-1"></i> Brouillon
                                                </span>
                                            {% else %}
                                                <span class="badge bg-secondary-lt text-secondary">
                                                    <i class="ti ti-archive me-1"></i> Archivé
                                                </span>
                                            {% endif %}
                                        </td>
                                        <td>
                                            <a href="{{ path('admin_course_show', {'id': course.id}) }}"
                                               class="btn btn-sm btn-primary"
                                               title="Voir le cours">
                                                <i class="ti ti-eye"></i>
                                            </a>
                                        </td>
                                    </tr>
                                {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <div class="text-center py-5">
                            <div class="mb-3" style="font-size: 3rem; opacity: 0.3;">
                                <i class="ti ti-book-off"></i>
                            </div>
                            <p class="text-muted mb-3">Aucun cours associé à cette langue</p>
                            <a href="{{ path('admin_course_new') }}" class="btn btn-primary">
                                <i class="ti ti-plus me-1"></i> Créer un cours
                            </a>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-md-4">
            {# Quick Actions Card #}
            <div class="card shadow-sm border-0 rounded-3 mb-3">
                <div class="card-header bg-light">
                    <h3 class="card-title mb-0">
                        <i class="ti ti-bolt text-warning me-2"></i> Actions rapides
                    </h3>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="{{ path('admin_language_edit', {'id': language.id}) }}" class="btn btn-primary">
                            <i class="ti ti-edit me-1"></i> Modifier cette langue
                        </a>
                        <a href="{{ path('admin_course_new') }}?language={{ language.id }}" class="btn btn-success">
                            <i class="ti ti-plus me-1"></i> Créer un cours
                        </a>
                        <a href="{{ path('admin_language_index') }}" class="btn btn-secondary">
                            <i class="ti ti-list me-1"></i> Liste des langues
                        </a>
                        <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" data-form-id="deleteForm{{ language.id }}">
                            <i class="ti ti-trash me-1"></i> Supprimer
                        </button>
                    </div>
                </div>
            </div>

            {# Statistics Card #}
            <div class="card shadow-sm border-0 rounded-3">
                <div class="card-header bg-light">
                    <h3 class="card-title mb-0">
                        <i class="ti ti-chart-bar text-info me-2"></i> Statistiques
                    </h3>
                </div>
                <div class="card-body">
                    <div class="mb-3 pb-3 border-bottom">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Nombre de cours</span>
                            <span class="fs-3 fw-bold text-primary">{{ language.courses|length }}</span>
                        </div>
                    </div>
                    <div class="mb-3 pb-3 border-bottom">
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Cours publiés</span>
                            <span class="fs-3 fw-bold text-success">
                            {% set publishedCount = 0 %}
                                {% for course in language.courses %}
                                    {% if course.status == 'published' %}
                                        {% set publishedCount = publishedCount + 1 %}
                                    {% endif %}
                                {% endfor %}
                                {{ publishedCount }}
                        </span>
                        </div>
                    </div>
                    <div>
                        <div class="d-flex justify-content-between align-items-center">
                            <span class="text-muted">Cours en brouillon</span>
                            <span class="fs-3 fw-bold text-warning">
                            {% set draftCount = 0 %}
                                {% for course in language.courses %}
                                    {% if course.status == 'draft' %}
                                        {% set draftCount = draftCount + 1 %}
                                    {% endif %}
                                {% endfor %}
                                {{ draftCount }}
                        </span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <form method="post" action="{{ path('admin_language_delete', {'id': language.id}) }}" style="display:none;" id="deleteForm{{ language.id }}">
        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ language.id) }}">
    </form>
{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .card { transition: transform 0.2s ease, box-shadow 0.2s ease; }
        .table-hover tbody tr:hover { background-color: #f0f8ff; transition: 0.2s; }
    </style>
{% endblock %}
