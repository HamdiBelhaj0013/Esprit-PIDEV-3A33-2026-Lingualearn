<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ language.name }} Courses — LinguaLearn</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;500;600;700&family=Fraunces:ital,wght@0,300;0,400;1,300;1,400&family=DM+Mono:wght@300;400&display=swap" rel="stylesheet">

    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --white:     #ffffff;
            --off-white: #f7f9fc;
            --surface:   #eef1f8;
            --ink:       #0d1526;
            --ink-soft:  #2c3a52;
            --muted:     #7a87a0;
            --border:    #e2e8f2;
            --blue:      #2563eb;
            --blue-dark: #1d4ed8;
            --blue-bg:   #eff6ff;
            --blue-mid:  #3b82f6;
            --green:     #16a34a;
            --green-bg:  #f0fdf4;
            --orange:    #ea580c;
            --orange-bg: #fff7ed;
            --violet:    #7c3aed;
            --violet-bg: #f5f3ff;
            --gold:      #ca8a04;
            --gold-bg:   #fefce8;
            --sidebar-w: 260px;
            --radius:    12px;
            --radius-lg: 20px;
        }

        html { scroll-behavior: smooth; }
        body { font-family: 'Sora', sans-serif; background: var(--off-white); color: var(--ink); min-height: 100vh; }

        /* ─── SIDEBAR ─── */
        .sidebar { position: fixed; top: 0; left: 0; bottom: 0; width: var(--sidebar-w); background: var(--white); border-right: 1px solid var(--border); display: flex; flex-direction: column; z-index: 50; transition: transform .3s ease; }
        .sidebar-logo { padding: 1.5rem 1.5rem 1.25rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: .75rem; text-decoration: none; }
        .sidebar-logo-text { font-family: 'Fraunces', serif; font-size: 1.3rem; font-weight: 400; color: var(--ink); }
        .sidebar-logo-text span { color: var(--blue); }
        .sidebar-user { padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: .85rem; }
        .user-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--blue), var(--blue-mid)); display: flex; align-items: center; justify-content: center; font-family: 'Fraunces', serif; font-size: 1rem; color: var(--white); flex-shrink: 0; }
        .user-avatar.premium { background: linear-gradient(135deg, var(--gold), #fbbf24); }
        .user-info { flex: 1; min-width: 0; }
        .user-name { font-size: .85rem; font-weight: 600; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .user-plan { font-size: .7rem; font-family: 'DM Mono', monospace; letter-spacing: .08em; text-transform: uppercase; margin-top: .1rem; }
        .user-plan.free { color: var(--muted); }
        .user-plan.premium { color: var(--gold); }
        .sidebar-nav { flex: 1; padding: 1rem 0; overflow-y: auto; }
        .nav-section-label { font-family: 'DM Mono', monospace; font-size: .6rem; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); padding: .75rem 1.5rem .35rem; display: block; }
        .nav-item { display: flex; align-items: center; gap: .75rem; padding: .65rem 1.5rem; font-size: .84rem; font-weight: 500; color: var(--muted); text-decoration: none; transition: color .2s, background .2s; position: relative; }
        .nav-item:hover { color: var(--ink); background: var(--off-white); }
        .nav-item.active { color: var(--blue); background: var(--blue-bg); font-weight: 600; }
        .nav-item.active::before { content: ''; position: absolute; left: 0; top: 4px; bottom: 4px; width: 3px; background: var(--blue); border-radius: 0 3px 3px 0; }
        .nav-icon { font-size: 1.1rem; width: 20px; text-align: center; }

        /* ─── MAIN ─── */
        .main { margin-left: var(--sidebar-w); min-height: 100vh; display: flex; flex-direction: column; }

        /* ─── TOPBAR ─── */
        .topbar { position: sticky; top: 0; z-index: 40; background: rgba(255,255,255,.92); backdrop-filter: blur(20px); border-bottom: 1px solid var(--border); padding: .85rem 2rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
        .topbar-left { display: flex; align-items: center; gap: 1rem; }
        .page-heading { font-family: 'Fraunces', serif; font-size: 1.25rem; font-weight: 400; color: var(--ink); }
        .page-sub { font-size: .78rem; color: var(--muted); margin-top: .1rem; }
        .back-link { display: inline-flex; align-items: center; gap: .4rem; font-size: .82rem; color: var(--muted); text-decoration: none; transition: color .2s; }
        .back-link:hover { color: var(--blue); }
        .hamburger-btn { display: none; width: 38px; height: 38px; border-radius: var(--radius); border: 1.5px solid var(--border); background: transparent; align-items: center; justify-content: center; cursor: pointer; flex-direction: column; gap: 4px; }
        .hamburger-btn span { width: 16px; height: 1.5px; background: var(--ink); display: block; border-radius: 2px; }

        /* ─── PAGE ─── */
        .page-content { padding: 2rem; flex: 1; max-width: 1100px; width: 100%; margin: 0 auto; }

        /* ─── LANGUAGE HERO ─── */
        .lang-hero {
            background: var(--white); border: 1.5px solid var(--border);
            border-radius: var(--radius-lg); padding: 2rem;
            display: flex; align-items: center; gap: 1.75rem;
            margin-bottom: 1.75rem; position: relative; overflow: hidden;
        }
        .lang-hero::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: linear-gradient(90deg, var(--blue), var(--blue-mid)); }
        .lang-hero-flag { width: 80px; height: 57px; border-radius: 10px; object-fit: cover; border: 1.5px solid var(--border); flex-shrink: 0; box-shadow: 0 4px 16px rgba(0,0,0,.1); }
        .lang-hero-flag-placeholder { width: 80px; height: 57px; border-radius: 10px; background: var(--surface); border: 1.5px solid var(--border); display: flex; align-items: center; justify-content: center; font-size: 2rem; flex-shrink: 0; }
        .lang-hero-info { flex: 1; }
        .lang-hero-name { font-family: 'Fraunces', serif; font-size: 2rem; font-weight: 300; color: var(--ink); margin-bottom: .3rem; }
        .lang-hero-meta { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
        .lang-code-pill { font-family: 'DM Mono', monospace; font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; background: var(--surface); color: var(--muted); padding: .25rem .7rem; border-radius: 6px; border: 1px solid var(--border); }
        .lang-enrolled-pill { font-family: 'DM Mono', monospace; font-size: .65rem; letter-spacing: .1em; text-transform: uppercase; background: var(--green-bg); color: var(--green); padding: .25rem .7rem; border-radius: 6px; }
        .lang-course-count { font-size: .82rem; color: var(--muted); }

        /* ─── FILTER BAR ─── */
        .filter-bar {
            display: flex; align-items: center; gap: .6rem;
            margin-bottom: 1.5rem; flex-wrap: wrap;
        }
        .filter-label { font-family: 'DM Mono', monospace; font-size: .65rem; letter-spacing: .15em; text-transform: uppercase; color: var(--muted); margin-right: .25rem; }
        .filter-pill {
            padding: .38rem .9rem; border-radius: 100px;
            font-size: .78rem; font-weight: 500;
            text-decoration: none; border: 1.5px solid var(--border);
            color: var(--muted); background: var(--white);
            transition: all .2s;
        }
        .filter-pill:hover { border-color: var(--blue); color: var(--blue); }
        .filter-pill.active { background: var(--blue); color: var(--white); border-color: var(--blue); font-weight: 600; }

        /* ─── COURSE GRID ─── */
        .course-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.25rem; }

        .course-card {
            background: var(--white); border: 1.5px solid var(--border);
            border-radius: var(--radius-lg); overflow: hidden;
            transition: border-color .2s, box-shadow .2s, transform .2s;
            display: flex; flex-direction: column;
        }
        .course-card:hover { border-color: var(--blue-mid); box-shadow: 0 8px 28px rgba(37,99,235,.1); transform: translateY(-3px); }

        .course-card-top {
            padding: 1.4rem 1.4rem .9rem;
            flex: 1;
        }
        .course-level-badge {
            display: inline-block; font-family: 'DM Mono', monospace;
            font-size: .6rem; letter-spacing: .12em; text-transform: uppercase;
            padding: .22rem .7rem; border-radius: 6px; margin-bottom: .85rem;
        }
        .level-beginner     { background: var(--green-bg);  color: var(--green); }
        .level-intermediate { background: var(--blue-bg);   color: var(--blue); }
        .level-advanced     { background: var(--violet-bg); color: var(--violet); }

        .course-title { font-family: 'Fraunces', serif; font-size: 1.1rem; font-weight: 400; color: var(--ink); line-height: 1.35; margin-bottom: .6rem; }
        .course-meta { font-size: .75rem; color: var(--muted); display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; }
        .course-lessons-count { font-family: 'DM Mono', monospace; font-size: .68rem; color: var(--muted); }

        .course-card-footer {
            padding: .9rem 1.4rem 1.2rem;
            border-top: 1px solid var(--border);
            display: flex; align-items: center; justify-content: space-between; gap: .75rem;
        }
        .course-date { font-size: .7rem; color: var(--muted); font-family: 'DM Mono', monospace; }

        .btn {
            padding: .5rem 1.1rem; border-radius: 100px;
            font-family: 'Sora', sans-serif; font-size: .8rem; font-weight: 600;
            text-decoration: none; cursor: pointer; border: none;
            transition: all .2s; display: inline-flex; align-items: center; gap: .35rem;
        }
        .btn-primary { background: var(--blue); color: var(--white); }
        .btn-primary:hover { background: var(--blue-dark); box-shadow: 0 4px 12px rgba(37,99,235,.28); }

        /* ─── FLASH ─── */
        .flash-success { background: var(--green-bg); border: 1.5px solid rgba(22,163,74,.2); border-radius: var(--radius); padding: .85rem 1.1rem; font-size: .85rem; color: var(--green); margin-bottom: 1.25rem; }
        .flash-warning { background: var(--gold-bg);  border: 1.5px solid rgba(202,138,4,.2);  border-radius: var(--radius); padding: .85rem 1.1rem; font-size: .85rem; color: var(--gold);  margin-bottom: 1.25rem; }

        /* ─── EMPTY ─── */
        .empty-state { text-align: center; padding: 4rem 2rem; color: var(--muted); background: var(--white); border: 1.5px solid var(--border); border-radius: var(--radius-lg); }
        .empty-state-icon { font-size: 3rem; margin-bottom: 1rem; }
        .empty-state-title { font-family: 'Fraunces', serif; font-size: 1.3rem; font-weight: 300; color: var(--ink); margin-bottom: .5rem; }
        .empty-state-sub { font-size: .85rem; line-height: 1.6; }

        /* ─── RESPONSIVE ─── */
        .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(13,21,38,.4); z-index: 45; }
        .sidebar-overlay.visible { display: block; }
        @media (max-width: 768px) {
            :root { --sidebar-w: 0px; }
            .sidebar { transform: translateX(-260px); width: 260px; }
            .sidebar.open { transform: translateX(0); }
            .main { margin-left: 0; }
            .hamburger-btn { display: flex; }
            .page-content { padding: 1.25rem; }
            .topbar { padding: .75rem 1.25rem; }
            .lang-hero { flex-direction: column; text-align: center; }
        }

        .reveal { opacity: 0; transform: translateY(16px); transition: opacity .45s ease, transform .45s ease; }
        .reveal.visible { opacity: 1; transform: translateY(0); }
    </style>
</head>
<body>

<aside class="sidebar" id="sidebar">
    <a href="{{ path('app_homepage') }}" class="sidebar-logo">
        <div class="sidebar-logo-text">Lingua<span>Learn</span></div>
    </a>
    <div class="sidebar-user">
        <div class="user-avatar {{ app.user.isPremium is defined and app.user.isPremium ? 'premium' : '' }}">
            {{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}
        </div>
        <div class="user-info">
            <div class="user-name">{{ app.user.fullName }}</div>
            <div class="user-plan {{ app.user.isPremium is defined and app.user.isPremium ? 'premium' : 'free' }}">
                {{ app.user.isPremium is defined and app.user.isPremium ? '★ ' ~ app.user.subscriptionPlan : 'Free Plan' }}
            </div>
        </div>
    </div>
    <nav class="sidebar-nav">
        <span class="nav-section-label">Main</span>
        <a href="{{ path('user_dashboard') }}" class="nav-item"><span class="nav-icon">⊞</span> Dashboard</a>
        <a href="{{ path('language_select') }}" class="nav-item active"><span class="nav-icon">📚</span> My Courses</a>
        <a href="{{ path('learn_practice') }}" class="nav-item"><span class="nav-icon">🧩</span> Practice</a>
        <a href="#" class="nav-item"><span class="nav-icon">📝</span> Mock Tests</a>
        <span class="nav-section-label">Account</span>
        <a href="{{ path('user_profile') }}" class="nav-item"><span class="nav-icon">👤</span> My Profile</a>
        <a href="{{ path('app_logout') }}" class="nav-item"><span class="nav-icon">→</span> Log Out</a>
    </nav>
</aside>

<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="main">
    <header class="topbar">
        <div class="topbar-left">
            <button class="hamburger-btn" id="hamburgerBtn"><span></span><span></span><span></span></button>
            <div>
                <div class="page-heading">{{ language.name }}</div>
                <div class="page-sub">
                    <a href="{{ path('language_select') }}" class="back-link">← Back to languages</a>
                </div>
            </div>
        </div>
    </header>

    <main class="page-content">

        {% for msg in app.flashes('success') %}<div class="flash-success">✓ {{ msg }}</div>{% endfor %}
        {% for msg in app.flashes('warning') %}<div class="flash-warning">⚠ {{ msg }}</div>{% endfor %}

        {# Language Hero #}
        <div class="lang-hero reveal">
            {% if language.flagUrl %}
                <img src="{{ language.flagUrl }}" alt="{{ language.name }} flag" class="lang-hero-flag"
                     onerror="this.style.display='none';this.nextElementSibling.style.display='flex';">
                <div class="lang-hero-flag-placeholder" style="display:none;">🌐</div>
            {% else %}
                <div class="lang-hero-flag-placeholder">🌐</div>
            {% endif %}
            <div class="lang-hero-info">
                <div class="lang-hero-name">{{ language.name }}</div>
                <div class="lang-hero-meta">
                    <span class="lang-code-pill">{{ language.code|upper }}</span>
                    <span class="lang-enrolled-pill">✓ Enrolled</span>
                    <span class="lang-course-count">{{ courses|length }} course{{ courses|length != 1 ? 's' : '' }} available</span>
                </div>
            </div>
        </div>

        {# Level Filter #}
        <div class="filter-bar reveal">
            <span class="filter-label">Filter:</span>
            <a href="{{ path('language_courses', {id: language.id}) }}"
               class="filter-pill {{ levelFilter is null ? 'active' : '' }}">All</a>
            {% for lvl in levels %}
                <a href="{{ path('language_courses', {id: language.id, level: lvl}) }}"
                   class="filter-pill {{ levelFilter == lvl ? 'active' : '' }}">
                    {{ lvl|capitalize }}
                </a>
            {% endfor %}
        </div>

        {# Courses #}
        {% if courses|length > 0 %}
            <div class="course-grid">
                {% for course in courses %}
                    <div class="course-card reveal">
                        <div class="course-card-top">
                            <span class="course-level-badge level-{{ course.level }}">{{ course.level|capitalize }}</span>
                            <div class="course-title">{{ course.title }}</div>
                            <div class="course-meta">
                                <span class="course-lessons-count">
                                    📖 {{ course.lessons|length }} lesson{{ course.lessons|length != 1 ? 's' : '' }}
                                </span>
                            </div>
                        </div>
                        <div class="course-card-footer">
                            <span class="course-date">
                                {{ course.publishedAt ? course.publishedAt|date('M j, Y') : '' }}
                            </span>
                            {% if course.lessons|length > 0 %}
                                <a href="{{ path('lesson_show', {id: course.lessons|first.id}) }}" class="btn btn-primary">Start →</a>
                            {% else %}
                                <span class="btn btn-primary" style="opacity:.5;cursor:default;">No lessons yet</span>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% else %}
            <div class="empty-state reveal">
                <div class="empty-state-icon">📚</div>
                <div class="empty-state-title">No courses found</div>
                <div class="empty-state-sub">
                    {% if levelFilter %}
                        No <strong>{{ levelFilter }}</strong> courses yet.
                        <a href="{{ path('language_courses', {id: language.id}) }}" style="color:var(--blue);">View all levels</a>
                    {% else %}
                        No published courses for {{ language.name }} yet. Check back soon!
                    {% endif %}
                </div>
            </div>
        {% endif %}

    </main>
</div>

<script>
    const sidebar   = document.getElementById('sidebar');
    const overlay   = document.getElementById('sidebarOverlay');
    const hamburger = document.getElementById('hamburgerBtn');
    hamburger.addEventListener('click', () => { sidebar.classList.toggle('open'); overlay.classList.toggle('visible'); });
    overlay.addEventListener('click',   () => { sidebar.classList.remove('open'); overlay.classList.remove('visible'); });

    const ro = new IntersectionObserver(entries => {
        entries.forEach(e => { if (e.isIntersecting) { e.target.classList.add('visible'); ro.unobserve(e.target); } });
    }, { threshold: 0.05 });
    document.querySelectorAll('.reveal').forEach(el => ro.observe(el));
</script>
</body>
</html>
