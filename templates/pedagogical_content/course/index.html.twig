{% extends 'layouts/admin.html.twig' %}

{% block title %}Admin · Cours{% endblock %}

{% block page_title %}
    <i class="ti ti-graduation-cap text-primary me-2"></i> Cours
{% endblock %}

{% block breadcrumb %}
<ol class="breadcrumb breadcrumb-icons p-2 rounded" style="background: rgba(32,107,196,0.1);">
    <li class="breadcrumb-item">
        <a href="{{ path('admin_dashboard') }}" style="color: #206bc4; text-decoration: none;">
            <i class="ti ti-home"></i> Tableau de bord
        </a>
    </li>
    <li class="breadcrumb-item">
        <a href="{{ path('admin_pedagogical_content_index') }}" style="color: #206bc4; text-decoration: none;">Contenu Pédagogique</a>
    </li>
    <li class="breadcrumb-item active" style="color: #206bc4;">Cours</li>
</ol>
{% endblock %}

{% block page_actions %}
<div class="col-auto">
    <a href="{{ path('admin_course_new') }}" class="btn btn-primary shadow-sm" style="border-radius: 8px; font-weight: 600;">
        <i class="ti ti-plus me-1"></i> Créer un cours
    </a>
</div>
{% endblock %}

{% block content %}
<div class="row g-4">

    <!-- Formulaire de recherche -->
    <div class="col-12">
        <div class="card shadow-sm border-0 rounded-3 mb-4">
            <div class="card-body p-3">
                <form id="filterForm" class="row g-3 align-items-end">
                    <div class="col-md-3">
                        <label class="form-label fw-bold text-secondary small text-uppercase">
                            <i class="ti ti-search"></i> Rechercher
                        </label>
                        <input type="text" name="search" id="searchInput" class="form-control form-control-sm"
                               placeholder="Titre du cours..." value="{{ search }}" style="border-radius: 8px;">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold text-secondary small text-uppercase">
                            <i class="ti ti-language"></i> Langue
                        </label>
                        <select name="language" id="languageFilter" class="form-select form-select-sm" style="border-radius: 8px;">
                            <option value="">-- Toutes --</option>
                            {% for l in languages %}
                                <option value="{{ l.id }}" {% if language == l.id %}selected{% endif %}>{{ l.name }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold text-secondary small text-uppercase">
                            <i class="ti ti-book"></i> Niveau
                        </label>
                        <select name="level" id="levelFilter" class="form-select form-select-sm" style="border-radius: 8px;">
                            <option value="">-- Tous --</option>
                            <option value="beginner" {% if level == 'beginner' %}selected{% endif %}>Débutant</option>
                            <option value="intermediate" {% if level == 'intermediate' %}selected{% endif %}>Intermédiaire</option>
                            <option value="advanced" {% if level == 'advanced' %}selected{% endif %}>Avancé</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold text-secondary small text-uppercase">
                            <i class="ti ti-badge"></i> Statut
                        </label>
                        <select name="status" id="statusFilter" class="form-select form-select-sm" style="border-radius: 8px;">
                            <option value="">-- Tous --</option>
                            <option value="published" {% if status == 'published' %}selected{% endif %}>Publié</option>
                            <option value="draft" {% if status == 'draft' %}selected{% endif %}>Brouillon</option>
                            <option value="archived" {% if status == 'archived' %}selected{% endif %}>Archivé</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Tri</label>
                        <select name="sort" id="sortSelect" class="form-select form-select-sm" style="border-radius: 8px;">
                            <option value="title" {% if sort == 'title' %}selected{% endif %}>Titre</option>
                            <option value="level" {% if sort == 'level' %}selected{% endif %}>Niveau</option>
                            <option value="status" {% if sort == 'status' %}selected{% endif %}>Statut</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <label class="form-label fw-bold text-secondary small text-uppercase">Ordre</label>
                        <select name="order" id="orderSelect" class="form-select form-select-sm" style="border-radius: 8px;">
                            <option value="ASC" {% if order == 'ASC' %}selected{% endif %}>?</option>
                            <option value="DESC" {% if order == 'DESC' %}selected{% endif %}>?</option>
                        </select>
                    </div>
                    <div class="col-md-1 d-flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm w-100">
                            <i class="ti ti-search"></i>
                        </button>
                        <a href="{{ path('admin_course_index') }}" class="btn btn-secondary btn-sm w-100">
                            <i class="ti ti-x"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div id="loadingIndicator" class="text-center my-3" style="display: none;">
        <div class="spinner-border text-primary" style="width: 40px; height: 40px;"></div>
        <p class="text-secondary mt-2">Recherche en cours...</p>
    </div>

    <!-- Tableau -->
    <div class="col-12">
        <div class="card shadow-sm border-0 rounded-3">
            <div id="courseTableContainer" class="table-responsive p-3">
                {% include 'pedagogical_content/course/_table.html.twig' %}
            </div>
        </div>
    </div>

</div>

<script>
// scripts inchangés
const filterForm = document.getElementById('filterForm');
const searchInput = document.getElementById('searchInput');
const languageFilter = document.getElementById('languageFilter');
const levelFilter = document.getElementById('levelFilter');
const statusFilter = document.getElementById('statusFilter');
const sortSelect = document.getElementById('sortSelect');
const orderSelect = document.getElementById('orderSelect');
const courseTableContainer = document.getElementById('courseTableContainer');
const loadingIndicator = document.getElementById('loadingIndicator');

filterForm.addEventListener('submit', e => { e.preventDefault(); performSearch(); });
searchInput.addEventListener('keyup', () => { clearTimeout(window.searchTimeout); window.searchTimeout = setTimeout(performSearch, 300); });
languageFilter.addEventListener('change', performSearch);
levelFilter.addEventListener('change', performSearch);
statusFilter.addEventListener('change', performSearch);
sortSelect.addEventListener('change', performSearch);
orderSelect.addEventListener('change', performSearch);

function performSearch() {
    const params = new URLSearchParams(new FormData(filterForm));
    loadingIndicator.style.display = 'block';
    courseTableContainer.style.opacity = '0.5';
    fetch('{{ path('admin_course_index') }}?' + params.toString(), { headers: {'X-Requested-With':'XMLHttpRequest'} })
        .then(r => r.json())
        .then(data => { courseTableContainer.innerHTML = data.html; courseTableContainer.style.opacity='1'; loadingIndicator.style.display='none'; attachToggleEvents(); })
        .catch(e => { console.error(e); loadingIndicator.style.display='none'; courseTableContainer.style.opacity='1'; });
}

function attachToggleEvents() {
    document.querySelectorAll('.toggle-status').forEach(cb => {
        cb.addEventListener('change', () => toggleStatus(cb.dataset.courseId, cb.checked));
    });
}
function toggleStatus(id, checked) {
    const msg = checked ? 'Cours publié' : 'Cours en brouillon';
    console.log(msg);
}
attachToggleEvents();
</script>

{% block stylesheets %}
<style>
.card { transition: transform 0.2s ease, box-shadow 0.2s ease; }
.card:hover { transform: translateY(-3px); box-shadow: 0 6px 18px rgba(32,107,196,0.12); }
.form-control:focus, .form-select:focus { border-color: #206bc4 !important; box-shadow: 0 0 0 3px rgba(32,107,196,0.15) !important; }
.table-hover tbody tr:hover { background-color: #f0f8ff; transition: 0.2s; }
</style>
{% endblock %}
{% endblock %}

