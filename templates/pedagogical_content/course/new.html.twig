{% extends 'layouts/admin.html.twig' %}

{% block page_title %}New Course{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb" aria-label="breadcrumbs">
        <li class="breadcrumb-item">
            <a href="{{ path('admin_dashboard') }}"><i class="ti ti-layout-dashboard"></i> Dashboard</a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ path('admin_pedagogical_content_index') }}">Pedagogical Content</a>
        </li>
        <li class="breadcrumb-item">
            <a href="{{ path('admin_course_index') }}">Courses</a>
        </li>
        <li class="breadcrumb-item active" aria-current="page">New</li>
    </ol>
{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_course_index') }}" class="btn btn-ghost-secondary" style="border-radius: 8px;">
        <i class="ti ti-arrow-left me-1"></i> Back to list
    </a>
{% endblock %}

{% block content %}
    <div class="row mt-2">
        <div class="col-lg-8">
            <div class="card ll-card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-plus me-2 text-primary"></i> Create Course
                    </h3>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                    <div class="mb-3">
                        {{ form_label(form.title, 'Title', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.title, {'attr': {'class': 'form-control', 'placeholder': 'Enter course title...', 'style': 'border-radius: 8px;'}}) }}
                        {{ form_errors(form.title) }}
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            {{ form_label(form.platformLanguage, 'Language', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.platformLanguage, {'attr': {'class': 'form-select', 'style': 'border-radius: 8px;'}}) }}
                            {{ form_errors(form.platformLanguage) }}
                        </div>
                        <div class="col-md-6">
                            {{ form_label(form.level, 'Level', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(form.level, {'attr': {'class': 'form-select', 'style': 'border-radius: 8px;'}}) }}
                            {{ form_errors(form.level) }}
                        </div>
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.status, 'Status', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.status, {'attr': {'class': 'form-select', 'style': 'border-radius: 8px;'}}) }}
                        {{ form_errors(form.status) }}
                    </div>

                    {{ form_rest(form) }}

                    <div class="d-flex gap-2 mt-4 pt-3" style="border-top: 1px solid #f1f5f9;">
                        <button type="submit" class="btn btn-ll-primary">
                            <i class="ti ti-check me-1"></i> Create Course
                        </button>
                        <a href="{{ path('admin_course_index') }}" class="btn btn-ghost-secondary" style="border-radius: 8px;">
                            Cancel
                        </a>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card ll-card">
                <div class="card-header">
                    <h3 class="card-title"><i class="ti ti-info-circle me-2"></i> Help</h3>
                </div>
                <div class="card-body">
                    <div class="text-muted" style="font-size: 0.8125rem; line-height: 1.6;">
                        <p class="mb-2"><strong>Title:</strong> Choose a clear, descriptive title for the course.</p>
                        <p class="mb-2"><strong>Language:</strong> Select the platform language this course belongs to.</p>
                        <p class="mb-2"><strong>Level:</strong> Beginner, Intermediate, or Advanced.</p>
                        <p class="mb-0"><strong>Status:</strong> Set to "Draft" to work on it before publishing.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
