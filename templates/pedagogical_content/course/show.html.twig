{% extends 'layouts/admin.html.twig' %}

{% block title %}Admin · {{ course.title }}{% endblock %}

{% block page_title %}{{ course.title }}{% endblock %}

{% block breadcrumb %}
    <ol class="breadcrumb breadcrumb-icons" aria-label="breadcrumbs">
        <li class="breadcrumb-item">
            <a href="{{ path('admin_dashboard') }}">
                <i class="ti ti-home"></i> Tableau de bord
            </a>
        </li>
        <li class="breadcrumb-item">Contenu Pédagogique</li>
        <li class="breadcrumb-item">
            <a href="{{ path('admin_course_index') }}">Cours</a>
        </li>
        <li class="breadcrumb-item active">{{ course.title }}</li>
    </ol>
{% endblock %}

{% block page_actions %}
    <div class="col-auto">
        <div class="btn-group">
            <a href="{{ path('admin_course_edit', {'id': course.id}) }}" class="btn btn-primary">
                <i class="ti ti-edit"></i> Modifier
            </a>
            <button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" data-form-id="deleteForm{{ course.id }}">
                <i class="ti ti-trash"></i> Supprimer
            </button>
        </div>
    </div>
{% endblock %}

{% block content %}
<div class="row">
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <div class="mb-4">
                    <h4 class="text-muted mb-2">Titre</h4>
                    <p class="mb-0">{{ course.title }}</p>
                </div>

                <div class="mb-4">
                    <h4 class="text-muted mb-2">Langue</h4>
                    <p class="mb-0">
                        <span class="badge bg-blue">{{ course.platformLanguage.name }}</span>
                    </p>
                </div>

                <div class="mb-4">
                    <h4 class="text-muted mb-2">Niveau</h4>
                    <p class="mb-0">
                        {% if course.level == 'beginner' %}
                            <span class="badge bg-green">Débutant</span>
                        {% elseif course.level == 'intermediate' %}
                            <span class="badge bg-yellow">Intermédiaire</span>
                        {% else %}
                            <span class="badge bg-red">Avancé</span>
                        {% endif %}
                    </p>
                </div>

                <div class="mb-4">
                    <h4 class="text-muted mb-2">Statut</h4>
                    <p class="mb-0">
                        {% if course.status == 'published' %}
                            <span class="badge bg-success">Publié</span>
                        {% elseif course.status == 'draft' %}
                            <span class="badge bg-warning">Brouillon</span>
                        {% else %}
                            <span class="badge bg-secondary">Archivé</span>
                        {% endif %}
                    </p>
                </div>

                <div class="mb-4">
                    <h4 class="text-muted mb-2">Leçons</h4>
                    {% if course.lessons|length > 0 %}
                        <div class="table-responsive">
                            <table class="table table-sm table-striped">
                                <thead>
                                    <tr>
                                        <th>Titre</th>
                                        <th>Récompense XP</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for lesson in course.lessons %}
                                        <tr>
                                            <td>
                                                <a href="{{ path('admin_lesson_show', {'id': lesson.id}) }}">
                                                    {{ lesson.title }}
                                                </a>
                                            </td>
                                            <td>
                                                <span class="badge bg-yellow">{{ lesson.xpReward }} XP</span>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% else %}
                        <p class="text-muted">Aucune leçon</p>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<form method="post" action="{{ path('admin_course_delete', {'id': course.id}) }}" style="display:none;" id="deleteForm{{ course.id }}">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ course.id) }}">
</form>
{% endblock %}
