<table class="table table-vcenter card-table" style="margin-bottom: 0;">
    <thead style="background: linear-gradient(135deg, #206bc4 0%, #764ba2 100%); color: white;">
        <tr>
            <th style="border: none; padding: 16px; font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;">Titre</th>
            <th style="border: none; padding: 16px; font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;">Langue</th>
            <th style="border: none; padding: 16px; font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;">Niveau</th>
            <th style="border: none; padding: 16px; font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px;">Statut</th>
            <th style="border: none; padding: 16px; font-weight: 600; text-transform: uppercase; font-size: 11px; letter-spacing: 0.5px; width: 150px;">Actions</th>
        </tr>
    </thead>
    <tbody>
        {% if courses|length > 0 %}
            {% for course in courses %}
                <tr class="course-row" data-course-id="{{ course.id }}" style="border-bottom: 1px solid #e9ecef; transition: all 0.2s ease;" onmouseover="this.style.backgroundColor='rgba(32, 107, 196, 0.03)'" onmouseout="this.style.backgroundColor='transparent'">
                    <td style="padding: 16px;">
                        <a href="{{ path('admin_course_show', {'id': course.id}) }}" style="color: #206bc4; text-decoration: none; font-weight: 500;">
                            {{ course.title }}
                        </a>
                    </td>
                    <td style="padding: 16px;">
                        <span class="badge" style="background: linear-gradient(135deg, #206bc4 0%, #3b7dd8 100%); color: white; padding: 6px 14px; border-radius: 20px; font-weight: 600; font-size: 11px; display: inline-block;">
                            {{ course.platformLanguage.name }}
                        </span>
                    </td>
                    <td style="padding: 16px;">
                        {% if course.level == 'beginner' %}
                            <span class="badge" style="background: linear-gradient(135deg, #28a745 0%, #48c774 100%); color: white; padding: 6px 14px; border-radius: 20px; font-weight: 600; font-size: 11px;">Débutant</span>
                        {% elseif course.level == 'intermediate' %}
                            <span class="badge" style="background: linear-gradient(135deg, #ffa500 0%, #ffb84d 100%); color: white; padding: 6px 14px; border-radius: 20px; font-weight: 600; font-size: 11px;">Intermédiaire</span>
                        {% else %}
                            <span class="badge" style="background: linear-gradient(135deg, #dc3545 0%, #e85a54 100%); color: white; padding: 6px 14px; border-radius: 20px; font-weight: 600; font-size: 11px;">Avancé</span>
                        {% endif %}
                    </td>
                    <td style="padding: 16px;">
                        <div class="form-check form-switch" style="margin: 0;">
                            <input class="form-check-input toggle-status" type="checkbox" id="status{{ course.id }}" data-course-id="{{ course.id }}" {% if course.status == 'published' %}checked{% endif %} style="width: 44px; height: 24px; margin: 0;">
                        </div>
                    </td>
                    <td style="padding: 16px;">
                        <div class="btn-group btn-group-sm" role="group">
                            <a href="{{ path('admin_course_show', {'id': course.id}) }}" class="btn btn-sm" style="background: #e9ecef; color: #206bc4; border: none; padding: 6px 12px; border-radius: 6px 0 0 6px; font-size: 11px; font-weight: 600;">
                                <i class="ti ti-eye"></i>
                            </a>
                            <a href="{{ path('admin_course_edit', {'id': course.id}) }}" class="btn btn-sm" style="background: #206bc4; color: white; border: none; padding: 6px 12px; font-size: 11px; font-weight: 600;">
                                <i class="ti ti-edit"></i>
                            </a>
                            <button type="button" class="btn btn-sm deleteBtn" data-form-id="deleteForm{{ course.id }}" data-bs-toggle="modal" data-bs-target="#confirmDeleteModal" style="background: #dc3545; color: white; border: none; padding: 6px 12px; border-radius: 0 6px 6px 0; font-size: 11px; font-weight: 600;">
                                <i class="ti ti-trash"></i>
                            </button>
                        </div>
                        <form method="post" action="{{ path('admin_course_delete', {'id': course.id}) }}" style="display:none;" id="deleteForm{{ course.id }}">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ course.id) }}">
                        </form>
                    </td>
                </tr>
            {% endfor %}
        {% else %}
            <tr>
                <td colspan="5" style="padding: 60px 20px; text-align: center; color: #6c757d;">
                    <p style="margin: 0 0 12px 0; font-size: 32px;">
                        <i class="ti ti-search" style="opacity: 0.4;"></i>
                    </p>
                    <p style="margin: 0; font-size: 14px; font-weight: 500;">Aucun cours trouvé</p>
                </td>
            </tr>
        {% endif %}
    </tbody>
</table>
