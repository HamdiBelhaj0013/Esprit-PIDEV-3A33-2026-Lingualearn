{% extends 'base.html.twig' %}

{% block title %}Modifier un Post - Forum{% endblock %}

{% block content %}
<div class="container-fluid mt-5">
    <div class="row mb-4">
        <div class="col-md-8">
            <h1><i class="bi bi-pencil-square"></i> Modifier le Post #{{ post.id }}</h1>
        </div>
        <div class="col-md-4 text-end">
            <a href="{{ path('admin_forum_post_index') }}" class="btn btn-secondary">
                <i class="bi bi-arrow-left"></i> Retour à la liste
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0"><i class="bi bi-form-check"></i> Formulaire de modification</h5>
                </div>
                <div class="card-body">
                    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

                    <div class="mb-3">
                        {{ form_label(form.title, 'Titre du Post') }}
                        {{ form_widget(form.title, {'attr': {'class': 'form-control' ~ (form.title.vars.errors|length > 0 ? ' is-invalid' : ''), 'placeholder': 'Entrez le titre...'}}) }}
                        {% if form.title.vars.errors|length > 0 %}
                            <div class="invalid-feedback d-block">
                                {% for error in form.title.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                        <small class="form-text text-muted">{{ form.title.vars.help }}</small>
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.content, 'Contenu') }}
                        {{ form_widget(form.content, {'attr': {'class': 'form-control' ~ (form.content.vars.errors|length > 0 ? ' is-invalid' : ''), 'placeholder': 'Écrivez votre message...'}}) }}
                        {% if form.content.vars.errors|length > 0 %}
                            <div class="invalid-feedback d-block">
                                {% for error in form.content.vars.errors %}
                                    {{ error.message }}
                                {% endfor %}
                            </div>
                        {% endif %}
                        <small class="form-text text-muted">{{ form.content.vars.help }}</small>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.authorId, 'ID Auteur') }}
                            {{ form_widget(form.authorId, {'attr': {'class': 'form-control' ~ (form.authorId.vars.errors|length > 0 ? ' is-invalid' : ''), 'placeholder': 'ID de l\'auteur'}}) }}
                            {% if form.authorId.vars.errors|length > 0 %}
                                <div class="invalid-feedback d-block">
                                    {% for error in form.authorId.vars.errors %}
                                        {{ error.message }}
                                    {% endfor %}
                                </div>
                            {% endif %}
                            <small class="form-text text-muted">{{ form.authorId.vars.help }}</small>
                        </div>

                        <div class="col-md-6 mb-3">
                            {{ form_label(form.platformLanguageId, 'Langue de la plateforme') }}
                            {{ form_widget(form.platformLanguageId, {'attr': {'class': 'form-select' ~ (form.platformLanguageId.vars.errors|length > 0 ? ' is-invalid' : '')}}) }}
                            {% if form.platformLanguageId.vars.errors|length > 0 %}
                                <div class="invalid-feedback d-block">
                                    {% for error in form.platformLanguageId.vars.errors %}
                                        {{ error.message }}
                                    {% endfor %}
                                </div>
                            {% endif %}
                        </div>
                    </div>

                    <div class="mb-3 form-check">
                        {{ form_widget(form.isActive, {'attr': {'class': 'form-check-input'}}) }}
                        {{ form_label(form.isActive, 'Post actif ?', {'label_attr': {'class': 'form-check-label'}}) }}
                        <small class="form-text text-muted d-block">{{ form.isActive.vars.help }}</small>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <a href="{{ path('admin_forum_post_index') }}" class="btn btn-secondary">
                            <i class="bi bi-x-lg"></i> Annuler
                        </a>
                        <button type="submit" class="btn btn-warning">
                            <i class="bi bi-check-lg"></i> Mettre à jour
                        </button>
                    </div>

                    {{ form_end(form) }}
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0"><i class="bi bi-info-circle"></i> Informations</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-8">ID:</dt>
                        <dd class="col-sm-4"><strong>#{{ post.id }}</strong></dd>

                        <dt class="col-sm-8">Créé le:</dt>
                        <dd class="col-sm-4"><small>{{ post.postedAt|date('Y-m-d H:i') }}</small></dd>

                        <dt class="col-sm-8">Vues:</dt>
                        <dd class="col-sm-4"><span class="badge bg-info">{{ post.viewCount }}</span></dd>

                        <dt class="col-sm-8">Réponses:</dt>
                        <dd class="col-sm-4"><span class="badge bg-secondary">{{ post.replyCount }}</span></dd>

                        <dt class="col-sm-8">Statut:</dt>
                        <dd class="col-sm-4">
                            {% if post.isActive %}
                                <span class="badge bg-success">Actif</span>
                            {% else %}
                                <span class="badge bg-danger">Inactif</span>
                            {% endif %}
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}