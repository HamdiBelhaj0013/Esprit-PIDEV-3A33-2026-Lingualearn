{% extends 'layouts/admin.html.twig' %}

{% block title %}{% block page_title %}Edit Reply #{{ reply.id }}{% endblock %}{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_forum_post_show', {id: reply.post.id}) }}" class="btn btn-outline-secondary">
        <i class="ti ti-message-square me-1"></i> View Post
    </a>
    <a href="{{ path('admin_forum_reply_index') }}" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i> Back to Replies
    </a>
{% endblock %}

{% block content %}

    <div class="row">

        {# ===== FORM COLUMN ===== #}
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-pencil me-2"></i> Edit Reply
                    </h3>
                </div>
                <div class="card-body">

                    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}

                    {# Content #}
                    <div class="mb-3">
                        <label class="form-label required">{{ form.content.vars.label }}</label>
                        {{ form_widget(form.content, {
                            'attr': {
                                'class': 'form-control' ~ (form.content.vars.errors|length > 0 ? ' is-invalid' : ''),
                                'placeholder': 'Write your reply here…',
                                'rows': '6'
                            }
                        }) }}
                        {% if form.content.vars.errors|length > 0 %}
                            <div class="invalid-feedback d-block">
                                {% for error in form.content.vars.errors %}{{ error.message }}{% endfor %}
                            </div>
                        {% endif %}
                    </div>

                    {# Author — displayed as read-only info, not editable #}
                    <div class="mb-3">
                        <label class="form-label">Author</label>
                        <div class="alert alert-secondary mb-0">
                            <div class="d-flex align-items-center">
                                <i class="ti ti-user-circle me-2 fs-3"></i>
                                <div>
                                    <strong>
                                        {% if author %}
                                            {{ author.firstName ?? '' }} {{ author.lastName ?? '' }}
                                            {% if author.email %}({{ author.email }}){% endif %}
                                        {% else %}
                                            User #{{ reply.authorId }}
                                        {% endif %}
                                    </strong>
                                    <br>
                                    <small class="text-muted">
                                        The author cannot be changed after creation
                                    </small>
                                </div>
                            </div>
                        </div>
                        {# Hidden field to preserve the author ID #}
                        {{ form_widget(form.authorId, {'attr': {'class': 'd-none'}}) }}
                    </div>

                    {# Toggles #}
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-check form-switch">
                                {{ form_widget(form.isActive, {'attr': {'class': 'form-check-input'}}) }}
                                <span class="form-check-label">{{ form.isActive.vars.label }}</span>
                            </label>
                        </div>
                        <div class="col-md-6">
                            <label class="form-check form-switch">
                                {{ form_widget(form.isBestAnswer, {'attr': {'class': 'form-check-input'}}) }}
                                <span class="form-check-label">{{ form.isBestAnswer.vars.label }}</span>
                            </label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="{{ path('admin_forum_reply_index') }}" class="btn btn-outline-secondary">
                            <i class="ti ti-x me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-warning">
                            <i class="ti ti-device-floppy me-1"></i> Save Changes
                        </button>
                    </div>

                    {{ form_end(form) }}

                </div>
            </div>
        </div>

        {# ===== SIDEBAR ===== #}
        <div class="col-lg-4">

            {# Reply metadata #}
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-info-circle me-2"></i> Reply Details
                    </h3>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-6 text-muted">ID</dt>
                        <dd class="col-6 fw-medium">#{{ reply.id }}</dd>

                        <dt class="col-6 text-muted">Author</dt>
                        <dd class="col-6">
                            <span class="text-muted">
                                <i class="ti ti-user me-1"></i>
                                {% if author %}
                                    {{ author.firstName ?? '' }} {{ author.lastName ?? '' }}
                                {% else %}
                                    User #{{ reply.authorId }}
                                {% endif %}
                            </span>
                        </dd>

                        <dt class="col-6 text-muted">Created</dt>
                        <dd class="col-6">
                            <small class="text-muted">{{ reply.repliedAt|date('Y-m-d H:i') }}</small>
                        </dd>

                        <dt class="col-6 text-muted">Status</dt>
                        <dd class="col-6">
                            {% if reply.isActive %}
                                <span class="badge bg-success-lt">
                                    <i class="ti ti-circle-check me-1"></i>Active
                                </span>
                            {% else %}
                                <span class="badge bg-danger-lt">
                                    <i class="ti ti-circle-x me-1"></i>Inactive
                                </span>
                            {% endif %}
                        </dd>

                        <dt class="col-6 text-muted">Best Answer</dt>
                        <dd class="col-6">
                            {% if reply.isBestAnswer %}
                                <span class="badge bg-success-lt">
                                    <i class="ti ti-star-filled me-1"></i>Yes
                                </span>
                            {% else %}
                                <span class="badge bg-secondary-lt">No</span>
                            {% endif %}
                        </dd>
                    </dl>
                </div>
            </div>

            {# Parent post #}
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-message-square me-2"></i> Parent Post
                    </h3>
                </div>
                <div class="card-body">
                    <p class="fw-medium mb-1">{{ reply.post.title }}</p>
                    <p class="text-muted small mb-3">
                        {{ reply.post.content|slice(0, 100) }}{% if reply.post.content|length > 100 %}…{% endif %}
                    </p>
                    <dl class="row small mb-3">
                        <dt class="col-7 text-muted">Post ID</dt>
                        <dd class="col-5">#{{ reply.post.id }}</dd>

                        <dt class="col-7 text-muted">Total replies</dt>
                        <dd class="col-5">
                            <span class="badge bg-secondary-lt">{{ reply.post.replyCount }}</span>
                        </dd>
                    </dl>
                    <a href="{{ path('admin_forum_post_show', {id: reply.post.id}) }}"
                       class="btn btn-outline-primary btn-sm w-100">
                        <i class="ti ti-eye me-1"></i> View Post
                    </a>
                </div>
            </div>

            {# Danger zone #}
            <div class="card border-danger">
                <div class="card-header bg-danger-lt">
                    <h3 class="card-title text-danger">
                        <i class="ti ti-alert-triangle me-2"></i> Danger Zone
                    </h3>
                </div>
                <div class="card-body">
                    <p class="text-muted small">Permanently delete this reply. This cannot be undone.</p>
                    <form method="post"
                          action="{{ path('admin_forum_reply_delete', {id: reply.id}) }}"
                          onsubmit="return confirm('Delete reply #{{ reply.id }}? This cannot be undone.');">
                        <input type="hidden" name="_method" value="DELETE">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reply.id) }}">
                        <button type="submit" class="btn btn-danger btn-sm w-100">
                            <i class="ti ti-trash me-1"></i> Delete Reply
                        </button>
                    </form>
                </div>
            </div>

        </div>
    </div>

{% endblock %}
