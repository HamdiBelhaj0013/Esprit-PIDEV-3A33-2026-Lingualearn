{% extends 'layouts/admin.html.twig' %}

{% block title %}{% block page_title %}New Reply{% endblock %}{% endblock %}

{% block page_actions %}
    <a href="{{ path('admin_forum_reply_index') }}" class="btn btn-outline-secondary">
        <i class="ti ti-arrow-left me-1"></i> Back to Replies
    </a>
    <a href="{{ path('admin_forum_index') }}" class="btn btn-outline-secondary">
        <i class="ti ti-layout-dashboard me-1"></i> Forum Overview
    </a>
{% endblock %}

{% block content %}

    <div class="row">

        {# ===== FORM COLUMN ===== #}
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-message-plus me-2"></i> Create New Reply
                    </h3>
                </div>
                <div class="card-body">

                    {{ form_start(form, {
                        'attr': { 'class': 'needs-validation', 'novalidate': true }
                    }) }}

                    {# Parent Post - Use Symfony widget (now editable since disabled=false) #}
                    <div class="mb-3">
                        {{ form_label(form.post, 'Parent Post', {'label_attr': {'class': 'form-label required'}}) }}
                        {{ form_widget(form.post, {
                            'attr': {
                                'class': 'form-select' ~ (form.post.vars.errors|length > 0 ? ' is-invalid' : '')
                            }
                        }) }}
                        {{ form_errors(form.post) }}
                        <small class="form-hint text-muted">
                            <i class="ti ti-info-circle me-1"></i>
                            Select which post this reply belongs to
                        </small>
                    </div>

                    {# Content #}
                    <div class="mb-3">
                        {{ form_label(form.content, 'Content', {'label_attr': {'class': 'form-label required'}}) }}
                        {{ form_widget(form.content, {
                            'attr': {
                                'class': 'form-control' ~ (form.content.vars.errors|length > 0 ? ' is-invalid' : ''),
                                'placeholder': 'Write your reply here…',
                                'rows': '6'
                            }
                        }) }}
                        {{ form_errors(form.content) }}
                    </div>

                    {# Author — automatically set, displayed as read-only info #}
                    <div class="mb-3">
                        <label class="form-label">Author</label>
                        <div class="alert alert-info mb-0">
                            <div class="d-flex align-items-center">
                                <i class="ti ti-user-circle me-2 fs-3"></i>
                                <div>
                                    <strong>
                                        {% if currentUser %}
                                            {{ currentUser.firstName ?? '' }} {{ currentUser.lastName ?? '' }}
                                            {% if currentUser.email %}({{ currentUser.email }}){% endif %}
                                        {% else %}
                                            Current User
                                        {% endif %}
                                    </strong>
                                    <br>
                                    <small class="text-muted">
                                        This reply will be posted as you (the currently logged-in user)
                                    </small>
                                </div>
                            </div>
                        </div>
                        {# Hidden field for author ID #}
                        {{ form_widget(form.authorId) }}
                    </div>

                    {# Toggles #}
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <label class="form-check form-switch">
                                {{ form_widget(form.isActive, {'attr': {'class': 'form-check-input'}}) }}
                                <span class="form-check-label">{{ form_label(form.isActive) }}</span>
                            </label>
                            {{ form_help(form.isActive) }}
                        </div>
                        <div class="col-md-6">
                            <label class="form-check form-switch">
                                {{ form_widget(form.isBestAnswer, {'attr': {'class': 'form-check-input'}}) }}
                                <span class="form-check-label">{{ form_label(form.isBestAnswer) }}</span>
                            </label>
                            {{ form_help(form.isBestAnswer) }}
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="{{ path('admin_forum_reply_index') }}" class="btn btn-outline-secondary">
                            <i class="ti ti-x me-1"></i> Cancel
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-check me-1"></i> Create Reply
                        </button>
                    </div>

                    {{ form_end(form) }}

                </div>
            </div>
        </div>

        {# ===== SIDEBAR ===== #}
        <div class="col-lg-4">
            <div class="card mb-3">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-info-circle me-2"></i> Guidelines
                    </h3>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="d-flex align-items-start gap-2 mb-2">
                            <i class="ti ti-point-filled text-primary mt-1"></i>
                            <span>Select the parent post this reply belongs to.</span>
                        </li>
                        <li class="d-flex align-items-start gap-2 mb-2">
                            <i class="ti ti-point-filled text-primary mt-1"></i>
                            <span>The reply will be automatically posted as you.</span>
                        </li>
                        <li class="d-flex align-items-start gap-2 mb-2">
                            <i class="ti ti-point-filled text-primary mt-1"></i>
                            <span>Keep your reply clear and concise.</span>
                        </li>
                        <li class="d-flex align-items-start gap-2 mb-2">
                            <i class="ti ti-point-filled text-primary mt-1"></i>
                            <span>Enable the reply to make it visible to users.</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="ti ti-link me-2"></i> Quick Links
                    </h3>
                </div>
                <div class="card-body d-grid gap-2">
                    <a href="{{ path('admin_forum_index') }}" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-layout-dashboard me-1"></i> Forum Overview
                    </a>
                    <a href="{{ path('admin_forum_reply_index') }}" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-list me-1"></i> All Replies
                    </a>
                    <a href="{{ path('admin_forum_post_index') }}" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-message-square me-1"></i> All Posts
                    </a>
                </div>
            </div>
        </div>

    </div>

{% endblock %}
