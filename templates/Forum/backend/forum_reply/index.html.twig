{% extends 'base.html.twig' %}

{% block title %}Gestion des Réponses - Forum{% endblock %}

{% block content %}
<div class="container-fluid mt-5">
    <div class="row mb-4">
        <div class="col-md-6">
            <h1><i class="ti ti-messages"></i> Gestion des Réponses du Forum</h1>
        </div>
        <div class="col-md-6 text-end">
            <a href="{{ path('admin_forum_reply_new') }}" class="btn btn-primary">
                <i class="ti ti-plus"></i> Nouvelle Réponse
            </a>
            <a href="{{ path('admin_forum_reply_export_csv') }}" class="btn btn-success">
                <i class="ti ti-download"></i> Exporter CSV
            </a>
        </div>
    </div>

    <!-- Statistiques -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Total Réponses</h5>
                    <p class="card-text fs-4">{{ stats.total ?? 0 }}</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Réponses Actives</h5>
                    <p class="card-text fs-4">{{ stats.active ?? 0 }}</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Réponses Inactives</h5>
                    <p class="card-text fs-4">{{ stats.inactive ?? 0 }}</p>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">Meilleures Réponses</h5>
                    <p class="card-text fs-4">{{ stats.bestAnswers ?? 0 }}</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Recherche et Filtres -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="ti ti-filter"></i> Recherche et Filtres</h5>
        </div>
        <div class="card-body">
            <form method="GET" class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">Mot-clé</label>
                    <input type="text" name="keyword" class="form-control" placeholder="Rechercher..." 
                           value="{{ filters.keyword ?? '' }}">
                </div>

                <div class="col-md-2">
                    <label class="form-label">ID Auteur</label>
                    <input type="number" name="authorId" class="form-control" placeholder="ID Auteur" 
                           value="{{ filters.authorId ?? '' }}">
                </div>

                <div class="col-md-3">
                    <label class="form-label">Post parent</label>
                    <select name="postId" class="form-select">
                        <option value="">Tous les posts</option>
                        {% if posts is defined %}
                            {% for p in posts %}
                                <option value="{{ p.id }}" {% if filters.postId == p.id %}selected{% endif %}>
                                    #{{ p.id }} - {{ p.title|slice(0, 30) }}{% if p.title|length > 30 %}...{% endif %}
                                </option>
                            {% endfor %}
                        {% endif %}
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Statut</label>
                    <select name="isActive" class="form-select">
                        <option value="">Tous</option>
                        <option value="1" {% if filters.isActive == 1 %}selected{% endif %}>Actives</option>
                        <option value="0" {% if filters.isActive == 0 %}selected{% endif %}>Inactives</option>
                    </select>
                </div>

                <div class="col-md-2 align-self-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="ti ti-search"></i> Rechercher
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Filtre Meilleure Réponse -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="ti ti-star"></i> Filtre Meilleure Réponse</h5>
        </div>
        <div class="card-body">
            <form method="GET" class="row g-3">
                <!-- Passer les filtres actuels -->
                <input type="hidden" name="keyword" value="{{ filters.keyword ?? '' }}">
                <input type="hidden" name="authorId" value="{{ filters.authorId ?? '' }}">
                <input type="hidden" name="postId" value="{{ filters.postId ?? '' }}">
                <input type="hidden" name="isActive" value="{{ filters.isActive ?? '' }}">
                <input type="hidden" name="sortField" value="{{ filters.sortField ?? '' }}">
                <input type="hidden" name="sortOrder" value="{{ filters.sortOrder ?? '' }}">

                <div class="col-md-6">
                    <label class="form-label">Meilleure réponse</label>
                    <select name="isBestAnswer" class="form-select">
                        <option value="">Toutes les réponses</option>
                        <option value="1" {% if filters.isBestAnswer == 1 %}selected{% endif %}>Meilleures réponses</option>
                        <option value="0" {% if filters.isBestAnswer == 0 %}selected{% endif %}>Autres réponses</option>
                    </select>
                </div>

                <div class="col-md-6 align-self-end">
                    <button type="submit" class="btn btn-success w-100">
                        <i class="ti ti-check"></i> Appliquer le filtre
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Tri -->
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0"><i class="ti ti-sort-ascending"></i> Tri</h5>
        </div>
        <div class="card-body">
            <form method="GET" class="row g-3">
                <!-- Passer les filtres actuels -->
                <input type="hidden" name="keyword" value="{{ filters.keyword ?? '' }}">
                <input type="hidden" name="authorId" value="{{ filters.authorId ?? '' }}">
                <input type="hidden" name="postId" value="{{ filters.postId ?? '' }}">
                <input type="hidden" name="isActive" value="{{ filters.isActive ?? '' }}">
                <input type="hidden" name="isBestAnswer" value="{{ filters.isBestAnswer ?? '' }}">

                <div class="col-md-6">
                    <label class="form-label">Trier par</label>
                    <select name="sortField" class="form-select">
                        <option value="repliedAt" {% if filters.sortField == 'repliedAt' %}selected{% endif %}>Date de réponse</option>
                        <option value="id" {% if filters.sortField == 'id' %}selected{% endif %}>ID</option>
                        <option value="authorId" {% if filters.sortField == 'authorId' %}selected{% endif %}>Auteur</option>
                        <option value="content" {% if filters.sortField == 'content' %}selected{% endif %}>Contenu</option>
                    </select>
                </div>

                <div class="col-md-3">
                    <label class="form-label">Ordre</label>
                    <select name="sortOrder" class="form-select">
                        <option value="DESC" {% if filters.sortOrder == 'DESC' %}selected{% endif %}>Décroissant ↓</option>
                        <option value="ASC" {% if filters.sortOrder == 'ASC' %}selected{% endif %}>Croissant ↑</option>
                    </select>
                </div>

                <div class="col-md-3 align-self-end">
                    <button type="submit" class="btn btn-info w-100">
                        <i class="ti ti-check"></i> Appliquer le tri
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Messages Flash -->
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="ti ti-check"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {% for message in app.flashes('error') %}
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="ti ti-alert-circle"></i> {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <!-- Tableau des Réponses -->
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th width="40"><input type="checkbox" id="selectAll" class="form-check-input"></th>
                        <th>ID</th>
                        <th>Post</th>
                        <th>Contenu</th>
                        <th>Auteur</th>
                        <th>Date</th>
                        <th>Meilleure</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% if replies is not empty %}
                        {% for reply in replies %}
                        <tr>
                            <td><input type="checkbox" class="form-check-input reply-checkbox" value="{{ reply.id }}"></td>
                            <td><strong>#{{ reply.id }}</strong></td>
                            <td>
                                <a href="{{ path('admin_forum_post_show', {id: reply.post.id}) }}" class="text-decoration-none" title="{{ reply.post.title }}">
                                    {{ reply.post.title|slice(0, 30) }}{% if reply.post.title|length > 30 %}...{% endif %}
                                </a>
                            </td>
                            <td>
                                <div class="text-truncate" title="{{ reply.content }}">
                                    {{ reply.content|slice(0, 50) }}{% if reply.content|length > 50 %}...{% endif %}
                                </div>
                            </td>
                            <td>{{ reply.authorId }}</td>
                            <td><small>{{ reply.repliedAt|date('Y-m-d H:i') }}</small></td>
                            <td>
                                {% if reply.isBestAnswer %}
                                    <span class="badge bg-success"><i class="ti ti-star-filled"></i> Oui</span>
                                {% else %}
                                    <span class="badge bg-secondary">Non</span>
                                {% endif %}
                            </td>
                            <td>
                                <div class="form-check form-switch">
                                    <input class="form-check-input toggle-status" type="checkbox" 
                                           {% if reply.isActive %}checked{% endif %}
                                           data-reply-id="{{ reply.id }}" 
                                           data-url="{{ path('admin_forum_reply_toggle_status', {id: reply.id}) }}">
                                </div>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    {% if not reply.isBestAnswer %}
                                    <button type="button" class="btn btn-success mark-best-answer" 
                                            data-reply-id="{{ reply.id }}" 
                                            data-url="{{ path('admin_forum_reply_mark_best_answer', {id: reply.id}) }}" 
                                            title="Marquer comme meilleure réponse">
                                        <i class="ti ti-star"></i>
                                    </button>
                                    {% endif %}
                                    <a href="{{ path('admin_forum_reply_edit', {id: reply.id}) }}" 
                                       class="btn btn-warning" title="Modifier">
                                        <i class="ti ti-pencil"></i>
                                    </a>
                                    <button type="button" class="btn btn-danger delete-reply" 
                                            data-reply-id="{{ reply.id }}" data-url="{{ path('admin_forum_reply_delete', {id: reply.id}) }}" 
                                            title="Supprimer">
                                        <i class="ti ti-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        {% endfor %}
                    {% else %}
                        <tr>
                            <td colspan="9" class="text-center text-muted py-5">
                                <i class="ti ti-inbox" style="font-size: 2rem;"></i>
                                <p class="mt-2">Aucune réponse trouvée</p>
                            </td>
                        </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
    </div>

    <!-- Actions en masse -->
    {% if replies is not empty %}
    <div class="card mt-3">
        <div class="card-body">
            <form method="POST" action="{{ path('admin_forum_reply_bulk_action') }}" id="bulkForm">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Action en masse</label>
                        <select name="action" class="form-select" required>
                            <option value="">Sélectionnez une action...</option>
                            <option value="activate">✓ Activer les réponses sélectionnées</option>
                            <option value="deactivate">✗ Désactiver les réponses sélectionnées</option>
                            <option value="delete">🗑️ Supprimer les réponses sélectionnées</option>
                        </select>
                    </div>
                    <div class="col-md-6 align-self-end">
                        <button type="submit" class="btn btn-warning w-100" id="bulkActionBtn" disabled>
                            <i class="ti ti-lightning"></i> Appliquer l'action
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
    {% endif %}

    <!-- Pagination -->
    {% if totalPages > 1 %}
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            {% if currentPage > 1 %}
                <li class="page-item">
                    <a class="page-link" href="?page=1&keyword={{ filters.keyword }}&authorId={{ filters.authorId }}&postId={{ filters.postId }}&isActive={{ filters.isActive }}&isBestAnswer={{ filters.isBestAnswer }}&sortField={{ filters.sortField }}&sortOrder={{ filters.sortOrder }}">Première</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="?page={{ currentPage - 1 }}&keyword={{ filters.keyword }}&authorId={{ filters.authorId }}&postId={{ filters.postId }}&isActive={{ filters.isActive }}&isBestAnswer={{ filters.isBestAnswer }}&sortField={{ filters.sortField }}&sortOrder={{ filters.sortOrder }}">Précédente</a>
                </li>
            {% endif %}

            {% for page in 1..totalPages %}
                {% if page >= currentPage - 2 and page <= currentPage + 2 %}
                    <li class="page-item {% if page == currentPage %}active{% endif %}">
                        <a class="page-link" href="?page={{ page }}&keyword={{ filters.keyword }}&authorId={{ filters.authorId }}&postId={{ filters.postId }}&isActive={{ filters.isActive }}&isBestAnswer={{ filters.isBestAnswer }}&sortField={{ filters.sortField }}&sortOrder={{ filters.sortOrder }}">{{ page }}</a>
                    </li>
                {% endif %}
            {% endfor %}

            {% if currentPage < totalPages %}
                <li class="page-item">
                    <a class="page-link" href="?page={{ currentPage + 1 }}&keyword={{ filters.keyword }}&authorId={{ filters.authorId }}&postId={{ filters.postId }}&isActive={{ filters.isActive }}&isBestAnswer={{ filters.isBestAnswer }}&sortField={{ filters.sortField }}&sortOrder={{ filters.sortOrder }}">Suivante</a>
                </li>
                <li class="page-item">
                    <a class="page-link" href="?page={{ totalPages }}&keyword={{ filters.keyword }}&authorId={{ filters.authorId }}&postId={{ filters.postId }}&isActive={{ filters.isActive }}&isBestAnswer={{ filters.isBestAnswer }}&sortField={{ filters.sortField }}&sortOrder={{ filters.sortOrder }}">Dernière</a>
                </li>
            {% endif %}
        </ul>
    </nav>
    {% endif %}
</div>

<!-- Modal de confirmation pour suppression -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="ti ti-alert-triangle"></i> Confirmer la suppression</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">Êtes-vous sûr de vouloir supprimer cette réponse ?</p>
                <p class="text-muted small">Cette action est irréversible.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
                <form method="POST" id="deleteForm" style="display: inline;">
                    <input type="hidden" name="_token" id="csrfToken">
                    <button type="submit" class="btn btn-danger">
                        <i class="ti ti-trash"></i> Supprimer
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const selectAll = document.getElementById('selectAll');
    const checkboxes = document.querySelectorAll('.reply-checkbox');
    const bulkActionBtn = document.getElementById('bulkActionBtn');

    selectAll?.addEventListener('change', function() {
        checkboxes.forEach(checkbox => checkbox.checked = this.checked);
        updateBulkActionButton();
    });

    checkboxes.forEach(checkbox => {
        checkbox.addEventListener('change', updateBulkActionButton);
    });

    function updateBulkActionButton() {
        const anyChecked = Array.from(checkboxes).some(cb => cb.checked);
        bulkActionBtn.disabled = !anyChecked;
    }

    const bulkForm = document.getElementById('bulkForm');
    bulkForm?.addEventListener('submit', function(e) {
        const selectedIds = Array.from(checkboxes)
            .filter(cb => cb.checked)
            .map(cb => cb.value);
        
        selectedIds.forEach(id => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'reply_ids[]';
            input.value = id;
            this.appendChild(input);
        });
    });

    document.querySelectorAll('.toggle-status').forEach(toggle => {
        toggle.addEventListener('change', function() {
            const url = this.dataset.url;
            fetch(url, {
                method: 'POST',
                headers: {'X-Requested-With': 'XMLHttpRequest'}
            })
            .then(response => response.json())
            .then(data => {
                if (!data.success) {
                    alert('Erreur: ' + data.message);
                    this.checked = !this.checked;
                }
            })
            .catch(() => {
                alert('Une erreur est survenue');
                this.checked = !this.checked;
            });
        });
    });

    document.querySelectorAll('.mark-best-answer').forEach(btn => {
        btn.addEventListener('click', function() {
            if (confirm('Marquer cette réponse comme meilleure réponse ?')) {
                const url = this.dataset.url;
                fetch(url, {
                    method: 'POST',
                    headers: {'X-Requested-With': 'XMLHttpRequest'}
                })
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        alert(data.message);
                        location.reload();
                    } else {
                        alert('Erreur: ' + data.message);
                    }
                })
                .catch(() => alert('Une erreur est survenue'));
            }
        });
    });

    document.querySelectorAll('.delete-reply').forEach(btn => {
        btn.addEventListener('click', function() {
            const url = this.dataset.url;
            const deleteForm = document.getElementById('deleteForm');
            deleteForm.action = url;
            new bootstrap.Modal(document.getElementById('deleteModal')).show();
        });
    });
});
</script>
{% endblock %}