            <hr style="border-color:var(--d-b1);margin:0;margin-top:auto">
            <div class="dsh" style="padding-bottom:8px">
                <div class="dsh-l">
                    <div class="dsh-ic" style="background:rgba(59,130,246,.12);color:#2563eb"><i class="ti ti-bolt"></i></div>
                    <div><div class="dsh-t">Quick Actions</div></div>
                </div>
            </div>
            <div class="qa-g">
                <a href="{{ path('admin_users_new') }}" class="qa-i">
                    <span class="qa-i-ico" style="color:#2563eb">👤</span>
                    <span class="qa-i-n">New User</span>
                    <span class="qa-i-s">Create account</span>
                </a>
                <a href="{{ path('admin_users_index') }}" class="qa-i">
                    <span class="qa-i-ico" style="color:#059669">📋</span>
                    <span class="qa-i-n">All Users</span>
                    <span class="qa-i-s">{{ total }} total</span>
                </a>
                <a href="{{ path('admin_users_index', {status: 'suspended'}) }}" class="qa-i">
                    <span class="qa-i-ico" style="color:#d97706">⚠️</span>
                    <span class="qa-i-n">Suspended</span>
                    <span class="qa-i-s">{{ suspended }} users</span>
                </a>
                <a href="{{ path('admin_dashboard_export') }}" class="qa-i">
                    <span class="qa-i-ico" style="color:#7c3aed">📊</span>
                    <span class="qa-i-n">Export CSV</span>
                    <span class="qa-i-s">Full report</span>
