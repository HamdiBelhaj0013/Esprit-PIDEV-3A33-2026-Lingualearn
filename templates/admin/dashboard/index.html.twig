{% block javascripts %}
    {{ parent() }}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            /* ── Animated number counters ──────────────────────────── */
            function countTo(el, target, ms) {
                const ease = t => 1 - Math.pow(1 - t, 3);
                const start = performance.now();
                (function step(now) {
                    const t = Math.min((now - start) / ms, 1);
                    el.textContent = Math.round(ease(t) * target).toLocaleString();
                    if (t < 1) requestAnimationFrame(step);
                })(performance.now());
            }
            document.querySelectorAll('[data-count]').forEach((el, i) => {
                setTimeout(() => countTo(el, parseInt(el.dataset.count) || 0, 1300), i * 110 + 250);
            });

            /* ── Progress bars ─────────────────────────────────────── */
            setTimeout(() => {
                document.querySelectorAll('.dpf[data-w], .plan-bar-fill[data-w]').forEach((b, i) => {
                    setTimeout(() => { b.style.width = b.dataset.w + '%'; }, i * 60);
                });
            }, 400);

            /* ── Chart.js defaults ─────────────────────────────────── */
            Chart.defaults.color = '#64748b';
            Chart.defaults.font.size = 11;

            /* ── User Growth Chart ─────────────────────────────────── */
            const gEl = document.getElementById('growthChart');
            let growthChart = null;

            function buildGrowthGrad(ctx) {
                const g = ctx.createLinearGradient(0, 0, 0, 240);
                g.addColorStop(0,   'rgba(59,130,246,.22)');
                g.addColorStop(0.6, 'rgba(59,130,246,.05)');
                g.addColorStop(1,   'rgba(59,130,246,0)');
                return g;
            }

            function updatePeriodTotal(data) {
                const total = (data || []).reduce((a, b) => a + b, 0);
                const el = document.getElementById('chartPeriodTotal');
                if (el) el.textContent = total > 0 ? total.toLocaleString() + ' registrations' : '';
                const lbl = document.getElementById('chartRangeLabel');
                if (lbl) lbl.textContent = 'Showing ' + total.toLocaleString() + ' registrations';
            }

            if (gEl) {
                const ctx = gEl.getContext('2d');

                /* Initial data — "all time" so SQL-imported users are visible immediately */
                const initLabels = {{ userGrowthData.labels|json_encode|raw }};
                const initData   = {{ userGrowthData.data|json_encode|raw }};

                growthChart = new Chart(gEl, {
                    type: 'line',
                    data: {
                        labels: initLabels,
                        datasets: [{
                            label: 'New Users',
                            data: initData,
                            borderColor: '#3b82f6',
                            borderWidth: 2.5,
                            backgroundColor: buildGrowthGrad(ctx),
                            tension: 0.45,
                            fill: true,
                            pointRadius: 0,
                            pointHoverRadius: 5,
                            pointHoverBackgroundColor: '#3b82f6',
                            pointHoverBorderColor: '#fff',
                            pointHoverBorderWidth: 2,
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        interaction: { mode: 'index', intersect: false },
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                backgroundColor: '#1e293b',
                                borderColor: 'rgba(59,130,246,.3)',
                                borderWidth: 1,
                                padding: 12,
                                titleColor: '#f1f5f9',
                                bodyColor: '#93c5fd',
                                callbacks: { label: c => `  ${c.parsed.y} new users` }
                            }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                ticks: { precision: 0, color: '#94a3b8' },
                                grid: { color: 'rgba(0,0,0,.05)', drawBorder: false },
                                border: { display: false }
                            },
                            x: {
                                grid: { display: false },
                                ticks: { color: '#94a3b8', maxTicksLimit: 10 },
                                border: { display: false }
                            }
                        }
                    }
                });
                updatePeriodTotal(initData);
            }

            /* ── Period tab switching ───────────────────────────────── */
            document.querySelectorAll('.dtab[data-p]').forEach(btn => {
                btn.addEventListener('click', function () {
                    document.querySelectorAll('.dtab[data-p]').forEach(b => b.classList.remove('on'));
                    this.classList.add('on');
                    const period = this.dataset.p;

                    fetch(`{{ path('admin_dashboard_chart_data') }}?period=${period}`)
                        .then(r => r.json())
                        .then(d => {
                            if (!growthChart) return;
                            /* Recreate gradient on new canvas dimensions */
                            const newGrad = buildGrowthGrad(gEl.getContext('2d'));
                            growthChart.data.labels = d.labels;
                            growthChart.data.datasets[0].data = d.data;
                            growthChart.data.datasets[0].backgroundColor = newGrad;
                            growthChart.update('active');
                            updatePeriodTotal(d.data);
                        })
                        .catch(console.error);
                });
            });

            /* ── Revenue Doughnut ──────────────────────────────────── */
            const rEl = document.getElementById('revenueChart');
            if (rEl) {
                const rData = {{ revenueData.data|json_encode|raw }};
                const hasRevenue = rData.some(v => v > 0);
                new Chart(rEl, {
                    type: 'doughnut',
                    data: {
                        labels: {{ revenueData.labels|json_encode|raw }},
                        datasets: [{
                            data: hasRevenue ? rData : [1],
                            backgroundColor: hasRevenue ? ['#10b981', '#f59e0b', '#e2e8f0'] : ['#e2e8f0'],
                            borderWidth: 3,
                            borderColor: '#ffffff',
                            hoverOffset: 8
                        }]
                    },
                    options: {
                        responsive: false,
                        maintainAspectRatio: false,
                        cutout: '76%',
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                enabled: hasRevenue,
                                backgroundColor: '#1e293b',
                                padding: 10,
                                titleColor: '#f1f5f9',
                                bodyColor: '#94a3b8',
                                callbacks: { label: c => `  $${c.parsed.toFixed(2)}` }
                            }
                        }
                    }
                });
            }

            /* ── Plan Distribution Doughnut ───────────────────────── */
            const pEl = document.getElementById('planChart');
            if (pEl) {
                const freeCnt     = {{ planDistribution.FREE|default(0) }};
                const monthlyCnt  = {{ planDistribution.MONTHLY|default(0) }};
                const yearlyCnt   = {{ planDistribution.YEARLY|default(0) }};
                const total       = freeCnt + monthlyCnt + yearlyCnt;
                new Chart(pEl, {
                    type: 'doughnut',
                    data: {
                        labels: ['Free', 'Monthly', 'Yearly'],
                        datasets: [{
                            data: total > 0 ? [freeCnt, monthlyCnt, yearlyCnt] : [1, 0, 0],
                            backgroundColor: total > 0 ? ['#94a3b8', '#10b981', '#f59e0b'] : ['#e2e8f0'],
                            borderWidth: 2,
                            borderColor: '#ffffff',
                            hoverOffset: 6
                        }]
                    },
                    options: {
                        responsive: false,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                enabled: total > 0,
                                backgroundColor: '#1e293b',
                                padding: 8,
                                titleColor: '#f1f5f9',
                                bodyColor: '#94a3b8',
                                callbacks: {
                                    label: c => {
                                        const pct = total > 0 ? ((c.parsed / total) * 100).toFixed(1) : 0;
                                        return `  ${c.label}: ${c.parsed} (${pct}%)`;
                                    }
                                }
                            }
                        }
                    }
                });
            }

            /* ── Refresh button ────────────────────────────────────── */
            document.getElementById('refreshBtn')?.addEventListener('click', () => {
                document.getElementById('refreshIcon').classList.add('spinning');
                setTimeout(() => location.reload(), 700);
            });

        });

        function setRange(days) {
            const end   = new Date();
            const start = new Date();
            start.setDate(start.getDate() - days);
            const fmt = d => d.toISOString().slice(0, 10);
            document.querySelector('[name="start_date"]').value = fmt(start);
            document.querySelector('[name="end_date"]').value   = fmt(end);
        }
    </script>
{% endblock %}
