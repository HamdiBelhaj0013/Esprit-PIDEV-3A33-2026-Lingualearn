                    </div>
                    <div class="rli">
                        <span class="rll"><span class="rld" style="background:#94a3b8"></span>Last Month MRR</span>
                        <span class="rlv">${{ revenueStats.lastMonth|default(0)|number_format(2) }}</span>
                    </div>
