            <div class="cr">
                <div class="cr-ic" style="background:rgba(16,185,129,.12);color:#059669"><i class="ti ti-users"></i></div>
                <div><div class="cr-n">Enrollments</div><div class="cr-s">Total course joins</div></div>
                <div class="cr-v gg">{{ totalEnrollments|default(0)|number_format }}</div>
            </div>
            <div class="cr">
                <div class="cr-ic" style="background:rgba(6,182,212,.12);color:#0891b2"><i class="ti ti-messages"></i></div>
                <div><div class="cr-n">Forum Posts</div><div class="cr-s">{{ forumStats.todayPosts|default(0) }} today &middot; {{ forumReplyCount|default(0) }} replies</div></div>
                <div class="cr-v gc">{{ forumPostCount|default(0) }}</div>
            </div>
        </div>

        {# ── Health + Quick Actions ── #}
        <div class="dc ar fu d9" style="display:flex;flex-direction:column">
            <div class="dsh">
                <div class="dsh-l">
                    <div class="dsh-ic" style="background:rgba(239,68,68,.12);color:#dc2626"><i class="ti ti-heartbeat"></i></div>
                    <div><div class="dsh-t">System Health</div><div class="dsh-s">Infrastructure status</div></div>
                </div>
