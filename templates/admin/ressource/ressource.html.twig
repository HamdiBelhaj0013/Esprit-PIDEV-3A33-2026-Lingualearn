{# templates/admin/ressource/ressource.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ressources - Administration</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: #f8fafc;
            color: #1e293b;
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        /* Sidebar - IDENTIQUE aux pages de gestion */
        .sidebar {
            width: 260px;
            background: white;
            border-right: 1px solid #e2e8f0;
            display: flex;
            flex-direction: column;
            position: fixed;
            height: 100vh;
        }

        .sidebar-header {
            padding: 24px 20px;
            border-bottom: 1px solid #f1f5f9;
        }

        .logo {
            font-size: 1.4rem;
            font-weight: 600;
            color: #2563eb;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .logo i {
            font-size: 1.8rem;
        }

        .nav-menu {
            flex: 1;
            padding: 20px 0;
        }

        .nav-item {
            display: flex;
            align-items: center;
            padding: 10px 20px;
            margin: 4px 8px;
            color: #64748b;
            text-decoration: none;
            font-size: 0.9rem;
            border-radius: 8px;
            transition: all 0.2s;
        }

        .nav-item i {
            margin-right: 12px;
            font-size: 1.2rem;
            width: 24px;
        }

        .nav-item:hover {
            background: #f1f5f9;
            color: #2563eb;
        }

        .nav-item.active {
            background: #2563eb;
            color: white;
        }

        .nav-item.active i {
            color: white;
        }

        .user-section {
            padding: 20px;
            border-top: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .user-avatar {
            width: 40px;
            height: 40px;
            background: #2563eb;
            color: white;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
        }

        /* Contenu principal */
        .content-area {
            margin-left: 260px;
            flex: 1;
            padding: 30px;
        }

        h1.title {
            font-size: 1.95rem;
            font-weight: 600;
            color: #0f172a;
            text-align: center;
            margin-bottom: 3.5rem;
        }

        .cards {
            display: flex;
            flex-wrap: wrap;
            gap: 2.25rem;
            justify-content: center;
        }

        .card-link {
            width: 280px;
            height: 164px;
            background: linear-gradient(135deg, #6d28d9, #a78bfa);
            color: white;
            border-radius: 12px;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-size: 1.32rem;
            font-weight: 600;
            box-shadow: 0 4px 14px rgba(109,40,217,0.18);
            transition: all 0.25s ease;
        }

        .card-link:hover {
            transform: translateY(-7px);
            box-shadow: 0 12px 28px rgba(109,40,217,0.28);
        }

        .card-link i {
            font-size: 3.2rem;
            margin-bottom: 0.9rem;
        }

        footer {
            text-align: center;
            padding: 1.5rem;
            color: #64748b;
            font-size: 0.9rem;
            border-top: 1px solid #e2e8f0;
            background: white;
            margin-left: 260px;
        }
    </style>
</head>
<body>

<div class="layout">
    <!-- Sidebar - IDENTIQUE aux pages de gestion -->
    <aside class="sidebar">
        <div class="sidebar-header">
            <div class="logo">
                <i class="bi bi-chat-quote-fill"></i>
                <span>LinguLearn</span>
            </div>
        </div>

        <div class="nav-menu">
            <a href="{{ path('admin_dashboard') }}" class="nav-item">
                <i class="bi bi-grid"></i>
                <span>Dashboard</span>
            </a>
            <a href="{{ path('admin_gestion_publications') }}" class="nav-item">
                <i class="bi bi-newspaper"></i>
                <span>Publications</span>
            </a>
            <a href="{{ path('admin_gestion_commentaires') }}" class="nav-item">
                <i class="bi bi-chat"></i>
                <span>Commentaires</span>
            </a>
           
        </div>

        <div class="user-section">
            <div class="user-avatar">
                {% if app.user %}
                    {{ app.user.email|first|upper }}
                {% else %}
                    A
                {% endif %}
            </div>
            <div>
                <div style="font-weight: 500; font-size:0.9rem;">
                    {% if app.user %}
                        {{ app.user.email }}
                    {% else %}
                        Admin
                    {% endif %}
                </div>
                <div style="font-size:0.75rem; color:#64748b;">Administrateur</div>
            </div>
        </div>
    </aside>

    <!-- Main content -->
    <main class="content-area">
        <h1 class="title">Gestion des Ressources</h1>

        <div class="cards">
            <a href="{{ path('admin_gestion_publications') }}" class="card-link">
                <i class="ti ti-file-text"></i>
                Gestion Publications
            </a>

            <a href="{{ path('admin_gestion_commentaires') }}" class="card-link">
                <i class="ti ti-messages"></i>
                Gestion Commentaires
            </a>
        </div>
    </main>

</div>

<footer>
    LinguaLearn Admin v1.0<br>
    © {{ "now"|date("Y") }} LinguaLearn. All rights reserved.
</footer>

</body>
</html>