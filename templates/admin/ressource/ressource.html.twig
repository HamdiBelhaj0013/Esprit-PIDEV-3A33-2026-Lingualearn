{# templates/admin/ressource/ressource.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ressources - Administration</title>

    <!-- Bootstrap 5 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <!-- Tabler Icons (very common in modern admin panels) -->
    <link rel="stylesheet" href="https://unpkg.com/@tabler/icons-webfont@latest/tabler-icons.min.css">

    <style>
        :root {
            --ll-purple:      #6d28d9;     /* deeper, premium purple */
            --ll-purple-light:#a78bfa;
            --ll-gray-100:    #f8fafc;
            --ll-gray-200:    #e2e8f0;
            --ll-gray-500:    #64748b;
            --ll-gray-700:    #334155;
            --ll-bg:          #ffffff;
            --ll-shadow-sm:   0 1px 3px rgba(0,0,0,0.05);
        }

        body {
            margin: 0;
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
            background: var(--ll-gray-100);
            color: var(--ll-gray-700);
        }

        .layout {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 260px;
            background: var(--ll-bg);
            border-right: 1px solid var(--ll-gray-200);
            display: flex;
            flex-direction: column;
            box-shadow: var(--ll-shadow-sm);
        }

        .logo-block {
            padding: 1.75rem 1.25rem 1.25rem;
            border-bottom: 1px solid var(--ll-gray-200);
            text-align: center;
        }

        .logo {
            font-size: 1.85rem;
            font-weight: 700;
            color: var(--ll-purple);
            text-decoration: underline;
            text-underline-offset: 5px;
            text-decoration-thickness: 2.5px;
            text-decoration-color: rgba(109, 40, 217, 0.35);
            letter-spacing: -0.4px;
        }

        .admin-badge {
            margin-top: 1rem;
            background: #f3e8ff;
            color: var(--ll-purple);
            font-size: 0.72rem;
            font-weight: 700;
            letter-spacing: 0.7px;
            text-transform: uppercase;
            padding: 0.35rem 0.9rem;
            border-radius: 999px;
            border: 1px solid #e9d5ff;
            display: inline-block;
        }

        .nav-section {
            padding: 1.25rem 1.5rem 0.5rem;
            font-size: 0.75rem;
            font-weight: 600;
            color: var(--ll-gray-500);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            padding: 0.65rem 1.5rem;
            color: var(--ll-gray-700);
            text-decoration: none;
            font-size: 0.96rem;
            transition: all 0.15s ease;
            position: relative;
        }

        .nav-link:hover,
        .nav-link.active {
            background: #f1f5f9;
            color: var(--ll-purple);
        }

        .nav-link.active::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 4px;
            background: var(--ll-purple);
        }

        .nav-link i {
            margin-right: 0.9rem;
            font-size: 1.28rem;
            color: var(--ll-gray-500);
            width: 24px;
            text-align: center;
            transition: all 0.2s ease;
        }

        .nav-link:hover i,
        .nav-link.active i {
            color: var(--ll-purple);
            transform: scale(1.08);
        }

        .user-block {
            margin-top: auto;
            border-top: 1px solid var(--ll-gray-200);
            padding: 1.25rem 1.5rem;
            background: var(--ll-gray-100);
            display: flex;
            align-items: center;
        }

        .user-avatar {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, var(--ll-purple), var(--ll-purple-light));
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: bold;
            font-size: 1.2rem;
            margin-right: 1rem;
            box-shadow: 0 2px 8px rgba(109,40,217,0.2);
        }

        .content-area {
            flex: 1;
            padding: 2.5rem 2.5rem 1rem;
        }

        h1.title {
            font-size: 1.95rem;
            font-weight: 600;
            color: #0f172a;
            text-align: center;
            margin-bottom: 3.5rem;
        }

        .cards {
            display: flex;
            flex-wrap: wrap;
            gap: 2.25rem;
            justify-content: center;
        }

        .card-link {
            width: 280px;
            height: 164px;
            background: linear-gradient(135deg, #6d28d9, #a78bfa);
            color: white;
            border-radius: 12px;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-size: 1.32rem;
            font-weight: 600;
            box-shadow: 0 4px 14px rgba(109,40,217,0.18);
            transition: all 0.25s ease;
        }

        .card-link:hover {
            transform: translateY(-7px);
            box-shadow: 0 12px 28px rgba(109,40,217,0.28);
        }

        .card-link i {
            font-size: 3.2rem;
            margin-bottom: 0.9rem;
        }

        footer {
            text-align: center;
            padding: 1.5rem;
            color: var(--ll-gray-500);
            font-size: 0.9rem;
            border-top: 1px solid var(--ll-gray-200);
            background: white;
        }
    </style>
</head>
<body>

<div class="layout">

    <!-- Enhanced Sidebar -->
    <aside class="sidebar">

        <div class="logo-block">
            <div class="logo">LinguaLearn</div>
            <div class="admin-badge">ADMIN PANEL</div>
        </div>

        <div class="nav-section">MAIN</div>
        <a href="" class="nav-link">
            <i class="ti ti-layout-dashboard"></i> Dashboard
        </a>

        <div class="nav-section">MANAGEMENT</div>

        <div class="nav-section">CONTENT</div>

        <div class="nav-section">COMMUNITY</div>

        <div class="nav-section">SYSTEM</div>
        <a href="#" class="nav-link">
            <i class="ti ti-settings"></i> Settings
        </a>

        <div class="user-block">
            <div class="user-avatar">A</div>
            <div>
                <div style="font-weight: 500;">Admin</div>
                <div style="font-size: 0.84rem; color: var(--ll-gray-500);">Administrator</div>
            </div>
        </div>

    </aside>

    <!-- Main content -->
    <main class="content-area">
        <h1 class="title">Gestion des Ressources</h1>

        <div class="cards">
            <a href="{{ path('admin_gestion_publications') }}" class="card-link">
                <i class="ti ti-file-text"></i>
                Gestion Publications
            </a>

            <a href="{{ path('admin_gestion_commentaires') }}" class="card-link">
                <i class="ti ti-messages"></i>
                Gestion Commentaires
            </a>
        </div>
    </main>

</div>

<footer>
    LinguaLearn Admin v1.0<br>
    © {{ "now"|date("Y") }} LinguaLearn. All rights reserved.
</footer>

</body>
</html>