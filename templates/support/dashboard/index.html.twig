{% extends 'layouts/admin.html.twig' %}

{% block title %}Support Dashboard - Admin{% endblock %}

{% block page_title %}
    <i class="ti ti-lifebuoy me-2"></i> Support Dashboard
{% endblock %}

{% block content %}
    <div class="row">
        <div class="col-md-3">
            <div class="card card-sm">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <div class="stat-item p-3 bg-primary-lt rounded-2">
                                <i class="ti ti-ticket text-primary fs-3"></i>
                            </div>
                        </div>
                        <div class="col">
                            <div class="stat mb-2">
                                <div class="stat-value">{{ stats.total }}</div>
                                <div class="stat-title">Total Tickets</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card card-sm">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <div class="stat-item p-3 bg-yellow-lt rounded-2">
                                <i class="ti ti-clock text-yellow fs-3"></i>
                            </div>
                        </div>
                        <div class="col">
                            <div class="stat mb-2">
                                <div class="stat-value">{{ stats.pending }}</div>
                                <div class="stat-title">Pending</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card card-sm">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <div class="stat-item p-3 bg-blue-lt rounded-2">
                                <i class="ti ti-progress-check text-blue fs-3"></i>
                            </div>
                        </div>
                        <div class="col">
                            <div class="stat mb-2">
                                <div class="stat-value">{{ stats.in_progress }}</div>
                                <div class="stat-title">In Progress</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card card-sm">
                <div class="card-body">
                    <div class="row align-items-center">
                        <div class="col-auto">
                            <div class="stat-item p-3 bg-green-lt rounded-2">
                                <i class="ti ti-check text-green fs-3"></i>
                            </div>
                        </div>
                        <div class="col">
                            <div class="stat mb-2">
                                <div class="stat-value">{{ stats.resolved }}</div>
                                <div class="stat-title">Resolved</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Quick Links</h3>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="{{ path('app_reclamation_index') }}" class="btn btn-outline-primary">
                            <i class="ti ti-ticket me-2"></i> Manage Tickets
                        </a>
                        <a href="{{ path('app_faq_index') }}" class="btn btn-outline-primary">
                            <i class="ti ti-help me-2"></i> Manage FAQ
                        </a>
                        <a href="{{ path('app_faq_new') }}" class="btn btn-outline-success">
                            <i class="ti ti-plus me-2"></i> Create New FAQ
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Support Status</h3>
                </div>
                <div class="card-body">
                    <div class="space-y">
                        <div class="d-flex align-items-center mb-3">
                            <div class="badge bg-yellow me-3"></div>
                            <div>
                                <strong>{{ stats.pending }}</strong> tickets waiting for response
                            </div>
                        </div>
                        <div class="d-flex align-items-center mb-3">
                            <div class="badge bg-blue me-3"></div>
                            <div>
                                <strong>{{ stats.in_progress }}</strong> tickets being processed
                            </div>
                        </div>
                        <div class="d-flex align-items-center mb-3">
                            <div class="badge bg-green me-3"></div>
                            <div>
                                <strong>{{ stats.resolved }}</strong> tickets resolved
                            </div>
                        </div>
                        <div class="d-flex align-items-center">
                            <div class="badge bg-secondary me-3"></div>
                            <div>
                                <strong>{{ stats.closed }}</strong> tickets closed
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
