{% extends 'layouts/admin.html.twig' %}

{% block title %}
    {% if is_granted('ROLE_ADMIN') %}
        FAQ Management - Admin
    {% else %}
        FAQ - Frequently Asked Questions
    {% endif %}
{% endblock %}

{% block page_title %}
    <i class="ti ti-help me-2"></i> 
    {% if is_granted('ROLE_ADMIN') %}
        FAQ Management
    {% else %}
        Frequently Asked Questions
    {% endif %}
{% endblock %}

{% block content %}

{# ── BOUTONS STATS & AUDIT (admin seulement) ── #}
{% if is_granted('ROLE_ADMIN') %}
<div class="d-flex gap-2 mb-3">
    <a href="{{ path('admin_support_stats') }}" class="btn btn-outline-primary">
        <i class="ti ti-chart-bar"></i> Statistiques avancées
    </a>
    <a href="{{ path('admin_support_audit') }}" class="btn btn-outline-secondary">
        <i class="ti ti-history"></i> Audit Trail
    </a>
</div>
{% endif %}

<div class="row">
    <div class="col-12">
        <!-- Search & Filter Bar -->
        <div class="card mb-3">
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <div class="input-icon">
                            <span class="input-icon-addon">
                                <i class="ti ti-search"></i>
                            </span>
                            <input type="text" name="search" class="form-control" 
                                   placeholder="Search question..." value="{{ search }}">
                        </div>
                    </div>
                    <div class="col-md-2">
                        <select name="subject" class="form-select">
                            <option value="">All Subjects</option>
                            {% for subj in subjects %}
                                <option value="{{ subj }}" {% if selected_subject == subj %}selected{% endif %}>{{ subj|capitalize }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="sort" class="form-select">
                            <option value="submittedAt" {% if sort == 'submittedAt' %}selected{% endif %}>Sort by Date</option>
                            <option value="question" {% if sort == 'question' %}selected{% endif %}>Sort by Question</option>
                            <option value="subject" {% if sort == 'subject' %}selected{% endif %}>Sort by Subject</option>
                            <option value="category" {% if sort == 'category' %}selected{% endif %}>Sort by Category</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <select name="order" class="form-select">
                            <option value="DESC" {% if order == 'DESC' %}selected{% endif %}>Descending</option>
                            <option value="ASC" {% if order == 'ASC' %}selected{% endif %}>Ascending</option>
                        </select>
                    </div>
                    <div class="col-md-1">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="ti ti-filter"></i>
                        </button>
                    </div>
                    {% if is_granted('ROLE_ADMIN') %}
                    <div class="col-md-1 text-end">
                        <a href="{{ path('app_faq_new') }}" class="btn btn-success w-100">
                            <i class="ti ti-plus"></i>
                        </a>
                    </div>
                    {% endif %}
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    All FAQs
                    {% if total > 0 %}
                        <span class="badge bg-azure ms-2">{{ total }}</span>
                    {% endif %}
                </h3>
                {% if pages > 1 %}
                    <div class="card-actions">
                        <span class="text-muted">Page {{ page }} / {{ pages }}</span>
                    </div>
                {% endif %}
            </div>
            <div class="card-body">
                {% if faqs|length > 0 %}
                    <div class="accordion" id="faqAccordion">
                        {% for faq in faqs %}
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="heading{{ faq.id }}">
                                <button class="accordion-button collapsed" type="button" 
                                        data-bs-toggle="collapse" 
                                        data-bs-target="#collapse{{ faq.id }}" 
                                        aria-expanded="false" 
                                        aria-controls="collapse{{ faq.id }}">
                                    <div class="d-flex justify-content-between align-items-center w-100 me-3">
                                        <div>
                                            {% if is_granted('ROLE_ADMIN') %}
                                                <strong class="text-muted me-2">#{{ faq.id }}</strong>
                                            {% endif %}
                                            {{ faq.question }}
                                        </div>
                                        <div>
                                            {% if faq.subject %}
                                                {% if faq.subject == 'payment' %}
                                                    <span class="badge bg-primary">Payment</span>
                                                {% elseif faq.subject == 'technical' %}
                                                    <span class="badge bg-info">Technical</span>
                                                {% elseif faq.subject == 'content' %}
                                                    <span class="badge bg-warning">Content</span>
                                                {% elseif faq.subject == 'premium' %}
                                                    <span class="badge bg-danger">Premium</span>
                                                {% elseif faq.subject == 'account' %}
                                                    <span class="badge bg-success">Account</span>
                                                {% else %}
                                                    <span class="badge bg-secondary">{{ faq.subject }}</span>
                                                {% endif %}
                                            {% endif %}
                                        </div>
                                    </div>
                                </button>
                            </h2>
                            <div id="collapse{{ faq.id }}" 
                                 class="accordion-collapse collapse" 
                                 aria-labelledby="heading{{ faq.id }}" 
                                 data-bs-parent="#faqAccordion">
                                <div class="accordion-body">
                                    <div class="mb-3">{{ faq.answer|nl2br }}</div>
                                    {% if is_granted('ROLE_ADMIN') %}
                                    <div class="d-flex gap-2 border-top pt-3">
                                        <a href="{{ path('app_faq_edit', {'id': faq.id}) }}"
                                           class="btn btn-sm btn-warning">
                                            <i class="ti ti-edit"></i> Edit
                                        </a>
                                        <form method="post"
                                              action="{{ path('app_faq_delete', {'id': faq.id}) }}"
                                              class="d-inline">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ faq.id) }}">
                                            <button type="submit" class="btn btn-sm btn-danger"
                                                    onclick="return confirm('Are you sure?')">
                                                <i class="ti ti-trash"></i> Delete
                                            </button>
                                        </form>
                                        <div class="ms-auto text-muted small">
                                            Created: {{ faq.submittedAt|date('d/m/Y') }}
                                            {% if faq.category %} | Category: {{ faq.category|capitalize }}{% endif %}
                                        </div>
                                    </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>

                    {% if pages > 1 %}
                    <div class="d-flex justify-content-center mt-3">
                        <ul class="pagination">
                            <li class="page-item {% if page <= 1 %}disabled{% endif %}">
                                <a class="page-link" href="{{ path('app_faq_index', app.request.query.all|merge({'page': page - 1})) }}">
                                    <i class="ti ti-chevron-left"></i>
                                </a>
                            </li>
                            {% for p in 1..pages %}
                                <li class="page-item {% if p == page %}active{% endif %}">
                                    <a class="page-link" href="{{ path('app_faq_index', app.request.query.all|merge({'page': p})) }}">{{ p }}</a>
                                </li>
                            {% endfor %}
                            <li class="page-item {% if page >= pages %}disabled{% endif %}">
                                <a class="page-link" href="{{ path('app_faq_index', app.request.query.all|merge({'page': page + 1})) }}">
                                    <i class="ti ti-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </div>
                    {% endif %}

                {% else %}
                    <div class="empty">
                        <div class="empty-icon"><i class="ti ti-help-off"></i></div>
                        <p class="empty-title">No FAQs found</p>
                        <p class="empty-subtitle text-muted">
                            {% if search or selected_subject %}
                                No results for your search.
                            {% else %}
                                {% if is_granted('ROLE_ADMIN') %}Start by creating a new FAQ.{% else %}Check back later.{% endif %}
                            {% endif %}
                        </p>
                        <div class="empty-action">
                            {% if search or selected_subject %}
                            <a href="{{ path('app_faq_index') }}" class="btn btn-outline-primary me-2">
                                <i class="ti ti-arrow-back"></i> Clear filters
                            </a>
                            {% endif %}
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('app_faq_new') }}" class="btn btn-primary">
                                    <i class="ti ti-plus"></i> Create First FAQ
                                </a>
                            {% endif %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}
