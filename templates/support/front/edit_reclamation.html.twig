{% extends 'base.html.twig' %}

{% block title %}Edit Reclamation #{{ reclamation.id }}{% endblock %}

{% block page_title %}
    <i class="ti ti-edit me-2"></i> Edit Reclamation #{{ reclamation.id }}
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Reclamation Details</h3>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <strong>Status:</strong>
                    {% if reclamation.status == 'PENDING' %}
                        <span class="badge bg-yellow">Pending</span>
                    {% elseif reclamation.status == 'IN_PROGRESS' %}
                        <span class="badge bg-blue">In Progress</span>
                    {% elseif reclamation.status == 'RESOLVED' %}
                        <span class="badge bg-green">Resolved</span>
                    {% elseif reclamation.status == 'CLOSED' %}
                        <span class="badge bg-secondary">Closed</span>
                    {% endif %}
                </div>

                {{ form_start(form) }}

                    <div class="mb-3">
                        {{ form_label(form.subject) }}
                        {{ form_widget(form.subject, {'attr': {'class': 'form-select'}}) }}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.messageBody) }}
                        {{ form_widget(form.messageBody, {'attr': {'class': 'form-control', 'rows': '5'}}) }}
                    </div>

                    <div class="form-footer">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-check"></i> Save Changes
                        </button>
                        <a href="{{ path('front_support_dashboard') }}" class="btn btn-link">
                            Back
                        </a>
                    </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Information</h3>
            </div>
            <div class="list-group list-group-flush">
                <div class="list-group-item">
                    <div class="row align-items-center">
                        <div class="col text-muted">ID</div>
                        <div class="col-auto"><strong>#{{ reclamation.id }}</strong></div>
                    </div>
                </div>
                <div class="list-group-item">
                    <div class="row align-items-center">
                        <div class="col text-muted">Created</div>
                        <div class="col-auto">{{ reclamation.submittedAt|date('d/m/Y H:i') }}</div>
                    </div>
                </div>
                <div class="list-group-item">
                    <div class="row align-items-center">
                        <div class="col text-muted">Responses</div>
                        <div class="col-auto"><span class="badge bg-azure">{{ reclamation.responses|length }}</span></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
