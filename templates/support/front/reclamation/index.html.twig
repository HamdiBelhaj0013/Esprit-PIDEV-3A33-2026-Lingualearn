{% extends 'base/layout.html.twig' %}

{% block title %}Mes réclamations - Support{% endblock %}

{% block page_title %}
    <i class="ti ti-ticket me-2"></i> Mes réclamations
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12">
        <!-- Search & Filter Bar -->
        <div class="card mb-3">
            <div class="card-body">
                <form method="get" class="row g-3 align-items-end">
                    <div class="col-md-4">
                        <label class="form-label">Recherche</label>
                        <div class="input-icon">
                            <span class="input-icon-addon">
                                <i class="ti ti-search"></i>
                            </span>
                            <input type="text" name="search" class="form-control" 
                                   placeholder="Rechercher..." value="{{ search }}">
                        </div>
                    </div>
                    
                    <div class="col-md-2">
                        <label class="form-label">Statut</label>
                        <select name="status" class="form-select">
                            <option value="">Tous</option>
                            <option value="PENDING" {% if status == 'PENDING' %}selected{% endif %}>En attente</option>
                            <option value="IN_PROGRESS" {% if status == 'IN_PROGRESS' %}selected{% endif %}>En cours</option>
                            <option value="RESOLVED" {% if status == 'RESOLVED' %}selected{% endif %}>Résolu</option>
                            <option value="CLOSED" {% if status == 'CLOSED' %}selected{% endif %}>Fermé</option>
                        </select>
                    </div>
                    
                    <div class="col-md-2">
                        <label class="form-label">Trier par</label>
                        <select name="sort" class="form-select">
                            <option value="submittedAt" {% if sort == 'submittedAt' %}selected{% endif %}>Date</option>
                            <option value="status" {% if sort == 'status' %}selected{% endif %}>Statut</option>
                            <option value="subject" {% if sort == 'subject' %}selected{% endif %}>Sujet</option>
                        </select>
                    </div>
                    
                    <div class="col-md-2">
                        <label class="form-label">Ordre</label>
                        <select name="order" class="form-select">
                            <option value="DESC" {% if order == 'DESC' %}selected{% endif %}>Décroissant</option>
                            <option value="ASC" {% if order == 'ASC' %}selected{% endif %}>Croissant</option>
                        </select>
                    </div>
                    
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="ti ti-filter"></i> Filtrer
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="row mb-3">
    <div class="col-12 d-flex justify-content-between align-items-center">
        <p class="text-muted mb-0">
            {% if total > 0 %}
                {{ total }} réclamation(s) trouvée(s)
                {% if pages > 1 %}- Page {{ page }} / {{ pages }}{% endif %}
            {% else %}
                Aucune réclamation trouvée
            {% endif %}
        </p>
        <a href="{{ path('front_reclamation_new') }}" class="btn btn-primary">
            <i class="ti ti-plus"></i> Nouvelle réclamation
        </a>
    </div>
</div>

{% if reclamations|length > 0 %}
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-vcenter table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Sujet</th>
                                    <th>Statut</th>
                                    <th>Date</th>
                                    <th>Réponses</th>
                                    <th class="table-actions" style="width: 1%; white-space: nowrap;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for reclamation in reclamations %}
                                <tr>
                                    <td>#{{ reclamation.id }}</td>
                                    <td>
                                        <div class="text-truncate" style="max-width: 200px;">
                                            {{ reclamation.subject }}
                                        </div>
                                    </td>
                                    <td>
                                        {% if reclamation.status == 'PENDING' %}
                                            <span class="badge bg-yellow">En attente</span>
                                        {% elseif reclamation.status == 'IN_PROGRESS' %}
                                            <span class="badge bg-blue">En cours</span>
                                        {% elseif reclamation.status == 'RESOLVED' %}
                                            <span class="badge bg-green">Résolu</span>
                                        {% elseif reclamation.status == 'CLOSED' %}
                                            <span class="badge bg-secondary">Fermé</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div>{{ reclamation.submittedAt|date('d/m/Y') }}</div>
                                        <small class="text-muted">{{ reclamation.submittedAt|date('H:i') }}</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-azure">
                                            {{ reclamation.responses|length }}
                                        </span>
                                    </td>
                                    <td class="table-actions">
                                        <a href="{{ path('front_reclamation_show', {'id': reclamation.id}) }}"
                                           class="btn btn-sm btn-info"
                                           title="Voir">
                                            <i class="ti ti-eye"></i>
                                        </a>

                                        {% if reclamation.status == 'PENDING' %}
                                            <a href="{{ path('front_reclamation_edit', {'id': reclamation.id}) }}"
                                               class="btn btn-sm btn-warning"
                                               title="Modifier">
                                                <i class="ti ti-edit"></i>
                                            </a>

                                            <form method="post"
                                                  action="{{ path('front_reclamation_delete', {'id': reclamation.id}) }}"
                                                  class="d-inline">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reclamation.id) }}">
                                                <button type="submit" class="btn btn-sm btn-danger"
                                                        onclick="return confirm('Êtes-vous sûr ?')"
                                                        title="Supprimer">
                                                    <i class="ti ti-trash"></i>
                                                </button>
                                            </form>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    {% if pages > 1 %}
                    <div class="d-flex justify-content-center mt-3">
                        <ul class="pagination">
                            <li class="page-item {% if page <= 1 %}disabled{% endif %}">
                                <a class="page-link" href="{{ path('front_reclamation_index', app.request.query.all|merge({'page': page - 1})) }}">
                                    <i class="ti ti-chevron-left"></i>
                                </a>
                            </li>
                            
                            {% for p in 1..pages %}
                                <li class="page-item {% if p == page %}active{% endif %}">
                                    <a class="page-link" href="{{ path('front_reclamation_index', app.request.query.all|merge({'page': p})) }}">{{ p }}</a>
                                </li>
                            {% endfor %}
                            
                            <li class="page-item {% if page >= pages %}disabled{% endif %}">
                                <a class="page-link" href="{{ path('front_reclamation_index', app.request.query.all|merge({'page': page + 1})) }}">
                                    <i class="ti ti-chevron-right"></i>
                                </a>
                            </li>
                        </ul>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <!-- Statistiques -->
    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card card-sm bg-primary-lt">
                <div class="card-body text-center">
                    <div class="text-primary h2 mb-1">{{ reclamations|length }}</div>
                    <div class="text-muted">Total</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-sm bg-yellow-lt">
                <div class="card-body text-center">
                    <div class="text-yellow h2 mb-1">
                        {% set pending = reclamations|filter(r => r.status == 'PENDING')|length %}
                        {{ pending }}
                    </div>
                    <div class="text-muted">En attente</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-sm bg-blue-lt">
                <div class="card-body text-center">
                    <div class="text-blue h2 mb-1">
                        {% set progress = reclamations|filter(r => r.status == 'IN_PROGRESS')|length %}
                        {{ progress }}
                    </div>
                    <div class="text-muted">En cours</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card card-sm bg-green-lt">
                <div class="card-body text-center">
                    <div class="text-green h2 mb-1">
                        {% set resolved = reclamations|filter(r => r.status == 'RESOLVED')|length %}
                        {{ resolved }}
                    </div>
                    <div class="text-muted">Résolues</div>
                </div>
            </div>
        </div>
    </div>
{% else %}
    <!-- État vide -->
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body text-center py-5">
                    <div style="font-size: 3rem; opacity: 0.3; margin-bottom: 1rem;">
                        <i class="ti ti-ticket-off"></i>
                    </div>
                    <h3>Aucune réclamation</h3>
                    <p class="text-muted mb-3">
                        {% if search or status %}
                            Aucun résultat pour votre recherche.
                        {% else %}
                            Vous n'avez pas encore créé de réclamation.
                        {% endif %}
                    </p>
                    <div class="btn-list justify-content-center">
                        {% if search or status %}
                        <a href="{{ path('front_reclamation_index') }}" class="btn btn-outline-primary">
                            <i class="ti ti-arrow-back"></i> Effacer les filtres
                        </a>
                        {% endif %}
                        <a href="{{ path('front_reclamation_new') }}" class="btn btn-primary">
                            <i class="ti ti-plus"></i> Créer ma première réclamation
                        </a>
                        <a href="{{ path('front_faq_index') }}" class="btn btn-outline-primary">
                            <i class="ti ti-help"></i> Consulter la FAQ
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endif %}
{% endblock %}
