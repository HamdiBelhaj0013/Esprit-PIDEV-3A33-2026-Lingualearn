{% extends 'layouts/user.html.twig' %}

{% block title %}Créer une réclamation - Support{% endblock %}

{% block page_title %}
    <i class="ti ti-ticket-plus me-2"></i> Créer une réclamation
{% endblock %}

{% block content %}
<div class="row">
    <div class="col-lg-8">
        <!-- Formulaire de réclamation -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Détails de votre réclamation</h3>
            </div>
            <div class="card-body">
                <p class="text-muted mb-4">
                    Décrivez votre problème en détail pour que notre équipe de support puisse vous aider rapidement.
                </p>

                {{ form_start(form, {'attr': {'class': 'form-horizontal'}}) }}

                    <div class="mb-3">
                        {{ form_row(form.subject) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.messageBody) }}
                        <small class="form-hint">Soyez aussi détaillé que possible pour nous aider à résoudre votre problème.</small>
                    </div>

                    <div class="form-footer">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-send"></i> Soumettre la réclamation
                        </button>
                        <a href="{{ path('front_reclamation_index') }}" class="btn btn-link">
                            Annuler
                        </a>
                    </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <!-- FAQ liées -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">
                    <i class="ti ti-bulb me-2"></i> Avez-vous consulté la FAQ ?
                </h3>
            </div>
            <div class="card-body">
                {% if related_faqs|length > 0 %}
                    <p class="text-muted mb-3">
                        Voici des réponses qui pourraient vous aider :
                    </p>

                    <div class="list-group list-group-flush">
                        {% for faq in related_faqs %}
                        <div class="list-group-item">
                            <div class="row align-items-center">
                                <div class="col">
                                    <h5 class="mb-1">{{ faq.question }}</h5>
                                    <p class="text-muted text-sm mb-0">
                                        {{ faq.answer|slice(0, 100)|raw }}...
                                    </p>
                                </div>
                            </div>
                        </div>
                        {% endfor %}
                    </div>

                    <div class="mt-3">
                        <a href="{{ path('front_faq_index', {'subject': selected_subject}) }}"
                           class="btn btn-sm btn-outline-primary w-100">
                            <i class="ti ti-help"></i> Voir la FAQ complète
                        </a>
                    </div>
                {% else %}
                    <p class="text-muted">
                        Consultez nos <strong>Foire Aux Questions (FAQ)</strong> pour trouver rapidement une réponse à votre question.
                    </p>
                    <a href="{{ path('front_faq_index') }}" class="btn btn-sm btn-outline-primary w-100">
                        <i class="ti ti-help"></i> Consulter la FAQ
                    </a>
                {% endif %}
            </div>
        </div>

        <!-- Conseils -->
        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Conseils</h3>
            </div>
            <div class="card-body small">
                <ul class="list-unstyled">
                    <li class="mb-2">
                        <i class="ti ti-check text-success"></i>
                        <strong>Soyez précis :</strong> Une description claire accélère la résolution
                    </li>
                    <li class="mb-2">
                        <i class="ti ti-check text-success"></i>
                        <strong>Incluez les détails :</strong> Numéro de transaction, compte, etc.
                    </li>
                    <li class="mb-2">
                        <i class="ti ti-check text-success"></i>
                        <strong>Attachez les preuves :</strong> Screenshots, messages d'erreur
                    </li>
                    <li>
                        <i class="ti ti-check text-success"></i>
                        <strong>Consultez la FAQ :</strong> Vous trouverez peut-être une réponse rapide
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
{% endblock %}

