{% extends 'base.html.twig' %}

{% block title %}Réclamation #{{ reclamation.id }} - Support{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        .message-bubble {
            border-radius: 10px;
            padding: 1rem;
            margin-bottom: 1rem;
            max-width: 80%;
        }
        .user-message {
            background-color: #e3f2fd;
            margin-left: auto;
        }
        .admin-message {
            background-color: #f5f5f5;
            margin-right: auto;
        }
        .message-header {
            font-weight: bold;
            margin-bottom: 0.5rem;
            font-size: 0.9rem;
        }
        .message-time {
            font-size: 0.8rem;
            color: #6c757d;
            text-align: right;
        }
        .status-badge {
            font-size: 0.75rem;
            padding: 0.25rem 0.75rem;
        }
    </style>
{% endblock %}

{% block body %}
<div class="container-xl">
    <!-- En-tête -->
    <div class="page-header">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title">
                    <i class="ti ti-ticket me-2"></i> Réclamation #{{ reclamation.id }}
                </h2>
                <div class="text-muted">
                    Créée le {{ reclamation.submittedAt|date('d/m/Y à H:i') }}
                </div>
            </div>
            <div class="col-auto">
                <span class="status-badge badge 
                    {% if reclamation.status == 'PENDING' %}bg-yellow
                    {% elseif reclamation.status == 'IN_PROGRESS' %}bg-blue
                    {% elseif reclamation.status == 'RESOLVED' %}bg-green
                    {% else %}bg-secondary{% endif %}">
                    {{ reclamation.status }}
                </span>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Colonne principale -->
        <div class="col-lg-8">
            <!-- Détails de la réclamation -->
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Détails de la réclamation</h3>
                </div>
                <div class="card-body">
                    <div class="mb-4">
                        <h5 class="mb-2">Sujet</h5>
                        <div class="card card-sm bg-primary-lt">
                            <div class="card-body">
                                {{ reclamation.subject }}
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <h5 class="mb-2">Description</h5>
                        <div class="card card-sm">
                            <div class="card-body">
                                {{ reclamation.messageBody|nl2br }}
                            </div>
                        </div>
                    </div>
                </div>
                {% if can_modify %}
                <div class="card-footer">
                    <div class="btn-list">
                        <a href="{{ path('front_reclamation_edit', {'id': reclamation.id}) }}" 
                           class="btn btn-warning">
                            <i class="ti ti-edit"></i> Modifier
                        </a>
                        <form method="post" 
                              action="{{ path('front_reclamation_delete', {'id': reclamation.id}) }}" 
                              class="d-inline"
                              onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette réclamation ?');">
                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reclamation.id) }}">
                            <button type="submit" class="btn btn-danger">
                                <i class="ti ti-trash"></i> Supprimer
                            </button>
                        </form>
                    </div>
                </div>
                {% endif %}
            </div>

            <!-- Conversation (Messages) -->
            <div class="card mt-4">
                <div class="card-header">
                    <h3 class="card-title">Conversation</h3>
                </div>
                <div class="card-body">
                    <!-- Message original (utilisateur) -->
                    <div class="message-bubble user-message">
                        <div class="message-header">
                            <i class="ti ti-user me-1"></i> Vous
                        </div>
                        <div class="message-content">
                            {{ reclamation.messageBody|nl2br }}
                        </div>
                        <div class="message-time">
                            {{ reclamation.submittedAt|date('d/m/Y H:i') }}
                        </div>
                    </div>

                    <!-- Réponses du support -->
                    {% for response in reclamation.responses %}
                    <div class="message-bubble admin-message">
                        <div class="message-header">
                            <i class="ti ti-headset me-1"></i> Support
                            {% if response.author %}
                                <small class="text-muted ms-2">
                                    ({{ response.author.firstName }} {{ response.author.lastName }})
                                </small>
                            {% else %}
                                <small class="text-muted ms-2">(Anonyme)</small>
                            {% endif %}
                        </div>
                        <div class="message-content">
                            {{ response.message|nl2br }}
                        </div>
                        <div class="message-time">
                            {{ response.respondedAt|date('d/m/Y H:i') }}
                        </div>
                    </div>
                    {% endfor %}

                    {% if reclamation.responses|length == 0 %}
                    <div class="empty">
                        <div class="empty-icon">
                            <i class="ti ti-messages" style="font-size: 3rem; opacity: 0.3;"></i>
                        </div>
                        <p class="empty-title">Aucune réponse pour le moment</p>
                        <p class="empty-subtitle text-muted">
                            Notre équipe de support traitera votre demande dans les plus brefs délais.
                        </p>
                    </div>
                    {% endif %}
                </div>
            </div>

            <!-- Formulaire de réponse (autorisé sans authentification) -->
            <div class="card mt-4">
                <div class="card-header">
                    <h3 class="card-title">Répondre</h3>
                </div>
                <div class="card-body">
                    {{ form_start(response_form, {'action': path('front_reclamation_reply', {'id': reclamation.id})}) }}
                    <div class="mb-3">
                        {{ form_row(response_form.message) }}
                    </div>
                    <div class="mb-3">
                        {{ form_row(response_form.status) }}
                    </div>
                    <div>
                        <button type="submit" class="btn btn-primary">Envoyer la réponse</button>
                    </div>
                    {{ form_end(response_form) }}
                </div>
            </div>
        </div>

        <!-- Colonne latérale (informations) -->
        <div class="col-lg-4">
            <!-- Informations -->
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Informations</h3>
                </div>
                <div class="list-group list-group-flush">
                    <div class="list-group-item">
                        <div class="row align-items-center">
                            <div class="col text-muted">ID</div>
                            <div class="col-auto">
                                <strong>#{{ reclamation.id }}</strong>
                            </div>
                        </div>
                    </div>
                    <div class="list-group-item">
                        <div class="row align-items-center">
                            <div class="col text-muted">Statut</div>
                            <div class="col-auto">
                                <span class="badge 
                                    {% if reclamation.status == 'PENDING' %}bg-yellow
                                    {% elseif reclamation.status == 'IN_PROGRESS' %}bg-blue
                                    {% elseif reclamation.status == 'RESOLVED' %}bg-green
                                    {% else %}bg-secondary{% endif %}">
                                    {{ reclamation.status }}
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="list-group-item">
                        <div class="row align-items-center">
                            <div class="col text-muted">Créée le</div>
                            <div class="col-auto">
                                {{ reclamation.submittedAt|date('d/m/Y') }}
                                <small class="text-muted d-block">
                                    {{ reclamation.submittedAt|date('H:i') }}
                                </small>
                            </div>
                        </div>
                    </div>
                    <div class="list-group-item">
                        <div class="row align-items-center">
                            <div class="col text-muted">Dernière mise à jour</div>
                            <div class="col-auto">
                                {% if reclamation.updatedAt %}
                                    {{ reclamation.updatedAt|date('d/m/Y H:i') }}
                                {% else %}
                                    <span class="text-muted">-</span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                    <div class="list-group-item">
                        <div class="row align-items-center">
                            <div class="col text-muted">Réponses</div>
                            <div class="col-auto">
                                <span class="badge bg-azure">
                                    {{ reclamation.responses|length }}
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actions rapides -->
            <div class="card mt-4">
                <div class="card-header">
                    <h3 class="card-title">Actions</h3>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a href="{{ path('front_reclamation_index') }}" class="btn btn-outline-primary">
                            <i class="ti ti-arrow-back"></i> Retour à la liste
                        </a>
                        
                        {% if can_modify %}
                        <a href="{{ path('front_reclamation_edit', {'id': reclamation.id}) }}" 
                           class="btn btn-warning">
                            <i class="ti ti-edit"></i> Modifier
                        </a>
                        {% endif %}
                        
                        <a href="{{ path('front_faq_index', {'subject': reclamation.subject}) }}" 
                           class="btn btn-info">
                            <i class="ti ti-help"></i> FAQ sur ce sujet
                        </a>
                    </div>
                </div>
            </div>

            <!-- Aide -->
            <div class="card mt-4">
                <div class="card-body">
                    <h4 class="card-title">Besoin d'aide supplémentaire ?</h4>
                    <p class="text-muted">
                        Si votre problème persiste, n'hésitez pas à nous contacter directement.
                    </p>
                    <a href="{{ path('front_reclamation_new') }}" class="btn btn-primary w-100">
                        <i class="ti ti-ticket"></i> Créer une nouvelle réclamation
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Confirmation avant suppression
    const deleteForm = document.querySelector('form[onsubmit]');
    if (deleteForm) {
        deleteForm.addEventListener('submit', function(e) {
            if (!confirm('Êtes-vous sûr de vouloir supprimer cette réclamation ?')) {
                e.preventDefault();
            }
        });
    }
});
</script>
{% endblock %}