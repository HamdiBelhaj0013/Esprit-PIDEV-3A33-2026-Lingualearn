{% extends 'base.html.twig' %}
{% block title %}Ticket #{{ reclamation.id }}{% endblock %}
{% block body %}

    <aside class="sidebar" id="sidebar">
        <a href="{{ path('app_homepage') }}" class="sidebar-logo">
            <div class="sidebar-logo-text">Lingua<span>Learn</span></div>
        </a>
        <div class="sidebar-user">
            <div class="user-avatar">{{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}</div>
            <div class="user-info">
                <div class="user-name">{{ app.user.fullName }}</div>
                <div class="user-plan free">Free Plan</div>
            </div>
        </div>
        <nav class="sidebar-nav">
            <span class="nav-section-label">Main</span>
            <a href="{{ path('user_dashboard') }}" class="nav-item"><span class="nav-icon">⊞</span> Dashboard</a>
            <a href="#" class="nav-item"><span class="nav-icon">📚</span> My Courses</a>
            <a href="#" class="nav-item"><span class="nav-icon">🧩</span> Practice</a>
            <a href="#" class="nav-item"><span class="nav-icon">📝</span> Mock Tests</a>
            <span class="nav-section-label">Account</span>
            <a href="{{ path('user_profile') }}" class="nav-item"><span class="nav-icon">👤</span> My Profile</a>
            <a href="#" class="nav-item"><span class="nav-icon">🔔</span> Notifications</a>
            <a href="#" class="nav-item"><span class="nav-icon">👑</span> Subscription</a>
            <span class="nav-section-label">Support</span>
            <a href="#" class="nav-item"><span class="nav-icon">❓</span> FAQ</a>
            <a href="{{ path('app_user_reclamation_index') }}" class="nav-item active"><span class="nav-icon">💬</span> Mes réclamations</a>
            <span class="nav-section-label">System</span>
            <a href="{{ path('app_logout') }}" class="nav-item"><span class="nav-icon">→</span> Log Out</a>
        </nav>
    </aside>
    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    {# ── Stocker les textes en data-attributes (évite les bugs d'apostrophes en JS) ── #}
    <div id="responseData" style="display:none">
        {% for response in reclamation.responses %}
            <span data-index="{{ loop.index }}" data-text="{{ response.message|e('html_attr') }}"></span>
        {% endfor %}
    </div>

    <div class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="hamburger-btn" id="hamburgerBtn"><span></span><span></span><span></span></button>
                <div>
                    <a href="{{ path('app_user_reclamation_index') }}" class="back-link">← Mes réclamations</a>
                    <div class="page-heading">Ticket #{{ reclamation.id }}</div>
                    <div class="page-sub">{{ reclamation.subject|capitalize }}</div>
                </div>
            </div>
            <div class="topbar-right">
            <span class="ticket-status status-{{ reclamation.status|lower }}">
                {% if reclamation.status == 'PENDING' %}⏳ En attente
                {% elseif reclamation.status == 'IN_PROGRESS' %}🔄 En cours
                {% elseif reclamation.status == 'RESOLVED' %}✅ Résolu
                {% else %}🔒 Fermé{% endif %}
            </span>
                <a href="{{ path('user_profile') }}" class="topbar-btn">👤</a>
            </div>
        </header>

        <main class="page-content">

            {# ── TICKET INFO ── #}
            <div class="ticket-detail-card reveal">
                <div class="ticket-meta-row">
                    <span>📅 {{ reclamation.submittedAt|date('d/m/Y à H:i') }}</span>
                    {% if reclamation.priority == 'URGENT' %}<span class="badge badge-urgent">🔴 URGENT</span>
                    {% elseif reclamation.priority == 'HIGH' %}<span class="badge badge-high">🟠 HIGH</span>
                    {% elseif reclamation.priority == 'LOW' %}<span class="badge badge-low">🟢 LOW</span>
                    {% endif %}
                    {% if reclamation.isLate() %}<span class="badge badge-late">🚨 SLA dépassé</span>{% endif %}
                </div>
                <div class="ticket-body-text">{{ reclamation.messageBody }}</div>
            </div>

            {# ── RÉPONSES ── #}
            {% if reclamation.responses|length > 0 %}
                <div class="section-title reveal">💬 Réponses de l'équipe support</div>

                {% for response in reclamation.responses %}
                    <div class="response-card reveal" data-response-id="{{ loop.index }}">
                        <div class="response-header">
                            <div class="response-author">
                                <div class="author-avatar">👤</div>
                                <div>
                                    <div class="author-name">Équipe Support LinguaLearn</div>
                                    <div class="author-time">{{ response.respondedAt|date('d/m/Y à H:i') }}</div>
                                </div>
                            </div>
                            {# ── BOUTON TRADUCTION ── #}
                            <div class="translate-controls">
                                <select class="lang-select" id="lang-{{ loop.index }}">
                                    <option value="en">🇬🇧 Anglais</option>
                                    <option value="ar">🇸🇦 Arabe</option>
                                    <option value="fr">🇫🇷 Français</option>
                                    <option value="es">🇪🇸 Espagnol</option>
                                    <option value="de">🇩🇪 Allemand</option>
                                </select>
                                {# Plus de texte passé en onclick — le JS lit depuis responseTexts #}
                                <button type="button"
                                        class="btn-translate"
                                        onclick="translateResponse({{ loop.index }})"
                                        id="btnTranslate-{{ loop.index }}">
                                    🌐 Traduire
                                </button>
                            </div>
                        </div>

                        {# Texte original #}
                        <div class="response-text" id="responseText-{{ loop.index }}">{{ response.message }}</div>

                        {# Texte traduit (caché par défaut) #}
                        <div class="translated-block" id="translatedBlock-{{ loop.index }}" style="display:none">
                            <div class="translated-label">🤖 Traduit par Gemini AI :</div>
                            <div class="translated-text" id="translatedText-{{ loop.index }}"></div>
                            <button type="button" class="btn-show-original" onclick="showOriginal({{ loop.index }})">
                                ↩ Voir l'original
                            </button>
                        </div>

                        {# Bloc erreur #}
                        <div class="error-block" id="errorBlock-{{ loop.index }}" style="display:none">
                            ❌ <span id="errorMsg-{{ loop.index }}"></span>
                        </div>
                    </div>
                {% endfor %}

            {% else %}
                <div class="empty-responses reveal">
                    <div style="font-size:2rem;margin-bottom:.5rem">⏳</div>
                    <p>Aucune réponse pour le moment.</p>
                    <p style="font-size:.8rem;color:var(--muted);margin-top:.25rem">Notre équipe vous répondra sous 24h.</p>
                </div>
            {% endif %}

            {# ── ÉVALUATION ── #}
            {% if reclamation.status == 'RESOLVED' %}
                <div class="eval-card reveal">
                    {% if reclamation.canBeRated() %}
                        <a href="{{ path('app_reclamation_rate', {id: reclamation.id}) }}" class="btn-rate">
                            ⭐ Évaluer ce ticket
                        </a>
                    {% elseif reclamation.hasBeenRated() %}
                        <span class="rated-badge">⭐ Vous avez noté {{ reclamation.satisfactionScore }}/5 — Merci !</span>
                    {% endif %}
                </div>
            {% endif %}

        </main>
    </div>

    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        :root { --white:#fff; --off-white:#f7f9fc; --ink:#0d1526; --ink-soft:#2c3a52; --muted:#7a87a0; --border:#e2e8f2; --blue:#2563eb; --blue-dark:#1d4ed8; --blue-bg:#eff6ff; --blue-mid:#3b82f6; --green:#16a34a; --green-bg:#f0fdf4; --gold:#ca8a04; --purple:#7c3aed; --purple-bg:#f5f3ff; --sidebar-w:260px; --radius:12px; --radius-lg:20px; }
        body { font-family:'Sora',sans-serif; background:var(--off-white); color:var(--ink); min-height:100vh; }
        .sidebar { position:fixed; top:0; left:0; bottom:0; width:var(--sidebar-w); background:var(--white); border-right:1px solid var(--border); display:flex; flex-direction:column; z-index:50; }
        .sidebar-logo { padding:1.5rem 1.5rem 1.25rem; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:.75rem; text-decoration:none; }
        .sidebar-logo-text { font-size:1.3rem; font-weight:700; color:var(--ink); }
        .sidebar-logo-text span { color:var(--blue); }
        .sidebar-user { padding:1.25rem 1.5rem; border-bottom:1px solid var(--border); display:flex; align-items:center; gap:.85rem; }
        .user-avatar { width:40px; height:40px; border-radius:50%; background:linear-gradient(135deg,var(--blue),var(--blue-mid)); display:flex; align-items:center; justify-content:center; font-size:.9rem; font-weight:700; color:#fff; flex-shrink:0; }
        .user-info { flex:1; min-width:0; }
        .user-name { font-size:.85rem; font-weight:600; color:var(--ink); }
        .user-plan.free { font-size:.7rem; text-transform:uppercase; color:var(--muted); }
        .sidebar-nav { flex:1; padding:1rem 0; overflow-y:auto; }
        .nav-section-label { font-size:.6rem; letter-spacing:.2em; text-transform:uppercase; color:var(--muted); padding:.75rem 1.5rem .35rem; display:block; }
        .nav-item { display:flex; align-items:center; gap:.75rem; padding:.65rem 1.5rem; font-size:.84rem; font-weight:500; color:var(--muted); text-decoration:none; transition:color .2s,background .2s; position:relative; }
        .nav-item:hover { color:var(--ink); background:var(--off-white); }
        .nav-item.active { color:var(--blue); background:var(--blue-bg); font-weight:600; }
        .nav-item.active::before { content:''; position:absolute; left:0; top:4px; bottom:4px; width:3px; background:var(--blue); border-radius:0 3px 3px 0; }
        .nav-icon { font-size:1.1rem; width:20px; text-align:center; }
        .main { margin-left:var(--sidebar-w); min-height:100vh; display:flex; flex-direction:column; }
        .topbar { position:sticky; top:0; z-index:40; background:rgba(255,255,255,.92); backdrop-filter:blur(20px); border-bottom:1px solid var(--border); padding:.85rem 2rem; display:flex; align-items:center; justify-content:space-between; gap:1rem; }
        .topbar-left { display:flex; align-items:center; gap:1rem; }
        .back-link { font-size:.78rem; color:var(--blue); text-decoration:none; display:block; margin-bottom:.15rem; }
        .page-heading { font-size:1.25rem; font-weight:700; color:var(--ink); }
        .page-sub { font-size:.78rem; color:var(--muted); }
        .topbar-right { display:flex; align-items:center; gap:.75rem; }
        .topbar-btn { width:38px; height:38px; border-radius:var(--radius); border:1.5px solid var(--border); background:transparent; display:flex; align-items:center; justify-content:center; text-decoration:none; color:var(--ink); font-size:1.1rem; }
        .ticket-status { font-size:.72rem; font-weight:700; padding:.25rem .85rem; border-radius:999px; white-space:nowrap; }
        .status-pending { background:#fef3c7; color:#92400e; }
        .status-in_progress { background:var(--blue-bg); color:var(--blue); }
        .status-resolved { background:var(--green-bg); color:var(--green); }
        .status-closed { background:#f1f5f9; color:var(--muted); }
        .hamburger-btn { display:none; width:38px; height:38px; border-radius:var(--radius); border:1.5px solid var(--border); background:transparent; align-items:center; justify-content:center; cursor:pointer; flex-direction:column; gap:4px; }
        .hamburger-btn span { width:16px; height:1.5px; background:var(--ink); display:block; border-radius:2px; }
        .page-content { padding:2rem; flex:1; max-width:800px; }
        .ticket-detail-card { background:var(--white); border:1.5px solid var(--border); border-radius:var(--radius-lg); padding:1.5rem; margin-bottom:1.5rem; }
        .ticket-meta-row { display:flex; gap:.75rem; flex-wrap:wrap; align-items:center; margin-bottom:1rem; font-size:.8rem; color:var(--muted); }
        .badge { font-size:.65rem; font-weight:700; padding:.18rem .6rem; border-radius:999px; }
        .badge-urgent { background:#fee2e2; color:#dc2626; }
        .badge-high { background:#fff7ed; color:#ea580c; }
        .badge-low { background:var(--green-bg); color:var(--green); }
        .badge-late { background:#fee2e2; color:#dc2626; }
        .ticket-body-text { font-size:.9rem; color:var(--ink-soft); line-height:1.7; white-space:pre-wrap; }
        .section-title { font-size:.82rem; font-weight:700; text-transform:uppercase; letter-spacing:.1em; color:var(--muted); margin-bottom:.75rem; }
        .response-card { background:var(--white); border:1.5px solid var(--border); border-radius:var(--radius-lg); padding:1.25rem 1.5rem; margin-bottom:.85rem; }
        .response-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem; flex-wrap:wrap; gap:.75rem; }
        .response-author { display:flex; align-items:center; gap:.75rem; }
        .author-avatar { width:36px; height:36px; border-radius:50%; background:linear-gradient(135deg,var(--blue),var(--blue-mid)); display:flex; align-items:center; justify-content:center; font-size:1rem; }
        .author-name { font-size:.85rem; font-weight:700; color:var(--ink); }
        .author-time { font-size:.72rem; color:var(--muted); }
        .response-text { font-size:.9rem; color:var(--ink-soft); line-height:1.7; }
        .translate-controls { display:flex; align-items:center; gap:.5rem; }
        .lang-select { padding:.35rem .65rem; border:1.5px solid var(--border); border-radius:8px; font-size:.75rem; color:var(--ink); background:var(--off-white); font-family:inherit; outline:none; cursor:pointer; }
        .lang-select:focus { border-color:var(--purple); }
        .btn-translate { display:inline-flex; align-items:center; gap:.3rem; padding:.35rem .85rem; background:linear-gradient(135deg,var(--purple),#6d28d9); color:#fff; border:none; border-radius:8px; font-size:.75rem; font-weight:700; cursor:pointer; font-family:inherit; transition:opacity .2s; box-shadow:0 2px 6px rgba(124,58,237,.3); }
        .btn-translate:hover:not(:disabled) { opacity:.9; }
        .btn-translate:disabled { opacity:.6; cursor:not-allowed; }
        .translated-block { margin-top:1rem; padding:.85rem 1rem; background:var(--purple-bg); border:1.5px solid #ddd6fe; border-radius:var(--radius); animation:slideDown .25s ease; }
        @keyframes slideDown { from{opacity:0;transform:translateY(-6px)} to{opacity:1;transform:translateY(0)} }
        .translated-label { font-size:.72rem; font-weight:700; color:var(--purple); margin-bottom:.5rem; }
        .translated-text { font-size:.9rem; color:var(--ink-soft); line-height:1.7; white-space:pre-wrap; }
        .btn-show-original { margin-top:.75rem; padding:.3rem .75rem; background:transparent; color:var(--purple); border:1.5px solid #ddd6fe; border-radius:6px; font-size:.75rem; font-weight:600; cursor:pointer; font-family:inherit; transition:background .15s; }
        .btn-show-original:hover { background:#ede9fe; }
        .error-block { margin-top:.75rem; padding:.5rem .85rem; background:#fee2e2; border:1.5px solid #fca5a5; border-radius:8px; font-size:.8rem; color:#dc2626; }
        .empty-responses { text-align:center; padding:2.5rem 1rem; background:var(--white); border:1.5px solid var(--border); border-radius:var(--radius-lg); color:var(--muted); margin-bottom:1rem; }
        .eval-card { padding:1.25rem; background:var(--white); border:1.5px solid var(--border); border-radius:var(--radius-lg); display:flex; justify-content:center; }
        .btn-rate { display:inline-flex; align-items:center; gap:.4rem; padding:.55rem 1.25rem; border-radius:8px; font-size:.85rem; font-weight:700; background:#fefce8; color:#ca8a04; border:1.5px solid #fde68a; text-decoration:none; transition:background .15s; }
        .btn-rate:hover { background:#fef08a; }
        .rated-badge { display:inline-flex; align-items:center; gap:.4rem; font-size:.85rem; font-weight:600; color:#ca8a04; }
        .reveal { opacity:0; transform:translateY(16px); transition:opacity .5s ease,transform .5s ease; }
        .reveal.visible { opacity:1; transform:translateY(0); }
        @media(max-width:768px) { :root{--sidebar-w:0px} .sidebar{transform:translateX(-260px);width:260px} .sidebar.open{transform:translateX(0)} .main{margin-left:0} .hamburger-btn{display:flex} .page-content{padding:1.25rem} .response-header{flex-direction:column;align-items:flex-start} }
        .sidebar-overlay { display:none; position:fixed; inset:0; background:rgba(13,21,38,.4); z-index:45; }
        .sidebar-overlay.visible { display:block; }
    </style>

    <script>
        // Sidebar
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const hamburger = document.getElementById('hamburgerBtn');
        if(hamburger) hamburger.addEventListener('click', () => { sidebar.classList.toggle('open'); overlay.classList.toggle('visible'); });
        if(overlay) overlay.addEventListener('click', () => { sidebar.classList.remove('open'); overlay.classList.remove('visible'); });
        const ro = new IntersectionObserver(entries => { entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('visible'); ro.unobserve(e.target); } }); }, {threshold:.06});
        document.querySelectorAll('.reveal').forEach(el => ro.observe(el));

        // =========================================================
        // Lire les textes depuis data-attributes (sûr contre apostrophes/guillemets)
        // =========================================================
        const responseTexts = {};
        document.querySelectorAll('#responseData span[data-index]').forEach(el => {
            responseTexts[el.dataset.index] = el.dataset.text;
        });

        const TRANSLATE_URL = '{{ path("app_gemini_translate") }}';

        // =========================================================
        // TRADUCTION IA — Gemini
        // =========================================================
        async function translateResponse(index) {
            const btn        = document.getElementById(`btnTranslate-${index}`);
            const langSelect = document.getElementById(`lang-${index}`);
            const block      = document.getElementById(`translatedBlock-${index}`);
            const output     = document.getElementById(`translatedText-${index}`);
            const errorBlock = document.getElementById(`errorBlock-${index}`);
            const errorMsg   = document.getElementById(`errorMsg-${index}`);
            const target     = langSelect.value;

            // Texte récupéré depuis responseTexts, pas depuis onclick
            const text = responseTexts[String(index)];
            if (!text) {
                console.error('Texte introuvable pour index', index);
                return;
            }

            // Reset erreur précédente
            errorBlock.style.display = 'none';

            btn.disabled = true;
            btn.textContent = '⏳ Traduction...';

            try {
                const res = await fetch(TRANSLATE_URL, {
                    method:  'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body:    JSON.stringify({ text: text, target: target })
                });

                const data = await res.json();

                if (!res.ok) {
                    throw new Error(data.error || `Erreur HTTP ${res.status}`);
                }

                if (data.translated) {
                    output.textContent = data.translated;
                    block.style.display = 'block';
                } else if (data.error) {
                    throw new Error(data.error);
                } else {
                    throw new Error('Réponse inattendue de Gemini');
                }

            } catch(e) {
                errorMsg.textContent = e.message || 'Erreur de traduction';
                errorBlock.style.display = 'block';
                console.error('Erreur traduction:', e);
            } finally {
                btn.disabled = false;
                btn.textContent = '🌐 Retraduire';
            }
        }

        function showOriginal(index) {
            document.getElementById(`translatedBlock-${index}`).style.display = 'none';
            document.getElementById(`btnTranslate-${index}`).textContent = '🌐 Traduire';
        }
    </script>
{% endblock %}
