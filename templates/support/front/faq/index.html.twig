{% extends 'base.html.twig' %}
{% block title %}FAQ — Centre d'aide{% endblock %}
{% block body %}

    <aside class="sidebar" id="sidebar">
        <a href="{{ path('app_homepage') }}" class="sidebar-logo">
            <div class="sidebar-logo-text">Lingua<span>Learn</span></div>
        </a>
        <div class="sidebar-user">
            <div class="user-avatar">{{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}</div>
            <div class="user-info">
                <div class="user-name">{{ app.user.fullName }}</div>
                <div class="user-plan free">Free Plan</div>
            </div>
        </div>
        <nav class="sidebar-nav">
            <span class="nav-section-label">Main</span>
            <a href="{{ path('user_dashboard') }}" class="nav-item"><span class="nav-icon">⊞</span> Dashboard</a>
            <a href="#" class="nav-item"><span class="nav-icon">📚</span> My Courses</a>
            <a href="#" class="nav-item"><span class="nav-icon">🧩</span> Practice</a>
            <a href="#" class="nav-item"><span class="nav-icon">📝</span> Mock Tests</a>
            <span class="nav-section-label">Account</span>
            <a href="{{ path('user_profile') }}" class="nav-item"><span class="nav-icon">👤</span> My Profile</a>
            <a href="#" class="nav-item"><span class="nav-icon">🔔</span> Notifications</a>
            <a href="#" class="nav-item"><span class="nav-icon">👑</span> Subscription</a>
            <span class="nav-section-label">Support</span>
            <a href="{{ path('app_user_faq_index') }}" class="nav-item active"><span class="nav-icon">❓</span> FAQ</a>
            <a href="{{ path('app_user_reclamation_index') }}" class="nav-item"><span class="nav-icon">💬</span> Mes réclamations</a>
            <span class="nav-section-label">System</span>
            <a href="{{ path('app_logout') }}" class="nav-item"><span class="nav-icon">→</span> Log Out</a>
        </nav>
    </aside>

    <div class="sidebar-overlay" id="sidebarOverlay"></div>

    <div class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="hamburger-btn" id="hamburgerBtn"><span></span><span></span><span></span></button>
                <div>
                    <div class="page-heading">Centre d'aide 🆘</div>
                    <div class="page-sub">Trouvez rapidement une réponse à vos questions</div>
                </div>
            </div>
            <div class="topbar-right">
                <a href="{{ path('app_user_reclamation_new') }}" class="btn-new-reclamation">+ Nouvelle réclamation</a>
                <a href="{{ path('user_profile') }}" class="topbar-btn">👤</a>
            </div>
        </header>

        <main class="page-content">

            {# Tabs #}
            <div class="support-tabs reveal">
                <a href="{{ path('app_user_faq_index') }}" class="stab active">❓ FAQ</a>
                <a href="{{ path('app_user_reclamation_index') }}" class="stab">💬 Mes réclamations</a>
            </div>

            {# Search #}
            <div class="search-card reveal">
                <form method="get" action="{{ path('app_user_faq_index') }}">
                    <div class="search-row">
                        <input type="text" name="search" value="{{ search ?? '' }}" placeholder="Rechercher une question..." class="search-input">
                        <button type="submit" class="btn-search">Rechercher</button>
                    </div>
                    <div class="filter-chips">
                        <a href="{{ path('app_user_faq_index', {search: search}) }}" class="chip {{ not selected_subject ? 'chip-active' : '' }}">Tous</a>
                        {% for subject in subjects %}
                            <a href="{{ path('app_user_faq_index', {subject: subject, search: search}) }}"
                               class="chip {{ selected_subject == subject ? 'chip-active' : '' }}">{{ subject|capitalize }}</a>
                        {% endfor %}
                    </div>
                </form>
            </div>

            {# FAQ List #}
            {% if faqs is empty %}
                <div class="empty-card reveal">
                    <div style="font-size:2.5rem;margin-bottom:.75rem;">🔍</div>
                    <p style="font-weight:700;margin-bottom:.5rem;">Aucune FAQ trouvée</p>
                    <p style="color:var(--muted);font-size:.875rem;">Essayez d'autres mots-clés ou <a href="{{ path('app_user_reclamation_new') }}" style="color:var(--blue);">soumettez une réclamation</a>.</p>
                </div>
            {% else %}
                <div class="faq-list reveal">
                    {% for faq in faqs %}
                        <div class="faq-item" id="faq-{{ loop.index }}">
                            <button class="faq-question" onclick="toggleFAQ({{ loop.index }})">
                                <span class="faq-badge subject-{{ faq.subject ?? 'other' }}">{{ faq.subject ?? 'autre' }}</span>
                                <span class="faq-q-text">{{ faq.question }}</span>
                                <span class="faq-arrow">▼</span>
                            </button>
                            <div class="faq-answer" id="answer-{{ loop.index }}">
                                <p>{{ faq.answer }}</p>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}

            {# CTA #}
            <div class="cta-card reveal">
                <div style="font-size:2rem;">💬</div>
                <div class="cta-text">
                    <strong>Vous n'avez pas trouvé votre réponse ?</strong>
                    <span>Notre équipe est là pour vous aider.</span>
                </div>
                <a href="{{ path('app_user_reclamation_new') }}" class="btn-cta">Contacter le support</a>
            </div>

        </main>
    </div>

    <style>
        *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }
        :root {
            --white: #ffffff; --off-white: #f7f9fc; --surface: #eef1f8;
            --ink: #0d1526; --ink-soft: #2c3a52; --muted: #7a87a0; --border: #e2e8f2;
            --blue: #2563eb; --blue-dark: #1d4ed8; --blue-bg: #eff6ff; --blue-mid: #3b82f6;
            --green: #16a34a; --green-bg: #f0fdf4;
            --gold: #ca8a04; --gold-bg: #fefce8;
            --sidebar-w: 260px; --radius: 12px; --radius-lg: 20px;
        }
        body { font-family: 'Sora', sans-serif; background: var(--off-white); color: var(--ink); min-height: 100vh; }
        .sidebar { position: fixed; top: 0; left: 0; bottom: 0; width: var(--sidebar-w); background: var(--white); border-right: 1px solid var(--border); display: flex; flex-direction: column; z-index: 50; transition: transform .3s ease; }
        .sidebar-logo { padding: 1.5rem 1.5rem 1.25rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: .75rem; text-decoration: none; }
        .sidebar-logo-text { font-size: 1.3rem; font-weight: 700; color: var(--ink); }
        .sidebar-logo-text span { color: var(--blue); }
        .sidebar-user { padding: 1.25rem 1.5rem; border-bottom: 1px solid var(--border); display: flex; align-items: center; gap: .85rem; }
        .user-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--blue), var(--blue-mid)); display: flex; align-items: center; justify-content: center; font-size: .9rem; font-weight: 700; color: var(--white); flex-shrink: 0; }
        .user-info { flex: 1; min-width: 0; }
        .user-name { font-size: .85rem; font-weight: 600; color: var(--ink); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .user-plan { font-size: .7rem; letter-spacing: .08em; text-transform: uppercase; margin-top: .1rem; }
        .user-plan.free { color: var(--muted); }
        .sidebar-nav { flex: 1; padding: 1rem 0; overflow-y: auto; }
        .nav-section-label { font-size: .6rem; letter-spacing: .2em; text-transform: uppercase; color: var(--muted); padding: .75rem 1.5rem .35rem; display: block; }
        .nav-item { display: flex; align-items: center; gap: .75rem; padding: .65rem 1.5rem; font-size: .84rem; font-weight: 500; color: var(--muted); text-decoration: none; transition: color .2s, background .2s; position: relative; }
        .nav-item:hover { color: var(--ink); background: var(--off-white); }
        .nav-item.active { color: var(--blue); background: var(--blue-bg); font-weight: 600; }
        .nav-item.active::before { content: ''; position: absolute; left: 0; top: 4px; bottom: 4px; width: 3px; background: var(--blue); border-radius: 0 3px 3px 0; }
        .nav-icon { font-size: 1.1rem; width: 20px; text-align: center; }
        .main { margin-left: var(--sidebar-w); min-height: 100vh; display: flex; flex-direction: column; }
        .topbar { position: sticky; top: 0; z-index: 40; background: rgba(255,255,255,.92); backdrop-filter: blur(20px); border-bottom: 1px solid var(--border); padding: .85rem 2rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
        .topbar-left { display: flex; align-items: center; gap: 1rem; }
        .page-heading { font-size: 1.25rem; font-weight: 700; color: var(--ink); }
        .page-sub { font-size: .78rem; color: var(--muted); margin-top: .1rem; }
        .topbar-right { display: flex; align-items: center; gap: .75rem; }
        .topbar-btn { width: 38px; height: 38px; border-radius: var(--radius); border: 1.5px solid var(--border); background: transparent; display: flex; align-items: center; justify-content: center; cursor: pointer; text-decoration: none; color: var(--ink-soft); font-size: 1.1rem; }
        .topbar-btn:hover { border-color: var(--blue); background: var(--blue-bg); color: var(--blue); }
        .btn-new-reclamation { display: inline-flex; align-items: center; background: var(--blue); color: #fff; padding: .5rem 1.1rem; border-radius: 8px; font-size: .8rem; font-weight: 600; text-decoration: none; transition: background .15s; }
        .btn-new-reclamation:hover { background: var(--blue-dark); color: #fff; }
        .hamburger-btn { display: none; width: 38px; height: 38px; border-radius: var(--radius); border: 1.5px solid var(--border); background: transparent; align-items: center; justify-content: center; cursor: pointer; flex-direction: column; gap: 4px; }
        .hamburger-btn span { width: 16px; height: 1.5px; background: var(--ink); display: block; border-radius: 2px; }
        .page-content { padding: 2rem; flex: 1; max-width: 860px; }

        /* Tabs */
        .support-tabs { display: flex; gap: .5rem; margin-bottom: 1.5rem; border-bottom: 2px solid var(--border); padding-bottom: .5rem; }
        .stab { display: inline-flex; align-items: center; gap: .4rem; padding: .5rem 1rem; color: var(--muted); text-decoration: none; font-size: .875rem; font-weight: 500; border-radius: 8px 8px 0 0; transition: all .15s; }
        .stab:hover { color: var(--blue); background: var(--blue-bg); }
        .stab.active { color: var(--blue); font-weight: 700; border-bottom: 2px solid var(--blue); margin-bottom: -2px; }

        /* Search */
        .search-card { background: var(--white); border: 1.5px solid var(--border); border-radius: var(--radius-lg); padding: 1.5rem; margin-bottom: 1.5rem; }
        .search-row { display: flex; gap: .75rem; margin-bottom: .75rem; }
        .search-input { flex: 1; padding: .65rem 1rem; border: 1.5px solid var(--border); border-radius: var(--radius); font-size: .9rem; color: var(--ink); background: var(--off-white); outline: none; font-family: inherit; transition: border-color .15s; }
        .search-input:focus { border-color: var(--blue); }
        .btn-search { background: var(--blue); color: #fff; border: none; border-radius: var(--radius); padding: .65rem 1.4rem; font-size: .875rem; font-weight: 600; cursor: pointer; font-family: inherit; transition: background .15s; }
        .btn-search:hover { background: var(--blue-dark); }
        .filter-chips { display: flex; flex-wrap: wrap; gap: .5rem; }
        .chip { padding: .3rem .85rem; border-radius: 999px; font-size: .8rem; font-weight: 500; color: var(--muted); background: var(--surface); border: 1.5px solid var(--border); text-decoration: none; transition: all .15s; }
        .chip:hover { color: var(--blue); border-color: var(--blue); }
        .chip-active { background: var(--blue-bg); color: var(--blue); border-color: var(--blue); font-weight: 600; }

        /* FAQ */
        .faq-list { display: flex; flex-direction: column; gap: .6rem; margin-bottom: 1.75rem; }
        .faq-item { background: var(--white); border: 1.5px solid var(--border); border-radius: var(--radius-lg); overflow: hidden; transition: box-shadow .2s; }
        .faq-item:hover { box-shadow: 0 4px 16px rgba(13,21,38,.07); }
        .faq-item.open { border-color: var(--blue); }
        .faq-question { width: 100%; display: flex; align-items: center; gap: .75rem; padding: 1.1rem 1.4rem; background: none; border: none; cursor: pointer; text-align: left; color: var(--ink); font-size: .9rem; font-weight: 600; font-family: inherit; }
        .faq-q-text { flex: 1; }
        .faq-arrow { flex-shrink: 0; color: var(--muted); transition: transform .2s; font-size: .75rem; }
        .faq-item.open .faq-arrow { transform: rotate(180deg); }
        .faq-answer { max-height: 0; overflow: hidden; transition: max-height .3s ease; }
        .faq-answer p { padding: 0 1.4rem 1.1rem; color: var(--muted); font-size: .875rem; line-height: 1.7; margin: 0; }
        .faq-item.open .faq-answer { max-height: 500px; }
        .faq-badge { font-size: .65rem; font-weight: 700; padding: .2rem .6rem; border-radius: 6px; flex-shrink: 0; text-transform: uppercase; letter-spacing: .06em; }
        .subject-payment   { background: #fef3c7; color: #92400e; }
        .subject-technical { background: var(--blue-bg); color: var(--blue); }
        .subject-content   { background: var(--green-bg); color: var(--green); }
        .subject-premium   { background: var(--gold-bg); color: var(--gold); }
        .subject-account   { background: #fce7f3; color: #9d174d; }
        .subject-other     { background: var(--surface); color: var(--muted); }

        /* CTA */
        .cta-card { display: flex; align-items: center; gap: 1rem; background: var(--blue-bg); border: 1.5px solid #c7d2fe; border-radius: var(--radius-lg); padding: 1.4rem 1.75rem; margin-top: 1.75rem; }
        .cta-text { flex: 1; display: flex; flex-direction: column; gap: .2rem; font-size: .875rem; color: var(--muted); }
        .cta-text strong { color: var(--ink); }
        .btn-cta { display: inline-flex; align-items: center; background: var(--blue); color: #fff; padding: .6rem 1.3rem; border-radius: var(--radius); font-size: .875rem; font-weight: 600; text-decoration: none; white-space: nowrap; transition: background .15s; }
        .btn-cta:hover { background: var(--blue-dark); color: #fff; }

        /* Empty */
        .empty-card { text-align: center; padding: 3rem 1rem; background: var(--white); border: 1.5px solid var(--border); border-radius: var(--radius-lg); margin-bottom: 1.75rem; }

        /* Reveal */
        .reveal { opacity: 0; transform: translateY(16px); transition: opacity .5s ease, transform .5s ease; }
        .reveal.visible { opacity: 1; transform: translateY(0); }

        @media (max-width: 768px) {
            :root { --sidebar-w: 0px; }
            .sidebar { transform: translateX(-260px); width: 260px; }
            .sidebar.open { transform: translateX(0); }
            .main { margin-left: 0; }
            .hamburger-btn { display: flex; }
            .page-content { padding: 1.25rem; }
            .topbar { padding: .75rem 1.25rem; }
        }
        .sidebar-overlay { display: none; position: fixed; inset: 0; background: rgba(13,21,38,.4); z-index: 45; }
        .sidebar-overlay.visible { display: block; }
    </style>

    <script>
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const hamburger = document.getElementById('hamburgerBtn');
        if(hamburger) { hamburger.addEventListener('click', () => { sidebar.classList.toggle('open'); overlay.classList.toggle('visible'); }); }
        if(overlay) { overlay.addEventListener('click', () => { sidebar.classList.remove('open'); overlay.classList.remove('visible'); }); }
        const ro = new IntersectionObserver(entries => { entries.forEach(e => { if(e.isIntersecting){ e.target.classList.add('visible'); ro.unobserve(e.target); } }); }, {threshold:.06});
        document.querySelectorAll('.reveal').forEach(el => ro.observe(el));
        function toggleFAQ(i) {
            const item = document.getElementById('faq-'+i);
            const isOpen = item.classList.contains('open');
            document.querySelectorAll('.faq-item').forEach(el => el.classList.remove('open'));
            if(!isOpen) item.classList.add('open');
        }
    </script>
{% endblock %}
