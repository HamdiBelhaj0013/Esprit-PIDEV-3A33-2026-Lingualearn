{% extends 'layouts/user.html.twig' %}

{% block title %}Foire Aux Questions - Support{% endblock %}

{% block page_title %}
    <i class="ti ti-help me-2"></i> Foire Aux Questions
{% endblock %}

{% block content %}
<div class="row">
    <div class="col-lg-3">
        <!-- Filtres -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Catégories</h3>
            </div>
            <div class="list-group list-group-flush">
                <a href="{{ path('front_faq_index', app.request.query.all|merge({'subject': null, 'page': 1})) }}"
                   class="list-group-item {% if not selected_subject %}active{% endif %}">
                    <i class="ti ti-list me-2"></i> Toutes les FAQs
                </a>

                {% for subject in subjects %}
                <a href="{{ path('front_faq_index', app.request.query.all|merge({'subject': subject, 'page': 1})) }}"
                   class="list-group-item {% if selected_subject == subject %}active{% endif %}">
                    <i class="ti ti-folder me-2"></i>
                    {% if subject == 'payment' %}
                        Paiement
                    {% elseif subject == 'technical' %}
                        Technique
                    {% elseif subject == 'content' %}
                        Contenu
                    {% elseif subject == 'premium' %}
                        Premium
                    {% elseif subject == 'account' %}
                        Compte
                    {% else %}
                        {{ subject }}
                    {% endif %}
                </a>
                {% endfor %}
            </div>
        </div>

        <!-- Actions -->
        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Actions</h3>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="{{ path('front_reclamation_new') }}" class="btn btn-primary btn-sm">
                        <i class="ti ti-ticket"></i> Créer une réclamation
                    </a>
                    <a href="{{ path('front_reclamation_index') }}" class="btn btn-outline-primary btn-sm">
                        <i class="ti ti-list"></i> Mes réclamations
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-9">
        <!-- Search & Sort Bar -->
        <div class="card mb-3">
            <div class="card-body">
                <form method="get" class="row g-3">
                    {% if selected_subject %}
                        <input type="hidden" name="subject" value="{{ selected_subject }}">
                    {% endif %}
                    
                    <div class="col-md-5">
                        <div class="input-icon">
                            <span class="input-icon-addon">
                                <i class="ti ti-search"></i>
                            </span>
                            <input type="text" name="search" class="form-control" 
                                   placeholder="Rechercher une question..." value="{{ search }}">
                        </div>
                    </div>
                    
                    <div class="col-md-3">
                        <select name="sort" class="form-select">
                            <option value="submittedAt" {% if sort == 'submittedAt' %}selected{% endif %}>Trier par date</option>
                            <option value="question" {% if sort == 'question' %}selected{% endif %}>Trier par question</option>
                            <option value="subject" {% if sort == 'subject' %}selected{% endif %}>Trier par sujet</option>
                            <option value="category" {% if sort == 'category' %}selected{% endif %}>Trier par catégorie</option>
                        </select>
                    </div>
                    
                    <div class="col-md-2">
                        <select name="order" class="form-select">
                            <option value="DESC" {% if order == 'DESC' %}selected{% endif %}>Décroissant</option>
                            <option value="ASC" {% if order == 'ASC' %}selected{% endif %}>Croissant</option>
                        </select>
                    </div>
                    
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="ti ti-filter"></i> Filtrer
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- FAQs List -->
        {% if faqs|length > 0 %}
            <div class="mb-3 d-flex justify-content-between align-items-center">
                <h3 class="page-subtitle mb-0">
                    {{ total }} résultat(s) trouvé(s)
                </h3>
                {% if pages > 1 %}
                    <span class="text-muted">Page {{ page }} / {{ pages }}</span>
                {% endif %}
            </div>

            <div class="space-y">
                {% for faq in faqs %}
                <div class="card">
                    <div class="card-body">
                        <div class="row align-items-start">
                            <div class="col">
                                <h4 class="card-title mb-2">
                                    <i class="ti ti-help-circle me-2 text-info"></i>
                                    {{ faq.question }}
                                </h4>
                                <p class="card-text text-muted mb-3">
                                    {{ faq.answer|nl2br }}
                                </p>
                                <div class="d-flex gap-2 flex-wrap">
                                    {% if faq.category %}
                                    <span class="badge bg-light text-dark">
                                        <i class="ti ti-tag me-1"></i>
                                        {% if faq.category == 'general' %}
                                            Général
                                        {% elseif faq.category == 'technical' %}
                                            Technique
                                        {% elseif faq.category == 'pedagogical' %}
                                            Pédagogique
                                        {% elseif faq.category == 'billing' %}
                                            Facturation
                                        {% else %}
                                            {{ faq.category }}
                                        {% endif %}
                                    </span>
                                    {% endif %}
                                    <small class="text-muted align-self-center">
                                        <i class="ti ti-calendar me-1"></i>
                                        {{ faq.submittedAt|date('d/m/Y') }}
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {% endfor %}
            </div>

            <!-- Pagination -->
            {% if pages > 1 %}
            <div class="d-flex justify-content-center mt-4">
                <ul class="pagination">
                    <li class="page-item {% if page <= 1 %}disabled{% endif %}">
                        <a class="page-link" href="{{ path('front_faq_index', app.request.query.all|merge({'page': page - 1})) }}">
                            <i class="ti ti-chevron-left"></i>
                        </a>
                    </li>
                    
                    {% for p in 1..pages %}
                        <li class="page-item {% if p == page %}active{% endif %}">
                            <a class="page-link" href="{{ path('front_faq_index', app.request.query.all|merge({'page': p})) }}">{{ p }}</a>
                        </li>
                    {% endfor %}
                    
                    <li class="page-item {% if page >= pages %}disabled{% endif %}">
                        <a class="page-link" href="{{ path('front_faq_index', app.request.query.all|merge({'page': page + 1})) }}">
                            <i class="ti ti-chevron-right"></i>
                        </a>
                    </li>
                </ul>
            </div>
            {% endif %}
        {% else %}
            <!-- État vide -->
            <div class="card">
                <div class="card-body text-center py-5">
                    <div style="font-size: 3rem; opacity: 0.3; margin-bottom: 1rem;">
                        <i class="ti ti-help-off"></i>
                    </div>
                    <h3>Aucune FAQ trouvée</h3>
                    <p class="text-muted mb-3">
                        {% if search %}
                            Aucun résultat pour "{{ search }}".
                        {% elseif selected_subject %}
                            Aucune question correspond à cette catégorie.
                        {% else %}
                            La section FAQ est vide pour le moment.
                        {% endif %}
                    </p>
                    <div class="btn-list justify-content-center">
                        {% if search %}
                        <a href="{{ path('front_faq_index', app.request.query.all|merge({'search': null, 'page': 1})) }}" class="btn btn-outline-primary">
                            <i class="ti ti-arrow-back"></i> Effacer la recherche
                        </a>
                        {% endif %}
                        <a href="{{ path('front_reclamation_new') }}" class="btn btn-primary">
                            <i class="ti ti-ticket"></i> Créer une réclamation
                        </a>
                        {% if selected_subject %}
                        <a href="{{ path('front_faq_index', app.request.query.all|merge({'subject': null, 'page': 1})) }}" class="btn btn-outline-primary">
                            <i class="ti ti-arrow-back"></i> Retour à toutes les FAQs
                        </a>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

