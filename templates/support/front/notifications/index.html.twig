{% extends 'base.html.twig' %}
{% block title %}Mes notifications{% endblock %}
{% block body %}

<aside class="sidebar" id="sidebar">
    <a href="{{ path('app_homepage') }}" class="sidebar-logo">
        <div class="sidebar-logo-text">Lingua<span>Learn</span></div>
    </a>
    <div class="sidebar-user">
        <div class="user-avatar">{{ app.user.firstName|first|upper }}{{ app.user.lastName|first|upper }}</div>
        <div class="user-info">
            <div class="user-name">{{ app.user.fullName }}</div>
            <div class="user-plan free">Free Plan</div>
        </div>
    </div>
    <nav class="sidebar-nav">
        <span class="nav-section-label">Main</span>
        <a href="{{ path('user_dashboard') }}" class="nav-item"><span class="nav-icon">⊞</span> Dashboard</a>
        <a href="#" class="nav-item"><span class="nav-icon">📚</span> My Courses</a>
        <a href="{{ path('learn_practice') }}" class="nav-item"><span class="nav-icon">🧩</span> Practice</a>
        <a href="#" class="nav-item"><span class="nav-icon">📝</span> Mock Tests</a>
        <span class="nav-section-label">Account</span>
        <a href="{{ path('user_profile') }}" class="nav-item"><span class="nav-icon">👤</span> My Profile</a>
        <a href="{{ path('app_user_notifications') }}" class="nav-item active">
            <span class="nav-icon">🔔</span> Notifications
            {{ include('support/front/notifications/badge.html.twig') }}
        </a>
        <a href="#" class="nav-item"><span class="nav-icon">👑</span> Subscription</a>
        <span class="nav-section-label">Support</span>
        <a href="#" class="nav-item" style="opacity:.4;cursor:not-allowed"><span class="nav-icon">❓</span> FAQ</a>
        <a href="{{ path('app_user_reclamation_index') }}" class="nav-item"><span class="nav-icon">💬</span> Mes réclamations</a>
        <span class="nav-section-label">System</span>
        <a href="{{ path('app_logout') }}" class="nav-item"><span class="nav-icon">→</span> Log Out</a>
    </nav>
</aside>
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<div class="main">
    <header class="topbar">
        <div class="topbar-left">
            <button class="hamburger-btn" id="hamburgerBtn"><span></span><span></span><span></span></button>
            <div>
                <div class="page-heading">🔔 Notifications</div>
                <div class="page-sub">Vos alertes de support</div>
            </div>
        </div>
        <div class="topbar-right">
            <a href="{{ path('user_profile') }}" class="topbar-btn">👤</a>
        </div>
    </header>

    <main class="page-content">

        {% if notifications is empty %}
            <div class="empty-card">
                <div style="font-size:2.5rem;margin-bottom:.75rem">🔕</div>
                <p style="font-weight:700;font-size:1.05rem;margin-bottom:.5rem">Aucune notification</p>
                <p style="color:var(--muted);font-size:.875rem">Vous recevrez une alerte quand l'équipe support vous répondra.</p>
            </div>
        {% else %}
            <div class="notif-list">
                {% for notif in notifications %}
                <div class="notif-card {{ notif.isRead ? 'read' : 'unread' }}" 
                     data-id="{{ notif.id }}"
                     data-url="{{ notif.reclamation ? path('app_user_reclamation_show', {id: notif.reclamation.id}) : '#' }}">
                    <div class="notif-icon type-{{ notif.type }}">
                        {% if notif.type == 'success' %}✅
                        {% elseif notif.type == 'warning' %}⚠️
                        {% else %}💬{% endif %}
                    </div>
                    <div class="notif-body">
                        <div class="notif-message">{{ notif.message }}</div>
                        <div class="notif-time">{{ notif.createdAt|date('d/m/Y à H:i') }}</div>
                    </div>
                    {% if not notif.isRead %}
                        <span class="notif-dot"></span>
                    {% endif %}
                </div>
                {% endfor %}
            </div>
        {% endif %}

    </main>
</div>

<style>
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}
:root{--white:#fff;--off-white:#f7f9fc;--ink:#0d1526;--muted:#7a87a0;--border:#e2e8f2;--blue:#2563eb;--blue-dark:#1d4ed8;--blue-bg:#eff6ff;--blue-mid:#3b82f6;--green:#16a34a;--green-bg:#f0fdf4;--gold:#ca8a04;--sidebar-w:260px;--radius:12px;--radius-lg:20px}
body{font-family:'Sora',sans-serif;background:var(--off-white);color:var(--ink);min-height:100vh}
.sidebar{position:fixed;top:0;left:0;bottom:0;width:var(--sidebar-w);background:var(--white);border-right:1px solid var(--border);display:flex;flex-direction:column;z-index:50;transition:transform .3s}
.sidebar-logo{padding:1.5rem 1.5rem 1.25rem;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:.75rem;text-decoration:none}
.sidebar-logo-text{font-size:1.3rem;font-weight:700;color:var(--ink)}
.sidebar-logo-text span{color:var(--blue)}
.sidebar-user{padding:1.25rem 1.5rem;border-bottom:1px solid var(--border);display:flex;align-items:center;gap:.85rem}
.user-avatar{width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,var(--blue),var(--blue-mid));display:flex;align-items:center;justify-content:center;font-size:.9rem;font-weight:700;color:#fff;flex-shrink:0}
.user-info{flex:1;min-width:0}
.user-name{font-size:.85rem;font-weight:600;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.user-plan{font-size:.7rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-top:.1rem}
.sidebar-nav{flex:1;padding:1rem 0;overflow-y:auto}
.nav-section-label{font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:var(--muted);padding:.75rem 1.5rem .35rem;display:block}
.nav-item{display:flex;align-items:center;gap:.75rem;padding:.65rem 1.5rem;font-size:.84rem;font-weight:500;color:var(--muted);text-decoration:none;transition:color .2s,background .2s;position:relative}
.nav-item:hover{color:var(--ink);background:var(--off-white)}
.nav-item.active{color:var(--blue);background:var(--blue-bg);font-weight:600}
.nav-item.active::before{content:'';position:absolute;left:0;top:4px;bottom:4px;width:3px;background:var(--blue);border-radius:0 3px 3px 0}
.nav-icon{font-size:1.1rem;width:20px;text-align:center}
.main{margin-left:var(--sidebar-w);min-height:100vh;display:flex;flex-direction:column}
.topbar{position:sticky;top:0;z-index:40;background:rgba(255,255,255,.92);backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:.85rem 2rem;display:flex;align-items:center;justify-content:space-between}
.topbar-left{display:flex;align-items:center;gap:1rem}
.page-heading{font-size:1.25rem;font-weight:700;color:var(--ink)}
.page-sub{font-size:.78rem;color:var(--muted)}
.topbar-right{display:flex;align-items:center;gap:.75rem}
.topbar-btn{width:38px;height:38px;border-radius:var(--radius);border:1.5px solid var(--border);background:transparent;display:flex;align-items:center;justify-content:center;text-decoration:none;color:var(--ink);font-size:1.1rem}
.hamburger-btn{display:none;width:38px;height:38px;border-radius:var(--radius);border:1.5px solid var(--border);background:transparent;align-items:center;justify-content:center;cursor:pointer;flex-direction:column;gap:4px}
.hamburger-btn span{width:16px;height:1.5px;background:var(--ink);display:block;border-radius:2px}
.page-content{padding:2rem;flex:1;max-width:760px}
.notif-list{display:flex;flex-direction:column;gap:.6rem}
.notif-card{display:flex;align-items:center;gap:1rem;background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius-lg);padding:1.1rem 1.4rem;cursor:pointer;transition:box-shadow .2s,border-color .2s;position:relative}
.notif-card:hover{box-shadow:0 4px 16px rgba(13,21,38,.08);border-color:#c7d2fe}
.notif-card.unread{border-left:4px solid var(--blue);background:var(--blue-bg)}
.notif-card.unread .notif-message{font-weight:700;color:var(--ink)}
.notif-card.read{opacity:.75}
.notif-icon{font-size:1.5rem;flex-shrink:0;width:44px;height:44px;display:flex;align-items:center;justify-content:center;border-radius:50%;background:var(--off-white)}
.type-success .notif-icon,.notif-card .type-success{background:var(--green-bg)}
.type-warning .notif-icon,.notif-card .type-warning{background:#fff7ed}
.notif-body{flex:1;min-width:0}
.notif-message{font-size:.88rem;color:var(--ink);line-height:1.4}
.notif-time{font-size:.72rem;color:var(--muted);margin-top:.25rem}
.notif-dot{width:10px;height:10px;border-radius:50%;background:var(--blue);flex-shrink:0}
.empty-card{text-align:center;padding:3.5rem 1rem;background:var(--white);border:1.5px solid var(--border);border-radius:var(--radius-lg)}
@media(max-width:768px){:root{--sidebar-w:0px}.sidebar{transform:translateX(-260px);width:260px}.sidebar.open{transform:translateX(0)}.main{margin-left:0}.hamburger-btn{display:flex}.page-content{padding:1.25rem}}
.sidebar-overlay{display:none;position:fixed;inset:0;background:rgba(13,21,38,.4);z-index:45}
.sidebar-overlay.visible{display:block}
</style>

<script>
// Sidebar
const sidebar = document.getElementById('sidebar');
const overlay = document.getElementById('sidebarOverlay');
const hamburger = document.getElementById('hamburgerBtn');
if(hamburger) hamburger.addEventListener('click', () => { sidebar.classList.toggle('open'); overlay.classList.toggle('visible'); });
if(overlay) overlay.addEventListener('click', () => { sidebar.classList.remove('open'); overlay.classList.remove('visible'); });

// Clic sur notification → marquer lue + rediriger
document.querySelectorAll('.notif-card').forEach(card => {
    card.addEventListener('click', async () => {
        const id  = card.dataset.id;
        const url = card.dataset.url;
        try {
            const res = await fetch(`/support/notifications/${id}/read`, { method: 'POST' });
            const data = await res.json();
            if (data.redirect) window.location.href = data.redirect;
        } catch(e) {
            if (url && url !== '#') window.location.href = url;
        }
    });
});
</script>
{% endblock %}
