{% extends 'base.html.twig' %}

{% block title %}Support - Reclamations & FAQ{% endblock %}

{% block page_title %}
    <i class="ti ti-lifebuoy me-2"></i> Support Center
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-12">
        <!-- Tabs Navigation -->
        <ul class="nav nav-tabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="reclamations-tab" data-bs-toggle="tab" data-bs-target="#reclamations" type="button" role="tab" aria-controls="reclamations" aria-selected="true">
                    <i class="ti ti-ticket me-2"></i> My Reclamations
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="faq-tab" data-bs-toggle="tab" data-bs-target="#faq" type="button" role="tab" aria-controls="faq" aria-selected="false">
                    <i class="ti ti-help me-2"></i> FAQ
                </button>
            </li>
        </ul>

        <!-- Tab Content -->
        <div class="tab-content">
            <!-- RECLAMATIONS TAB -->
            <div class="tab-pane fade show active" id="reclamations" role="tabpanel" aria-labelledby="reclamations-tab">
                <div class="card mt-3">
                        <div class="card-header">
                            <h3 class="card-title">My Reclamations</h3>
                            <div class="card-actions">
                                <a href="{{ path('front_reclamation_new') }}" class="btn btn-primary btn-sm">
                                    <i class="ti ti-plus"></i> New Reclamation
                                </a>
                            </div>
                        </div>
                    <div class="card-body">
                        {% if reclamations|length > 0 %}
                            <div class="table-responsive">
                                <table class="table table-vcenter table-hover">
                                    <thead>
                                        <tr>
                                            <th>ID</th>
                                            <th>Subject</th>
                                            <th>Status</th>
                                            <th>Date</th>
                                            <th>Responses</th>
                                            <th style="width: 1%; white-space: nowrap;">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for reclamation in reclamations %}
                                        <tr>
                                            <td><strong>#{{ reclamation.id }}</strong></td>
                                            <td>
                                                <div class="text-truncate" style="max-width: 200px;">
                                                    {{ reclamation.subject }}
                                                </div>
                                            </td>
                                            <td>
                                                {% if reclamation.status == 'PENDING' %}
                                                    <span class="badge bg-yellow">Pending</span>
                                                {% elseif reclamation.status == 'IN_PROGRESS' %}
                                                    <span class="badge bg-blue">In Progress</span>
                                                {% elseif reclamation.status == 'RESOLVED' %}
                                                    <span class="badge bg-green">Resolved</span>
                                                {% elseif reclamation.status == 'CLOSED' %}
                                                    <span class="badge bg-secondary">Closed</span>
                                                {% endif %}
                                            </td>
                                            <td>{{ reclamation.submittedAt|date('d/m/Y H:i') }}</td>
                                            <td>
                                                <span class="badge bg-azure">{{ reclamation.responses|length }}</span>
                                            </td>
                                            <td style="white-space: nowrap;">
                                                <a href="{{ path('front_reclamation_show', {'id': reclamation.id}) }}" class="btn btn-sm btn-info" title="View">
                                                    <i class="ti ti-eye"></i>
                                                </a>
                                                {% if reclamation.status == 'PENDING' %}
                                                    <a href="{{ path('front_reclamation_edit', {'id': reclamation.id}) }}" class="btn btn-sm btn-warning" title="Edit">
                                                        <i class="ti ti-edit"></i>
                                                    </a>
                                                    <form method="post" action="{{ path('front_reclamation_delete', {'id': reclamation.id}) }}" class="d-inline">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reclamation.id) }}">
                                                        <button type="submit" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')" title="Delete">
                                                            <i class="ti ti-trash"></i>
                                                        </button>
                                                    </form>
                                                {% endif %}
                                            </td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <div class="empty">
                                <div class="empty-icon">
                                    <i class="ti ti-ticket-off"></i>
                                </div>
                                <p class="empty-title">No Reclamations Yet</p>
                                <p class="empty-subtitle">Create your first reclamation to get support.</p>
                                <div class="empty-action">
                                    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newReclamationModal">
                                        <i class="ti ti-plus"></i> Create Reclamation
                                    </button>
                                </div>
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>

            <!-- FAQ TAB -->
            <div class="tab-pane fade" id="faq" role="tabpanel" aria-labelledby="faq-tab">
                <div class="row mt-3">
                    <div class="col-lg-3">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">Categories</h3>
                            </div>
                            <div class="list-group list-group-flush">
                                <a href="#all-faqs" class="list-group-item list-group-item-action" onclick="filterFAQs('')">
                                    <i class="ti ti-list me-2"></i> All FAQs
                                </a>
                                {% for subject in subjects %}
                                <a href="#faqs-{{ subject }}" class="list-group-item list-group-item-action" onclick="filterFAQs('{{ subject }}')">
                                    <i class="ti ti-folder me-2"></i>
                                    {% if subject == 'payment' %}
                                        Payment
                                    {% elseif subject == 'technical' %}
                                        Technical
                                    {% elseif subject == 'content' %}
                                        Content
                                    {% elseif subject == 'premium' %}
                                        Premium
                                    {% elseif subject == 'account' %}
                                        Account
                                    {% else %}
                                        {{ subject }}
                                    {% endif %}
                                </a>
                                {% endfor %}
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-9">
                        <div class="card">
                            <div class="card-header">
                                <h3 class="card-title">Frequently Asked Questions</h3>
                            </div>
                            <div class="card-body">
                                {% if faqs|length > 0 %}
                                    <div class="space-y">
                                        {% for faq in faqs %}
                                        <div class="faq-item" data-subject="{{ faq.subject }}">
                                            <div class="accordion-item">
                                                <h2 class="accordion-header">
                                                    <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#faq-{{ faq.id }}" aria-expanded="false" aria-controls="faq-{{ faq.id }}">
                                                        <i class="ti ti-help-circle me-2 text-info"></i>
                                                        {{ faq.question }}
                                                    </button>
                                                </h2>
                                                <div id="faq-{{ faq.id }}" class="accordion-collapse collapse" data-bs-parent=".space-y">
                                                    <div class="accordion-body">
                                                        {{ faq.answer|nl2br }}
                                                        {% if faq.category %}
                                                            <div class="mt-3">
                                                                <span class="badge bg-light text-dark">
                                                                    {{ faq.category }}
                                                                </span>
                                                            </div>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        {% endfor %}
                                    </div>
                                {% else %}
                                    <div class="empty">
                                        <div class="empty-icon">
                                            <i class="ti ti-help-off"></i>
                                        </div>
                                        <p class="empty-title">No FAQs Available</p>
                                        <p class="empty-subtitle">Check back later for answers to common questions.</p>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{# Creation moved to dedicated page `front_reclamation_new` (requires ROLE_USER). #}

<script>
function filterFAQs(subject) {
    const faqItems = document.querySelectorAll('.faq-item');

    faqItems.forEach(item => {
        if (subject === '' || item.dataset.subject === subject) {
            item.style.display = '';
        } else {
            item.style.display = 'none';
        }
    });
}
</script>
{% endblock %}
