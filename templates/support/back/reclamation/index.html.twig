{% extends 'layouts/admin.html.twig' %}

{% block title %}Reclamations Management - Admin{% endblock %}

{% block page_title %}
    <i class="ti ti-ticket me-2"></i> Reclamations Management
{% endblock %}

{% block content %}
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">All Reclamations</h3>
                <div class="card-actions">
                    {% if current_status %}
                    <a href="{{ path('admin_reclamation_index') }}" class="btn btn-outline-secondary btn-sm">
                        <i class="ti ti-x"></i> Clear Filter
                    </a>
                    {% endif %}
                </div>
            </div>
            <div class="card-body">
                <!-- Status Filter -->
                <div class="mb-3">
                    <div class="btn-group" role="group">
                        <a href="{{ path('admin_reclamation_index') }}"
                           class="btn {% if not current_status %}btn-primary{% else %}btn-outline-primary{% endif %}">
                            All ({{ reclamations|length }})
                        </a>
                        <a href="{{ path('admin_reclamation_index', {'status': 'PENDING'}) }}"
                           class="btn {% if current_status == 'PENDING' %}btn-warning{% else %}btn-outline-warning{% endif %}">
                            Pending ({{ reclamations|filter(r => r.status == 'PENDING')|length }})
                        </a>
                        <a href="{{ path('admin_reclamation_index', {'status': 'IN_PROGRESS'}) }}"
                           class="btn {% if current_status == 'IN_PROGRESS' %}btn-info{% else %}btn-outline-info{% endif %}">
                            In Progress ({{ reclamations|filter(r => r.status == 'IN_PROGRESS')|length }})
                        </a>
                        <a href="{{ path('admin_reclamation_index', {'status': 'RESOLVED'}) }}"
                           class="btn {% if current_status == 'RESOLVED' %}btn-success{% else %}btn-outline-success{% endif %}">
                            Resolved ({{ reclamations|filter(r => r.status == 'RESOLVED')|length }})
                        </a>
                        <a href="{{ path('admin_reclamation_index', {'status': 'CLOSED'}) }}"
                           class="btn {% if current_status == 'CLOSED' %}btn-secondary{% else %}btn-outline-secondary{% endif %}">
                            Closed ({{ reclamations|filter(r => r.status == 'CLOSED')|length }})
                        </a>
                    </div>
                </div>

                {% if reclamations|length > 0 %}
                    <div class="table-responsive">
                        <table class="table table-vcenter table-hover">
                            <thead>
                                <tr>
                                    <th>ID</th>
                                    <th>Subject</th>
                                    <th>User</th>
                                    <th>Status</th>
                                    <th>Responses</th>
                                    <th>Date</th>
                                    <th style="width: 1%; white-space: nowrap;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for reclamation in reclamations %}
                                <tr>
                                    <td>
                                        <strong>#{{ reclamation.id }}</strong>
                                    </td>
                                    <td>
                                        <div class="text-truncate" style="max-width: 250px;">
                                            {{ reclamation.subject }}
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            {{ reclamation.user.firstName }} {{ reclamation.user.lastName }}
                                        </div>
                                        <small class="text-muted">{{ reclamation.user.email }}</small>
                                    </td>
                                    <td>
                                        {% if reclamation.status == 'PENDING' %}
                                            <span class="badge bg-yellow">Pending</span>
                                        {% elseif reclamation.status == 'IN_PROGRESS' %}
                                            <span class="badge bg-blue">In Progress</span>
                                        {% elseif reclamation.status == 'RESOLVED' %}
                                            <span class="badge bg-green">Resolved</span>
                                        {% elseif reclamation.status == 'CLOSED' %}
                                            <span class="badge bg-secondary">Closed</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <span class="badge bg-azure">
                                            {{ reclamation.responses|length }}
                                        </span>
                                    </td>
                                    <td>
                                        {{ reclamation.submittedAt|date('d/m/Y H:i') }}
                                    </td>
                                    <td style="white-space: nowrap;">
                                        <a href="{{ path('admin_reclamation_show', {'id': reclamation.id}) }}"
                                           class="btn btn-sm btn-info">
                                            <i class="ti ti-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                {% else %}
                    <div class="empty">
                        <div class="empty-icon">
                            <i class="ti ti-ticket-off"></i>
                        </div>
                        <p class="empty-title">No reclamations</p>
                        <p class="empty-subtitle text-muted">
                            No tickets found for the current filter.
                        </p>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

