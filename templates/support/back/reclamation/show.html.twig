{% extends 'base/layout.html.twig' %}

{% block title %}Reclamation #{{ reclamation.id }} - Admin{% endblock %}

{% block page_title %}
    <i class="ti ti-ticket me-2"></i> Reclamation #{{ reclamation.id }}
{% endblock %}

{% block body %}
<div class="row">
    <div class="col-lg-8">
        <!-- Reclamation Details -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Details</h3>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Subject:</strong> {{ reclamation.subject }}
                    </div>
                    <div class="col-md-6">
                        <strong>Status:</strong>
                        {% if reclamation.status == 'PENDING' %}
                            <span class="badge bg-yellow">Pending</span>
                        {% elseif reclamation.status == 'IN_PROGRESS' %}
                            <span class="badge bg-blue">In Progress</span>
                        {% elseif reclamation.status == 'RESOLVED' %}
                            <span class="badge bg-green">Resolved</span>
                        {% elseif reclamation.status == 'CLOSED' %}
                            <span class="badge bg-secondary">Closed</span>
                        {% endif %}
                    </div>
                </div>

                <div class="mb-3">
                    <strong>Message:</strong>
                    <div class="card card-sm mt-2">
                        <div class="card-body">
                            {{ reclamation.messageBody|nl2br }}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Conversation -->
        <div class="card mt-4">
            <div class="card-header">
                <h3 class="card-title">Conversation</h3>
            </div>
            <div class="card-body">
                {% for response in reclamation.responses %}
                <div class="card card-sm mb-3">
                    <div class="card-header bg-light d-flex justify-content-between">
                        <strong>
                            <i class="ti ti-headset me-1"></i> Support
                            {% if response.author %}
                                ({{ response.author.firstName }} {{ response.author.lastName }})
                            {% else %}
                                (Anonyme)
                            {% endif %}
                        </strong>
                        <small class="text-muted">{{ response.respondedAt|date('d/m/Y H:i') }}</small>
                    </div>
                    <div class="card-body">
                        {{ response.message|nl2br }}
                    </div>
                </div>
                {% endfor %}

                {% if reclamation.responses|length == 0 %}
                <div class="empty">
                    <div class="empty-icon">
                        <i class="ti ti-messages"></i>
                    </div>
                    <p class="empty-title">No responses yet</p>
                    <p class="empty-subtitle text-muted">Add a response below to interact with the user.</p>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Response Form -->
        <div class="card mt-4">
            <div class="card-header">
                <h3 class="card-title">Add Response</h3>
            </div>
            <div class="card-body">
                {{ form_start(form) }}

                    <div class="mb-3">
                        {{ form_label(form.message) }}
                        {{ form_widget(form.message, {'attr': {'class': 'form-control', 'rows': '5'}}) }}
                        {% if form.message.vars.errors|length > 0 %}
                            <div class="invalid-feedback" style="display: block;">
                                {{ form_errors(form.message) }}
                            </div>
                        {% endif %}
                    </div>

                    <div class="mb-3">
                        {{ form_label(form.status) }}
                        {{ form_widget(form.status, {'attr': {'class': 'form-select'}}) }}
                        <small class="form-hint">Update the ticket status when responding</small>
                    </div>

                    <div class="form-footer">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-send"></i> Send Response
                        </button>
                        <a href="{{ path('admin_reclamation_index') }}" class="btn btn-link">
                            Back to list
                        </a>
                    </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <!-- Sidebar -->
    <div class="col-lg-4">
        <!-- User Info -->
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">User Information</h3>
            </div>
            <div class="list-group list-group-flush">
                {% if reclamation.user %}
                <div class="list-group-item">
                    <div class="row align-items-center">
                        <div class="col">
                            <strong>Name</strong>
                        </div>
                        <div class="col-auto">
                            {{ reclamation.user.firstName }} {{ reclamation.user.lastName }}
                        </div>
                    </div>
                </div>
                <div class="list-group-item">
                    <div class="row align-items-center">
                        <div class="col">
                            <strong>Email</strong>
                        </div>
                        <div class="col-auto">
                            <a href="mailto:{{ reclamation.user.email }}">
                                {{ reclamation.user.email }}
                            </a>
                        </div>
                    </div>
                </div>
                {% else %}
                <div class="list-group-item">
                    <div class="row align-items-center">
                        <div class="col">
                            <strong>User</strong>
                        </div>
                        <div class="col-auto text-muted">
                            Anonyme
                        </div>
                    </div>
                </div>
                {% endif %}
            </div>
        </div>

        <!-- Ticket Info -->
        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Ticket Information</h3>
            </div>
            <div class="list-group list-group-flush">
                <div class="list-group-item">
                    <div class="row align-items-center">
                        <div class="col text-muted">ID</div>
                        <div class="col-auto">
                            <strong>#{{ reclamation.id }}</strong>
                        </div>
                    </div>
                </div>
                <div class="list-group-item">
                    <div class="row align-items-center">
                        <div class="col text-muted">Created</div>
                        <div class="col-auto">
                            {{ reclamation.submittedAt|date('d/m/Y H:i') }}
                        </div>
                    </div>
                </div>
                <div class="list-group-item">
                    <div class="row align-items-center">
                        <div class="col text-muted">Responses</div>
                        <div class="col-auto">
                            <span class="badge bg-azure">{{ reclamation.responses|length }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Actions -->
        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Actions</h3>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="{{ path('admin_reclamation_index') }}" class="btn btn-outline-primary">
                        <i class="ti ti-arrow-back"></i> Back to list
                    </a>
                    <form method="post" action="{{ path('admin_reclamation_delete', {'id': reclamation.id}) }}">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ reclamation.id) }}">
                        <button type="submit" class="btn btn-danger w-100"
                                onclick="return confirm('Are you sure?')">
                            <i class="ti ti-trash"></i> Delete Ticket
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
