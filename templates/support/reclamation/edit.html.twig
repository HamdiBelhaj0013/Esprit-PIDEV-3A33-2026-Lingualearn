{% extends 'layouts/admin.html.twig' %}

{% block title %}Edit Ticket #{{ reclamation.id }}{% endblock %}

{% block page_title %}
    <i class="ti ti-edit me-2"></i> Edit Ticket #{{ reclamation.id }}
{% endblock %}

{% block content %}
<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Ticket Details</h3>
            </div>
            <div class="card-body">
                {{ form_start(form) }}

                    <div class="mb-3">
                        {{ form_row(form.subject) }}
                    </div>

                    <div class="mb-3">
                        {{ form_row(form.messageBody) }}
                    </div>

                    {% if is_granted('ROLE_ADMIN') %}
                        <div class="mb-3">
                            {{ form_row(form.status) }}
                        </div>
                    {% endif %}

                    <div class="form-footer">
                        <button type="submit" class="btn btn-primary">
                            <i class="ti ti-check"></i> Save Changes
                        </button>
                        <a href="{{ path('app_reclamation_show', {'id': reclamation.id}) }}" class="btn btn-link">
                            Cancel
                        </a>
                    </div>

                {{ form_end(form) }}
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <h3 class="card-title">Information</h3>
            </div>
            <div class="list-group list-group-flush">
                <div class="list-group-item">
                    <div class="row align-items-center">
                        <div class="col text-muted">ID</div>
                        <div class="col-auto">
                            <strong>#{{ reclamation.id }}</strong>
                        </div>
                    </div>
                </div>
                <div class="list-group-item">
                    <div class="row align-items-center">
                        <div class="col text-muted">Created</div>
                        <div class="col-auto">
                            {{ reclamation.submittedAt|date('d/m/Y H:i') }}
                        </div>
                    </div>
                </div>
                <div class="list-group-item">
                    <div class="row align-items-center">
                        <div class="col text-muted">Responses</div>
                        <div class="col-auto">
                            <span class="badge bg-azure">{{ reclamation.responses|length }}</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-3">
            <div class="card-header">
                <h3 class="card-title">Actions</h3>
            </div>
            <div class="card-body">
                <div class="d-grid gap-2">
                    <a href="{{ path('app_reclamation_show', {'id': reclamation.id}) }}" class="btn btn-outline-primary">
                        <i class="ti ti-arrow-back"></i> Back to ticket
                    </a>
                    <a href="{{ path('app_reclamation_index') }}" class="btn btn-outline-secondary">
                        <i class="ti ti-list"></i> Back to list
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
